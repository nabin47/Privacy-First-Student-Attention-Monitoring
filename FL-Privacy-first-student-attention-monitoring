n","\n","print(\"\\nCATEGORICAL VALUES\")\n","for c in df.select_dtypes(include=\"object\").columns:\n","    print(f\"--- {c} ---\")\n","    print(df[c].value_counts(dropna=False))\n","\n","print(\"\\nROW-ORDER DIAGNOSTIC (not evidence of temporal identity)\")\n","y = df[TARGET].to_numpy()\n","same_rate = float(np.mean(y[1:] == y[:-1]))\n","p1 = float(df[TARGET].mean())\n","iid_expected = p1**2 + (1-p1)**2\n","print(\"Consecutive same-label rate:\", round(same_rate,4))\n","print(\"IID expected same-label rate:\", round(iid_expected,4))\n","\n","block = df.assign(_block=np.arange(len(df))//500).groupby(\"_block\")[TARGET].agg(size=\"size\", label1_rate=\"mean\")\n","display(block)\n"]},{"cell_type":"code","execution_count":5,"id":"c970d165","metadata":{"execution":{"iopub.execute_input":"2026-10-11T10:38:24.479907Z","iopub.status.busy":"2026-10-11T10:38:24.479621Z","iopub.status.idle":"2026-10-11T10:38:24.535425Z","shell.execute_reply":"2026-10-11T10:38:24.534607Z"},"papermill":{"duration":0.064716,"end_time":"2026-10-11T10:38:24.536723","exception":false,"start_time":"2026-10-11T10:38:24.472007","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train: (4995, 46) Test: (1249, 46)\n","Encoded features: 46\n"]}],"source":["\n","# 5. Leakage-safe train/test preprocessing\n","train_df, test_df = train_test_split(\n","    df, test_size=0.20, stratify=df[TARGET], random_state=SEED\n",")\n","\n","numeric_cols = [c for c in EXPECTED_FEATURES if df[c].dtype != \"object\"]\n","categorical_cols = [c for c in EXPECTED_FEATURES if df[c].dtype == \"object\"]\n","\n","try:\n","    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","except TypeError:\n","    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","\n","preprocessor = ColumnTransformer([\n","    (\"num\", Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"scaler\", StandardScaler()),\n","    ]), numeric_cols),\n","    (\"cat\", Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","        (\"onehot\", onehot),\n","    ]), categorical_cols),\n","])\n","\n","X_train = preprocessor.fit_transform(train_df[EXPECTED_FEATURES]).astype(np.float32)\n","X_test = preprocessor.transform(test_df[EXPECTED_FEATURES]).astype(np.float32)\n","y_train = train_df[TARGET].to_numpy(np.int64)\n","y_test = test_df[TARGET].to_numpy(np.int64)\n","FEATURE_NAMES_ENCODED = list(preprocessor.get_feature_names_out())\n","\n","print(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\n","print(\"Encoded features:\", len(FEATURE_NAMES_ENCODED))\n","\n","\n","# Fold-safe preprocessing helper used by blocked sensitivity and any fold-wise audit.\n","# IMPORTANT: the preprocessor is fit only on the supplied training frame, preventing\n","# information from the blocked test fold from entering imputation/scaling/encoding.\n","def build_fold_preprocessor(frame, cols=None):\n","    cols = list(EXPECTED_FEATURES if cols is None else cols)\n","    num_cols = [c for c in cols if frame[c].dtype != \"object\"]\n","    cat_cols = [c for c in cols if frame[c].dtype == \"object\"]\n","\n","    try:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","    except TypeError:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","\n","    transformers = []\n","    if num_cols:\n","        transformers.append((\n","            \"num\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"median\")),\n","                (\"scaler\", StandardScaler()),\n","            ]),\n","            num_cols,\n","        ))\n","    if cat_cols:\n","        transformers.append((\n","            \"cat\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","                (\"onehot\", oh),\n","            ]),\n","            cat_cols,\n","        ))\n","\n","    if not transformers:\n","        raise ValueError(\"No usable numeric or categorical columns were supplied.\")\n","\n","    return ColumnTransformer(transformers, remainder=\"drop\")\n","\n"]},{"cell_type":"markdown","id":"26e23155","metadata":{"papermill":{"duration":0.0062,"end_time":"2026-10-11T10:38:24.549516","exception":false,"start_time":"2026-10-11T10:38:24.543316","status":"completed"},"tags":[]},"source":["\n","## 6. Benchmark-validity / feature-dependence audit\n","\n","This section is deliberately separate from FL.\n","\n","A high-performing shallow model does **not** automatically mean train/test leakage. Instead, it shows that the released behavioral representation contains a strong, low-complexity mapping to the released operational label.\n","\n","We therefore report:\n","\n","- shallow decision-tree reconstruction,\n","- feature-group-only performance,\n","- a direct-cue lookup,\n","- and later, leave-one-group-out sensitivity.\n","\n","Use terms such as **feature–label construction dependence** or **benchmark-validity audit**, rather than calling this “leakage” unless a true split violation is demonstrated.\n"]},{"cell_type":"code","execution_count":6,"id":"95725fda","metadata":{"execution":{"iopub.execute_input":"2026-10-11T10:38:24.563312Z","iopub.status.busy":"2026-10-11T10:38:24.563074Z","iopub.status.idle":"2026-10-11T10:38:27.021929Z","shell.execute_reply":"2026-10-11T10:38:27.021134Z"},"papermill":{"duration":2.467922,"end_time":"2026-10-11T10:38:27.023733","exception":false,"start_time":"2026-10-11T10:38:24.555811","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">