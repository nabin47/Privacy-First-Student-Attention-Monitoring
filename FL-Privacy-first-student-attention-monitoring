                  )\n\n                for method in CLIENT_COUNT_SENSITIVITY_METHODS:\n                    if progress.empty:\n                        done = False\n                    else:\n                        done = (\n                            (progress[\"n_clients\"].astype(int) == n_clients)\n                            & (progress[\"seed\"].astype(int) == seed)\n                            & (progress[\"condition\"] == condition)\n                            & (progress[\"method\"] == method)\n                            & (\n                                (progress[\"alpha\"].isna() & (alpha is None))\n                                | progress[\"alpha\"].fillna(-999).eq(\n                                    float(alpha) if alpha is not None else -999\n                                )\n                            )\n                        ).any()\n\n                    if done:\n                        continue\n\n                    result, _, _ = run_federated(\n                        X_train,\n                        y_train,\n                        X_test,\n                        y_test,\n                        parts,\n                        method,\n                        seed,\n                        CFG[\"fl_rounds\"],\n                        CFG[\"local_epochs\"],\n                        CFG[\"batch_size\"],\n                    )\n                    result.update({\n                        \"n_clients\": int(n_clients),\n                        \"seed\": int(seed),\n                        \"condition\": condition,\n                        \"alpha\": np.nan if alpha is None else float(alpha),\n                        \"method\": method,\n                    })\n                    progress = upsert_checkpoint(\n                        CLIENT_SENS_PROGRESS,\n                        [result],\n                        [\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"],\n                    )\n\n    expected = (\n       