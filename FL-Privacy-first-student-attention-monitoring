].astype(float)\n                    eps_mask = np.isinf(eps_values) if eps_is_inf else np.isclose(eps_values, float(eps))\n                else:\n                    eps_mask = pd.Series(False, index=dp_progress.index, dtype=bool)\n                done = False\n                if not dp_progress.empty:\n                    done = (\n                        (dp_progress[\"seed\"] == int(seed))\n                        & eps_mask\n                        & (dp_progress[\"method\"] == method)\n                        & (dp_progress.get(\"dp_protocol_version\", pd.Series(index=dp_progress.index, dtype=object)) == DP_PROTOCOL_VERSION)\n                    ).any()\n                if done:\n                    print(f\"SKIP DP-v2 seed={seed} eps={eps} method={method}\")\n                    continue\n\n                private_epsilon = None if eps_is_inf else float(eps)\n                run_kind = \"MATCHED-NONPRIVATE\" if eps_is_inf else \"PRIVATE\"\n                print(f\"RUN DP-v2 {run_kind} seed={seed} eps={eps} method={method}\")\n                result = run_federated_dp(\n                    X_train, y_train, X_test, y_test, parts, method, seed,\n                    rounds=CFG[\"fl_rounds\"], local_epochs=CFG[\"local_epochs\"],\n                    batch_size=CFG[\"batch_size\"], target_epsilon=private_epsilon\n                )\n                result.update({\n                    \"partition\": \"IID\",\n                    \"n_clients\": int(N_CLIENTS),\n                    \"privacy_unit\": \"record/row-level\" if not eps_is_inf else \"not_private_control\",\n                    \"delta\": float(DP_DELTA),\n                    \"experiment_seed\": int(seed),\n                })\n                dp_progress = upsert_checkpoint(\n                    DP_PROGRESS_PATH, [result],\n                    [\"seed\", \"target_epsilon\", \"method\"]\n                )\n                print(f\"DP-v2 CHECKPOINT: {len(dp_progress)}/{expected_total} total rows\")\n\n    # 