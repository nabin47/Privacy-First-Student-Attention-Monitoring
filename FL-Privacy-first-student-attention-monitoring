kaggle/working/attention_fl_v3_q1_10client_results\")\nRESULTS_DIR.mkdir(parents=True, exist_ok=True)\n\nMODEL_CACHE_DIR = RESULTS_DIR / \"model_cache\"\nMODEL_CACHE_DIR.mkdir(parents=True, exist_ok=True)\n\nCLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nFGSM_PROGRESS_PATH = RESULTS_DIR / \"fgsm_full_progress_v3.csv\"\nFGSM_FINAL_PATH = RESULTS_DIR / \"fgsm_full_v3.csv\"\n\nprint(\"FGSM paths initialized\")\nprint(\"FGSM_PROGRESS_PATH:\", FGSM_PROGRESS_PATH)\nprint(\"FGSM_FINAL_PATH:\", FGSM_FINAL_PATH)","metadata":{"execution":{"iopub.execute_input":"2026-10-07T10:33:27.234721Z","iopub.status.busy":"2026-10-07T10:33:27.233544Z","iopub.status.idle":"2026-10-07T10:33:27.241555Z","shell.execute_reply":"2026-10-07T10:33:27.240663Z","shell.execute_reply.started":"2026-10-07T10:33:27.234657Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 21A. Full FGSM evaluation — reuse cached clean IID models; no FL retraining\nFGSM_SEEDS = list(CFG[\"seeds\"])\nFGSM_METHODS = [\"FedAvg\", \"FedProx\", \"CAFAD\"]\nFGSM_EPSILONS = [0.05, 0.10, 0.15]\nRUN_FULL_FGSM = True\n\ndef clean_iid_state_path(seed, method):\n    return MODEL_CACHE_DIR / f\"clean_seed{seed:02d}_iid_alphaiid_{method}.pt\"\n\ndef evaluate_cached_fgsm(state, X, y, epsilons):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n    xt = torch.tensor(X, dtype=torch.float32, device=DEVICE, requires_grad=True)\n    yt = torch.tensor(y, dtype=torch.long, device=DEVICE)\n\n    logits = model(xt)\n    loss = nn.functional.cross_entropy(logits, yt)\n    model.zero_grad(set_to_none=True)\n    loss.backward()\n    grad_sign = xt.grad.detach().sign()\n\n    with torch.no_grad():\n        clean_pred = logits.argmax(1).detach().cpu().numpy()\n    clean_acc = accuracy_score(y, clean_pred)\n    clean_f1 = f1_score(y, clean_pred, zero_division=0)\n\n    rows = []\n    for eps in epsilons:\n        x_adv = (xt.detach() + float(eps) * grad_sign).detach()\n        with torch.no_grad():\n            adv_pred = model(x_adv).argmax(1).cpu().numpy()\n        adv_acc = accuracy_score(y, adv_pred)\n        rows.append({\n            \"attack_epsilon\": float(eps),\n            \"clean_accuracy\": float(clean_acc),\n            \"clean_f1\": float(clean_f1),\n            \"adv_accuracy\": float(adv_acc),\n            \"adv_balanced_accuracy\": float(balanced_accuracy_score(y, adv_pred)),\n            \"adv_f1\": float(f1_score(y, adv_pred, zero_division=0)),\n            \"adv_precision\": float(precision_score(y, adv_pred, zero_division=0)),\n            \"adv_recall\": float(recall_score(y, adv_pred, zero_division=0)),\n            \"adv_mcc\": float(matthews_corrcoef(y, adv_pred)),\n            \"adv_pred_class1_rate\": float(np.mean(adv_pred == 1)),\n            \"accuracy_drop\": float(clean_acc - adv_acc),\n        })\n    return rows\n\nif RUN_FULL_FGSM:\n    fgsm_progress = load_checkpoint(FGSM_PROGRESS_PATH)\n    expected_fgsm = len(FGSM_SEEDS) * len(FGSM_METHODS) * len(FGSM_EPSILONS)\n\n    if not CLEAN_FINAL_PATH.exists():\n        raise FileNotFoundError(f\"Clean FL final results are required before FGSM: {CLEAN_FINAL_PATH}\")\n\n    for seed in FGSM_SEEDS:\n        for method in FGSM_METHODS:\n            state_path = clean_iid_state_path(seed, method)\n            if not state_path.exists():\n                raise FileNotFoundError(\n                    f\"Missing cached clean IID model for seed={seed}, method={method}: {state_path}. \"\n                    \"Complete the clean FL sweep first.\"\n                )\n\n            done = False\n            if not fgsm_progress.empty:\n                done = (\n                    (fgsm_progress[\"seed\"].astype(int) == seed)\n                    & (fgsm_progress[\"method\"] == method)\n                    & fgsm_progress[\"attack_epsilon\"].isin(FGSM_EPSILONS)\n                ).sum() == len(FGSM_EPSILONS)\n            if done:\n                print(f\"SKIP FGSM seed={seed} method={method}\")\n                continue\n\n            payload = torch.load(state_path, map_location=\"cpu\")\n            state = payload[\"state\"] if isinstance(payload, dict) and \"state\" in payload else payload\n            rows = evaluate_cached_fgsm(state, X_test, y_test, FGSM_EPSILONS)\n            for row in rows:\n                row.update({\"seed\": int(seed), \"method\": method})\n\n            fgsm_progress = upsert_checkpoint(\n                FGSM_PROGRESS_PATH, rows, [\"seed\", \"method\", \"attack_epsilon\"]\n            )\n            print(f\"FGSM CHECKPOINT: {len(fgsm_progress)}/{expected_fgsm} rows\")\n\n    if len(fgsm_progress) == expected_fgsm:\n        atomic_to_csv(\n            fgsm_progress.sort_values([\"method\", \"attack_epsilon\", \"seed\"]),\n            FGSM_FINAL_PATH\n        )\n        print(\"FGSM COMPLETE:\", len(fgsm_progress), \"rows ->\", FGSM_FINAL_PATH)\n        display(\n            fgsm_progress.groupby([\"method\", \"attack_epsilon\"]).agg(\n                clean_accuracy_mean=(\"clean_accuracy\", \"mean\"),\n                adv_accuracy_mean=(\"adv_accuracy\", \"mean\"),\n                adv_accuracy_std=(\"adv_accuracy\", \"std\"),\n                accuracy_drop_mean=(\"accuracy_drop\", \"mean\"),\n                accuracy_drop_std=(\"accuracy_drop\", \"std\"),\n                n=(\"seed\", \"count\")\n            ).reset_index()\n        )\n    else:\n        print(\"FGSM INCOMPLETE; progress retained at:\", FGSM_PROGRESS_PATH)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-07T10:33:32.029765Z","iopub.status.busy":"2026-10-07T10:33:32.029414Z","iopub.status.idle":"2026-10-07T10:33:34.818877Z","shell.execute_reply":"2026-10-07T10:33:34.818007Z","shell.execute_reply.started":"2026-10-07T10:33:32.029734Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 22. Final statistical analyses and publication exports\n\nThese cells perform analysis only. They do not retrain any models.","metadata":{}},{"cell_type":"code","source":"# 22A. Recompute clean statistics from the saved final file (no clean-model retraining)\nRESULTS_DIR = Path(\"/kaggle/working/attention_fl_v3_q1_10client_results\")\nCLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nCLEAN_SEEDS = list(CFG[\"seeds\"])\nMETHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nif not CLEAN_FINAL_PATH.exists():\n    raise FileNotFoundError(f\"Completed clean FL result file is required: {CLEAN_FINAL_PATH}\")\nclean_results = pd.read_csv(CLEAN_FINAL_PATH)\nexpected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\nassert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n\nMETRICS = [\"accuracy\",\"balanced_accuracy\",\"f1\",\"precision\",\"recall\",\"mcc\",\"auroc\"]\nfrom scipy.stats import t, wilcoxon\nif \"bh_adjust\" not in globals():\n    def bh_adjust(pvals):\n        pvals = np.asarray(pvals, dtype=float)\n        n = len(pvals)\n        order = np.argsort(pvals)\n        ranked = pvals[order]\n        q = ranked * n / np.arange(1, n + 1)\n        q = np.minimum.accumulate(q[::-1])[::-1]\n        out = np.empty_like(q)\n        out[order] = q\n        return np.minimum(out, 1.0)\n\ndef summarize_metric(data, group_cols, metric):\n    rows=[]\n    for keys,g in data.groupby(group_cols, dropna=False):\n        vals=g[metric].dropna().to_numpy(); n=len(vals)\n        if n<2: continue\n        mean=float(vals.mean()); std=float(vals.std(ddof=1)); sem=std/np.sqrt(n)\n        margin=float(t.ppf(0.975,n-1)*sem)\n        if not isinstance(keys,tuple): keys=(keys,)\n        row=dict(zip(group_cols,keys)); row.update({\"metric\":metric,\"n\":n,\"mean\":mean,\"std\":std,\"ci95_low\":mean-margin,\"ci95_high\":mean+margin,\"ci95_half_width\":margin}); rows.append(row)\n    return pd.DataFrame(rows)\n\nmetric_summary=pd.concat([summarize_metric(clean_results,[\"condition\",\"alpha\",\"method\"],m) for m in METRICS],ignore_index=True)\naccuracy_summary=metric_summary[metric_summary[\"metric\"]==\"accuracy\"].copy()\nfor c in [\"mean\",\"std\",\"ci95_low\",\"ci95_high\"]:\n    accuracy_summary[c+\"_percent\"]=accuracy_summary[c]*100\n\n# Paired Wilcoxon tests vs FedAvg within every fixed condition.\ncomparison_rows=[]\nfor (condition,alpha),g in clean_results.groupby([\"condition\",\"alpha\"],dropna=False):\n    base=g[g[\"method\"]==\"FedAvg\"].set_index(\"seed\")\n    for method in [m for m in METHODS if m!=\"FedAvg\"]:\n        cur=g[g[\"method\"]==method].set_index(\"seed\")\n        common=sorted(set(base.index)&set(cur.index))\n        for metric in [\"accuracy\",\"f1\"]:\n            a=base.loc[common,metric].to_numpy(); b=cur.loc[common,metric].to_numpy()\n            stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n            comparison_rows.append({\"condition\":condition,\"alpha\":alpha,\"method_a\":\"FedAvg\",\"method_b\":method,\"metric\":metric,\"n\":len(common),\"mean_diff_b_minus_a\":float(np.mean(b-a)),\"median_diff_b_minus_a\":float(np.median(b-a)),\"wilcoxon_p\":float(p)})\naccuracy_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"accuracy\"])\nf1_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"f1\"])\nall_tests=pd.concat([accuracy_tests,f1_tests],ignore_index=True)\nall_tests[\"bh_q\"] = bh_adjust(all_tests[\"wilcoxon_p\"].to_numpy())\n\nmetric_summary.to_csv(RESULTS_DIR/\"clean_metric_summary_v3.csv\",index=False)\naccuracy_summary.to_csv(RESULTS_DIR/\"clean_accuracy_summary_v3.csv\",index=False)\naccuracy_tests.to_csv(RESULTS_DIR/\"clean_paired_accuracy_tests_v3.csv\",index=False)\nf1_tests.to_csv(RESULTS_DIR/\"clean_paired_f1_tests_v3.csv\",index=False)\nprint(\"Clean analysis exported.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T11:27:14.346297Z","iopub.execute_input":"2026-10-10T11:27:14.346668Z","iopub.status.idle":"2026-10-10T11:27: