lean held-out local data.\n","metadata":{}},{"id":"8e2405bf","cell_type":"code","source":"\n# 13A. Poisoning / straggler sweep\nROBUST_METHODS=[\"FedAvg\",\"FedProx\",\"Median\",\"TrimmedMean\",\"CAFAD\"]\n\ndef run_robustness_sweep():\n    rows=[]\n    seeds=list(range(max(10,len(CFG[\"seeds\"]))))\n    for seed in seeds:\n        parts=balanced_iid_partition(y_train,N_CLIENTS,seed)\n        scenarios=[\n            (\"one_poison_20pct\",[0],0.20,[]),\n            (\"two_poison_40pct\",[0,1],0.40,[]),\n            (\"one_straggler\",[],0.0,[0])\n        ]\n        for scenario,poisoned,rate,stragglers in scenarios:\n            for method in ROBUST_METHODS:\n                r,_,_=run_federated(\n                    X_train,y_train,X_test,y_test,parts,method,seed,\n                    CFG[\"fl_rounds\"],CFG[\"local_epochs\"],CFG[\"batch_size\"],\n                    corrupt_clients=poisoned,corrupt_rate=rate,straggler_clients=stragglers\n                )\n                r.update({\"scenario\":scenario,\"partition\":\"IID\"})\n                rows.append(r)\n                print(scenario,method,seed,round(r[\"accuracy\"],4))\n    out=pd.DataFrame(rows)\n    out.to_csv(RESULTS_DIR/\"robustness_sweep_v3.csv\",index=False)\n    return out\n\nRUN_ROBUSTNESS_SWEEP=False\nif RUN_ROBUSTNESS_SWEEP:\n    robustness_results=run_robustness_sweep()\n    display(robustness_results.groupby([\"scenario\",\"method\"])[\"accuracy\"].agg([\"mean\",\"std\",\"count\"]))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T16:19:01.857646Z","iopub.execute_input":"2026-10-05T16:19:01.857948Z","iopub.status.idle":"2026-10-05T16:55:49.307152Z","shell.execute_reply.started":"2026-10-05T16:19:01.857915Z","shell.execute_reply":"2026-10-05T16:55:49.306519Z"}},"outputs":[{"name":"stdout","text":"one_poison_20pct FedAvg 0 0.8927\none_poison_20pct FedProx 0 0.8927\none_poison_20pct Median 0 0.8935\none_poison_20pct TrimmedMean 0 0.8943\none_poison_20pct CAFAD 0 0.8927\ntwo