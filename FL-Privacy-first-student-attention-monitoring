ue)\ncolors = {\"fedavg\": \"#4C72B0\", \"cafad\": \"#DD8452\", \"fedprox\": \"#55A868\"}\n\nfor ax, (setting_name, _) in zip(axes, SETTINGS):\n    subset = full_history_df[(full_history_df.Setting == setting_name) & (full_history_df.Epsilon == 1.0)]\n    for method in METHODS:\n        m = subset[subset.Method == method]\n        stat = m.groupby(\"Round\")[\"Accuracy\"].agg([\"mean\", \"std\"]).reset_index()\n        ax.plot(stat[\"Round\"], stat[\"mean\"], label=method.upper(), color=colors[method], marker=\"o\", markersize=3)\n        ax.fill_between(stat[\"Round\"], stat[\"mean\"] - stat[\"std\"], stat[\"mean\"] + stat[\"std\"],\n                         color=colors[method], alpha=0.2)\n    ax.set_title(f\"{setting_name} (epsilon=1.0)\")\n    ax.set_xlabel(\"Communication Round\")\naxes[0].set_ylabel(\"Test Accuracy (mean +/- std, 10 seeds)\")\naxes[0].legend()\nplt.tight_layout()\nplt.savefig(\"fig1_convergence.png\", dpi=300, bbox_inches=\"tight\")\nplt.savefig(\"fig1_convergence.pdf\", bbox_inches=\"tight\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T17:20:39.093368Z","iopub.execute_input":"2026-09-07T17:20:39.093592Z","iopub.status.idle":"2026-09-07T17:20:40.317973Z","shell.execute_reply.started":"2026-09-07T17:20:39.093573Z","shell.execute_reply":"2026-09-07T17:20:40.317174Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":24},{"cell_type":"code","source":"# --- Fig 2: grouped bar chart, final accuracy by method x {IID,Non-IID} x {eps=1,5,inf} ---\nfig2_epsilons = [1.0, 5.0, np.inf]\nfig2_data = results_df[results_df.Epsilon.isin(fig2_epsilons)]\ngrp = fig2_data.groupby([\"Setting\", \"Epsilon\", \"Method\"])[\"Accuracy\"].agg([\"mean\", \"std\"]).reset_index()\n\nfig, ax = plt.subplots(figsize=(12, 6))\nbar_width = 0.12\nx_labels = [f\"{s}\\neps={'inf' if np.isinf(e) else e}\" for s in [\"IID\", \"Non-IID\"] for e in fig2_epsilons]\nx = np.arange(len(x_labels))\n\nfor i, method in enumerate(METHODS):\n    means, stds = [], []\n    for s in [\"IID\", \"Non-IID\"]:\n        for e in fig2_epsilons:\n            row = grp[(grp.Setting == s) & (grp.Epsilon == e) & (grp.Method == method)]\n            means.append(row[\"mean\"].values[0] if len(row) else np.nan)\n            stds.append(row[\"std\"].values[0] if len(row) else np.nan)\n    ax.bar(x + i * bar_width, means, bar_width, yerr=stds, label=method.upper(), color=colors[method], capsize=3)\n\nax.set_xticks(x + bar_width)\nax.set_xticklabels(x_labels)\nax.set_ylabel(\"Final Test Accuracy (mean +/- std, 10 seeds)\")\nax.set_title(\"Final Accuracy by Method, Data Setting, and Privacy Level\")\nax.legend()\nplt.tight_layout()\nplt.savefig(\"fig2_bar_accuracy.png\", dpi=300, bbox_inches=\"tight\")\nplt.savefig(\"fig2_bar_accuracy.pdf\", bbox_inches=\"tight\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T17:20:40.319056Z","iopub.execute_input":"2026-09-07T17:20:40.319334Z","iopub.status.idle":"2026-09-07T17:20:41.153746Z","shell.execute_reply.started":"2026-09-07T17:20:40.319307Z","shell.execute_reply":"2026-09-07T17:20:41.153089Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":25},{"cell_type":"markdown","source":"**Limitation, stated plainly for the paper:** the differential-privacy\nresults above use per-example gradient clipping and Gaussian noise\ncalibrated via the classical (single-release) Gaussian mechanism, composed\nnaively across local SGD steps and communication rounds. This gives a\ncorrect DP-SGD *mechanism* but not a tight cumulative (epsilon, delta)\nguarantee across the full training run -- for that, re-run with a proper\nRenyi-DP / moments accountant (e.g. the `opacus` library, or `dp-accounting`)\nand report the accountant's epsilon instead of the naive per-round value. Say\nthis explicitly in the paper's Method and Limitations sections; do not claim\na formally proven epsilon without doing so (see Abadi et al., 2016).","metadata":{}},{"cell_type":"code","source":"# --- Fig 3: privacy-utility trade-off curve ---\nfig, ax = plt.subplots(figsize=(9, 6))\nfinite_eps = [e for e in EPSILONS if np.isfinite(e)]\nfor setting_name, _ in SETTINGS:\n    for method in METHODS:\n        means, stds = [], []\n        for eps in finite_eps:\n            sub = results_df[(results_df.Method == method) & (results_df.Setting == setting_name) & (results_df.Epsilon == eps)][\"Accuracy\"]\n            means.append(sub.mean())\n            stds.append(sub.std())\n        ls = \"-\" if setting_name == \"IID\" else \"--\"\n        ax.errorbar(finite_eps, means, yerr=stds, marker=\"o\", linestyle=ls,\n                     color=colors[method], label=f\"{method.upper()} ({setting_name})\", capsize=3)\n\n# non-private (epsilon=inf) reference lines\nfor method in METHODS:\n    ref = results_df[(results_df.Method == method) & (results_df.Epsilon == np.inf) & (results_df.Setting == \"IID\")][\"Accuracy\"].mean()\n    ax.axhline(ref, color=colors[method], linestyle=\":\", alpha=0.4)\n\nax.set_xlabel(\"Privacy Budget (epsilon) -- smaller = more private\")\nax.set_ylabel(\"Final Test Accuracy\")\nax.set_title(\"Privacy-Utility Trade-off (dotted lines = non-private epsilon=inf reference)\")\nax.legend(fontsize=8, ncol=2)\nplt.tight_layout()\nplt.savefig(\"fig3_privacy_utility.png\", dpi=300, bbox_inches=\"tight\")\nplt.savefig(\"fig3_privacy_utility.pdf\", bbox_inches=\"tight\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T17:20:41.154814Z","iopub.execute_input":"2026-09-07T17:20:41.155166Z","iopub.status.idle":"2026-09-07T17:20:41.998249Z","shell.execute_reply.started":"2026-09-07T17:20:41.155143Z","shell.execute_reply":"2026-09-07T17:20:41.997576Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":26},{"cell_type":"markdown","source":"## 9. Explainability (Fig. 5, SHAP) and Communication Cost\n\nSince CAFAD's global model is a nonlinear MLP, we use `shap.KernelExplainer`\nagainst `predict_proba`, which is model-agnostic (a linear explainer would\nnot give valid attributions for a nonlinear model).","metadata":{}},{"cell_type":"code","source":"# Train one representative global CAFAD model (IID, epsilon=1.0) for SHAP + communication-cost reporting\nshap_model, _ = run_federated(X_train, y_train, X_test, y_test, method=\"cafad\",\n                               epsilon=1.0, rounds=ROUNDS, clients=NUM_CLIENTS, seed=42, alpha=10.0, mu=0.1)\n\nbackground = shap.sample(X_train, 50, random_state=0)\nexplainer = shap.KernelExplainer(shap_model.predict_proba, background)\nX_shap = X_test[:200]\nshap_values = explainer.shap_values(X_shap, nsamples=100, silent=True)\n# shap_values shape: (n_samples, n_features, n_classes) -- take the positive class\nsv_pos = shap_values[:, :, 1] if np.ndim(shap_values) == 3 else shap_values[1]\n\nshap.summary_plot(sv_pos, X_shap, feature_names=feature_names, show=False)\nplt.title(\"SHAP Feature Importance (Global CAFAD Model, IID, epsilon=1.0)\")\nplt.tight_layout()\nplt.savefig(\"fig5_shap_summary.png\", dpi=300, bbox_inches=\"tight\")\nplt.savefig(\"fig5_shap_summary.pdf\", bbox_inches=\"tight\")\nplt.show()\n\n# Communication cost: bytes transferred per round = 2 (up+down) x clients x parameter count x 8 bytes (float64)\nn_params = shap_model.W1.size + shap_model.b1.size + shap_model.W2.size + shap_model.b2.size\nbytes_per_round = 2 * NUM_CLIENTS * n_params * 8\ntotal_comm_cost = bytes_per_round * ROUNDS\nprint(f\"Model parameters: {n_params:,}\")\nprint(f\"Communication per round: {bytes_per_round:,} bytes ({bytes_per_round/1024:.1f} KB)\")\nprint(f\"Total communication cost over {ROUNDS} rounds x {NUM_CLIENTS} clients: {total_comm_cost:,} bytes \"\n      f\"({total_comm_cost/1e6:.2f} MB)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T17:20:41.999503Z","iopub.execute_input":"2026-09-07T17:20:41.999829Z","iopub.status.idle":"2026-09-07T17:20:47.746002Z","shell.execute_reply.started":"2026-09-07T17:20:41.999798Z","shell.execute_reply":"2026-09-07T17:20:47.745413Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x790 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Model parameters: 1,153\nCommunication per round: 92,240 bytes (90.1 KB)\nTotal communication cost over 20 rounds x 5 clients: 1,844,800 bytes (1.84 MB)\n","output_type":"stream"}],"execution_count":27},{"cell_type":"markdown","source":"## 10. Adversarial Robustness (Table 3)\n\nReal FGSM using the model's true backprop input-gradient (see\n`fgsm_attack` / `SimpleMLP.input_gradient` above), evaluated across all 10\nseeds for each method at epsilon=1.0, IID setting, attack strength 0.15.","metadata":{}},{"cell_type":"code","source":"ATTACK_EPSILON = 0.15\nadv_rows = []\nfor method in METHODS:\n    for seed in SEEDS:\n        model, _ = run_federated(X_train, y_train, X_test, y_test, method=method,\n                                  epsilon=1.0, rounds=ROUNDS, clients=NUM_CLIENTS,\n                                  seed=seed, alpha=10.0, mu=0.1)\n        report = evaluate_adversarial(model, X_test, y_test, epsilon=ATTACK_EPSILON)\n        adv_rows.append([method, seed, report[\"clean_accuracy\"], report[\"adv_accuracy\"], report[\"accuracy_drop\"]])\n\nadv_df = pd.DataFrame(adv_rows, columns=[\"Method\", \"Seed\", \"CleanAccuracy\", \"AdvAccuracy\", \"AccuracyDrop\"])\nadv_summary = adv_df.groupby(\"Method\")[[\"CleanAccuracy\", \"AdvAccuracy\", \"AccuracyDrop\"]].agg([\"mean\", \"std\"]).round(4)\ndisplay(adv_summary)\nadv_df.to_csv(\"adversarial_results.csv\", index=False)\nadv_summary.to_latex(\"adversarial_table.tex\")","metadata":{"trusted":true,"execution":{"iopub.st