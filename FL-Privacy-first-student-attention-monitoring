, alpha, parts in conditions:\n","            summary = client_summary(parts, y_train)\n","            print(\n","                f\"\\nSeed={seed} | Condition={condition} | Alpha={alpha} | \"\n","                f\"Client sizes={summary['n'].tolist()}\"\n","            )\n","\n","            for method in METHODS:\n","                alpha_token = \"iid\" if alpha is None else str(float(alpha)).replace(\".\", \"p\")\n","                state_path = (\n","                    MODEL_CACHE_DIR\n","                    / f\"clean_seed{seed:02d}_{condition.lower()}_alpha{alpha_token}_{method}.pt\"\n","                )\n","                history_path = (\n","                    CLEAN_HISTORY_CACHE_DIR\n","                    / f\"clean_seed{seed:02d}_{condition.lower()}_alpha{alpha_token}_{method}.csv\"\n","                )\n","\n","                already_done = False\n","                if not clean_progress.empty:\n","                    match = clean_progress[\n","                        (clean_progress[\"seed\"] == int(seed))\n","                        & (clean_progress[\"condition\"] == condition)\n","                        & (clean_progress[\"method\"] == method)\n","                        & (\n","                            (clean_progress[\"alpha\"].isna() & (alpha is None))\n","                            | clean_progress[\"alpha\"].fillna(-999).eq(\n","                                float(alpha) if alpha is not None else -999\n","                            )\n","                        )\n","                    ]\n","                    already_done = (\n","                        len(match) > 0\n","                        and state_path.exists()\n","                        and history_path.exists()\n","                    )\n","\n","                if already_done:\n","                    print(f\"SKIP  {condition} alpha={alpha} {method} seed={seed}\")\n","                    continue\n","\n","                print(f\"RUN   {condition} alpha={alpha} {method} seed={seed}\")\n","\n","                result, history, state = run_federated(\n","                    X_train,\n","                    y_train,\n","                    X_test,\n","                    y_test,\n","                    parts,\n","                    method,\n","                    seed,\n","                    CFG[\"fl_rounds\"],\n","                    CFG[\"local_epochs\"],\n","                    CFG[\"batch_size\"],\n","                )\n","\n","                result.update({\n","                    \"condition\": condition,\n","                    \"alpha\": np.nan if alpha is None else float(alpha),\n","                    \"partition_seed\": int(seed),\n","                    \"n_clients\": int(N_CLIENTS),\n","                })\n","\n","                # Save the model state and its complete round history atomically.\n","                atomic_torch_save(\n","                    {\n","                        \"state\": state,\n","                        \"seed\": int(seed),\n","                        \"condition\": condition,\n","                        \"alpha\": None if alpha is None else float(alpha),\n","                        \"method\": method,\n","                        \"n_clients\": int(N_CLIENTS),\n","                    },\n","                    state_path,\n","                )\n","\n","                hist = history.copy()\n","                hist[\"condition\"] = condition\n","                hist[\"alpha\"] = np.nan if alpha is None else float(alpha)\n","                hist[\"n_clients\"] = int(N_CLIENTS)\n","                atomic_to_csv(hist, history_path)\n","\n","                # Only mark the run complete after BOTH state and history exist.\n","                clean_progress = upsert_checkpoint(\n","                    CLEAN_PROGRESS_PATH,\n","                    [result],\n","                    [\"seed\", \"condition\", \"alpha\", \"method\"],\n","                )\n","\n","                print(f\"CHECKPOIN