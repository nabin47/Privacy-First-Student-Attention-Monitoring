t(adv_acc),\n","            \"adv_balanced_accuracy\": float(balanced_accuracy_score(y, adv_pred)),\n","            \"adv_f1\": float(f1_score(y, adv_pred, zero_division=0)),\n","            \"adv_precision\": float(precision_score(y, adv_pred, zero_division=0)),\n","            \"adv_recall\": float(recall_score(y, adv_pred, zero_division=0)),\n","            \"adv_mcc\": float(matthews_corrcoef(y, adv_pred)),\n","            \"adv_pred_class1_rate\": float(np.mean(adv_pred == 1)),\n","            \"accuracy_drop\": float(clean_acc - adv_acc),\n","        })\n","    return rows\n","\n","if RUN_FULL_FGSM:\n","    fgsm_progress = load_checkpoint(FGSM_PROGRESS_PATH)\n","    expected_fgsm = len(FGSM_SEEDS) * len(FGSM_METHODS) * len(FGSM_EPSILONS)\n","\n","    if not CLEAN_FINAL_PATH.exists():\n","        raise FileNotFoundError(f\"Clean FL final results are required before FGSM: {CLEAN_FINAL_PATH}\")\n","\n","    for seed in FGSM_SEEDS:\n","        for method in FGSM_METHODS:\n","            state_path = clean_iid_state_path(seed, method)\n","            if not state_path.exists():\n","                raise FileNotFoundError(\n","                    f\"Missing cached clean IID model for seed={seed}, method={method}: {state_path}. \"\n","                    \"Complete the clean FL sweep first.\"\n","                )\n","\n","            done = False\n","            if not fgsm_progress.empty:\n","                done = (\n","                    (fgsm_progress[\"seed\"].astype(int) == seed)\n","                    & (fgsm_progress[\"method\"] == method)\n","                    & fgsm_progress[\"attack_epsilon\"].isin(FGSM_EPSILONS)\n","                ).sum() == len(FGSM_EPSILONS)\n","            if done:\n","                print(f\"SKIP FGSM seed={seed} method={method}\")\n","                continue\n","\n","            payload = torch.load(state_path, map_location=\"cpu\")\n","            state = payload[\"state\"] if isinstance(payload, dict) and \"state\" in payload else payload\n","            rows = evaluate_cached_fgsm(state, X_test, y_test, FGSM_EPSILONS)\n","            for row in rows:\n","                row.update({\"seed\": int(seed), \"method\": method})\n","\n","            fgsm_progress = upsert_checkpoint(\n","                FGSM_PROGRESS_PATH, rows, [\"seed\", \"method\", \"attack_epsilon\"]\n","            )\n","            print(f\"FGSM CHECKPOINT: {len(fgsm_progress)}/{expected_fgsm} rows\")\n","\n","    if len(fgsm_progress) == expected_fgsm:\n","        atomic_to_csv(\n","            fgsm_progress.sort_values([\"method\", \"attack_epsilon\", \"seed\"]),\n","            FGSM_FINAL_PATH\n","        )\n","        print(\"FGSM COMPLETE:\", len(fgsm_progress), \"rows ->\", FGSM_FINAL_PATH)\n","        display(\n","            fgsm_progress.groupby([\"method\", \"attack_epsilon\"]).agg(\n","                clean_accuracy_mean=(\"clean_accuracy\", \"mean\"),\n","                adv_accuracy_mean=(\"adv_accuracy\", \"mean\"),\n","                adv_accuracy_std=(\"adv_accuracy\", \"std\"),\n","                accuracy_drop_mean=(\"accuracy_drop\", \"mean\"),\n","                accuracy_drop_std=(\"accuracy_drop\", \"std\"),\n","                n=(\"seed\", \"count\")\n","            ).reset_index()\n","        )\n","    else:\n","        print(\"FGSM INCOMPLETE; progress retained at:\", FGSM_PROGRESS_PATH)\n"]},{"cell_type":"markdown","id":"eb0b93c2","metadata":{"papermill":{"duration":0.080359,"end_time":"2026-11-07T12:07:17.510685","exception":false,"start_time":"2026-11-07T12:07:17.430326","status":"completed"},"tags":[]},"source":["## 23. Per-rule learning rates, label flipping under skew, and Multi-Krum\n","\n","23A selects a learning rate for each rule on the Dirichlet alpha=0.1 partition of the validation split. 23B reruns alpha=0.1 with those rates, and separately with twice the rounds at the shared rate. 23C adds Multi-Krum to the primary clean and unreliable-client protocols. 23D repeats the two label