46</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>ExtraTrees</td>\n      <td>0.916733</td>\n      <td>0.916668</td>\n      <td>0.913478</td>\n      <td>0.833235</td>\n      <td>0.917354</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":8},{"id":"ed26d3d8","cell_type":"markdown","source":"## 7. Federated simulation\n\nThe FL clients are **controlled partitions of the training records**. In the manuscript, call them **simulated clients / decentralized data partitions**, not identified students. The primary benchmark uses 10 clients; the optional client-count sensitivity compares 5 vs 10 clients on a smaller matched grid.","metadata":{}},{"id":"1ab4370b","cell_type":"code","source":"# 7A. Partition helpers\ndef balanced_iid_partition(y, n_clients, seed):\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n    for cls in np.unique(y):\n        idx = rng.permutation(np.where(y == cls)[0])\n        for k, s in enumerate(np.array_split(idx, n_clients)):\n            parts[k].extend(s.tolist())\n    return [np.array(sorted(z), dtype=int) for z in parts]\n\n\ndef dirichlet_label_partition(\n    y,\n    n_clients,\n    alpha,\n    seed,\n    min_size=PARTITION_MIN_SIZE,\n    max_tries=PARTITION_MAX_TRIES,\n):\n    rng = np.random.default_rng(seed)\n    classes = np.unique(y)\n    best_parts = None\n    best_min = -1\n\n    for _ in range(max_tries):\n        parts = [[] for _ in range(n_clients)]\n\n        for cls in classes:\n            idx = rng.permutation(np.where(y == cls)[0])\n            props = rng.dirichlet(np.ones(n_clients) * alpha)\n            cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n            splits = np.split(idx, cuts)\n            for k, s in enumerate(splits):\n                parts[k].extend(s.tolist())\n\n        sizes = [len(z) for z in parts]\n        current_min = min(sizes)\n        if current_min > best_min:\n            best_min = current_min\n            best_parts = [list(z) for z in parts]\n\n        if current_min >= min_size:\n            return [np.array(sorted(z), dtype=int) for z in parts]\n\n    # Last-resort repair for pathological Dirichlet draws. This only activates\n    # when the sampled partition cannot satisfy the requested floor after\n    # max_tries; samples are transferred from the largest client(s) so that\n    # local training never receives an unusably tiny client.\n    repaired = [list(z) for z in best_parts]\n    while min(len(z) for z in repaired) < min_size:\n        small = int(np.argmin([len(z) for z in repaired]))\n        donors = np.argsort([len(z) for z in repaired])[::-1]\n        donor = next(int(d) for d in donors if d != small and len(repaired[d]) > min_size)\n        need = min_size - len(repaired[small])\n        take = min(need, len(repaired[donor]) - min_size)\n        if take <= 0:\n            raise RuntimeError(\n                f\"Could not repair Dirichlet partition to min_size={min_size}; \"\n                f\"client sizes={[len(z) for z in repaired]}\"\n            )\n        moved = repaired[donor][-take:]\n        del repaired[donor][-take:]\n        repaired[small].extend(moved)\n\n    print(\n        f\"WARNING: alpha={alpha} seed={seed} did not meet min_size={min_size} \"\n        f\"within {max_tries} draws; repaired best draw to min_client_size={min_size}.\"\n    )\n    return [np.array(sorted(z), dtype=int) for z in repaired]\n\n\ndef feature_cluster_partition(X, y, n_clients, n_clusters, seed):\n    km = MiniBatchKMeans(\n        n_clusters=n_clusters,\n        random_state=seed,\n        batch_size=256,\n        n_init=10,\n    )\n    cluster_id = km.fit_predict(X)\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n\n    for c in range(n_clusters):\n        idx = rng.permutation(np.where(cluster_id == c)[0])\n        if len(idx) == 0:\n            continue\n        props = rng.dirichlet(np.ones(n_clients) * 0.35)\n        cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n        for k, s in enumerate(np.split(idx, cuts)):\n            parts[k].extend(s.tolist())\n\n    for k in range(n_clients):\n        if len(parts[k]) == 0:\n            donor = int(np.argmax([len(z) for z in parts]))\n            parts[k].append(parts[donor].pop())\n\n    return [np.array(sorted(z), dtype=int) for z in parts], cluster_id\n\n\ndef client_summary(parts, y, cluster_id=None):\n    rows = []\n    global_rate = float(np.mean(y))\n\n    for k, idx in enumerate(parts):\n        row = {\n            \"client\": k,\n            \"n\": len(idx),\n            \"label1_rate\": float(np.mean(y[idx])),\n            \"abs_label_shift\": abs(float(np.mean(y[idx])) - global_rate),\n        }\n        if cluster_id is not None:\n            vals, counts = np.unique(cluster_id[idx], return_counts=True)\n            row[\"n_feature_clusters\"] = len(vals)\n            row[\"dominant_cluster_share\"] = float(counts.max() / counts.sum())\n        rows.append(row)\n\n    return pd.DataFrame(rows)\n\n\nprint(f\"Partition helpers ready for {N_CLIENTS} simulated clients.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T04:43:01.305295Z","iopub.execute_input":"2026-10-06T04:43:01.305824Z","iopub.status.idle":"2026-10-06T04:43:01.322599Z","shell.execute_reply.started":"2026-10-06T04:43:01.305793Z","shell.execute_reply":"2026-10-06T04:43:01.321874Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Partition helpers ready for 10 simulated clients.\n","output_type":"stream"}],"execution_count":9},{"id":"4ad8744c","cell_type":"code","source":"# 8. PyTorch model + utilities\n\ndef seed_everything(seed):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n\nclass MLP(nn.Module):\n    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden1), nn.ReLU(),\n            nn.Linear(hidden1, hidden2), nn.ReLU(),\n            nn.Linear(hidden2, 2)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef clone_state_dict(model):\n    # Always checkpoint on CPU so files remain portable across Kaggle sessions.\n    return {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n\ndef load_state_dict_device(model, state):\n    model.load_state_dict({k: v.to(DEVICE) for k, v in state.items()})\n\ndef load_state_dict_cpu(model, state):\n    # Backward-compatible alias used by the existing analysis code.\n    load_state_dict_device(model, state)\n\ndef evaluate_state(state, X, y):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n    with torch.no_grad():\n        xt = torch.from_numpy(np.asarray(X, dtype=np.float32)).to(DEVICE)\n        logits = model(xt)\n        prob = torch.softmax(logits, dim=1)[:, 1].detach().cpu().numpy()\n        pred = logits.argmax(1).detach().cpu().numpy()\n    return {\n        \"accuracy\": accuracy_score(y, pred),\n        \"balanced_accuracy\": balanced_accuracy_score(y, pred),\n        \"f1\": f1_score(y, pred, zero_division=0),\n        \"precision\": precision_score(y, pred, zero_division=0),\n        \"recall\": recall_score(y, pred, zero_division=0),\n        \"mcc\": matthews_corrcoef(y, pred),\n        \"auroc\": roc_auc_score(y, prob) if len(np.unique(y)) == 2 else np.nan\n    }\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T04:43:01.325928Z","iopub.execute_input":"2026-10-06T04:43:01.32645Z","iopub.status.idle":"2026-10-06T04:43:01.346021Z","shell.execute_reply.started":"2026-10-06T04:43:01.326428Z","shell.execute_reply":"2026-10-06T04:43:01.345465Z"},"trusted":true},"outputs":[],"execution_count":10},{"id":"b0535d7a","cell_type":"code","source":"# 9. Local training (non-DP)\ndef local_train(\n    global_state,\n    X,\n    y,\n    client_idx,\n    seed,\n    epochs=2,\n    batch_size=64,\n    lr=LR,\n    prox_mu=0.0,\n    corrupt_rate=0.0,\n    straggler=False\n):\n    seed_everything(seed)\n\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, global_state)\n    model.train()\n\n    idx = np.asarray(client_idx, dtype=int).copy()\n    if len(idx) < 2:\n        raise ValueError(f\"Client has only {len(idx)} samples; too small for local training.\")\n\n    rng = np.random.default_rng(seed)\n    rng.shuffle(idx)\n\n    client_y = y[idx]\n    classes, counts = np.unique(client_y, return_counts=True)\n    n_classes = len(classes)\n    val_n = max(1, int(round(0.20 * len(idx))))\n\n    can_stratify = (\n        n_classes == 2\n        and int(counts.min()) >= 2\n        and val_n >= 2\n        and (len(idx) - val_n) >= 2\n    )\n\n    if can_stratify:\n        tr_idx, va_idx = train_test_split(\n            idx, test_size=0.20, stratify=client_y, random_state=seed\n        )\n    elif n_classes == 2 and int(counts.min()) == 1:\n        rare_class = classes[np.argmin(counts)]\n        rare_idx = idx[client_y == rare_class]\n        common_idx = idx[client_y != rare_class]\n        rng.shuffle(common_idx)\n        val_n = min(max(1, int(round(0.20 * len(idx)))), max(1, len(common_idx) - 1))\n        va_idx = common_idx[:val_n]\n        tr_idx = np.concatenate([rare_idx, common_idx[val_n:]])\n        rng.shuffle(tr_idx)\n    else:\n        cut = max(1, min(len(idx) - 1, int(round(0.80 * len(idx)))))\n        tr_idx, va_idx = idx[:cut], idx[cut:]\n\n    y_local = y[tr_idx].copy()\n    if corrupt_rate > 0:\n        corrupt_mask = rng.random(len(y_local)) < corrupt_rate\n        y_local[corrupt_mask] = 1 - y_local[corrupt_mask]\n\n    x_tensor = torch.from_numpy(np.asarray(X[tr_idx], dtype=np.float32))\n    y_tensor = torch.from_numpy(np.asarray(y_local, dtype=np.int64))\n    ds = TensorDataset(x_tensor, y_tensor)\n    loader = DataLoader(\n        ds, batch_size=min(batch_size, len(ds)), shuffle=True,\n        drop_last=False, pin_memory=(DEVICE.type == \"cuda\")\n    )\n\n    optimizer = torch.optim.SGD(model.parameters(), lr=lr)\n    criterion = nn.CrossEntropyLoss()\n    n_epochs = 1 if straggler else epochs\n\n    global_tensors = {\n        name: p.detach().clone()\n        for name, p in model.named_parameters()\n        if p.requires_grad\n    }\n\n    for _ in range(n_epochs):\n        for xb, yb in loader:\n            xb = xb.to(DEVICE, non_blocking=True)\n            yb = yb.to(DEVICE, non_blocking=True)\n            optimizer.zero_grad(set_to_none=True)\n            loss = criterion(model(xb), yb)\n            if prox_mu > 0:\n                prox = 0.0\n                for name, p in model.named_parameters():\n                    if p.requires_grad:\n                        prox = prox + torch.sum((p - global_tensors[name]) ** 2)\n                loss = loss + 0.5 * prox_mu * prox\n            loss.backward()\n            optimizer.step()\n\n    model.eval()\n    with torch.no_grad():\n        xv = torch.from_numpy(np.asarray(X[va_idx], dtype=np.float32)).to(DEVICE)\n        pred = model(xv).argmax(dim=1).detach().cpu().numpy()\n    val_acc = accuracy_score(y[va_idx], pred)\n\n    return clone_state_dict(model), float(val_acc), len(tr_idx)\n\ndef train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n    corrupt_clients = set(corrupt_clients or [])\n    straggler_clients = set(straggler_clients or [])\n    states, val_accs, ns = [], [], []\n    for k, idx in enumerate(parts):\n        prox = PROX_MU if method == \"FedProx\" else 0.0\n        st, acc, n = local_train(\n            global_state, X, y, idx, seed + k, epochs=epochs, batch_size=batch_size,\n            lr=LR, prox_mu=prox,\n            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n            straggler=(k in straggler_clients)\n        )