ue\n","            parts = balanced_iid_partition(y_fit, N_CLIENTS, s)\n","            with use_settings(dp_lr_by_eps={float(eps): lr_candidate}):\n","                r = run_federated_dp(X_fit, y_fit, X_val, y_val, parts, \"MedianTrue\", s,\n","                                     rounds=CFG[\"fl_rounds\"], local_epochs=CFG[\"local_epochs\"],\n","                                     batch_size=CFG[\"batch_size\"], target_epsilon=float(eps))\n","            r6t = record(R6_TUNE_PATH, {\"method\": \"MedianTrue\", \"target_epsilon\": float(eps), \"lr\": lr_candidate,\n","                                        \"seed\": s, \"val_accuracy\": r[\"accuracy\"], \"run_key\": key})\n","            done.add(key)\n","    print(\"R6A done: eps\", eps)\n","\n","r6t = load_checkpoint(R6_TUNE_PATH)\n","DP_LR_MEDIAN_TRUE = select_lr(r6t, \"target_epsilon\", DP_LR_TOLERANCE)\n","display((r6t.groupby([\"target_epsilon\", \"lr\"])[\"val_accuracy\"].mean().unstack(\"lr\") * 100).round(2))\n","print(\"MedianTrue DP learning rates:\", DP_LR_MEDIAN_TRUE)"]},{"cell_type":"code","execution_count":25,"id":"bb034aef","metadata":{"execution":{"iopub.execute_input":"2026-11-19T00:25:20.413185Z","iopub.status.busy":"2026-11-19T00:25:20.412801Z","iopub.status.idle":"2026-11-19T01:56:46.217398Z","shell.execute_reply":"2026-11-19T01:56:46.216445Z"},"papermill":{"duration":5485.837126,"end_time":"2026-11-19T01:56:46.234317","exception":false,"start_time":"2026-11-19T00:25:20.397191","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["R6B seed done: 0\n","R6B seed done: 1\n","R6B seed done: 2\n","R6B seed done: 3\n","R6B seed done: 4\n","R6B seed done: 5\n","R6B seed done: 6\n","R6B seed done: 7\n","R6B seed done: 8\n","R6B seed done: 9\n","R6B seed done: 10\n","R6B seed done: 11\n","R6B seed done: 12\n","R6B seed done: 13\n","R6B seed done: 14\n","R6B seed done: 15\n","R6B seed done: 16\n","R6B seed done: 17\n","R6B seed done: 18\n","R6B seed done: 19\n"]},{