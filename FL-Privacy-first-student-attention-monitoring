.997902</td>\n      <td>0.517421</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>3</td>\n      <td>1415</td>\n      <td>0.010601</td>\n      <td>0.469880</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>4</td>\n      <td>828</td>\n      <td>0.008454</td>\n      <td>0.472026</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":9},{"id":"4ad8744c","cell_type":"code","source":"\n# 8. PyTorch model + utilities\ndef seed_everything(seed):\n    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)\n\nclass MLP(nn.Module):\n    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden1), nn.ReLU(),\n            nn.Linear(hidden1, hidden2), nn.ReLU(),\n            nn.Linear(hidden2, 2)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef clone_state_dict(model):\n    return {k: v.detach().cpu().clone() for k,v in model.state_dict().items()}\n\ndef load_state_dict_cpu(model, state):\n    model.load_state_dict({k:v.clone() for k,v in state.items()})\n\ndef evaluate_state(state, X, y):\n    model=MLP(X.shape[1]); load_state_dict_cpu(model, state); model.eval()\n    with torch.no_grad():\n        xt=torch.tensor(X, dtype=torch.float32)\n        logits=model(xt)\n        prob=torch.softmax(logits, dim=1)[:,1].numpy()\n        pred=logits.argmax(1).numpy()\n    return {\n        \"accuracy\":accuracy_score(y,pred),\n        \"balanced_accuracy\":balanced_accuracy_score(y,pred),\n        \"f1\":f1_score(y,pred),\n        \"precision\":precision_score(y,pred,zero_division=0),\n        \"recall\":recall_score(y,pred,zero_division=0),\n        \"mcc\":matthews_corrcoef(y,pred),\n        \"auroc\":roc_auc_score(y,prob) if len(np.unique(y))==2 else np.nan\n    }\n","metadata":{"execution":{"iopub.status.busy":"2026-10-05T15:00:49.244685Z","iopub.execute_input":"2026-10-05T15:00:49.24503Z","iopub.status.idle":"2026-10-05T15:00:49.254262Z","shell.execute_reply.started":"2026-10-05T15:00:49.245005Z","shell.execute_reply":"2026-10-05T15:00:49.253501Z"},"trusted":true},"outputs":[],"execution_count":10},{"id":"b0535d7a","cell_type":"code","source":"\n# 9. Local training (non-DP)\ndef local_train(\n    global_state,\n    X,\n    y,\n    client_idx,\n    seed,\n    epochs=2,\n    batch_size=64,\n    lr=LR,\n    prox_mu=0.0,\n    corrupt_rate=0.0,\n    straggler=False\n):\n    seed_everything(seed)\n\n    model = MLP(X.shape[1])\n    load_state_dict_cpu(model, global_state)\n    model.train()\n\n    idx = np.asarray(client_idx, dtype=int).copy()\n\n    if len(idx) < 4:\n        raise ValueError(\n            f\"Client has only {len(idx)} samples; too small for local training.\"\n        )\n\n    rng = np.random.default_rng(seed)\n    rng.shuffle(idx)\n\n    # =========================================================\n    # SAFE LOCAL TRAIN / VALIDATION SPLIT\n    # =========================================================\n    client_y = y[idx]\n    classes, counts = np.unique(\n        client_y,\n        return_counts=True\n    )\n\n    n_classes = len(classes)\n    min_class_count = int(counts.min())\n\n    val_n = max(1, int(round(0.20 * len(idx))))\n\n    # Normal case: both classes have enough samples.\n    can_stratify = (\n        n_classes == 2\n        and min_class_count >= 2\n        and val_n >= 2\n        and (len(idx) - val_n) >= 2\n    )\n\n    if can_stratify:\n\n        tr_idx, va_idx = train_test_split(\n            idx,\n            test_size=0.20,\n            stratify=client_y,\n            random_state=seed\n        )\n\n    else:\n\n        # -----------------------------------------------------\n        # Severe label-skew case.\n        #\n        # Example:\n        #   class 0 = 279 samples\n        #   class 1 =   1 sample\n        #\n        # Never put the single rare example into validation,\n        # otherwise local training may lose that class entirely.\n        # -----------------------------------------------------\n\n        if n_classes == 2 and min_class_count == 1:\n\n            rare_class = classes[np.argmin(counts)]\n\n            rare_idx = idx[\n                client_y == rare_class\n            ]\n\n            common_idx = idx[\n                client_y != rare_class\n            ]\n\n            # Keep all singleton rare-class examples in training.\n            rng.shuffle(common_idx)\n\n            val_n = min(\n                max(1, int(round(0.20 * len(idx)))),\n                max(1, len(common_idx) - 1)\n            )\n\n            va_idx = common_idx[:val_n]\n            tr_idx = np.concatenate([\n                rare_idx,\n                common_idx[val_n:]\n            ])\n\n            rng.shuffle(tr_idx)\n\n        else:\n\n            # One-class client or otherwise unusable for\n            # stratified validation.\n            cut = max(\n                1,\n                min(\n                    len(idx) - 1,\n                    int(round(0.80 * len(idx)))\n                )\n            )\n\n            tr_idx = idx[:cut]\n            va_idx = idx[cut:]\n\n    # =========================================================\n    # TRAINING LABELS\n    # =========================================================\n    y_local = y[tr_idx].copy()\n\n    if corrupt_rate > 0:\n\n        corrupt_mask = (\n            rng.random(len(y_local)) < corrupt_rate\n        )\n\n        y_local[corrupt_mask] = (\n            1 - y_local[corrupt_mask]\n        )\n\n    ds = TensorDataset(\n        torch.tensor(X[tr_idx], dtype=torch.float32),\n        torch.tensor(y_local, dtype=torch.long)\n    )\n\n    loader = DataLoader(\n        ds,\n        batch_size=batch_size,\n        shuffle=True,\n        drop_last=False\n    )\n\n    optimizer = torch.optim.SGD(\n        model.parameters(),\n        lr=lr\n    )\n\n    criterion = nn.CrossEntropyLoss()\n\n    n_epochs = 1 if straggler else epochs\n\n    global_tensors = {\n        name: p.detach().clone()\n        for name, p in model.named_parameters()\n        if p.requires_grad\n    }\n\n    # =========================================================\n    # LOCAL TRAINING\n    # =========================================================\n    for _ in range(n_epochs):\n\n        for xb, yb in loader:\n\n            optimizer.zero_grad()\n\n            loss = criterion(\n                model(xb),\n                yb\n            )\n\n            # FedProx\n            if prox_mu > 0:\n\n                prox = 0.0\n\n                for name, p in model.named_parameters():\n\n                    if p.requires_grad:\n\n                        prox = prox + torch.sum(\n                            (p - global_tensors[name]) ** 2\n                        )\n\n                loss = loss + 0.5 * prox_mu * prox\n\n            loss.backward()\n            optimizer.step()\n\n    # =========================================================\n    # LOCAL VALIDATION\n    #\n    # IMPORTANT:\n    # We only need accuracy here because CAFAD uses the\n    # validation accuracy as its confidence signal.\n    # Do NOT call evaluate_state(), which computes F1/MCC/AUROC\n    # and generates warnings for single-class validation sets.\n    # =========================================================\n\n    model.eval()\n\n    with torch.no_grad():\n\n        xv = torch.tensor(\n            X[va_idx],\n            dtype=torch.float32\n        )\n\n        logits = model(xv)\n\n        pred = logits.argmax(\n            dim=1\n        ).cpu().numpy()\n\n    val_acc = accuracy_score(\n        y[va_idx],\n        pred\n    )\n\n    return (\n        clone_state_dict(model),\n        float(val_acc),\n        len(tr_idx)\n    )\n\ndef train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n    corrupt_clients=set(corrupt_clients or [])\n    straggler_clients=set(straggler_clients or [])\n    states=[]; val_accs=[]; ns=[]\n    for k,idx in enumerate(parts):\n        prox=PROX_MU if method==\"FedProx\" else 0.0\n        st,acc,n=local_train(\n            global_state,X,y,idx,seed+k,epochs=epochs,batch_size=batch_size,\n            lr=LR,prox_mu=prox,\n            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n            straggler=(k in straggler_clients)\n        )\n        states.append(st); val_accs.append(acc); ns.append(n)\n    return states,val_accs,ns\n","metadata":{"execution":{"iopub.status.busy":"2026-10-05T15:00:49.255537Z","iopub.execute_input":"2026-10-05T15:00:49.255831Z","iopub.status.idle":"2026-10-05T15:00:49.276644Z","shell.execute_reply.started":"2026-10-05T15:00:49.255793Z","shell.execute_reply":"2026-10-05T15:00:49.275823Z"},"trusted":true},"outputs":[],"execution_count":11},{"id":"e3b989ae-5ec3-430e-9c72-e3f81a09cefc","cell_type":"markdown","source":"## Test the worst α=0.1 CLIENT","metadata":{}},{"id":"a2baa18b-91d2-449e-bcfd-6159dd9d227b","cell_type":"code","source":"# =========================================================\n# TEST α=0.1 CLIENT LOCAL TRAINING\n# =========================================================\n\ntest_parts = dirichlet_label_partition(\n    y_train,\n    N_CLIENTS,\n    alpha=0.1,\n    seed=1,\n    min_size=100\n)\n\nprint(\"Client summaries:\")\ndisplay(\n    client_summary(\n        test_parts,\n        y_train\n    )\n)\n\n# Create initial global model state directly.\n# This avoids depending on clone_state_dict().\ntest_model = MLP(X_train.shape[1])\n\ntest_state = {\n    name: param.detach().cpu().clone()\n    for name, param in test_model.state_dict().items()\n}\n\n# Test local training on every client.\nfor k, idx in enumerate(test_parts):\n\n    state, val_acc, n_train = local_train(\n        test_state,\n        X_train,\n        y_train,\n        idx,\n        seed=100 + k,\n        epochs=1,\n        batc