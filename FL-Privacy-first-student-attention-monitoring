processor = ColumnTransformer([\n    (\"num\", Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"median\")),\n        (\"scaler\", StandardScaler()),\n    ]), numeric_cols),\n    (\"cat\", Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n        (\"onehot\", onehot),\n    ]), categorical_cols),\n])\n\nX_train = preprocessor.fit_transform(train_df[EXPECTED_FEATURES]).astype(np.float32)\nX_test = preprocessor.transform(test_df[EXPECTED_FEATURES]).astype(np.float32)\ny_train = train_df[TARGET].to_numpy(np.int64)\ny_test = test_df[TARGET].to_numpy(np.int64)\nFEATURE_NAMES_ENCODED = list(preprocessor.get_feature_names_out())\n\nprint(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\nprint(\"Encoded features:\", len(FEATURE_NAMES_ENCODED))\n\n\n# Fold-safe preprocessing helper used by blocked sensitivity and any fold-wise audit.\n# IMPORTANT: the preprocessor is fit only on the supplied training frame, preventing\n# information from the blocked test fold from entering imputation/scaling/encoding.\ndef build_fold_preprocessor(frame, cols=None):\n    cols = list(EXPECTED_FEATURES if cols is None else cols)\n    num_cols = [c for c in cols if frame[c].dtype != \"object\"]\n    cat_cols = [c for c in cols if frame[c].dtype == \"object\"]\n\n    try:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n    except TypeError:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n\n    transformers = []\n    if num_cols:\n        transformers.append((\n            \"num\",\n            Pipeline([\n                (\"imputer\", SimpleImputer(strategy=\"median\")),\n                (\"scaler\", StandardScaler()),\n            ]),\n            num_cols,\n        ))\n    if cat_cols:\n        transformers.append((\n            \"cat\",\n            Pipeline([\n                (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n                (\"onehot\", oh),\n            ]),\n            cat_cols,\n        ))\n\n    if not transformers:\n        raise ValueError(\"No usable numeric or categorical columns were supplied.\")\n\n    return ColumnTransformer(transformers, remainder=\"drop\")\n\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T14:56:48.241249Z","iopub.execute_input":"2026-10-10T14:56:48.242663Z","iopub.status.idle":"2026-10-10T14:56:48.326283Z","shell.execute_reply.started":"2026-10-10T14:56:48.242621Z","shell.execute_reply":"2026-10-10T14:56:48.325098Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Train: (4995, 44) Test: (1249, 44)\nEncoded features: 44\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"\n## 6. Benchmark-validity / feature-dependence audit\n\nThis section is deliberately separate from FL.\n\nA high-performing shallow model does **not** automatically mean train/test leakage. Instead, it shows that the released behavioral representation contains a strong, low-complexity mapping to the released operational label.\n\nWe therefore report:\n\n- shallow decision-tree reconstruction,\n- feature-group-only performance,\n- a direct-cue lookup,\n- and later, leave-one-group-out sensitivity.\n\nUse terms such as **feature–label construction dependence** or **benchmark-validity audit**, rather than calling this “leakage” unless a true split violation is demonstrated.\n","metadata":{}},{"cell_type":"code","source":"\n# 6A. Shallow-tree reconstruction\ndef make_tree_pipeline(cols, max_depth=3):\n    num = [c for c in cols if df[c].dtype != \"object\"]\n    cat = [c for c in cols if df[c].dtype == \"object\"]\n    try:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n    except TypeError:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n    pre = ColumnTransformer([\n        (\"num\", SimpleImputer(strategy=\"median\"), num),\n        (\"cat\", Pipeline([\n            (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n            (\"onehot\", oh),\n        ]), cat),\n    ])\n    return Pipeline([(\"pre\", pre),\n                     (\"clf\", DecisionTreeClassifier(max_depth=max_depth, random_state=SEED))])\n\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\naudit_rows = []\n\nfor gname, cols in V3_FEATURE_GROUPS.items():\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": gname, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\nkey_cues = [\"gaze_on_screen\", \"head_pose\", \"hand_obj_interaction\", \"phone_present\"]\nfor name, cols in [(\"key_direct_cues\", key_cues), (\"all_features\", EXPECTED_FEATURES)]:\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": name, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\naudit_table = pd.DataFrame(audit_rows).sort_values(\"mean_accuracy\", ascending=False)\ndisplay(audit_table)\naudit_table.to_csv(RESULTS_DIR / \"v3_feature_group_audit.csv\", index=False)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T08:33:16.939477Z","iopub.status.busy":"2026-10-06T08:33:16.939026Z","iopub.status.idle":"2026-10-06T08:33:20.247103Z","shell.execute_reply":"2026-10-06T08:33:20.246416Z","shell.execute_reply.started":"2026-10-06T08:33:16.939448Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 6B. Direct-cue conditional lookup (fit on train only)\ncue_train = train_df[key_cues + [TARGET]].copy()\ncue_test = test_df[key_cues + [TARGET]].copy()\n\ntrain_keys = cue_train[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\ntest_keys = cue_test[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\n\nmajority_map = cue_train.assign(_key=train_keys).groupby(\"_key\")[TARGET].agg([\"mean\",\"size\"])\nglobal_majority = int(train_df[TARGET].mean() >= 0.5)\n\npred = []\nfor key in test_keys:\n    if key in majority_map.index:\n        pred.append(int(majority_map.loc[key, \"mean\"] >= 0.5))\n    else:\n        pred.append(global_majority)\n\nprint(\"Direct-cue lookup accuracy:\", round(accuracy_score(y_test, pred), 4))\nprint(\"Direct-cue lookup F1:\", round(f1_score(y_test, pred), 4))\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T04:42:59.950712Z","iopub.status.busy":"2026-10-06T04:42:59.949669Z","iopub.status.idle":"2026-10-06T04:43:00.020882Z","shell.execute_reply":"2026-10-06T04:43:00.020264Z","shell.execute_reply.started":"2026-10-06T04:42:59.950675Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 6C. Centralized baselines\ncentral_results = []\n\ndt_pipe = make_tree_pipeline(EXPECTED_FEATURES, max_depth=3)\ndt_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\ndt_pred = dt_pipe.predict(test_df[EXPECTED_FEATURES])\ncentral_results.append({\n    \"model\": \"DecisionTree_depth3\",\n    \"accuracy\": accuracy_score(y_test, dt_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, dt_pred),\n    \"f1\": f1_score(y_test, dt_pred),\n    \"mcc\": matthews_corrcoef(y_test, dt_pred),\n})\n\net_pipe = Pipeline([\n    (\"pre\", preprocessor),\n    (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1))\n])\net_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\net_pred = et_pipe.predict(test_df[EXPECTED_FEATURES])\net_prob = et_pipe.predict_proba(test_df[EXPECTED_FEATURES])[:,1]\ncentral_results.append({\n    \"model\": \"ExtraTrees\",\n    \"accuracy\": accuracy_score(y_test, et_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, et_pred),\n    \"f1\": f1_score(y_test, et_pred),\n    \"mcc\": matthews_corrcoef(y_test, et_pred),\n    \"auroc\": roc_auc_score(y_test, et_prob),\n})\n\ncentral_table = pd.DataFrame(central_results)\ndisplay(central_table)\ncentral_table.to_csv(RESULTS_DIR / \"centralized_baselines_v3.csv\", index=False)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T04:43:00.021999Z","iopub.status.busy":"2026-10-06T04:43:00.021681Z","iopub.status.idle":"2026-10-06T04:43:01.303993Z","shell.execute_reply":"2026-10-06T04:43:01.303347Z","shell.execute_reply.started":"2026-10-06T04:43:00.021978Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Federated simulation\n\nThe FL clients are **controlled partitions of the training records**. In the manuscript, call them **simulated clients / decentralized data partitions**, not identified students. The primary benchmark uses 10 clients; the optional client-count sensitivity compares 5 vs 10 clients on a smaller matched grid.","metadata":{}},{"cell_type":"code","source":"# 7A. Partition helpers\ndef balanced_iid_partition(y, n_clients, seed):\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n    for cls in np.unique(y):\n        idx = rng.permutation(np.where(y == cls)[0])\n        for k, s in enumerate(np.array_split(idx, n_clients)):\n            parts[k].extend(s.tolist())\n    return [np.array(sorted(z), dtype=int) for z in parts]\n\n\ndef dirichlet_label_partition(\n    y,\n    n_clients,\n    alpha,\n    seed,\n    min_size=PARTITION_MIN_SIZE,\n    max_tries=PARTITION_MAX_TRIES,\n):\n    rng = np.random.default_rng(seed)\n    classes = np.unique(y)\n    best_parts = None\n    best_min = -1\n\n    for _ in range(max_tries):\n        parts = [[] for _ in range(n_clients)]\n\n        for cls in classes:\n            idx = rng.permutation(np.where(y == cls)[0])\n            props = rng.dirichlet(np.ones(n_clients) * alpha)\n            cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n            splits = np.split(idx, cuts)\n            for k, s in enumerate(splits):\n                parts[k].extend(s.tolist())\n\n        sizes = [len(z) for z in parts]\n        current_min = min(sizes)\n        if current_min > best_min:\n            best_min = current_min\n            best_parts = [list(z) for z in parts]\n\n        if current_min >= min_size:\n            return [np.array(sorted(z), dtype=int) for z in parts]\n\n    # Last-resort repair for pathological Dirichlet draws. This only activates\n    # when the sampled partition cannot satisfy the requested floor after\n    # max_tries; samples are transferred from the largest client(s) so that\n    # local training never receives an unusably tiny client.\n    repaired = [list(z) for z in best_parts]\n    while min(len(z) for z in repaired) < min_size:\n        small = int(np.argmin([len(z) for z in repaired]))\n        donors = np.argsort([len(z) for z in repaired])[::-1]\n        donor = next(int(d) for d in donors if d != small and len(repaired[d]) > min_size)\n        need = min_size - len(repaired[small])\n        take = min(need, len(repaired[donor]) - min_size)\n        if take <= 0:\n            raise RuntimeError(\n                f\"Could not repair Dirichlet partition to min_size={min_size}; \"\n                f\"client sizes={[len(z) for z in repaired]}\"\n            )\n        moved = repaired[donor][-take:]\n        del repaired[donor][-take:]\n        repaired[small].extend(moved)\n\n    print(\n        f\"WARNING: alpha={alpha} seed={seed} did not meet min_size={min_size} \"\n        f\"within {max_tries} draws; repaired best draw to min_client_size={min_size}.\"\n    )\n    return [np.array(sorted(z), dtype=int) for z in repaired]\n\n\ndef feature_cluster_partition(X, y, n_clients, n_clusters, seed):\n    km = MiniBatchKMeans(\n        n_clusters=n_clusters,\n        random_state=seed,\n        batch_size=256,\n        n_init=10,\n    )\n    cluster_id = km.fit_predict(X)\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n\n    for c in range(n_clusters):\n        idx = rng.permutation(np.where(cluster_id == c)[0])\n        if len(idx) == 0:\n            continue\n        props = rng.dirichlet(np.ones(n_clients) * 0.35)\n        cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n        for k, s in enumerate(np.split(idx, cuts)):\n            parts[k].extend(s.tolist())\n\n    for k in range(n_clients):\n        if len(parts[k]) == 0:\n            donor = int(np.argmax([len(z) for z in parts]))\n            parts[k].append(parts[donor].pop())\n\n    return [np.array(sorted(z), dtype=int) for z in parts], cluster_id\n\n\ndef client_summary(parts, y, cluster_id=None):\n    rows = []\n    global_rate = float(np.mean(y))\n\n    for k, idx in enumerate(parts):\n        row = {\n            \"client\": k,\n            \"n\": len(idx),\n            \"label1_rate\": float(np.mean(y[idx])),\n            \"abs_label_shift\": abs(float(np.mean(y[idx])) - global_rate),\n        }\n        if cluster_id is not None:\n            vals, counts = np.unique(cluster_id[idx], return_counts=True)\n            row[\"n_feature_clusters\"] = len(vals)\n            row[\"dominant_cluster_share\"] = float(counts.max() / counts.sum())\n        rows.append(row)\n\n    return pd.DataFrame(rows)\n\n\nprint(f\"Partition helpers ready for {N_CLIENTS} simulated clients.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:18:42.211998Z","iopub.execute_input":"2026-10-10T08:18:42.21227Z","iopub.status.idle":"2026-10-10T08:18:42.228846Z","shell.execute_reply.started":"2026-10-10T08:18:42.212245Z","shell.execute_reply":"2026-10-10T08:18:42.227933Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Partition helpers ready for 10 simulated clients.\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# 8. PyTorch model + utilities\n\ndef seed_everything(seed):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n\nclass MLP(nn.Module):\n    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden1), nn.ReLU(),\n            nn.Linear(hidden1, hidden2), nn.ReLU(),\n            nn.Linear(hidden2, 2)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef clone_state_dict(model):\n    # Always checkpoint on CPU so files remain portable across Kaggle sessions.\n    return {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n\ndef load_state_dict_device(model, state):\n    model.load_state_dict({k: v.to(DEVICE) for k, v in state.items()})\n\ndef load_state_dict_cpu(model, state):\n    # Backward-compatible alias used by the existing analysis code.\n    load_state_dict_device(model, state)\n\ndef evaluate_state(state, X, y):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n    with torch.no_grad():\n        xt = torch.from_numpy(np.asarray(X, dtype=np.float32)).to(DEVICE)\n        logits = model(xt)\n        prob = torch.softmax(logits, dim=1)[:, 1].detach().cpu().numpy()\n        pred = logits.argmax(1).detach().cpu().numpy()\n    return {\n        \"accuracy\": accuracy_score(y, pred),\n        \"balanced_accuracy\": balanced_accuracy_score(y, pred),\n        \"f1\": f1_score(y, pred, zero_division=0),\n        \"precision\": precision_score(y, pred, zero_division=0),\n        \"recall\": recall_score(y, pred, zero_division=0),\n        \"mcc\": matthews_corrcoef(y, pred),\n        \"auroc\": roc_auc_score(y, prob) if len(np.unique(y)) == 2 else np.nan\n    }\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:19:04.973462Z","iopub.execute_input":"2026-10-10T08:19:04.973716Z","iopub.status.idle":"2026-10-10T08:19:04.983119Z","shell.execute_reply.started":"2026-10-10T08:19:04.973695Z","shell.execute_reply":"2026-10-10T08:19:04.982383Z"},"trusted":true},"outputs":[],"execution_count":7},{"cell_type":"code","source":"# 9. Local training (non-DP)\ndef local_train(\n    global_state,\n    X,\n    y,\n    client_idx,\n    seed,\n    epochs=2,\n    batch_size=64,\n    lr=LR,\n    prox_mu=0.0,\n    corrupt_rate=0.0,\n    straggler=False\n):\n    seed_everything(seed)\n\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, global_state)\n    model.train()\n\n    idx = np.asarray(client_idx, dtype=int).copy()\n    if len(idx) < 2:\n        raise ValueError(f\"Client has only {len(idx)} samples; too small for local training.\")\n\n    rng = np.random.default_rng(seed)\n    rng.shuffle(idx)\n\n    client_y = y[idx]\n    classes, counts = np.unique(client_y, return_counts=True)\n    n_classes = len(classes)\n    val_n = max(1, int(round(0.20 * len(idx))))\n\n    can_stratify = (\n        n_classes == 2\n        and int(counts.min()) >= 2\n        and val_n >= 2\n        and (len(idx) - val_n) >= 2\n    )\n\n    if can_stratify:\n        tr_idx, va_idx = train_test_split(\n            idx, test_size=0.20, stratify=client_y, random_state=seed\n        )\n    elif n_classes == 2 and int(counts.min()) == 1:\n        rare_class = classes[np.argmin(counts)]\n        rare_idx = idx[client_y == rare_class]\n        common_idx = idx[client_y != rare_class]\n        rng.shuffle(common_idx)\n        val_n = min(max(1, int(round(0.20 * len(idx)))), max(1, len(common_idx) - 1))\n        va_idx = common_idx[:val_n]\n        tr_idx = np.concatenate([rare_idx, common_idx[val_n:]])\n        rng.shuffle(tr_idx)\n    else:\n        cut = max(1, min(len(idx) - 1, int(round(0.80 * len(idx)))))\n        tr_idx, va_idx = idx[:cut], idx[cut:]\n\n    y_local = y[tr_idx].copy()\n    if corrupt_rate > 0:\n        corrupt_mask = rng.random(len(y_local)) < corrupt_rate\n        y_local[corrupt_mask] = 1 - y_local[corrupt_mask]\n\n    x_tensor = torch.from_numpy(np.asarray(X[tr_idx], dtype=np.float32))\n    y_tensor = torch.from_numpy(np.asarray(y_local, dtype=np.int64))\n    ds = TensorDataset(x_tensor, y_tensor)\n    loader = DataLoader(\n        ds, batch_size=min(batch_size, len(ds)), shuffle=True,\n        drop_last=False, pin_memory=(DEVICE.type == \"cuda\")\n    )\n\n    optimizer = torch.optim.SGD(model.parameters(), lr=lr)\n    criterion = nn.CrossEntropyLoss()\n    n_epochs = 1 if straggler else epochs\n\n    global_tensors = {\n        name: p.detach().clone()\n        for name, p in model.named_parameters()\n        if p.requires_grad\n    }\n\n    for _ in range(n_epochs):\n        for xb, yb in loader:\n            xb = xb.to(DEVICE, non_blocking=True)\n            yb = yb.to(DEVICE, non_blocking=True)\n            optimizer.zero_grad(set_to_none=True)\n            loss = criterion(model(xb), yb)\n            if prox_mu > 0:\n                prox = 0.0\n                for name, p in model.named_parameters():\n                    if p.requires_grad:\n                        prox = prox + torch.sum((p - global_tensors[name]) ** 2)\n                loss = loss + 0.5 * prox_mu * prox\n            loss.backward()\n            optimizer.step()\n\n    model.eval()\n    with torch.no_grad():\n        xv = torch.from_numpy(np.asarray(X[va_idx], dtype=np.float32)).to(DEVICE)\n        pred = model(xv).argmax(dim=1).detach().cpu().numpy()\n    val_acc = accuracy_score(y[va_idx], pred)\n\n    return clone_state_dict(model), float(val_acc), len(tr_idx)\n\ndef train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n    corrupt_clients = set(corrupt_clients or [])\n    straggler_clients = set(straggler_clients or [])\n    states, val_accs, ns = [], [], []\n    for k, idx in enumerate(parts):\n        prox = PROX_MU if method == \"FedProx\" else 0.0\n        st, acc, n = local_train(\n            global_state, X, y, idx, seed + k, epochs=epochs, batch_size=batch_size,\n            lr=LR, prox_mu=prox,\n            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n            straggler=(k in straggler_clients)\n        )\n        states.append(st); val_accs.append(acc); ns.append(n)\n    return states, val_accs, ns\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:19:08.210645Z","iopub.execute_input":"2026-10-10T08:19:08.211038Z","iopub.status.idle":"2026-10-10T08:19:08.228906Z","shell.execute_reply.started":"2026-10-10T08:19:08.211008Z","shell.execute_reply":"2026-10-10T08:19:08.227989Z"},"trusted":true},"outputs":[],"execution_count":8},{"cell_type":"code","source":"\n# 10. Aggregators\ndef aggregate_fedavg(states, ns):\n    total=float(sum(ns))\n    return {k:sum(states[i][k]*(ns[i]/total) for i in range(len(states))) for k in states[0]}\n\ndef aggregate_median(states):\n    return {k:torch.median(torch.stack([s[k] for s in states]),dim=0).values for k in states[0]}\n\ndef aggregate_trimmed_mean(states, trim_fraction=0.2):\n    n=len(states); trim=int(math.floor(n*trim_fraction))\n    if 2*trim>=n: return aggregate_median(states)\n    out={}\n    for k in states[0]:\n        t=torch.stack([s[k] for s in states])\n        t,_=torch.sort(t,dim=0)\n        out[k]=t[trim:n-trim].mean(dim=0)\n    return out\n\ndef aggregate_cafad(states, ns, val_accs, beta=CAFAD_BETA, z=CAFAD_Z):\n    c=np.asarray(val_accs,float); mu=float(c.mean()); sd=float(c.std())\n    mask=np.ones(len(c),dtype=bool) if sd<1e-12 else (c >= mu-z*sd)\n    if not mask.any(): mask[:]=True\n    logits=beta*(c-c.max())\n    raw=np.asarray(ns,float)*np.exp(logits)*mask.astype(float)\n    if raw.sum()<=0: raw=np.asarray(ns,float)\n    w=raw/raw.sum()\n    return ({k:sum(states[i][k]*float(w[i]) for i in range(len(states))) for k in states[0]}, w, mask)\n\ndef aggregate_multikrum(states, f=1):\n    n=len(states)\n    if n<=2*f+2: return aggregate_fedavg(states,[1]*n)\n    V=torch.stack([torch.cat([s[k].reshape(-1).float() for k in s]) for s in states])\n    d=torch.cdist(V,V,p=2)**2\n    scores=[]\n    for i in range(n):\n        others=torch.cat([d[i,:i],d[i,i+1:]])\n        scores.append(torch.topk(others,k=n-f-2,largest=False).values.sum().item())\n    chosen=np.argsort(scores)[:n-f-2]\n    chosen_states=[states[int(i)] for i in chosen]\n    return aggregate_fedavg(chosen_states,[1]*len(chosen_states))\n\ndef aggregate(method, states, ns, val_accs):\n    if method in (\"FedAvg\",\"FedProx\"): return aggregate_fedavg(states,ns),None,None\n    if method==\"Median\": return aggregate_median(states),None,None\n    if method==\"TrimmedMean\": return aggregate_trimmed_mean(states,TRIM_FRACTION),None,None\n    if method==\"Krum\": return aggregate_multikrum(states,KRUM_F),None,None\n    if method==\"CAFAD\":\n        st,w,mask=aggregate_cafad(states,ns,val_accs); return st,w,mask\n    raise ValueError(method)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T04:43:01.370111Z","iopub.status.busy":"2026-10-06T04:43:01.369841Z","iopub.status.idle":"2026-10-06T04:43:01.391899Z","shell.execute_reply":"2026-10-06T04:43:01.391155Z","shell.execute_reply.started":"2026-10-06T04:43:01.370082Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 11. Federated driver\nMETHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n\n\ndef run_federated(X, y, X_eval, y_eval, parts, method, seed, rounds, local_epochs,\n                  batch_size, corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n    seed_everything(seed)\n    global_state = clone_state_dict(MLP(X.shape[1]).to(DEVICE))\n    final_weights = None\n    final_mask = None\n    history = []\n\n    for rnd in range(rounds):\n        states, val_accs, ns = train_clients_once(\n            global_state, parts, X, y, seed + rnd * 1000, method,\n            local_epochs, batch_size,\n            corrupt_clients=corrupt_clients, corrupt_rate=corrupt_rate,\n            straggler_clients=straggler_clients\n        )\n        global_state, weights, mask = aggregate(method, states, ns, val_accs)\n        final_weights, final_mask = weights, mask\n        history.append({\n            \"round\": rnd + 1,\n            \"method\": method,\n            \"seed\": seed,\n            **evaluate_state(global_state, X_eval, y_eval),\n            \"mean_client_val_acc\": float(np.mean(val_accs)),\n            \"std_client_val_acc\": float(np.std(val_accs)),\n        })\n\n    result = evaluate_state(global_state, X_eval, y_eval)\n    result.update({\n        \"method\": method,\n        \"seed\": seed,\n        \"final_cafad_weight_min\": float(np.min(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_weight_max\": float(np.max(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_masked_clients\": int((~final_mask).sum()) if final_mask is not None else np.nan\n    })\n    return result, pd.DataFrame(history), global_state\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:19:23.458302Z","iopub.execute_input":"2026-10-10T08:19:23.458587Z","iopub.status.idle":"2026-10-10T08:19:23.466452Z","shell.execute_reply.started":"2026-10-10T08:19:23.458564Z","shell.execute_reply":"2026-10-10T08:19:23.465697Z"},"trusted":true},"outputs":[],"execution_count":9},{"cell_type":"markdown","source":"## 12. Clean FL / heterogeneity sweep\n\nPrimary paper grid: 20 seeds × 10 simulated clients × (IID + Dirichlet α∈{10,2,1,0.5,0.1}) × five aggregation methods = 600 federated runs. Every run writes a recoverable result row, round history, and final model-state cache.","metadata":{}},{"cell_type":"code","source":"# 11B. Checkpoint utilities\n\ndef atomic_to_csv(frame, path):\n    path = Path(path)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = path.with_suffix(path.suffix + \".tmp\")\n    frame.to_csv(tmp, index=False)\n    os.replace(tmp, path)\n\n\ndef atomic_torch_save(obj, path):\n    path = Path(path)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = path.with_suffix(path.suffix + \".tmp\")\n    torch.save(obj, tmp)\n    os.replace(tmp, path)\n\n\ndef upsert_checkpoint(path, new_rows, key_cols):\n    path = Path(path)\n    current = pd.read_csv(path) if path.exists() else pd.DataFrame()\n    incoming = pd.DataFrame(new_rows)\n    merged = pd.concat([current, incoming], ignore_index=True, sort=False)\n\n    if key_cols:\n        merged = merged.drop_duplicates(subset=key_cols, keep=\"last\")\n\n    merged = merged.reset_index(drop=True)\n    atomic_to_csv(merged, path)\n    return merged\n\n\ndef load_checkpoint(path):\n    path = Path(path)\n    return pd.read_csv(path) if path.exists() else pd.DataFrame()\n\n\ndef consolidate_clean_histories():\n    files = sorted(CLEAN_HISTORY_CACHE_DIR.glob(\"*.csv\"))\n    if not files:\n        raise FileNotFoundError(f\"No clean-history cache files found in {CLEAN_HISTORY_CACHE_DIR}\")\n\n    frames = [pd.read_csv(p) for p in files]\n    out = pd.concat(frames, ignore_index=True)\n    out = out.drop_duplicates(\n        subset=[\"seed\", \"condition\", \"alpha\", \"method\", \"round\"],\n        keep=\"last\",\n    )\n    atomic_to_csv(out, CLEAN_HISTORY_PATH)\n    return out\n\n\nprint(\"Results directory:\", RESULTS_DIR)\nprint(\"Checkpoint directory:\", CHECKPOINT_DIR)\nprint(\"Model cache directory:\", MODEL_CACHE_DIR)\nprint(\"Clean-history cache directory:\", CLEAN_HISTORY_CACHE_DIR)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:19:30.834128Z","iopub.execute_input":"2026-10-10T08:19:30.834401Z","iopub.status.idle":"2026-10-10T08:19:30.842984Z","shell.execute_reply.started":"2026-10-10T08:19:30.834377Z","shell.execute_reply":"2026-10-10T08:19:30.842136Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Results directory: /kaggle/working/attention_fl_v3_q1_10client_results\nCheckpoint directory: /kaggle/working/attention_fl_v3_q1_10client_results/checkpoints\nModel cache directory: /kaggle/working/attention_fl_v3_q1_10client_results/model_cache\nClean-history cache directory: /kaggle/working/attention_fl_v3_q1_10client_results/clean_history_cache\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# PRE-FLIGHT: validate the primary protocol before launching long experiments.\nassert N_CLIENTS == 10\nassert RUN_MODE == \"PAPER\"\nassert CFG[\"fl_rounds\"] == 25\nassert CFG[\"local_epochs\"] == 3\nassert CFG[\"batch_size\"] == 64\nassert len(CFG[\"seeds\"]) == 20\nassert len(CFG[\"alphas\"]) == 5\nassert METHODS == [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nassert len(DP_TARGET_EPS) == 4\nassert PARTITION_MIN_SIZE >= 2\nassert DEVICE is not None\nassert RESULTS_DIR.name.endswith(f\"_{EXPERIMENT_TAG}_results\")\n\nprint(\"PRE-FLIGHT PASSED\")\nprint(\"Device:\", DEVICE)\nprint(\"Results directory:\", RESULTS_DIR)\nprint(\"Clean FL runs:\", len(CFG[\"seeds\"]) * (1 + len(CFG[\"alphas\"])) * len(METHODS))\nprint(\"Robustness runs:\", 20 * 3 * 5)\nprint(\"DP private runs:\", 20 * 4 * 3)\nprint(\"FGSM rows:\", 20 * 3 * 3)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T04:43:01.427563Z","iopub.status.busy":"2026-10-06T04:43:01.426912Z","iopub.status.idle":"2026-10-06T04:43:01.449603Z","shell.execute_reply":"2026-10-06T04:43:01.448973Z","shell.execute_reply.started":"2026-10-06T04:43:01.427541Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 12A. Main clean FL sweep — checkpointed, one run at a time\nCLEAN_SEEDS = list(CFG[\"seeds\"])\nCLEAN_PROGRESS_PATH = RESULTS_DIR / \"clean_fl_sweep_progress_v3.csv\"\nCLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nCLEAN_HISTORY_PATH = RESULTS_DIR / \"clean_fl_history_v3.csv\"\n\nRUN_CLEAN_SWEEP = True\n\nif RUN_CLEAN_SWEEP:\n    clean_progress = load_checkpoint(CLEAN_PROGRESS_PATH)\n\n    if not clean_progress.empty:\n        clean_progress[\"seed\"] = clean_progress[\"seed\"].astype(int)\n        clean_progress[\"alpha\"] = pd.to_numeric(clean_progress[\"alpha\"], errors=\"coerce\")\n\n    expected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\n\n    for seed in CLEAN_SEEDS:\n        iid_parts = balanced_iid_partition(y_train, N_CLIENTS, seed)\n\n        conditions = [(\"IID\", None, iid_parts)]\n        for alpha in CFG[\"alphas\"]:\n            parts = dirichlet_label_partition(\n                y_train,\n                N_CLIENTS,\n                alpha=float(alpha),\n                seed=seed,\n                min_size=PARTITION_MIN_SIZE,\n                max_tries=PARTITION_MAX_TRIES,\n            )\n            conditions.append((\"Dirichlet\", float(alpha), parts))\n\n        for condition, alpha, parts in conditions:\n            summary = client_summary(parts, y_train)\n            print(\n                f\"\\nSeed={seed} | Condition={condition} | Alpha={alpha} | \"\n                f\"Client sizes={summary['n'].tolist()}\"\n            )\n\n            for method in METHODS:\n                alpha_token = \"iid\" if alpha is None else str(float(alpha)).replace(\".\", \"p\")\n                state_path = (\n                    MODEL_CACHE_DIR\n                    / f\"clean_seed{seed:02d}_{condition.lower()}_alpha{alpha_token}_{method}.pt\"\n                )\n                history_path = (\n                    CLEAN_HISTORY_CACHE_DIR\n                    / f\"clean_seed{seed:02d}_{condition.lower()}_alpha{alpha_token}_{method}.csv\"\n                )\n\n                already_done = False\n                if not clean_progress.empty:\n                    match = clean_progress[\n                        (clean_progress[\"seed\"] == int(seed))\n                        & (clean_progress[\"condition\"] == condition)\n                        & (clean_progress[\"method\"] == method)\n                        & (\n                            (clean_progress[\"alpha\"].isna() & (alpha is None))\n                            | clean_progress[\"alpha\"].fillna(-999).eq(\n                                float(alpha) if alpha is not None else -999\n                            )\n                        )\n                    ]\n                    already_done = (\n                        len(match) > 0\n                        and state_path.exists()\n                        and history_path.exists()\n                    )\n\n                if already_done:\n                    print(f\"SKIP  {condition} alpha={alpha} {method} seed={seed}\")\n                    continue\n\n                print(f\"RUN   {condition} alpha={alpha} {method} seed={seed}\")\n\n                result, history, state = run_federated(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    method,\n                    seed,\n                    CFG[\"fl_rounds\"],\n                    CFG[\"local_epochs\"],\n                    CFG[\"batch_size\"],\n                )\n\n                result.update({\n                    \"condition\": condition,\n                    \"alpha\": np.nan if alpha is None else float(alpha),\n                    \"partition_seed\": int(seed),\n                    \"n_clients\": int(N_CLIENTS),\n                })\n\n                # Save the model state and its complete round history atomically.\n                atomic_torch_save(\n                    {\n                        \"state\": state,\n                        \"seed\": int(seed),\n                        \"condition\": condition,\n                        \"alpha\": None if alpha is None else float(alpha),\n                        \"method\": method,\n                        \"n_clients\": int(N_CLIENTS),\n                    },\n                    state_path,\n                )\n\n                hist = history.copy()\n                hist[\"condition\"] = condition\n                hist[\"alpha\"] = np.nan if alpha is None else float(alpha)\n                hist[\"n_clients\"] = int(N_CLIENTS)\n                atomic_to_csv(hist, history_path)\n\n                # Only mark the run complete after BOTH state and history exist.\n                clean_progress = upsert_checkpoint(\n                    CLEAN_PROGRESS_PATH,\n                    [result],\n                    [\"seed\", \"condition\", \"alpha\", \"method\"],\n                )\n\n                print(f\"CHECKPOINT: {len(clean_progress)}/{expected_clean} clean runs\")\n\n    if len(clean_progress) == expected_clean:\n        atomic_to_csv(\n            clean_progress.sort_values(\n                [\"condition\", \"alpha\", \"method\", \"seed\"],\n                na_position=\"first\",\n            ),\n            CLEAN_FINAL_PATH,\n        )\n        histories = consolidate_clean_histories()\n        print(\n            \"CLEAN SWEEP COMPLETE:\",\n            len(clean_progress),\n            \"runs;\",\n            len(histories),\n            \"history rows.\",\n        )\n    else:\n        print(\n            \"CLEAN SWEEP INCOMPLETE; progress retained at:\",\n            CLEAN_PROGRESS_PATH,\n        )\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T04:43:01.450858Z","iopub.status.busy":"2026-10-06T04:43:01.450576Z","iopub.status.idle":"2026-10-06T06:31:25.204832Z","shell.execute_reply":"2026-10-06T06:31:25.204154Z","shell.execute_reply.started":"2026-10-06T04:43:01.450828Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 13. Client unreliability\n\nPrimary robustness scenarios use 10 simulated clients: one fully poisoned client (10% of clients), two fully poisoned clients (20%), three fully poisoned clients (30%), and one undertrained straggler (10%). The local validation data remains clean, so CAFAD receives an honest validation-confidence signal.","metadata":{}},{"cell_type":"code","source":"# 13A. Client unreliability / poisoning sweep — checkpointed\nROBUST_METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nROBUST_SEEDS = list(range(20))\nROBUST_PROGRESS_PATH = (\n    RESULTS_DIR / \"robustness_sweep_corrected_progress_v3.csv\"\n)\nROBUST_FINAL_PATH = (\n    RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n)\n\n# Preserve the original attack semantics from the working notebook:\n# - one client: 20% of that client's local training labels are flipped\n# - two clients: 40% of each selected client's local training labels are flipped\n# - one straggler: one client trains for only 1 local epoch\nROBUST_SCENARIOS = [\n    (\"full_label_flip_20pct_clients\", [0, 1], 1.0, []),\n    (\"full_label_flip_40pct_clients\", [0, 1, 2, 3], 1.0, []),\n    (\"one_straggler_10pct_clients\", [], 0.0, [0]),\n]\n\nRUN_ROBUSTNESS_SWEEP = True\n\nif RUN_ROBUSTNESS_SWEEP:\n    robustness_progress = load_checkpoint(ROBUST_PROGRESS_PATH)\n    expected_robust = (\n        len(ROBUST_SEEDS)\n        * len(ROBUST_SCENARIOS)\n        * len(ROBUST_METHODS)\n    )\n\n    for seed in ROBUST_SEEDS:\n        parts = balanced_iid_partition(y_train, N_CLIENTS, seed)\n\n        for scenario, poisoned, rate, stragglers in ROBUST_SCENARIOS:\n            for method in ROBUST_METHODS:\n                done = False\n\n                if not robustness_progress.empty:\n                    done = (\n                        (robustness_progress[\"seed\"].astype(int) == seed)\n                        & (robustness_progress[\"scenario\"] == scenario)\n                        & (robustness_progress[\"method\"] == method)\n                    ).any()\n\n                if done:\n                    print(f\"SKIP  {scenario} {method} seed={seed}\")\n                    continue\n\n                print(f\"RUN   {scenario} {method} seed={seed}\")\n\n                result, _, _ = run_federated(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    method,\n                    seed,\n                    CFG[\"fl_rounds\"],\n                    CFG[\"local_epochs\"],\n                    CFG[\"batch_size\"],\n   