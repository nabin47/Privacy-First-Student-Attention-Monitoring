ress.empty:\n        dp_progress[\"seed\"] = dp_progress[\"seed\"].astype(int)\n        dp_progress[\"target_epsilon\"] = pd.to_numeric(dp_progress[\"target_epsilon\"], errors=\"coerce\")\n\n    expected_private = len(DP_SEEDS) * len(DP_EPSILONS) * len(DP_METHODS)\n\n    if not CLEAN_FINAL_PATH.exists():\n        raise FileNotFoundError(\n            f\"Clean FL final results are required before DP: {CLEAN_FINAL_PATH}\"\n        )\n\n    for seed in DP_SEEDS:\n        parts = balanced_iid_partition(y_train, N_CLIENTS, seed)\n        for eps in DP_EPSILONS:\n            for method in DP_METHODS:\n                done = False\n                if not dp_progress.empty:\n                    done = (\n                        (dp_progress[\"seed\"] == int(seed))\n                        & np.isclose(dp_progress[\"target_epsilon\"].astype(float), float(eps))\n                        & (dp_progress[\"method\"] == method)\n                    ).any()\n                if done:\n                    print(f\"SKIP DP  seed={seed} eps={eps} method={method}\")\n                    continue\n\n                print(f\"RUN  DP  seed={seed} eps={eps} method={method}\")\n                result = run_federated_dp(\n                    X_train, y_train, X_test, y_test, parts, method, seed,\n                    rounds=CFG[\"fl_rounds\"], local_epochs=CFG[\"local_epochs\"],\n                    batch_size=CFG[\"batch_size\"], target_epsilon=float(eps)\n                )\n                result.update({\n                    \"partition\": \"IID\",\n                    \"n_clients\": int(N_CLIENTS),\n                    \"privacy_unit\": \"record/row-level\",\n                    \"delta\": float(DP_DELTA),\n                })\n                dp_progress = upsert_checkpoint(\n                    DP_PROGRESS_PATH, [result],\n                    [\"seed\", \"target_epsilon\", \"method\"]\n                )\n                print(f\"DP CHECKPOINT: {len(dp_progress)}/{expected_private} private runs\")\n\n    if len(dp_progress) == expected_private:\n        clean_iid = pd.read_csv(CLEAN_FINAL_PATH)\n        nonprivate = clean_iid[\n            (clean_iid[\"condition\"] == \"IID\")\n            & (clean_iid[\"method\"].isin(DP_METHODS))\n        ].copy()\n        assert len(nonprivate) == len(DP_SEEDS) * len(DP_METHODS), (\n            f\"Expected {len(DP_SEEDS) * len(DP_METHODS)} non-private clean references; \"\n            f\"found {len(nonprivate)}\"\n        )\n        nonprivate[\"target_epsilon\"] = np.inf\n        nonprivate[\"max_client_achieved_epsilon\"] = np.nan\n        nonprivate[\"mean_client_sigma\"] = np.nan\n        nonprivate[\"privacy_unit\"] = \"record/row-level\"\n        nonprivate[\"delta\"] = float(DP_DELTA)\n        nonprivate[\"partition\"] = \"IID\"\n        nonprivate[\"n_clients\"] = int(N_CLIENTS)\n\n        private = dp_progress.copy()\n        dp_all = pd.concat([private, nonprivate], ignore_index=True, sort=False)\n        dp_all = dp_all.drop_duplicates(\n            subset=[\"seed\", \"target_epsilon\", \"method\"], keep=\"last\"\n        ).sort_values([\"target_epsilon\", \"method\", \"seed\"], na_position=\"last\")\n        atomic_to_csv(dp_all, DP_FINAL_PATH)\n        print(\"DP SWEEP COMPLETE:\", len(dp_all), \"rows ->\", DP_FINAL_PATH)\n        display(\n            dp_all.groupby([\"target_epsilon\", \"method\"], dropna=False).agg(\n                accuracy_mean=(\"accuracy\", \"mean\"),\n                accuracy_std=(\"accuracy\", \"std\"),\n                f1_mean=(\"f1\", \"mean\"),\n                f1_std=(\"f1\", \"std\"),\n                balanced_accuracy_mean=(\"balanced_accuracy\", \"mean\"),\n                auroc_mean=(\"auroc\", \"mean\"),\n                achieved_epsilon=(\"max_client_achieved_epsilon\", \"mean\"),\n                n=(\"accuracy\", \"count\")\n            ).reset_index()\n        )\n    else:\n        print(\"DP SWEEP INCOMPLETE; progress retained at:\", DP_PROGRESS_PATH)\n","metadat