        for eps in DP_GRID_EPSILONS:\n","            eps_is_inf = bool(np.isinf(eps))\n","            for method in DP_METHODS:\n","                # Recompute the mask after every completed run because the checkpoint grows in-place.\n","                if not dp_progress.empty:\n","                    eps_values = dp_progress[\"target_epsilon\"].astype(float)\n","                    eps_mask = np.isinf(eps_values) if eps_is_inf else np.isclose(eps_values, float(eps))\n","                else:\n","                    eps_mask = pd.Series(False, index=dp_progress.index, dtype=bool)\n","                done = False\n","                if not dp_progress.empty:\n","                    done = (\n","                        (dp_progress[\"seed\"] == int(seed))\n","                        & eps_mask\n","                        & (dp_progress[\"method\"] == method)\n","                        & (dp_progress.get(\"dp_protocol_version\", pd.Series(index=dp_progress.index, dtype=object)) == DP_PROTOCOL_VERSION)\n","                    ).any()\n","                if done:\n","                    print(f\"SKIP DP-v2 seed={seed} eps={eps} method={method}\")\n","                    continue\n","\n","                private_epsilon = None if eps_is_inf else float(eps)\n","                run_kind = \"MATCHED-NONPRIVATE\" if eps_is_inf else \"PRIVATE\"\n","                print(f\"RUN DP-v2 {run_kind} seed={seed} eps={eps} method={method}\")\n","                result = run_federated_dp(\n","                    X_train, y_train, X_test, y_test, parts, method, seed,\n","                    rounds=CFG[\"fl_rounds\"], local_epochs=CFG[\"local_epochs\"],\n","                    batch_size=CFG[\"batch_size\"], target_epsilon=private_epsilon\n","                )\n","                result.update({\n","                    \"partition\": \"IID\",\n","                    \"n_clients\": int(N_CLIENTS),\n","                    \"privacy_unit\": \"record/row-level\" if not eps_is_inf else \"not_private_control\",\n","                    \"delta\": float(DP_DELTA),\n","                    \"experiment_seed\": int(seed),\n","                    \"lr\": float(_dp_lr_for(private_epsilon)),\n","                })\n","                dp_progress = upsert_checkpoint(\n","                    DP_PROGRESS_PATH, [result],\n","                    [\"seed\", \"target_epsilon\", \"method\"]\n","                )\n","                print(f\"DP-v2 CHECKPOINT: {len(dp_progress)}/{expected_total} total rows\")\n","\n","    # Re-read the on-disk progress for an independent completion check.\n","    dp_progress = load_checkpoint(DP_PROGRESS_PATH)\n","    dp_progress[\"seed\"] = pd.to_numeric(dp_progress[\"seed\"], errors=\"raise\").astype(int)\n","    dp_progress[\"target_epsilon\"] = pd.to_numeric(dp_progress[\"target_epsilon\"], errors=\"raise\")\n","    finite_private = dp_progress[np.isfinite(dp_progress[\"target_epsilon\"])]\n","    controls = dp_progress[np.isinf(dp_progress[\"target_epsilon\"])]\n","\n","    assert len(dp_progress) == expected_total, (\n","        f\"Expected {expected_total} corrected rows, found {len(dp_progress)}. \"\n","        \"Progress has been retained; rerun this cell to resume.\"\n","    )\n","    assert len(finite_private) == expected_private, (\n","        f\"Expected {expected_private} private rows, found {len(finite_private)}\"\n","    )\n","    assert len(controls) == expected_control, (\n","        f\"Expected {expected_control} matched non-private controls, found {len(controls)}\"\n","    )\n","    assert finite_private[\"max_client_achieved_epsilon\"].notna().all()\n","    assert (\n","        finite_private[\"max_client_achieved_epsilon\"].astype(float)\n","        <= finite_private[\"target_epsilon\"].astype(float) + 1e-3\n","    ).all(), \"At least one client accountant exceeded its target epsilon.\"\n","    assert finite_private[\"dp_protocol_version\"].eq(DP_PROTOCOL_VERSION).all()\n","    assert controls[\"dp_enabled\"].astype(str).str.lower().isin([\"false\", \"0\"]).all()\n","    assert controls[\"nonprivate_control_protocol\"].eq(\n","        \"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\"\n","    ).all()\n","\n","    dp_all = dp_progress.drop_duplicates(\n","        subset=[\"seed\", \"target_epsilon\", \"method\"], keep=\"last\"\n","    ).sort_values([\"target_epsilon\", \"method\", \"seed\"], na_position=\"last\")\n","    atomic_to_csv(dp_all, DP_FINAL_PATH)\n","    print(\"CORRECTED DP-v2 SWEEP COMPLETE:\", len(dp_all), \"rows ->\", DP_FINAL_PATH)\n","    print(\"Private rows:\", len(finite_private), \"| Matched controls:\", len(controls))\n","    print(\"RNG modes used by private runs:\", sorted(finite_private[\"dp_rng_mode\"].dropna().unique().tolist()))\n","    display(\n","        dp_all.groupby([\"target_epsilon\", \"method\"], dropna=False).agg(\n","            accuracy_mean=(\"accuracy\", \"mean\"),\n","            accuracy_std=(\"accuracy\", \"std\"),\n","            f1_mean=(\"f1\", \"mean\"),\n","            f1_std=(\"f1\", \"std\"),\n","            balanced_accuracy_mean=(\"balanced_accuracy\", \"mean\"),\n","            auroc_mean=(\"auroc\", \"mean\"),\n","            achieved_epsilon=(\"max_client_achieved_epsilon\", \"mean\"),\n","            n=(\"accuracy\", \"count\"),\n","        ).reset_index()\n","    )\n","else:\n","    print(\"RUN_FULL_DP=False; corrected DP-v2 sweep skipped.\")\n"]},{"cell_type":"markdown","id":"b558be68","metadata":{"papermill":{"duration":0.052565,"end_time":"2026-10-11T14:02:03.848493","exception":false,"start_time":"2026-10-11T14:02:03.795928","status":"completed"},"tags":[]},"source":["## 21. FGSM evaluation\n","\n","FGSM deliberately reuses the already-trained clean IID global models saved during the clean sweep. This removes the earlier redundant 60-model retraining step."]},{"cell_type":"code","execution_count":36,"id":"23808a00","metadata":{"execution":{"iopub.execute_input":"2026-10-11T14:02:03.94782