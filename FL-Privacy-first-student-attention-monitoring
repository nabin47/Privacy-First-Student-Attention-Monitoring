      continue\n\n        mean = np.mean(values)\n\n        std = np.std(\n            values,\n            ddof=1\n        )\n\n        sem = std / np.sqrt(n)\n\n        tcrit = t.ppf(\n            0.975,\n            df=n - 1\n        )\n\n        margin = tcrit * sem\n\n        if not isinstance(\n            keys,\n            tuple\n        ):\n            keys = (keys,)\n\n        row = dict(\n            zip(\n                group_cols,\n                keys\n            )\n        )\n\n        row.update({\n\n            \"metric\": metric,\n\n            \"n\": n,\n\n            \"mean\": mean,\n\n            \"std\": std,\n\n            \"ci95_low\":\n                mean - margin,\n\n            \"ci95_high\":\n                mean + margin,\n\n            \"ci95_half_width\":\n                margin\n        })\n\n        rows.append(row)\n\n    return pd.DataFrame(rows)\n\n\nsummary_tables = []\n\nfor metric in METRICS:\n\n    summary_tables.append(\n        summarize_metric(\n            clean_results,\n            [\n                \"condition\",\n                \"alpha\",\n                \"method\"\n            ],\n            metric\n        )\n    )\n\n\nmetric_summary = pd.concat(\n    summary_tables,\n    ignore_index=True\n)\n\n\naccuracy_summary = (\n    metric_summary[\n        metric_summary[\"metric\"]\n        == \"accuracy\"\n    ]\n    .copy()\n)\n\n\naccuracy_summary[\n    \"mean_percent\"\n] = (\n    accuracy_summary[\"mean\"] * 100\n)\n\naccuracy_summary[\n    \"std_percent\"\n] = (\n    accuracy_summary[\"std\"] * 100\n)\n\naccuracy_summary[\n    \"ci95_low_percent\"\n] = (\n    accuracy_summary[\"ci95_low\"] * 100\n)\n\naccuracy_summary[\n    \"ci95_high_percent\"\n] = (\n    accuracy_summary[\"ci95_high\"] * 100\n)\n\n\n# ------------------------------------------------------------\n# 3. Paired tests needed by 19G\n# ------------------------------------------------------------\n\nBASELINE = \"FedAvg\"\n\nCOMPARE_METHODS = [\n    \"FedProx\",\n    \"Median\",\n    \"TrimmedMean\",\n    \"CAFAD\"\n]\n\n\ndef bh_adjust(p_values):\n\n    p_values = np.asarray(\n        p_values,\n        dtype=float\n    )\n\n    n = len(p_values)\n\n    order = np.argsort(\n        p_values\n    )\n\n    ranked = p_values[order]\n\n    adjusted = (\n        ranked * n\n        /\n        np.arange(\n            1,\n            n + 1\n        )\n    )\n\n    adjusted = (\n        np.minimum.accumulate(\n            adjusted[::-1]\n        )[::-1]\n    )\n\n    output = np.empty_like(\n        adjusted\n    )\n\n    output[order] = np.minimum(\n        adjusted,\n        1.0\n    )\n\n    return output\n\n\ndef paired_comparison(\n    data,\n    metric\n):\n\n    rows = []\n\n    conditions = (\n        data[\n            [\n                \"condition\",\n                \"alpha\"\n            ]\n        ]\n        .drop_duplicates()\n        .to_dict(\n            \"records\"\n        )\n    )\n\n\n    for c in conditions:\n\n        condition = c[\"condition\"]\n\n        alpha = c[\"alpha\"]\n\n\n        subset = data[\n            (\n                data[\"condition\"]\n                == condition\n            )\n            &\n            (\n                (\n                    data[\"alpha\"].isna()\n                    &\n                    pd.isna(alpha)\n                )\n                |\n                (\n                    data[\"alpha\"]\n                    == alpha\n                )\n            )\n        ].copy()\n\n\n        pivot = subset.pivot(\n            index=\"seed\",\n            columns=\"method\",\n            values=metric\n        )\n\n\n        for method in COMPARE_METHODS:\n\n            if (\n                BASELINE not in pivot.columns\n                or method not in pivot.columns\n            ):\n                continue\n\n\n            pair = pivot[\n                [\n                    BASELINE,\n                    method\n                ]\n            ].dropna()\n\n\n            if len(pair) < 5:\n                continue\n\n\n            diff = (\n                pair[method]\n                -\n                pair[BASELINE]\n            ).to_numpy()\n\n\n            stat, p = wilcoxon(\n                diff,\n                zero_method=\"wilcox\",\n                alternative=\"two-sided\"\n            )\n\n\n            diff_std = np.std(\n                diff,\n                ddof=1\n            )\n\n\n            paired_d = (\n                np.mean(diff)\n                / diff_std\n                if diff_std > 0\n                else np.nan\n            )\n\n\n            rows.append({\n\n                \"condition\":\n                    condition,\n\n                \"alpha\":\n                    alpha,\n\n                \"metric\":\n                    metric,\n\n                \"baseline\":\n                    BASELINE,\n\n                \"method\":\n                    method,\n\n                \"n_pairs\":\n                    len(pair),\n\n                \"mean_difference\":\n                    np.mean(diff),\n\n                \"median_difference\":\n                    np.median(diff),\n\n                \"mean_difference_pp\":\n                    100 * np.mean(diff),\n\n                \"median_difference_pp\":\n                    100 * np.median(diff),\n\n                \"paired_effect_d\":\n                    paired_d,\n\n                \"wilcoxon_statistic\":\n                    stat,\n\n                \"p_value\":\n                    p\n\n            })\n\n\n    result = pd.DataFrame(rows)\n\n    if len(result):\n\n        result[\"p_bh\"] = bh_adjust(\n            result[\"p_value\"]\n        )\n\n    return result\n\n\naccuracy_tests = paired_comparison(\n    clean_results,\n    \"accuracy\"\n)\n\nf1_tests = paired_comparison(\n    clean_results,\n    \"f1\"\n)\n\n\n# ------------------------------------------------------------\n# 4. Define the clean methods used by publication figures\n# ------------------------------------------------------------\n\nMETHODS = [\n    \"FedAvg\",\n    \"FedProx\",\n    \"Median\",\n    \"TrimmedMean\",\n    \"CAFAD\"\n]\n\n\nDP_METHODS = [\n    \"FedAvg\",\n    \"Median\",\n    \"TrimmedMean\"\n]\n\n\nFGSM_METHODS = [\n    \"FedAvg\",\n    \"FedProx\",\n    \"CAFAD\"\n]\n\n\nprint(\n    \"\\nResume + Finalize bootstrap ready.\"\n)\n\nprint(\n    \"Clean summary rows:\",\n    len(metric_summary)\n)\n\nprint(\n    \"Accuracy test rows:\",\n    len(accuracy_tests)\n)\n\nprint(\n    \"F1 test rows:\",\n    len(f1_tests)\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"be451970-9bcf-4731-b054-15657b65b247","cell_type":"code","source":"# ============================================================\n# 19D-RESUME-A. FGSM helper\n# ============================================================\n\ndef prediction_diagnostics_from_state(\n    state,\n    X,\n    y\n):\n\n    model = MLP(\n        X.shape[1]\n    )\n\n    load_state_dict_cpu(\n        model,\n        state\n    )\n\n    model.eval()\n\n    with torch.no_grad():\n\n        xt = torch.tensor(\n            X,\n            dtype=torch.float32\n        )\n\n        logits = model(\n            xt\n        )\n\n        prob = (\n            torch.softmax(\n                logits,\n                dim=1\n            )[:, 1]\n            .cpu()\n            .numpy()\n        )\n\n        pred = (\n            logits\n            .argmax(1)\n            .cpu()\n            .numpy()\n        )\n\n\n    return {\n        \"accuracy\":\n            accuracy_score(\n                y,\n                pred\n            ),\n\n        \"balanced_accuracy\":\n            balanced_accuracy_score(\n                y,\n                pred\n            ),\n\n        \"f1\":\n            f1_score(\n                y,\n                pred,\n                zero_division=0\n            ),\n\n        \"precision\":\n            precision_score(\n                y,\n                pred,\n                zero_division=0\n            ),\n\n        \"recall\":\n            recall_score(\n                y,\n                pred,\n                zero_division=0\n            ),\n\n        \"mcc\":\n            matthews_corrcoef(\n                y,\n                pred\n            ),\n\n        \"auroc\":\n            roc_auc_score(\n                y,\n                prob\n            ),\n\n        \"pred_class1_rate\":\n            float(\n                np.mean(\n                    pred == 1\n                )\n            )\n    }\n\n\nprint(\n    \"FGSM helper ready.\"\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"70202bae-dfec-41fe-8b7f-2c4f40cdbd98","cell_type":"code","source":"# ============================================================\n# 19D-2. RESUMABLE FULL DP PRIVACY–UTILITY SWEEP\n# ============================================================\n\nRUN_FULL_DP = False\n\nDP_SEEDS = list(range(20))\n\nDP_EPSILONS = [\n    0.5,\n    1.0,\n    2.0,\n    5.0\n]\n\nDP_METHODS = [\n    \"FedAvg\",\n    \"Median\",\n    \"TrimmedMean\"\n]\n\nDP_PROGRESS_PATH = (\n    RESULTS_DIR / \"dp_privacy_utility_progress_v3.csv\"\n)\n\nDP_FINAL_PATH = (\n    RESULTS_DIR / \"dp_privacy_utility_v3.csv\"\n)\n\n\nif RUN_FULL_DP:\n\n    # --------------------------------------------------------\n    # Load previous progress\n    # --------------------------------------------------------\n\n    if DP_PROGRESS_PATH.exists():\n\n        dp_progress = pd.read_csv(\n            DP_PROGRESS_PATH\n        )\n\n        print(\n            \"Loaded existing DP progress:\",\n            len(dp_progress),\n            \"completed runs\"\n        )\n\n    else:\n\n        dp_progress = pd.DataFrame()\n\n        print(\n            \"No previous DP checkpoint found.\"\n        )\n\n\n    # --------------------------------------------------------\n    # Normalize / remove accidental duplicates\n    # --------------------------------------------------------\n\n    if len(dp_progress):\n\n        dp_progress = (\n            dp_progress\n            .drop_duplicates(\n                subset=[\n                    \"seed\",\n                    \"target_epsilon\",\n                    \"method\"\n                ],\n                keep=\"last\"\n            )\n            .reset_index(drop=True)\n        )\n\n\n    # --------------------------------------------------------\n    # Resume private DP experiments\n    # --------------------------------------------------------\n\n    for seed in DP_SEEDS:\n\n        print(\n            f\"\\n========== DP SEED {seed} ==========\"\n        )\n\n        parts = balanced_iid_partition(\n            y_train,\n            N_CLIENTS,\n            seed\n        )\n\n        for eps in DP_EPSILONS:\n\n            for method in DP_METHODS:\n\n                # --------------------------------------------\n                # Check whether this exact run already exists\n                # --------------------------------------------\n\n                already_done = False\n\n                if len(dp_progress):\n\n                    already_done = (\n                        (\n                            dp_progress[\"seed\"]\n                            == seed\n                        )\n                        &\n                        (\n                            dp_progress[\n                                \"target_epsilon\"\n                            ].astype(float)\n                            == float(eps)\n                        )\n                        &\n                        (\n                            dp_progress[\"method\"]\n                            == method\n                        )\n                    ).any()\n\n\n                if already_done:\n\n                    print(\n                        f\"SKIP | seed={seed} | \"\n                        f\"eps={eps} | method={method}\"\n                    )\n\n                    continue\n\n\n                # --------------------------------------------\n                # Run missing experiment\n                # --------------------------------------------\n\n                print(\n                    f\"RUN  | seed={seed} | \"\n                    f\"eps={eps} | method={method}\"\n                )\n\n                result = run_federated_dp(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    method,\n                    seed,\n                    rounds=CFG[\"fl_rounds\"],\n                    local_epochs=CFG[\"local_epochs\"],\n                    batch_size=CFG[\"batch_size\"],\n                    target_epsilon=eps\n                )\n\n\n                # --------------------------------------------\n                # Immediately checkpoint this run\n                # --------------------------------------------\n\n                new_row = pd.DataFrame([result])\n\n                dp_progress = pd.concat(\n                    [\n                        dp_progress,\n                        new_row\n                    ],\n                    ignore_index=True\n                )\n\n                dp_progress = (\n                    dp_progress\n                    .drop_duplicates(\n                        subset=[\n                            \"seed\",\n                            \"target_epsilon\",\n                            \"method\"\n                        ],\n                        keep=\"last\"\n                    )\n                    .sort_values(\n                        [\n                            \"seed\",\n                            \"target_epsilon\",\n                            \"method\"\n                        ]\n                    )\n                    .reset_index(drop=True)\n                )\n\n                dp_progress.to_csv(\n                    DP_PROGRESS_PATH,\n                    index=False\n                )\n\n                print(\n                    f\"CHECKPOINT SAVED | \"\n                    f\"{len(dp_progress)}/240 runs\"\n                )\n\n\n    # --------------------------------------------------------\n    # Build non-private reference from EXISTING clean FL data\n    # --------------------------------------------------------\n    #\n    # IMPORTANT:\n    # We do NOT train another 60 models here.\n    #\n    # The existing clean FL sweep already contains:\n    #   20 seeds × IID × 3 required methods\n    #\n    # Those are our epsilon = infinity references.\n    # --------------------------------------------------------\n\n    if \"clean_results\" not in globals():\n\n        clean_results = pd.read_csv(\n            RESULTS_DIR /\n            \"clean_fl_sweep_v3.csv\"\n        )\n\n\n    nonprivate_results = (\n        clean_results[\n            (clean_results[\"condition\"] == \"IID\")\n            &\n            (\n                clean_results[\"method\"]\n                .isin(DP_METHODS)\n            )\n        ]\n        .copy()\n    )\n\n\n    nonprivate_results[\"target_epsilon\"] = np.inf\n\n    nonprivate_results[\n        \"max_client_achieved_epsilon\"\n    ] = np.nan\n\n    nonprivate_results[\n        \"mean_client_sigma\"\n    ] = np.nan\n\n\n    # --------------------------------------------------------\n    # Combine private + non-private results\n    # --------------------------------------------------------\n\n    dp_all = pd.concat(\n        [\n            dp_progress,\n            nonprivate_results\n        ],\n        ignore_index=True,\n        sort=False\n    )\n\n\n    # --------------------------------------------------------\n    # Remove duplicates\n    # --------------------------------------------------------\n\n    dp_all = (\n        dp_all\n        .drop_duplicates(\n            subset=[\n                \"seed\",\n                \"target_epsilon\",\n                \"method\"\n            ],\n            keep=\"last\"\n        )\n        .sort_values(\n            [\n                \"target_epsilon\",\n                \"method\",\n                \"seed\"\n            ],\n            na_position=\"last\"\n        )\n        .reset_index(drop=True)\n    )\n\n\n    # --------------------------------------------------------\n    # Save final DP dataset\n    # --------------------------------------------------------\n\n    dp_all.to_csv(\n        DP_FINAL_PATH,\n        index=False\n    )\n\n\n    print(\"\\n============================================\")\n    print(\"DP SWEEP COMPLETE\")\n    print(\"============================================\")\n    print(\n        \"Private runs:\",\n        len(dp_progress),\n        \"/ 240\"\n    )\n\n    print(\n        \"Final result rows:\",\n        len(dp_all)\n    )\n\n    print(\n        \"Saved:\",\n        DP_FINAL_PATH\n    )\n\n\n    # --------------------------------------------------------\n    # Summary\n    # --------------------------------------------------------\n\n    display(\n        dp_all.groupby(\n            [\n                \"target_epsilon\",\n                \"method\"\n            ],\n            dropna=False\n        )\n        .agg(\n            accuracy_mean=(\n                \"accuracy\",\n                \"mean\"\n            ),\n            accuracy_std=(\n                \"accuracy\",\n                \"std\"\n            ),\n            f1_mean=(\n                \"f1\",\n                \"mean\"\n            ),\n            f1_std=(\n                \"f1\",\n                \"std\"\n            ),\n            balanced_accuracy_mean=(\n                \"balanced_accuracy\",\n                \"mean\"\n            ),\n            auroc_mean=(\n                \"auroc\",\n                \"mean\"\n            ),\n            achieved_epsilon=(\n                \"max_client_achieved_epsilon\",\n                \"mean\"\n 