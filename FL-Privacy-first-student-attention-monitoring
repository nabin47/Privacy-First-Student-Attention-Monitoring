e\n","rob = pd.read_csv(ROBUST_FINAL_PATH)\n","fig,ax=plt.subplots(figsize=(10,5))\n","order=rob.groupby(\"scenario\")[\"accuracy\"].mean().sort_values(ascending=False).index.tolist()\n","for method in ROBUST_METHODS:\n","    g=rob[rob[\"method\"]==method].groupby(\"scenario\")[\"accuracy\"].agg([\"mean\",\"std\"]).reindex(order)\n","    ax.errorbar(np.arange(len(order)),g[\"mean\"]*100,yerr=g[\"std\"]*100,marker=\"o\",capsize=4,label=method)\n","ax.set_xticks(np.arange(len(order))); ax.set_xticklabels(order,rotation=20,ha=\"right\"); ax.set_ylabel(\"Accuracy (%)\"); ax.set_title(\"Corrected client unreliability: full label-flip poisoning and straggler\"); ax.grid(True,alpha=.25); ax.legend(fontsize=8); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_client_robustness_corrected.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","\n","# Blocked sensitivity\n","blk=pd.read_csv(BLOCKED_FINAL)\n","fig,ax=plt.subplots(figsize=(8,5))\n","for model_name in blk[\"model\"].unique():\n","    s=blk[blk[\"model\"]==model_name].sort_values(\"block\")\n","    ax.plot(s[\"block\"],s[\"accuracy\"]*100,marker=\"o\",label=model_name)\n","ax.set_xlabel(\"Contiguous held-out block\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Blocked-split sensitivity\"); ax.grid(True,alpha=.25); ax.legend(); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_blocked_split_sensitivity.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","\n","# DP privacy-utility\n","DP_ALL=pd.read_csv(DP_FINAL_PATH)\n","fig,ax=plt.subplots(figsize=(8,5))\n","for method in DP_METHODS:\n","    g=DP_ALL[DP_ALL[\"method\"]==method].groupby(\"target_epsilon\")[\"accuracy\"].agg([\"mean\",\"std\"]).reset_index().sort_values(\"target_epsilon\")\n","    finite=g[np.isfinite(g[\"target_epsilon\"])]; inf=g[~np.isfinite(g[\"target_epsilon\"])]\n","    if not finite.empty: ax.errorbar(finite[\"target_epsilon\"],finite[\"mean\"]*100,yerr=finite[\"std\"]*100,marker=\"o\",capsize=4,label=method)\n","    if not inf.empty: ax.axhline(inf[\"mean\"].iloc[0]*100,linestyle=\"--\",label=f\"{method} non-private\")\n","ax.set_xscale(\"log\"); ax.invert_xaxis(); ax.set_xlabel(\"Record-level ε (target budget)\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Privacy–utility trade-off\"); ax.grid(True,alpha=.25); ax.legend(fontsize=7); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_privacy_utility_corrected_v2.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","\n","# FGSM degradation\n","fg=pd.read_csv(FGSM_FINAL_PATH)\n","fig,ax=plt.subplots(figsize=(8,5))\n","for method in FGSM_METHODS:\n","    g=fg[fg[\"method\"]==method].groupby(\"attack_epsilon\")[\"accuracy_drop\"].agg([\"mean\",\"std\"]).reset_index()\n","    ax.errorbar(g[\"attack_epsilon\"],g[\"mean\"]*100,yerr=g[\"std\"]*100,marker=\"o\",capsize=4,label=method)\n","ax.set_xlabel(\"FGSM ε in encoded feature space\"); ax.set_ylabel(\"Accuracy drop (percentage points)\"); ax.set_title(\"Evaluation-time adversarial degradation\"); ax.grid(True,alpha=.25); ax.legend(); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_FGSM_degradation.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","\n","# Client-count sensitivity (K=10 points are reused from the main clean sweep; K=5/20 are newly trained).\n","if CLIENT_SENS_FINAL.exists():\n","    sens = pd.read_csv(CLIENT_SENS_FINAL)\n","    from scipy.stats import t as student_t\n","    fig, axes = plt.subplots(1, 3, figsize=(14, 4.5), sharey=True)\n","    sens_conditions = [(\"IID\", None, \"IID\"), (\"Dirichlet\", 0.5, \"Dirichlet α=0.5\"), (\"Dirichlet\", 0.1, \"Dirichlet α=0.1\")]\n","    for ax, (condition, alpha, title) in zip(axes, sens_conditions):\n","        m = sens[\"condition\"].eq(condition)\n","        if alpha is None:\n","            m &= sens[\"alpha\"].isna()\n","        else:\n","            m &= np.isclose(pd.to_numeric(sens[\"alpha\"], errors=\"coerce\").fillna(-999), float(alpha))\n","        subset = sens.loc[m]\n","        for method in [\"FedAvg\", \"CAFAD\"]:\n","            stats = subset[subset[\"method\"].eq(method)].groupby(\"n_clients\")[\"accuracy\"].agg([\"mean\", \"std\", \"count\"]).reset_index().sort_values(\"n_clients\")\n","            if stats.empty:\n","                continue\n","            sem = stats[\"std\"] / np.sqrt(stats[\"count\"])\n","            critical = [student_t.ppf(0.975, max(int(n)-1, 1)) for n in stats[\"count\"]]\n","            ci = sem.to_numpy() * np.asarray(critical)\n","            ax.errorbar(stats[\"n_clients\"], stats[\"mean\"]*100, yerr=ci*100, marker=\"o\", capsize=4, label=method)\n","        ax.set_title(title); ax.set_xlabel(\"Number of simulated clients K\"); ax.set_xticks([5, 10, 20]); ax.grid(True, alpha=.25)\n","    axes[0].set_ylabel(\"Test accuracy (%)\")\n","    axes[-1].legend(fontsize=8)\n","    fig.suptitle(\"Client-count sensitivity: mean accuracy with 95% confidence intervals\", y=1.02)\n","    fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_client_count_sensitivity_K5_K10_K20.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","else:\n","    print(\"Client-count sensitivity figure skipped: run Cell 19B first; expected file:\", CLIENT_SENS_FINAL)\n"]},{"cell_type":"code","execution_count":46,"id":"77158813","metadata":{"execution":{"iopub.execute_input":"2026-11-07T17:13:30.677557Z","iopub.status.busy":"2026-11-07T17:13:30.677191Z","iopub.status.idle":"2026-11-07T17:13:32.476861Z","shell.execute_reply":"2026-11-07T17:13:32.475364Z"},"papermill":{"duration":1.894577,"end_time":"2026-11-07T17:13:32.478814","exception":false,"start_time":"2026-11-07T17:13:30.584237","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{\n","  \"clean_rows\": 600,\n","  \"robustness_rows_corrected\": 300,\n","  \"robustness_protocol\": \"20% and 40% of clients with fully flipped local training labels; one straggler\",\n","  \"blocked_rows\": 10,\n","  \"dp_private_rows\": 240,\n","  \"dp_nonprivate_rows\": 60,\n","  \"dp_protocol_version\": \"v2_poisson_expected_batch_sum_noise_matched_control\",\n","  \"dp_rng_modes\": [\n","    \"os.urandom + Box-Muller (OS-CSPRNG-backed)\"\n","  ],\n","  \"dp_csprng_used_for_all_private_runs\": true,\n","  \"fgsm_rows\": 180,\n","  \"n_clients_primary\": 10,\n","  \"client_count_sensitivity_rows\": 120,\n","  \"client_count_sensitivity_protocol\": \"IID and Dirichlet alpha=0.5 only; alpha=0.1 excluded due to repaired K=20 partitions\",\n","  \"client_count_values\": [\n","    5,\n","    10,\n","    20\n","  ],\n","  \"device_available_at_finalization\": \"cpu\",\n","  \"results_dir\": \"/kaggle/working/attention_fl_v3_q1_10client_lrtuned_results\"\n","}\n","\n","CORRECTED ROBUSTNESS, CLIENT-COUNT SENSITIVITY, FIGURES, AND TABLES EXPORTED.\n"]}],"source":["# 24C. Manuscript-ready tables, paired tests, and final completeness checks\n","# Pin all manuscript inputs to the corrected protocol's result paths.\n","RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n","CLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\n","ROBUST_FINAL_PATH = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n","BLOCKED_FINAL = RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\"\n","DP_FINAL_PATH = RESULTS_DIR / \"dp_privacy_utility_corrected_v2.csv\"\n","FGSM_FINAL_PATH = RESULTS_DIR / \"fgsm_full_v3.csv\"\n","CLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_valid_v2.csv\"\n","\n","ROBUST_METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","ROBUST_SEEDS = list(range(20))\n","ROBUST_SCENARIOS = [\n","    (\"full_label_flip_20pct_clients\", [0, 1], 1.0, []),\n","    (\"full_label_flip_40pct_clients\", [0, 1, 2, 3], 1.0, []),\n","    (\"one_straggler_10pct_clients\", [], 0.0, [0]),\n","]\n","\n","clean_results = pd.read_csv(CLEAN_FINAL_PATH)\n","rob = pd.read_csv(ROBUST_FINAL_PATH)\n","blk = pd.read_csv(BLOCKED_FINAL)\n","dp = pd.read_csv(DP_FINAL_PATH)\n","fg = pd.read_csv(FGSM_FINAL_PATH)\n","client_sens = pd.read_csv(CLIENT_SENS_FINAL) if CLIENT_SENS_FINAL.exists() else None\n","\n","expected_clean = len(CFG[\"seeds\"]) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\n","expected_robust = len(ROBUST_SEEDS) * len(ROBUST_SCENARIOS) * len(ROBUST_METHODS)\n","assert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n","assert len(rob) == expected_robust, f\"Expected {expected_robust} corrected robustness rows, found {len(rob)}\"\n","assert len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 240\n","assert len(dp[~np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 60\n","assert \"dp_protocol_version\" in dp.columns and dp[\"dp_protocol_version\"].eq(\"v2_poisson_expected_batch_sum_noise_matched_control\").all(), \"DP file is not the corrected v2 protocol.\"\n","dp_eps_col = pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")\n","dp_private_rows = dp[np.isfinite(dp_eps_col)]\n","assert dp_private_rows[\"max_client_achieved_epsilon\"].notna().all()\n","assert (dp_private_rows[\"max_client_achieved_epsilon\"].astype(float) <= dp_private_rows[\"target_epsilon\"].astype(float) + 1e-3).all(), \"DP accountant exceeds target epsilon.\"\n","assert dp_private_rows[\"dp_enabled\"].astype(str).str.lower().isin([\"true\", \"1\"]).all()\n","dp_control_rows = dp[~np.isfinite(dp_eps_col)]\n","assert dp_control_rows[\"nonprivate_control_protocol\"].eq(\"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\").all(), \"Non-private controls are not matched controls.\"\n","assert len(fg) == 180\n","assert len(blk) == 10\n","assert client_sens is not None, f\"Run Cell 19B first; missing {CLIENT_SENS_FINAL}\"\n","assert len(client_sens) == 120, f\"Expected 120 valid K=5/10/20 sensitivity rows, found {len(client_sens)}\"\n","assert set(pd.to_numeric(client_sens[\"n_clients\"], errors=\"raise\").astype(int).unique()) == {5, 10, 20}\n","assert set(client_sens[\"condition\"].unique()) == {\"IID\", \"Dirichlet\"}\n","assert set(pd.to_numeric(client_sens.loc[client_sens[\"condition\"] == \"Dirichlet\", \"alpha\"], errors=\"raise\").unique()) == {0.5}\n","assert not client_sens.duplicated([\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"]).any()\n","\n","# Save core raw data products.\n","metric_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_clean_benchmark_table.csv\", index=False)\n","accuracy_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_accuracy_tests.csv\", index=False)\n","f1_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_f1_tests.csv\", index=False)\n","rob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_results_corrected.csv\", index=False)\n","blk.to_csv(RESULTS_DIR / \"MANUSCRIPT_blocked_sensitivity.csv\", index=False)\n","dp.to_csv(RESULTS_DIR / \"MANUSCRIPT_DP_results_corrected_v2.csv\", index=False)\n","fg.to_csv(RESULTS_DIR / \"MANUSCRIPT_FGSM_results.csv\", index=False)\n","client_sens.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_raw.csv\", index=False)\n","\n","# Robustness summary table: mean/SD and 95% CI for accuracy, F1, MCC by scenario and method.\n","robust_summary = pd.concat([\n","    summarize_metric(rob, [\"scenario\", \"method\"], metric)\n","    for metric in [\"accuracy\", \"f1\", \"mcc\"]\n","], ignore_index=True)\n","robust_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_corrected.csv\", index=False)\n","\n","# Client-count summary table: mean/SD/95% CI for accuracy, F1 and balanced accuracy.\n","client_sens_summary = pd.concat([\n","    summarize_metric(client_sens, [\"n_clients\", \"condition\", \"alpha\", \"method\"], metric)\n","    for metric in [\"accuracy\", \"f1\", \"balanced_accuracy\"]\n","], ignore_index=True)\n","client_sens_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_summary.csv\", index=False)\n","\n","# Paired Wilcoxon tests; BH correction is applied over all tests within each family.\n","def _bh_qvalues(p_values):\n","    p = np.asarray(p_values, dtype=float)\n","    q = np.full(p.shape, np.nan, dtype=float)\n","    finite = np.isfinite(p)\n","    pv = p[finite]\n","    if pv.size == 0:\n","        return q\n","    order = np.argsort(pv)\n","    ranked = pv[order]\n","    adjusted = ranked * len(ranked) / np.arange(1, len(ranked) + 1)\n","    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1]\n","    unorder = np.empty_like(adjusted)\n","    unorder[order] = np.clip(adjusted, 0, 1)\n","    q[finite] = unorder\n","    return q\n","\n","def _paired_method_tests(frame, group_cols, methods_to_compare, metrics, method_col=\"method\"):\n","    rows = []\n","    for group_key, group in frame.groupby(group_cols, dropna=False):\n","        if not isinstance(group_key, tuple):\n","            group_key = (group_key,)\n","        group_values = dict(zip(group_cols, group_key))\n","        base = group[group[method_col].eq(\"FedAvg\")].set_index(\"seed\")\n","        for method in methods_to_compare:\n","            current = group[group[method_col].eq(method)].set_index(\"seed\")\n","            common = sorted(set(base.index).intersection(current.index))\n","            for metric in metrics:\n","                if len(common) < 2:\n","                    continue\n","                a = base.loc[common, metric].astype(float).to_numpy()\n","                b = current.loc[common, metric].astype(float).to_numpy()\n","                diff = b - a\n","                p = 1.0 if np.allclose(diff, 0) else float(wilcoxon(a, b, zero_method=\"wilcox\").pvalue)\n","                rows.append({\n","                    **group_values, \"method_a\": \"FedAvg\", \"method_b\": method,\n","                    \"metric\": metric, \"n_pairs\": len(common),\n","                    \"mean_diff_method_b_minus_fedavg\": float(np.mean(diff)),\n","                    \"median_diff_method_b_minus_fedavg\": float(np.median(diff)),\n","                    \"wilcoxon_p\": p,\n","                })\n","    out = pd.DataFrame(rows)\n","    if not out.empty:\n","        out[\"bh_q\"] = _bh_qvalues(out[\"wilcoxon_p\"].to_numpy())\n","        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n","    return out\n","\n","robustness_tests = _paired_method_tests(\n","    rob, [\"scenario\"], [m for m in ROBUST_METHODS if m != \"FedAvg\"], [\"accuracy\", \"f1\"]\n",")\n","robustness_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_paired_tests_BH.csv\", index=False)\n","\n","client_sensitivity_tests = _paired_method_tests(\n","    client_sens, [\"n_clients\", \"condition\", \"alpha\"], [\"CAFAD\"], [\"accuracy\", \"f1\"]\n",")\n","client_sensitivity_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_paired_tests_BH.csv\", index=False)\n","\n","compact_rob = rob.groupby([\"scenario\", \"method\"])[[\"accuracy\", \"f1\", \"mcc\"]].agg([\"mean\", \"std\"]).reset_index()\n","compact_rob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_compact_corrected.csv\", index=False)\n","\n","# Final completeness manifest. Resolve device from the active runtime instead of a stale None value.\n","active_device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","dp_rng_is_csprng = dp.loc[\n","    np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")), \"dp_rng_mode\"\n","].astype(str).str.contains(\"CSPRNG\").all()\n","if not dp_rng_is_csprng:\n","    print(\n","        \"DP METHODOLOGY WARNING: at least one private run used a non-cryptographic \"\n","        \"PyTorch PRNG fallback. Do not present this as a strict practical DP certificate; \"\n","        \"rerun the corrected DP grid with a supported CSPRNG before making a formal privacy claim.\"\n","    )\n","final_manifest = {\n","    \"clean_rows\": int(len(clean_results)),\n","    \"robustness_rows_corrected\": int(len(rob)),\n","    \"robustness_protocol\": \"20% and 40% of clients with fully flipped local training labels; one straggler\",\n","    \"blocked_rows\": int(len(blk)),\n","    \"dp_private_rows\": int(len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))])),\n","    \"dp_nonprivate_rows\": int(len(dp[~np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))])),\n","    \"dp_protocol_version\": str(dp[\"dp_protocol_version\"].iloc[0]),\n","    \"dp_rng_modes\": sorted(dp.loc[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")), \"dp_rng_mode\"].dropna().unique().tolist()),\n","    \"dp_csprng_used_for_all_private_runs\": bool(dp.loc[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")), \"dp_rng_mode\"].astype(str).str.contains(\"CSPRNG\").all()),\n","    \"fgsm_rows\": int(len(fg)),\n","    \"n_clients_primary\": 10,\n","    \"client_count_sensitivity_rows\": int(len(client_sens)),\n","    \"client_count_sensitivity_protocol\": \"IID and Dirichlet alpha=0.5 only; alpha=0.1 excluded due to repaired K=20 partitions\",\n","    \"dp_protocol_version\": str(dp[\"dp_protocol_version\"].iloc[0]),\n","    \"client_count_values\": sorted(pd.to_numeric(client_sens[\"n_clients\"], errors=\"raise\").astype(int).unique().tolist()),\n","    \"device_available_at_finalization\": str(active_device),\n","    \"results_dir\": str(RESULTS_DIR),\n","}\n","atomic_to_csv(pd.DataFrame([final_manifest]), RESULTS_DIR / \"FINAL_COMPLETENESS_CHECK.csv\")\n","with open(RESULTS_DIR / \"FINAL_COMPLETENESS_CHECK.json\", \"w\", encoding=\"utf-8\") as f:\n","    json.dump(final_manifest, f, indent=2)\n","print(json.dumps(final_manifest, indent=2))\n","print(\"\\nCORRECTED ROBUSTNESS, CLIENT-COUNT SENSITIVITY, FIGURES, AND TABLES EXPORTED.\")\n"]},{"cell_type":"code","execution_count":47,"id":"589780b9","metadata":{"execution":{"iopub.execute_input":"2026-11-07T17:13:32.659818Z","iopub.status.busy":"2026-11-07T17:13:32.659417Z","iopub.status.idle":"2026-11-07T17:13:32.967767Z","shell.execute_reply":"2026-11-07T17:13:32.966733Z"},"papermill":{"duration":0.400772,"end_time":"2026-11-07T17:13:32.96973","exception":false,"start_time":"202