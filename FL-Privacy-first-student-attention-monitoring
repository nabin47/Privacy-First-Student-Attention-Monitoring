v_pred)\n    return {\"clean_accuracy\":clean_acc,\"adv_accuracy\":adv_acc,\n            \"accuracy_drop\":clean_acc-adv_acc,\"epsilon\":epsilon}\n\niid_parts=balanced_iid_partition(y_train,N_CLIENTS,0)\n_,_,pilot_state=run_federated(\n    X_train,y_train,X_test,y_test,iid_parts,\"FedAvg\",0,2,1,64\n)\ndisplay(pd.DataFrame([fgsm_metrics(pilot_state,X_test,y_test,0.01)]))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:41.689476Z","iopub.execute_input":"2026-10-04T10:11:41.689808Z","iopub.status.idle":"2026-10-04T10:11:42.04389Z","shell.execute_reply.started":"2026-10-04T10:11:41.689784Z","shell.execute_reply":"2026-10-04T10:11:42.043074Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"   clean_accuracy  adv_accuracy  accuracy_drop  epsilon\n0        0.698159      0.658127       0.040032     0.01","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>clean_accuracy</th>\n      <th>adv_accuracy</th>\n      <th>accuracy_drop</th>\n      <th>epsilon</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0.698159</td>\n      <td>0.658127</td>\n      <td>0.040032</td>\n      <td>0.01</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":26},{"id":"62702687","cell_type":"markdown","source":"\n## 16. Statistics and manuscript outputs\n\nUse matched seed-level comparisons.\n\nRecommended reporting:\n\n- mean/median paired difference,\n- confidence interval,\n- Wilcoxon signed-rank test,\n- Benjamini–Hochberg correction,\n- effect size,\n- not p-values alone.\n","metadata":{}},{"id":"68fa11a4","cell_type":"code","source":"\n# 16A. BH correction + paired test helper\ndef bh_adjust(pvals):\n    pvals=np.asarray(pvals,float); n=len(pvals)\n    order=np.argsort(pvals); ranked=pvals[order]\n    q=ranked*n/np.arange(1,n+1)\n    q=np.minimum.accumulate(q[::-1])[::-1]\n    out=np.empty_like(q); out[order]=q\n    return np.minimum(out,1.0)\n\ndef paired_method_test(results,method_a,method_b,metric=\"accuracy\"):\n    a=results[results[\"method\"]==method_a].sort_values(\"seed\")[metric].to_numpy()\n    b=results[results[\"method\"]==method_b].sort_values(\"seed\")[metric].to_numpy()\n    if len(a)!=len(b) or len(a)<5: raise ValueError(\"Need at least 5 matched seeds.\")\n    stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n    return {\"method_a\":method_a,\"method_b\":method_b,\"metric\":metric,\n            \"mean_diff\":float(np.mean(a-b)),\"median_diff\":float(np.median(a-b)),\n            \"wilcoxon_p\":float(p)}\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:42.045063Z","iopub.execute_input":"2026-10-04T10:11:42.045402Z","iopub.status.idle":"2026-10-04T10:11:42.053437Z","shell.execute_reply.started":"2026-10-04T10:11:42.045376Z","shell.execute_reply":"2026-10-04T10:11:42.052635Z"},"trusted":true},"outputs":[],"execution_count":27},{"id":"c07518fc","cell_type":"markdown","source":"\n## 17. Recommended paper figures/tables\n\n**Figure 1 — V3 benchmark audit:** label distribution, missingness, duplicate/conflicting-label count, shallow-tree reconstruction by feature group.\n\n**Figure 2 — Client heterogeneity:** IID vs Dirichlet α and feature-cluster skew.\n\n**Figure 3 — FL clean performance:** method × heterogeneity, mean ± confidence interval.\n\n**Figure 4 — Client unreliability:** poisoning and straggler effects relative to FedAvg.\n\n**Figure 5 — Privacy–utility:** achieved record-level ε vs accuracy/F1 for FedAvg, Median, TrimmedMean.\n\n**Figure 6 — FGSM:** clean-to-attacked degradation.\n\n**Tables:** full metrics, feature dependence, statistical tests, and privacy-accounting details.\n","metadata":{}},{"id":"3b8cc861","cell_type":"code","source":"\n# 18. Machine-readable run manifest\nmanifest={\n    \"dataset\":\"Students Attention Detection Dataset V3\",\n    \"data_path\":str(DATA_PATH),\n    \"n_rows\":int(len(df)),\n    \"n_features\":int(len(EXPECTED_FEATURES)),\n    \"n_clients\":N_CLIENTS,\n    \"run_mode\":RUN_MODE,\n    \"config\":CFG,\n    \"fl_methods\":METHODS,\n    \"dp_methods\":DP_METHODS,\n    \"dp_delta\":DP_DELTA,\n    \"dp_max_grad_norm\":DP_MAX_GRAD_NORM,\n    \"privacy_unit\":\"record/row-level\",\n    \"subject_ids_available\":False,\n    \"notes\":[\n        \"Clients are simulated partitions, not identified real students.\",\n        \"CAFAD validation confidence is not included in the formal DP comparison.\",\n        \"Feature-cluster skew is controlled heterogeneity, not claimed to reproduce real device populations.\"\n    ]\n}\nwith open(RESULTS_DIR/\"run_manifest_v3.json\",\"w\") as f: json.dump(manifest,f,indent=2)\nprint(json.dumps(manifest,indent=2))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:42.054329Z","iopub.execute_input":"2026-10-04T10:11:42.05456Z","iopub.status.idle":"2026-10-04T10:11:42.070246Z","shell.execute_reply.started":"2026-10-04T10:11:42.054505Z","shell.execute_reply":"2026-10-04T10:11:42.069388Z"},"trusted":true},"outputs":[{"name":"stdout","text":"{\n  \"dataset\": \"Students Attention Detection Dataset V3\",\n  \"data_path\": \"/kaggle/input/datasets/ahmednabin47/attention-detection-dataset-v3/attention_detection_dataset_v3.csv\",\n  \"n_rows\": 6244,\n  \"n_features\": 37,\n  \"n_clients\": 5,\n  \"run_mode\": \"PILOT\",\n  \"config\": {\n    \"fl_rounds\": 8,\n    \"local_epochs\": 2,\n    \"batch_size\": 64,\n    \"seeds\": [\n      0,\n      1,\n      2\n    ],\n    \"alphas\": [\n      10.0,\n      0.5\n    ],\n    \"poison_rates\": [\n      0.2,\n      0.4\n    ]\n  },\n  \"fl_methods\": [\n    \"FedAvg\",\n    \"FedProx\",\n    \"Median\",\n    \"TrimmedMean\",\n    \"CAFAD\"\n  ],\n  \"dp_methods\": [\n    \"FedAvg\",\n    \"Median\",\n    \"TrimmedMean\"\n  ],\n  \"dp_delta\": 1e-05,\n  \"dp_max_grad_norm\": 1.0,\n  \"privacy_unit\": \"record/row-level\",\n  \"subject_ids_available\": false,\n  \"notes\": [\n    \"Clients are simulated partitions, not identified real students.\",\n    \"CAFAD validation confidence is not included in the formal DP comparison.\",\n    \"Feature-cluster skew is controlled heterogeneity, not claimed to reproduce real device populations.\"\n  ]\n}\n","output_type":"stream"}],"execution_count":28},{"id":"a674b7d4","cell_type":"markdown","source":"\n# Final research protocol\n\nRun in this order:\n\n1. Dataset audit\n2. Benchmark-validity / feature-dependence audit\n3. Centralized baselines\n4. FL pilot\n5. Heterogeneity sweep\n6. Client unreliability sweep\n7. DP sweep\n8. FGSM\n9. Paired statistics + BH correction\n10. Figures/tables + saved CSVs\n\nThe paper should lead with the empirical fact that the released V3 feature representation already contains substantial information about the released operational attention label. The FL contribution then becomes a **controlled benchmark of privacy, heterogeneity and client unreliability**, rather than a claim that a new aggregator is universally superior.\n","metadata":{}}]}