:{},"output_type":"display_data"}],"source":["\n","# 6A. Shallow-tree reconstruction\n","def make_tree_pipeline(cols, max_depth=3):\n","    num = [c for c in cols if df[c].dtype != \"object\"]\n","    cat = [c for c in cols if df[c].dtype == \"object\"]\n","    try:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","    except TypeError:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","    pre = ColumnTransformer([\n","        (\"num\", SimpleImputer(strategy=\"median\"), num),\n","        (\"cat\", Pipeline([\n","            (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","            (\"onehot\", oh),\n","        ]), cat),\n","    ])\n","    return Pipeline([(\"pre\", pre),\n","                     (\"clf\", DecisionTreeClassifier(max_depth=max_depth, random_state=SEED))])\n","\n","skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n","audit_rows = []\n","\n","for gname, cols in V3_FEATURE_GROUPS.items():\n","    pipe = make_tree_pipeline(cols, max_depth=3)\n","    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n","    audit_rows.append({\"feature_set\": gname, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n","\n","key_cues = [\"gaze_on_screen\", \"head_pose\", \"hand_obj_interaction\", \"phone_present\"]\n","for name, cols in [(\"key_direct_cues\", key_cues), (\"all_features\", EXPECTED_FEATURES)]:\n","    pipe = make_tree_pipeline(cols, max_depth=3)\n","    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n","    audit_rows.append({\"feature_set\": name, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n","\n","audit_table = pd.DataFrame(audit_rows).sort_values(\"mean_accuracy\", ascending=False)\n","display(audit_table)\n","audit_table.to_csv(RESULTS_DIR / \"v3_feature_group_audit.csv\", index=False)\n"]},{"cell_type":"code","e