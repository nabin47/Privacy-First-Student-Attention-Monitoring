apture = io.StringIO()\n","                    with contextlib.redirect_stdout(_capture):\n","                        parts = dirichlet_label_partition(\n","                            y_train, n_clients, float(alpha), seed,\n","                            min_size=PARTITION_MIN_SIZE, max_tries=PARTITION_MAX_TRIES\n","                        )\n","                    if \"repaired best draw\" in _capture.getvalue().lower():\n","                        raise RuntimeError(\n","                            f\"Partition repair occurred for K={n_clients}, alpha={alpha}, seed={seed}. \"\n","                            \"Do not report this as an ordinary Dirichlet partition.\"\n","                        )\n","                for method in CLIENT_COUNT_SENSITIVITY_METHODS:\n","                    if not progress.empty:\n","                        done = (\n","                            (progress[\"n_clients\"].astype(int) == n_clients)\n","                            & (progress[\"seed\"].astype(int) == seed)\n","                            & (progress[\"condition\"] == condition)\n","                            & (progress[\"method\"] == method)\n","                            & (progress[\"alpha\"].isna() if alpha is None else\n","                               np.isclose(pd.to_numeric(progress[\"alpha\"], errors=\"coerce\"), float(alpha), equal_nan=False))\n","                        ).any()\n","                    else:\n","                        done = False\n","                    if done:\n","                        continue\n","                    result, _, _ = run_federated(\n","                        X_train, y_train, X_test, y_test, parts, method, seed,\n","                        CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"]\n","                    )\n","                    result.update({\n","                        \"n_clients\": int(n_clients), \"seed\": int(seed),\n","                        \"condition\": condition, \"alpha\": np.nan if