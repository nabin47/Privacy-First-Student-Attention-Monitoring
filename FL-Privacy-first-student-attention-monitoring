ent_lrtuned_results\"\n","}\n","\n","CORRECTED ROBUSTNESS, CLIENT-COUNT SENSITIVITY, FIGURES, AND TABLES EXPORTED.\n"]}],"source":["# 22C. Manuscript-ready tables, paired tests, and final completeness checks\n","# Pin all manuscript inputs to the corrected protocol's result paths.\n","RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n","CLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\n","ROBUST_FINAL_PATH = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n","BLOCKED_FINAL = RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\"\n","DP_FINAL_PATH = RESULTS_DIR / \"dp_privacy_utility_corrected_v2.csv\"\n","FGSM_FINAL_PATH = RESULTS_DIR / \"fgsm_full_v3.csv\"\n","CLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_valid_v2.csv\"\n","\n","ROBUST_METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","ROBUST_SEEDS = list(range(20))\n","ROBUST_SCENARIOS = [\n","    (\"full_label_flip_20pct_clients\", [0, 1], 1.0, []),\n","    (\"full_label_flip_40pct_clients\", [0, 1, 2, 3], 1.0, []),\n","    (\"one_straggler_10pct_clients\", [], 0.0, [0]),\n","]\n","\n","clean_results = pd.read_csv(CLEAN_FINAL_PATH)\n","rob = pd.read_csv(ROBUST_FINAL_PATH)\n","blk = pd.read_csv(BLOCKED_FINAL)\n","dp = pd.read_csv(DP_FINAL_PATH)\n","fg = pd.read_csv(FGSM_FINAL_PATH)\n","client_sens = pd.read_csv(CLIENT_SENS_FINAL) if CLIENT_SENS_FINAL.exists() else None\n","\n","expected_clean = len(CFG[\"seeds\"]) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\n","expected_robust = len(ROBUST_SEEDS) * len(ROBUST_SCENARIOS) * len(ROBUST_METHODS)\n","assert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n","assert len(rob) == expected_robust, f\"Expected {expected_robust} corrected robustness rows, found {len(rob)}\"\n","assert len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 240\n","assert len(dp[~np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 60\n","assert \"dp_protocol_version\" in dp.columns and dp[\"dp_protocol_version\"].eq(\"v2_poisson_expected_batch_sum_noise_matched_control\").all(), \"DP file is not the corrected v2 protocol.\"\n","dp_eps_col = pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")\n","dp_private_rows = dp[np.isfinite(dp_eps_col)]\n","assert dp_private_rows[\"max_client_achieved_epsilon\"].notna().all()\n","assert (dp_private_rows[\"max_client_achieved_epsilon\"].astype(float) <= dp_private_rows[\"target_epsilon\"].astype(float) + 1e-3).all(), \"DP accountant exceeds target epsilon.\"\n","assert dp_private_rows[\"dp_enabled\"].astype(str).str.lower().isin([\"true\", \"1\"]).all()\n","dp_control_rows = dp[~np.isfinite(dp_eps_col)]\n","assert dp_control_rows[\"nonprivate_control_protocol\"].eq(\"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\").all(), \"Non-private controls are not matched controls.\"\n","assert len(fg) == 180\n","assert len(blk) == 10\n","assert client_sens is not None, f\"Run Cell 19B first; missing {CLIENT_SENS_FINAL}\"\n","assert len(client_sens) == 120, f\"Expected 120 valid K=5/10/20 sensitivity rows, found {len(client_sens)}\"\n","assert set(pd.to_numeric(client_sens[\"n_clients\"], errors=\"raise\").astype(int).unique()) == {5, 10, 20}\n","assert set(client_sens[\"condition\"].unique()) == {\"IID\", \"Dirichlet\"}\n","assert set(pd.to_numeric(client_sens.loc[client_sens[\"condition\"] == \"Dirichlet\", \"alpha\"], errors=\"raise\").unique()) == {0.5}\n","assert not client_sens.duplicated([\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"]).any()\n","\n","# Save core raw data products.\n","metric_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_clean_benchmark_table.csv\", index=False)\n","accuracy_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_accuracy_tests.csv\", index=False)\n","f1_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_f1_tests.csv\", index=False)\n","rob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_results_corrected.csv\", index=False)\n","blk.to_csv(RESULTS_DIR / \"MANUSCRIPT_blocked_sensitivity.csv\", index=False)\n","dp.to_csv(RESULTS_DIR / \"MANUSCRIPT_DP_results_corrected_v2.csv\", index=False)\n","fg.to_csv(RESULTS_DIR / \"MANUSCRIPT_FGSM_results.csv\", index=False)\n","client_sens.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_raw.csv\", index=False)\n","\n","# Robustness summary table: mean/SD and 95% CI for accuracy, F1, MCC by scenario and method.\n","robust_summary = pd.concat([\n","    summarize_metric(rob, [\"scenario\", \"method\"], metric)\n","    for metric in [\"accuracy\", \"f1\", \"mcc\"]\n","], ignore_index=True)\n","robust_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_corrected.csv\", index=False)\n","\n","# Client-count summary table: mean/SD/95% CI for accuracy, F1 and balanced accuracy.\n","client_sens_summary = pd.concat([\n","    summarize_metric(client_sens, [\"n_clients\", \"condition\", \"alpha\", \"method\"], metric)\n","    for metric in [\"accuracy\", \"f1\", \"balanced_accuracy\"]\n","], ignore_index=True)\n","client_sens_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_summary.csv\", index=False)\n","\n","# Paired Wilcoxon tests; BH correction is applied over all tests within each family.\n","def _bh_qvalues(p_values):\n","    p = np.asarray(p_values, dtype=float)\n","    q = np.full(p.shape, np.nan, dtype=float)\n","    finite = np.isfinite(p)\n","    pv = p[finite]\n","    if pv.size == 0:\n","        return q\n","    order = np.argsort(pv)\n","    ranked = pv[order]\n","    adjusted = ranked * len(ranked) / np.arange(1, len(ranked) + 1)\n","    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1]\n","    unorder = np.empty_like(adjusted)\n","    unorder[order] = np.clip(adjusted, 0, 1)\n","    q[finite] = unorder\n","    return q\n","\n","def _paired_method_tests(frame, group_cols, methods_to_compare, metrics, method_col=\"method\"):\n","    rows = []\n","    for group_key, group in frame.groupby(group_cols, dropna=False):\n","        if not isinstance(group_key, tuple):\n","            group_key = (group_key,)\n","        group_values = dict(zip(group_cols, group_key))\n","        base = group[group[method_col].eq(\"FedAvg\")].set_index(\"seed\")\n","        for method in methods_to_compare:\n","            current = group[group[method_col].eq(method)].set_index(\"seed\")\n","            common = sorted(set(base.index).intersection(current.index))\n","            for metric in metrics:\n","                if len(common) < 2:\n","                    continue\n","                a = base.loc[common, metric].astype(float).to_numpy()\n","                b = current.loc[common, metric].astype(float).to_numpy()\n","                diff = b - a\n","                p = 1.0 if np.allclose(diff, 0) else float(wilcoxon(a, b, zero_method=\"wilcox\").pvalue)\n","                rows.append({\n","                    **group_values, \"method_a\": \"FedAvg\", \"method_b\": method,\n","                    \"metric\": metric, \"n_pairs\": len(common),\n","                    \"mean_diff_method_b_minus_fedavg\": float(np.mean(diff)),\n","                    \"median_diff_method_b_minus_fedavg\": float(np.median(diff)),\n","                    \"wilcoxon_p\": p,\n","                })\n","    out = pd.DataFrame(rows)\n","    if not out.empty:\n","        out[\"bh_q\"] = _bh_qvalues(out[\"wilcoxon_p\"].to_numpy())\n","        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n","    return out\n","\n","robustness_tests = _paired_method_tests(\n","    rob, [\"scenario\"], [m for m in ROBUST_METHODS if m != \"FedAvg\"], [\"accuracy\", \"f1\"]\n",")\n","robustness_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_paired_tests_BH.csv\", index=False)\n","\n","client_sensitivity_tests = _paired_method_tests(\n","    client_sens, [\"n_clients\", \"condition\", \"alpha\"], [\"CAFAD\"], [\"accuracy\", \"f1\"]\n",")\n","client_sensitivity_tests.to_csv(RESULTS_DI