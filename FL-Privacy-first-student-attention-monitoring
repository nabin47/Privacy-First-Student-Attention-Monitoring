,"    (\"TrimmedMean\", \"TrimmedMean\", {}), (\"Krum\", \"Krum\", {}),\n","    (\"MeanUnweighted\", \"MeanUnweighted\", {}),\n","    (\"CAFAD\", \"CAFAD\", {}),\n","    (\"CAFAD_flipped_val\", \"CAFAD\", {\"consistent_val\": True}),\n","    (\"CAFAD_reports_perfect\", \"CAFAD\", {\"reported_acc\": 1.0}),\n","]\n","\n","def pick_poisoned(parts, m, target):\n","    sizes = np.array([len(p) for p in parts], dtype=float)\n","    total = sizes.sum()\n","    subsets = [c for r in range(1, len(parts)) for c in itertools.combinations(range(len(parts)), r)]\n","    return list(min(subsets, key=lambda c: (round(abs(sizes[list(c)].sum() / total - target), 2),\n","                                            abs(len(c) - m), c)))\n","\n","r5 = load_checkpoint(R5_PATH); done = done_keys(r5)\n","for seed in CFG[\"seeds\"]:\n","    parts = partition_for(\"Dirichlet\", R3_ALPHA, seed)\n","    for scenario, m, target in R5_TARGETS:\n","        poisoned = pick_poisoned(parts, m, target)\n","        share = sum(len(parts[k]) for k in poisoned) / len(y_train)\n","        label1 = float(np.mean(np.concatenate([y_train[parts[k]] for k in poisoned])))\n","        for arm, method, flags in R5_ARMS:\n","            key = f\"{scenario}|{arm}|{seed}\"\n","            if key in done:\n","                continue\n","            with use_settings(lr=RULE_LR_A01[method], **flags):\n","                res, _, _ = run_federated(X_train, y_train, X_test, y_test, parts, method, seed,\n","                                          CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"],\n","                                          corrupt_clients=poisoned, corrupt_rate=1.0, straggler_clients=[])\n","            res.update({\"scenario\": scenario, \"arm\": arm, \"condition\": \"Dirichlet\", \"alpha\": R3_ALPHA,\n","                        \"lr\": float(RULE_LR_A01[method]), \"n_clients\": N_CLIENTS,\n","                        \"poisoned_clients\": \" \".join(map(str, poisoned)), \"poisoned_client_count\": len(poisoned),\n","                        \"target_share\": target, \"poisoned_record_share\": share,\n","                        \"poisoned_label1_rate\": label1, \"run_key\": key})\n","            r5 = record(R5_PATH, res); done.add(key)\n","    print(\"R5 seed done:\", seed)\n","\n","r5 = load_checkpoint(R5_PATH)\n","display(r5.drop_duplicates([\"scenario\", \"seed\"]).groupby(\"scenario\")[\"poisoned_record_share\"].describe().round(3))\n","display(mean_sd(r5, [\"scenario\", \"arm\"]).pivot(index=\"arm\", columns=\"scenario\", values=\"mean\"))"]},{"cell_type":"markdown","id":"f2e25443","metadata":{"papermill":{"duration":0.0132,"end_time":"2026-11-18T23:58:12.923798","exception":false,"start_time":"2026-11-18T23:58:12.910598","status":"completed"},"tags":[]},"source":["## R6. Record-level DP-SGD with the usual median"]},{"cell_type":"code","execution_count":24,"id":"a465d894","metadata":{"execution":{"iopub.execute_input":"2026-11-18T23:58:12.953534Z","iopub.status.busy":"2026-11-18T23:58:12.95217Z","iopub.status.idle":"2026-11-19T00:25:20.367458Z","shell.execute_reply":"2026-11-19T00:25:20.36644Z"},"papermill":{"duration":1627.445796,"end_time":"2026-11-19T00:25:20.382998","exception":false,"start_time":"2026-11-18T23:58:12.937202","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["R6A done: eps 0.5\n","R6A done: eps 1.0\n","R6A done: eps 2.0\n","R6A done: eps 5.0\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th>lr</th>\n","      <th>0.02</th>\n","      <th>0.05</th>\n","      <th>0.10</th>\n","      <th>0.20</th>\n","      <th>0.5