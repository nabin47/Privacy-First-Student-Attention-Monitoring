torch.cat([s[k].reshape(-1).float() for k in s]) for s in states])\n    d=torch.cdist(V,V,p=2)**2\n    scores=[]\n    for i in range(n):\n        others=torch.cat([d[i,:i],d[i,i+1:]])\n        scores.append(torch.topk(others,k=n-f-2,largest=False).values.sum().item())\n    chosen=np.argsort(scores)[:n-f-2]\n    chosen_states=[states[int(i)] for i in chosen]\n    return aggregate_fedavg(chosen_states,[1]*len(chosen_states))\n\ndef aggregate(method, states, ns, val_accs):\n    if method in (\"FedAvg\",\"FedProx\"): return aggregate_fedavg(states,ns),None,None\n    if method==\"Median\": return aggregate_median(states),None,None\n    if method==\"TrimmedMean\": return aggregate_trimmed_mean(states,TRIM_FRACTION),None,None\n    if method==\"Krum\": return aggregate_multikrum(states,KRUM_F),None,None\n    if method==\"CAFAD\":\n        st,w,mask=aggregate_cafad(states,ns,val_accs); return st,w,mask\n    raise ValueError(method)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-05T03:58:51.787388Z","iopub.execute_input":"2026-10-05T03:58:51.788424Z","iopub.status.idle":"2026-10-05T03:58:51.803616Z","shell.execute_reply.started":"2026-10-05T03:58:51.78839Z","shell.execute_reply":"2026-10-05T03:58:51.802626Z"},"trusted":true},"outputs":[],"execution_count":26},{"id":"f7cfcf6b","cell_type":"code","source":"\n# 11. Federated driver + pilot sanity check\nMETHODS=[\"FedAvg\",\"FedProx\",\"Median\",\"TrimmedMean\",\"CAFAD\"]\n\ndef run_federated(X,y,X_eval,y_eval,parts,method,seed,rounds,local_epochs,batch_size,\n                  corrupt_clients=None,corrupt_rate=0.0,straggler_clients=None):\n    seed_everything(seed)\n    global_state=clone_state_dict(MLP(X.shape[1]))\n    final_weights=None; final_mask=None; history=[]\n\n    for rnd in range(rounds):\n        states,val_accs,ns=train_clients_once(\n            global_state,parts,X,y,seed+rnd*1000,method,local_epochs,batch_size,\n            corrupt_clients=corrupt_clients,corrupt_rate=corrupt_rate,\n            straggler_clients=straggler_clients\n        )\n        global_state,weights,mask=aggregate(method,states,ns,val_accs)\n        final_weights,final_mask=weights,mask\n        history.append({\"round\":rnd+1,**evaluate_state(global_state,X_eval,y_eval),\n                        \"mean_client_val_acc\":float(np.mean(val_accs))})\n\n    result=evaluate_state(global_state,X_eval,y_eval)\n    result.update({\n        \"method\":method,\"seed\":seed,\n        \"final_cafad_weight_min\":float(np.min(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_weight_max\":float(np.max(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_masked_clients\":int((~final_mask).sum()) if final_mask is not None else np.nan\n    })\n    return result,pd.DataFrame(history),global_state\n\npilot_parts=balanced_iid_partition(y_train,N_CLIENTS,0)\npilot=[]\nfor method in METHODS:\n    r,_,st=run_federated(X_train,y_train,X_test,y_test,pilot_parts,method,0,2,1,64)\n    pilot.append(r)\ndisplay(pd.DataFrame(pilot))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-05T03:58:55.507044Z","iopub.execute_input":"2026-10-05T03:58:55.507631Z","iopub.status.idle":"2026-10-05T03:58:57.039864Z","shell.execute_reply.started":"2026-10-05T03:58:55.507588Z","shell.execute_reply":"2026-10-05T03:58:57.038839Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"   accuracy  balanced_accuracy        f1  precision    recall       mcc  \\\n0  0.700560           0.689843  0.572082   0.912409  0.416667  0.458401   \n1  0.698959           0.688177  0.568807   0.911765  0.413333  0.455577   \n2  0.703763           0.693177  0.578588   0.913669  0.423333  0.464035   \n3  0.701361           0.690677  0.573714   0.912727  0.418333  0.459811   \n4  0.700560           0.689843  0.572082   0.912409  0.416667  0.458401   \n\n      auroc       method  seed  final_cafad_weight_min  \\\n0  0.733580       FedAvg     0                     NaN   \