c),\n","            \"adv_balanced_accuracy\": float(balanced_accuracy_score(y, adv_pred)),\n","            \"adv_f1\": float(f1_score(y, adv_pred, zero_division=0)),\n","            \"adv_precision\": float(precision_score(y, adv_pred, zero_division=0)),\n","            \"adv_recall\": float(recall_score(y, adv_pred, zero_division=0)),\n","            \"adv_mcc\": float(matthews_corrcoef(y, adv_pred)),\n","            \"adv_pred_class1_rate\": float(np.mean(adv_pred == 1)),\n","            \"accuracy_drop\": float(clean_acc - adv_acc),\n","        })\n","    return rows\n","\n","if RUN_FULL_FGSM:\n","    fgsm_progress = load_checkpoint(FGSM_PROGRESS_PATH)\n","    expected_fgsm = len(FGSM_SEEDS) * len(FGSM_METHODS) * len(FGSM_EPSILONS)\n","\n","    if not CLEAN_FINAL_PATH.exists():\n","        raise FileNotFoundError(f\"Clean FL final results are required before FGSM: {CLEAN_FINAL_PATH}\")\n","\n","    for seed in FGSM_SEEDS:\n","        for method in FGSM_METHODS:\n","            state_path = clean_iid_state_path(seed, method)\n","            if not state_path.exists():\n","                raise FileNotFoundError(\n","                    f\"Missing cached clean IID model for seed={seed}, method={method}: {state_path}. \"\n","                    \"Complete the clean FL sweep first.\"\n","                )\n","\n","            done = False\n","            if not fgsm_progress.empty:\n","                done = (\n","                    (fgsm_progress[\"seed\"].astype(int) == seed)\n","                    & (fgsm_progress[\"method\"] == method)\n","                    & fgsm_progress[\"attack_epsilon\"].isin(FGSM_EPSILONS)\n","                ).sum() == len(FGSM_EPSILONS)\n","            if done:\n","                print(f\"SKIP FGSM seed={seed} method={method}\")\n","                continue\n","\n","            payload = torch.load(state_path, map_location=\"cpu\")\n","            state = payload[\"state\"] if isinstance(payload, dict) and \"state\" in payload else payload\n","            rows = evaluate_cached_fgsm(state, X_test, y_test, FGSM_EPSILONS)\n","            for row in rows:\n","                row.update({\"seed\": int(seed), \"method\": method})\n","\n","            fgsm_progress = upsert_checkpoint(\n","                FGSM_PROGRESS_PATH, rows, [\"seed\", \"method\", \"attack_epsilon\"]\n","            )\n","            print(f\"FGSM CHECKPOINT: {len(fgsm_progress)}/{expected_fgsm} rows\")\n","\n","    if len(fgsm_progress) == expected_fgsm:\n","        atomic_to_csv(\n","            fgsm_progress.sort_values([\"method\", \"attack_epsilon\", \"seed\"]),\n","            FGSM_FINAL_PATH\n","        )\n","        print(\"FGSM COMPLETE:\", len(fgsm_progress), \"rows ->\", FGSM_FINAL_PATH)\n","        display(\n","            fgsm_progress.groupby([\"method\", \"attack_epsilon\"]).agg(\n","                clean_accuracy_mean=(\"clean_accuracy\", \"mean\"),\n","                adv_accuracy_mean=(\"adv_accuracy\", \"mean\"),\n","                adv_accuracy_std=(\"adv_accuracy\", \"std\"),\n","                accuracy_drop_mean=(\"accuracy_drop\", \"mean\"),\n","                accuracy_drop_std=(\"accuracy_drop\", \"std\"),\n","                n=(\"seed\", \"count\")\n","            ).reset_index()\n","        )\n","    else:\n","        print(\"FGSM INCOMPLETE; progress retained at:\", FGSM_PROGRESS_PATH)\n"]},{"cell_type":"markdown","id":"38fbcf3e","metadata":{"papermill":{"duration":0.049971,"end_time":"2026-10-11T14:02:06.056462","exception":false,"start_time":"2026-10-11T14:02:06.006491","status":"completed"},"tags":[]},"source":["## 22. Final statistical analyses and publication exports\n","\n","These cells perform analysis only. They do not retrain any models."]},{"cell_type":"code","execution_count":38,"id":"3abdc762","metadata":{"execution":{"iopub.execute_input":"2026-10-11T14:02:06.258187Z","iopub.status.busy":"2026-10-11T14:02:06.257827Z","iopub.status.idle":"2026-10-11T14:02:06.423355Z","shell.execute_reply":"2026-10-11T14:02:06.422459Z"},"papermill":{"duration":0.318374,"end_time":"2026-10-11T14:02:06.424752","exception":false,"start_time":"2026-10-11T14:02:06.106378","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Clean analysis exported.\n"]}],"source":["# 22A. Recompute clean statistics from the saved final file (no clean-model retraining)\n","CLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\n","CLEAN_SEEDS = list(CFG[\"seeds\"])\n","METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","if not CLEAN_FINAL_PATH.exists():\n","    raise FileNotFoundError(f\"Completed clean FL result file is required: {CLEAN_FINAL_PATH}\")\n","clean_results = pd.read_csv(CLEAN_FINAL_PATH)\n","expected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\n","assert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n","\n","METRICS = [\"accuracy\",\"balanced_accuracy\",\"f1\",\"precision\",\"recall\",\"mcc\",\"auroc\"]\n","from scipy.stats import t, wilcoxon\n","if \"bh_adjust\" not in globals():\n","    def bh_adjust(pvals):\n","        pvals = np.asarray(pvals, dtype=float)\n","        n = len(pvals)\n","        order = np.argsort(pvals)\n","        ranked = pvals[order]\n","        q = ranked * n / np.arange(1, n + 1)\n","        q = np.minimum.accumulate(q[::-1])[::-1]\n","        out = np.empty_like(q)\n","        out[order] = q\n","        return np.minimum(out, 1.0)\n","\n","def summarize_metric(data, group_cols, metric):\n","    rows=[]\n","    for keys,g in data.groupby(group_cols, dropna=False):\n","        vals=g[metric].dropna().to_numpy(); n=len(vals)\n","        if n<2: continue\n","        mean=float(vals.mean()); std=float(vals.std(ddof=1)); sem=std/np.sqrt(n)\n","        margin=float(t.ppf(0.975,n-1)*sem)\n","        if not isinstance(keys,tuple): keys=(keys,)\n","        row=dict(zip(group_cols,keys)); row.update({\"metric\":metric,\"n\":n,\"mean\":mean,\"std\":std,\"ci95_low\":mean-margin,\"ci95_high\":mean+margin,\"ci95_half_width\":margin}); rows.append(row)\n","    return pd.DataFrame(rows)\n","\n","metric_summary=pd.concat([summarize_metric(clean_results,[\"condition\",\"alpha\",\"method\"],m) for m in METRICS],ignore_index=True)\n","accuracy_summary=metric_summary[metric_summary[\"metric\"]==\"accuracy\"].copy()\n","for c in [\"mean\",\"std\",\"ci95_low\",\"ci95_high\"]:\n","    accuracy_summary[c+\"_percent\"]=accuracy_summary[c]*100\n","\n","# Paired Wilcoxon tests vs FedAvg within every fixed condition.\n","comparison_rows=[]\n","for (condition,alpha),g in clean_results.groupby([\"condition\",\"alpha\"],dropna=False):\n","    base=g[g[\"method\"]==\"FedAvg\"].set_index(\"seed\")\n","    for method in [m for m in METHODS if m!=\"FedAvg\"]:\n","        cur=g[g[\"method\"]==method].set_index(\"seed\")\n","        common=sorted(set(base.index)&set(cur.index))\n","        for metric in [\"accuracy\",\"f1\"]:\n","            a=base.loc[common,metric].to_numpy(); b=cur.loc[common,metric].to_numpy()\n","            stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n","            comparison_rows.append({\"condition\":condition,\"alpha\":alpha,\"method_a\":\"FedAvg\",\"method_b\":method,\"metric\":metric,\"n\":len(common),\"mean_diff_b_minus_a\":float(np.mean(b-a)),\"median_diff_b_minus_a\":float(np.median(b-a)),\"wilcoxon_p\":float(p)})\n","accuracy_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"accuracy\"])\n","f1_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"f1\"])\n","all_tests=pd.concat([accuracy_tests,f1_tests],ignore_index=True)\n","all_tests[\"bh_q\"] = bh_adjust(all_tests[\"wilcoxon_p\"].to_numpy())\n","\n","metric_summary.to_csv(RESULTS_DIR/\"clean_metric_summary_v3.csv\",index=False)\n","accuracy_summary.to_csv(RESULTS_DIR/\"clean_accuracy_summary_v3.csv\",index=False)\n","accuracy_tests.to_csv(RESULTS_DIR/\"clean_paired_accuracy_tests_v3.csv\",index=False)\n","f1_tests.to_csv(RESULTS_DIR/\"clean_paired_f1_tests_v3.csv\",index=False)\n","print(\"Clean analysis exported.\")\n"]},{"cell_type":"code","execution_count":39,"id":"5e4c2cb9","metadata":{"execution":{"iopub.execute_input":"2026-10-11T14:02:06.531313Z","iopub.status.busy":"2026-10-11T14:02:06.530428Z","iopub.status.idle":"2026-10-11T14:02:09.758642Z","shell.execute_reply":"2026-10-11T14:02:09.757941Z"},"papermill":{"duration":3.282905,"end_time":"2026-10-11T14:02:09.759973","exception":false,"start_time":"2026-10-11T14:02:06.477068","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1000x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_16/3068726758.py:78: UserWarning: No artists with labels found to put in legend.  Note that artists whose label start with an underscore are ignored when legend() is called with no argument.\n","  axes[-1].legend(fontsize=8)\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x450 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# 22B. Figures — clean heterogeneity, corrected robustness, privacy–utility, FGSM, blocked and client-count sensitivity\n","# Explicit output paths avoid accidentally plotting the earlier milder robustness sweep.\n","ROBUST_FINAL_PATH = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n","DP_FINAL_PATH = RESULTS_DIR