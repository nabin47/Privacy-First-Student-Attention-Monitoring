 partition repair.\n","PARTITION_DIAGNOSTIC_SEEDS = list(range(10))\n","PARTITION_DIAGNOSTIC_COUNTS = [5, 10, 20]\n","PARTITION_DIAGNOSTIC_ALPHAS = [0.5]\n","partition_diagnostic_rows = []\n","for _k in PARTITION_DIAGNOSTIC_COUNTS:\n","    for _alpha in PARTITION_DIAGNOSTIC_ALPHAS:\n","        for _seed in PARTITION_DIAGNOSTIC_SEEDS:\n","            # Use the same partitioner, but capture whether a minimum-size repair is triggered.\n","            # The function's warning output is informative; this diagnostic records actual sizes.\n","            _capture = io.StringIO()\n","            with contextlib.redirect_stdout(_capture):\n","                _parts = dirichlet_label_partition(\n","                    y_train, _k, float(_alpha), _seed,\n","                    min_size=PARTITION_MIN_SIZE, max_tries=PARTITION_MAX_TRIES\n","                )\n","            _sizes = [len(x) for x in _parts]\n","            _repair_text = _capture.getvalue()\n","            partition_diagnostic_rows.append({\n","                \"n_clients\": _k, \"alpha\": float(_alpha), \"seed\": _seed,\n","                \"min_client_size\": int(min(_sizes)), \"max_client_size\": int(max(_sizes)),\n","                \"client_sizes\": json.dumps(_sizes),\n","                \"repair_warning\": \"repaired best draw\" in _repair_text.lower(),\n","            })\n","partition_diagnostic = pd.DataFrame(partition_diagnostic_rows)\n","partition_diagnostic.to_csv(RESULTS_DIR / \"client_partition_diagnostic_v2.csv\", index=False)\n","display(partition_diagnostic.groupby([\"n_clients\", \"alpha\"]).agg(\n","    seeds=(\"seed\", \"count\"), min_observed_client_size=(\"min_client_size\", \"min\"),\n","    repair_seed_count=(\"repair_warning\", \"sum\")\n",").reset_index())\n","print(\"Sensitivity design excludes alpha=0.1 until partitions can be generated without repair.\")\n"]},{"cell_type":"code","execution_count":32,"id":"d92076e0","metadata":{"execution":{"iopub.execute_input":"2026-11-07T09:44:41.789892Z","iopub.status.busy":"2026-11-07T09:44:41.789464Z","iopub.status.idle":"2026-11-07T09:55:57.494101Z","shell.execute_reply":"2026-11-07T09:55:57.493216Z"},"papermill":{"duration":675.828829,"end_time":"2026-11-07T09:55:57.556236","exception":false,"start_time":"2026-11-07T09:44:41.727407","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Valid client-count sensitivity exported: 120 rows.\n"]}],"source":["# 19B. Valid client-count sensitivity: K=5/10/20, IID and Dirichlet alpha=0.5 only\n","# K=10 values are reused from the completed primary benchmark; train only K=5 and K=20.\n","# alpha=0.1 is excluded because prior K=20 partitions required ad-hoc minimum-size repair.\n","RUN_CLIENT_COUNT_SENSITIVITY = True\n","CLIENT_COUNT_SENSITIVITY_COUNTS = [5, 20]\n","CLIENT_COUNT_SENSITIVITY_SEEDS = list(range(10))\n","CLIENT_COUNT_SENSITIVITY_METHODS = [\"FedAvg\", \"CAFAD\"]\n","CLIENT_COUNT_SENSITIVITY_CONDITIONS = [(\"IID\", None), (\"Dirichlet\", 0.5)]\n","\n","CLIENT_SENS_PROGRESS = RESULTS_DIR / \"client_count_sensitivity_K5_K20_valid_v2_progress.csv\"\n","CLIENT_SENS_NEW_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K20_valid_v2.csv\"\n","CLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_valid_v2.csv\"\n","\n","if RUN_CLIENT_COUNT_SENSITIVITY:\n","    progress = load_checkpoint(CLIENT_SENS_PROGRESS)\n","    if not progress.empty:\n","        progress[\"seed\"] = pd.to_numeric(progress[\"seed\"], errors=\"raise\").astype(int)\n","        progress[\"n_clients\"] = pd.to_numeric(progress[\"n_clients\"], errors=\"raise\").astype(int)\n","\n","    for n_clients in CLIENT_COUNT_SENSITIVITY_COUNTS:\n","        for seed in CLIENT_COUNT_SENSITIVITY_SEEDS:\n","            for condition, alpha in CLIENT_COUNT_SENSITIVITY_CONDITIONS:\n","                if condition == \"IID\":\n","                    parts = balanced_iid_partition(y_train, n_clients, seed)\n","                else:\n","                    _capture = io.StringIO()\n","                    with contextlib.redirect_stdout(_capture):\n","                        parts = dirichlet_label_partition(\n","                            y_train, n_clients, float(alpha), seed,\n","                            min_size=PARTITION_MIN_SIZE, max_tries=PARTITION_MAX_TRIES\n","                        )\n","                    if \"repaired best draw\" in _capture.getvalue().lower():\n","                        raise RuntimeError(\n","                            f\"Partition repair occurred for K={n_clients}, alpha={alpha}, seed={seed}. \"\n","                            \"Do not report this as an ordinary Dirichlet partition.\"\n","                        )\n","                for method in CLIENT_COUNT_SENSITIVITY_METHODS:\n","                    if not progress.empty:\n","                        done = (\n","                            (progress[\"n_clients\"].astype(int) == n_clients)\n","                            & (progress[\"seed\"].astype(int) == seed)\n","                            & (progress[\"condition\"] == condition)\n","                            & (progress[\"method\"] == method)\n","                            & (progress[\"alpha\"].isna() if alpha is None else\n","                               np.isclose(pd.to_numeric(progress[\"alpha\"], errors=\"coerce\"), float(alpha), equal_nan=False))\n","                        ).any()\n","                    else:\n","                        done = False\n","                    if done:\n","                        continue\n","                    result, _, _ = run_federated(\n","                        X_train, y_train, X_test, y_test, parts, method, seed,\n","                        CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"]\n","                    )\n","                    result.update({\n","                        \"n_clients\": int(n_clients), \"seed\": int(seed),\n","                        \"condition\": condition, \"alpha\": np.n