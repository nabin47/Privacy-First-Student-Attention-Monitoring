tatus.busy":"2026-10-11T12:13:35.976483Z","iopub.status.idle":"2026-10-11T12:13:35.98458Z","shell.execute_reply":"2026-10-11T12:13:35.983664Z"},"papermill":{"duration":0.05031,"end_time":"2026-10-11T12:13:35.986361","exception":false,"start_time":"2026-10-11T12:13:35.936051","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["No old robustness checkpoint found.\n"]}],"source":["from pathlib import Path\n","import pandas as pd\n","\n","OLD_PROGRESS = RESULTS_DIR / \"robustness_sweep_progress_v3.csv\"\n","\n","NEW_PROGRESS = (\n","    RESULTS_DIR / \"robustness_sweep_corrected_progress_v3.csv\"\n",")\n","NEW_FINAL = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n","\n","NEW_SCENARIOS = [\n","    \"full_label_flip_20pct_clients\",\n","    \"full_label_flip_40pct_clients\",\n","    \"one_straggler_10pct_clients\",\n","]\n","\n","if not OLD_PROGRESS.exists():\n","    print(\"No old robustness checkpoint found.\")\n","else:\n","    old = pd.read_csv(OLD_PROGRESS)\n","\n","    corrected = old[\n","        old[\"scenario\"].isin(NEW_SCENARIOS)\n","    ].copy()\n","\n","    if not corrected.empty:\n","        corrected[\"seed\"] = corrected[\"seed\"].astype(int)\n","\n","        corrected = corrected.drop_duplicates(\n","            subset=[\"seed\", \"scenario\", \"method\"],\n","            keep=\"last\",\n","        )\n","\n","    def atomic_save(df, path):\n","        path.parent.mkdir(parents=True, exist_ok=True)\n","        temp = path.with_suffix(path.suffix + \".tmp\")\n","        df.to_csv(temp, index=False)\n","        temp.replace(path)\n","\n","    atomic_save(corrected, NEW_PROGRESS)\n","\n","    expected = 20 * 3 * 5\n","\n","    print(\"Corrected checkpoint saved:\", NEW_PROGRESS)\n","    print(\"Completed corrected runs:\", len(corrected))\n","    print(\"Expected corrected runs:\", expected)\n","\n","    if not corrected.empty:\n","        print(\"\\nRuns by scenario:\")\n","        print(corrected.groupby(\"scenario\").size())\n","\n","    if len(corrected) == expected:\n","        atomic_save(\n","            corrected.sort_values([\"scenario\", \"method\", \"seed\"]),\n","            NEW_FINAL,\n","        )\n","        print(\"\\nCorrected robustness sweep is complete:\", NEW_FINAL)\n","    else:\n","        print(\n","            \"\\nCorrected robustness sweep is incomplete. \"\n","            \"Resume missing runs using the corrected checkpoint.\"\n","        )"]},{"cell_type":"markdown","id":"3d26d12e","metadata":{"papermill":{"duration":0.041238,"end_time":"2026-10-11T12:13:36.068347","exception":false,"start_time":"2026-10-11T12:13:36.027109","status":"completed"},"tags":[]},"source":["## 14. Record-level DP-SGD — corrected protocol v2 (use only v2 outputs)\n","\n","The DP mechanism below uses Poisson sampling, per-record gradient clipping, Gaussian noise added to the clipped **gradient sum**, and division by the fixed expected batch size `q*n`. Empty sampled lots still execute a noisy update. The integer-order RDP accountant calibrates the noise multiplier for the complete local training schedule. Since clients hold disjoint row partitions, report the maximum client-level epsilon (record/row-level privacy; not student-level privacy).\n","\n","**Important:** the DP CSVs in the previously archived results ZIP were generated by the old realized-lot-normalization implementation. They are historical outputs and must not be used as the paper's formal DP results. Run Cells 14A–14C and the corrected DP sweep (Cell 20B) to create the v2 results.\n","\n","For a formal privacy claim, set `DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM=True` and use a compatible `torchcsprng` installation. If the CSPRNG is unavailable, the code labels its fallback as non-cryptographic and must not be described as a cryptographically secure implementation."]},{"cell_type":"code","execution_count":23,"id":"700ab665","metadata":{"execution":{"iopub.execute_input":"2026-10-11T12:13:36.146451Z","iopub.status.busy":"2026-10-11T12:13:36.146169Z","iopub.status.idle":"2026-10-11T12:13:36.171644Z","shell.execute_reply":"2026-10-11T12:13:36.170329Z"},"papermill":{"duration":0.066629,"end_time":"2026-10-11T12:13:36.173394","exception":false,"start_time":"2026-10-11T12:13:36.106765","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torchcsprng is unavailable; using an OS-CSPRNG-backed implementation based on os.urandom for Poisson sampling and Gaussian noise.\n"]}],"source":["# 14A. Integer-order RDP accountant + cached calibration and DP RNG helpers (v2)\n","import secrets\n","import os\n","\n","DP_RDP_ORDERS = list(range(2, 65))\n","DP_CALIBRATION_CACHE = {}\n","DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM = True  # Formal DP runs fail closed unless torchcsprng is available.\n","\n","try:\n","    import torchcsprng as _torchcsprng\n","    DP_TORCHCSPRNG_AVAILABLE = True\n","except Exception:\n","    _torchcsprng = None\n","    DP_TORCHCSPRNG_AVAILABLE = False\n","\n","# os.urandom is backed by the operating system CSPRNG. If torchcsprng is not\n","# installed, use OS-CSPRNG bytes directly for Poisson masks and Gaussian noise.\n","# This avoids silently falling back to a conventional seeded PyTorch PRNG.\n","DP_CSPRNG_AVAILABLE = DP_TORCHCSPRNG_AVAILABLE or hasattr(os, \"urandom\")\n","if not DP_TORCHCSPRNG_AVAILABLE:\n","    print(\n","        \"torchcsprng is unavailable; using an OS-CSPRNG-backed implementation \"\n","        \"based on os.urandom for Poisson sampling and Gaussian noise.\"\n","    )\n","\n","def _os_csprng_uniform(shape):\n","    \"\"\"Generate float64 U(0,1) values from OS-CSPRNG bytes (never NumPy RNG).\"\"\"\n","    count = int(np.prod(shape, dtype=np.int64))\n","    if count == 0:\n","        return np.empty(shape, dtype=np.float64)\n","    raw = os.urandom(count * 8)\n","    vals = np.frombuffer(raw, dtype=np.uint64).copy() >> np.uint64(11)  # 53 random bits\n","    out = (vals.astype(np.float64) + 0.5) / float(2**53)\n","    return out.reshape(shape)\n","\n","def _os_csprng_normal(shape):\n","    \"\"\"Box-Muller standard normals from OS-CSPRNG uniforms.\"\"\"\n","    count = int(np.prod(shape, dtype=np.int64))\n","    if count == 0:\n","        return np.empty(shape, dtype=np.float64)\n","    pairs = (count + 1) // 2\n","    u = _os_csprng_uniform((pairs, 2))\n","    radius = np.sqrt(-2.0 * np.log(u[:, 0]))\n","    angle = 2.0 * np.pi * u[:, 1]\n","    z = np.empty(pairs * 2, dtype=np.float64)\n","    z[0::2] = radius * np.cos(angle)\n","    z[1::2] = radius * np.sin(angle)\n","    return z[:count].reshape(shape)\n","\n","def subsampled_gaussian_rdp(q, sigma, order):\n","    \"\"\"Exact integer-order RDP of the Poisson-subsampled Gaussian mechanism.\"\"\"\n","    a = int(order)\n","    if a < 2:\n","        raise ValueError(\"Integer RDP order must be >= 2.\")\n","    if sigma <= 0:\n","        raise ValueError(\"sigma must be positive for a private mechanism.\")\n","    if q <= 0:\n","        return 0.0\n","    if q >= 1:\n","        return float(a / (2.0 * sigma**2))\n","    i = np.arange(a + 1, dtype=np.float64)\n","    log_comb = gammaln(a + 1) - gammaln(i + 1) - gammaln(a - i + 1)\n","    log_q = i * math.log(q)\n","    log_1q = (a - i) * math.log1p(-q)\n","    exponent = (i * i - i) / (2.0 * sigma**2)\n","    log_a = logsumexp(log_comb + log_q + log_1q + exponent)\n","    return float(log_a / (a - 1))\n","\n","\n","def rdp_epsilon(q, sigma, steps, delta=DP_DELTA, orders=None):\n","    \"\"\"Convert composed RDP to an (epsilon, delta) upper bound.\"\"\"\n","    if not (0.0 < delta < 1.0):\n","        raise ValueError(\"delta must be in (0, 1).\")\n","    if steps <= 0:\n","        raise ValueError(\"steps must be positive.\")\n","    orders = DP_RDP_ORDERS if orders is None else list(orders)\n","    epsilons = [\n","        steps * subsampled_gaussian_rdp(q, sigma, a)\n","        + math.log(1.0 / delta) / (a - 1)\n","        for a in orders\n","    ]\n","    return float(np.min(epsilons))\n","\n","\n","def calibrate_sigma(target_epsilon, q, steps, delta=DP_DELTA):\n","    \"\"\"Find a conservative noise multiplier for the specified full-run budget.\"\"\"\n","    if not np.isfinite(target_epsilon) or target_epsilon <= 0:\n","        raise ValueError(\"target_epsilon must be finite and positive.\")\n","    if not (0.0 < q <= 1.0):\n","        raise ValueError(\"Poisson sample rate q must be in (0, 1].\")\n","\n","    lo, hi = 1e-3, 1.0\n","    while rdp_epsilon(q, hi, steps, delta) > target_epsilon:\n","        hi *= 2.0\n","        if hi > 1e6:\n","            raise RuntimeError(\"Could not bracket a noise multiplier for this budget.\")\n","    # If even the smallest searched multiplier already satisfies the target, keep a valid bracket.\n","    while rdp_epsilon(q, lo, steps, delta) <= target_epsilon and lo > 1e-12:\n","        lo *= 0.5\n","    for _ in range(64):\n","        mid = (lo + hi) / 2.0\n","        if rdp_epsilon(q, mid, steps, delta) > target_epsilon:\n","            lo = mid\n","        else:\n","            hi = mid\n","    return float(hi)\n","\n","\n","def get_dp_client_plan(n, batch_size, total_rounds, local_epochs, target_epsilon,\n","                       delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM):\n","    \"\"\"Plan/cached accounting once for a client-size and protocol combination.\"\"\"\n","    n = int(n)\n","    if n <= 0:\n","        raise ValueError(\"DP client must contain at least one record.\")\n","    q = min(1.0, float(batch_size) / n)\n","    expected_batch_size = q * n  # fixed expected Poisson lot size, never realized lot size\n","    steps_per_epoch = max(1, int(math.ceil(1.0 / q)))\n","    total_steps = int(total_rounds) * int(local_epochs) * steps_per_epoch\n","    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n","    eps_key = None if not private else round(float(target_epsilon), 12)\n","    key = (n, int(batch_size), int(total_rounds), int(local_epochs), eps_key,\n","           float(delta), float(max_grad_norm), tuple(DP_RDP_ORDERS))\n","    if key not in DP_CALIBRATION_CACHE:\n","        if private:\n","            sigma = calibrate_sigma(float(target_epsilon), q, total_steps, delta)\n","            achieved = rdp_epsilon(q, sigma, total_steps, delta)\n","        else:\n","            sigma = 0.0\n","            achieved = np.nan\n","        DP_CALIBRATION_CACHE[key] = {\n","            \"n\": n,\n","            \"q\": float(q),\n","            \"expected_batch_size\": float(expected_batch_size),\n","            \"steps_per_epoch\": steps_per_epoch,\n","            \"total_steps\": total_steps,\n","            \"sigma\": float(sigma),\n","            \"achieved_epsilon\": float(achieved) if np.isfinite(achieved) else np.nan,\n","            \"dp_enabled\": bool(private),\n","            \"target_epsilon\": float(target_epsilon) if private else np.inf,\n","            \"delta\": float(delta),\n","            \"max_grad_norm\": float(max_grad_norm),\n","        }\n","    return dict(DP_CALIBRATION_CACHE[key])\n","\n","\n","def make_dp_random_generator():\n","    \"\"\"Return a cryptographic RNG mode; never silently use a seeded PRNG for DP.\"\"\"\n","    if DP_TORCHCSPRNG_AVAILABLE:\n","        gen = _torchcsprng.create_random_device_generator(\"/dev/urandom\")\n","        return gen, \"torchcsprng:/dev/urandom (CSPRNG)\"\n","    if hasattr(os, \"urandom\"):\n","        return None, \"os.urandom + Box-Muller (OS-CSPRNG-backed)\"\n","    if DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM:\n","        raise RuntimeError(\n","            \"No cryptographically secure random source is available. \"\n","            \"Use a runtime with os.urandom or install a compatible torchcsprng build.\"\n","        )\n","    gen = torch.Generator(device=DEVICE)\n","    gen.manual_seed(secrets.randbits(63))\n","    return gen, \"OS-entropy-seeded PyTorch PRNG (NOT cryptographically secure)\"\n","\n","\n","def _dp_poisson_mask(n, q, generator, rng_mode):\n","    if \"torchcsprng\" in rng_mode:\n","        return (torch.rand(int(n), device=\"cpu\", generator=generator) < q).to(DEVICE)\n","    if \"os.urandom\" in rng_mode:\n","        u = _os_csprng_uniform((int(n),))\n","        return torch.from_numpy(u < float(q)).to(DEVICE)\n","    return torch.rand(int(n), device=DEVICE, generator=generator) < q\n","\n","def _dp_gaussian_noise_like(reference, std, generator, rng_mode):\n","    if \"torchcsprng\" in rng_mode:\n","        noise = torch.empty(tuple(reference.shape), dtype=reference.dtype, device=\"cpu\")\n","        noise.normal_(mean=0.0, std=float(std), generator=generator)\n","        return noise.to(reference.device)\n","    if \"os.urandom\" in rng_mode:\n","        arr = _os_csprng_normal(tuple(reference.shape)) * float(std)\n","        return torch.as_tensor(arr, dtype=reference.dtype, device=reference.device)\n","    noise = torch.empty_like(reference)\n","    noise.normal_(mean=0.0, std=float(std), generator=generator)\n","    return noise\n"]},{"cell_type":"code","execution_count":24,"id":"26b8aa53","metadata":{"execution":{"iopub.execute_input":"2026-10-11T12:13:36.252886Z","iopub.status.busy":"2026-10-11T12:13:36.252606Z","iopub.status.idle":"2026-10-11T12:13:36.265333Z","shell.execute_reply":"2026-10-11T12:13:36.264648Z"},"papermill":{"duration":0.054315,"end_time":"2026-10-11T12:13:36.266659","exception":false,"start_time":"2026-10-11T12:13:36.212344","status":"completed"},"tags":[]},"outputs":[],"source":["# 14B. Corrected Poisson-sampled DP-SGD: expected-batch denominator + empty-lot noise\n","\n","def dp_local_train(global_state, X, y, client_idx, seed, total_rounds, local_epochs,\n","                   batch_size, target_epsilon, delta=DP_DELTA,\n","                   max_grad_norm=DP_MAX_GRAD_NORM, lr=LR, dp_plan=None):\n","    \"\"\"Train one client's local model. target_epsilon=None disables clipping/noise for a matched control.\"\"\"\n","    seed_everything(seed)  # deterministic model initialization; private RNG is created independently below\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, global_state)\n","    model.train()\n","\n","    idx = np.asarray(client_idx, dtype=int)\n","    if len(idx) == 0:\n","        raise ValueError(\"DP client partition cannot be empty.\")\n","    x_local = torch.from_numpy(np.asarray(X[idx], dtype=np.float32)).to(DEVICE)\n","    y_local = torch.from_numpy(np.asarray(y[idx], dtype=np.int64)).to(DEVICE)\n","    n = len(idx)\n","\n","    plan = dp_plan or get_dp_client_plan(\n","        n, batch_size, total_rounds, local_epochs, target_epsilon, delta, max_grad_norm\n","    )\n","    q = float(plan[\"q\"])\n","    expected_batch_size = float(plan[\"expected_batch_size\"])\n","    steps_per_epoch = int(plan[\"steps_per_epoch\"])\n","    sigma = float(plan[\"sigma\"])\n","    dp_enabled = bool(plan[\"dp_enabled\"])\n","\n","    if dp_enabled:\n","        privacy_generator, rng_mode = make_dp_random_generator()\n","    else:\n","        privacy_generator, rng_mode = None, \"not_applicable_matched_nonprivate_control\"\n","\n","    params = {k: v for k, v in model.named_parameters()}\n","    buffers = {k: v for k, v in model.named_buffers()}\n","\n","    def loss_one(params, buffers, x_one, y_one):\n","        logits = functional_call(model, (params, buffers), (x_one.unsqueeze(0),))\n","        return nn.functional.cross_entropy(logits, y_one.unsqueeze(0))\n","\n","    grad_one = grad(loss_one)\n","\n","    for _ in range(int(local_epochs)):\n","        for _ in range(steps_per_epoch):\n","            if dp_enabled:\n","                mask = _dp_poisson_mask(n, q, privacy_generator, rng_mode)\n","            else:\n","                # The non-private reference uses the same Poisson sampling protocol,\n","                # but its randomness is reproducibly seeded and no privacy claim is made.\n","                mask = (torch.rand(n, device=DEVICE) < q)\n","            ids = torch.where(mask)[0]\n","\n","            # A Poisson-sampled lot may be empty. The private mechanism must still\n","            # release a Gaussian-perturbed sum for that step; do not skip the update.\n","            grad_sums = {name: torch.zeros_like(p) for name, p in params.items()}\n","            if ids.numel() > 0:\n","                xb, yb = x_local[ids], y_local[ids]\n","                per_sample = vmap(grad_one, in_dims=(None, None, 0, 0))(\n","                    params, buffers, xb, yb\n","                )\n","\n","                if dp_enabled:\n","                    norm_sq = None\n","                    for g in per_sample.values():\n","                        flat = g.reshape(g.shape[0], -1)\n","                        term = (flat * flat).sum(dim=1)\n","                        norm_sq = term if norm_sq is None else norm_sq + term\n","                    norms = torch.sqrt(norm_sq + 1e-12)\n","                    coeff = torch.clamp(float(max_grad_norm) / norms, max=1.0)\n","                    for name, g in per_sample.items():\n","                        view = coeff.view(-1, *([1] * (g.ndim - 1)))\n","                        grad_sums[name] = (g * view).sum(dim=0)\n","                else:\n","                    # Matched non-private control: same sampling/update schedule,\n","                    # with clipping and noise disabled.\n","                    for name, g in per_sample.items():\n","                        grad_sums[name] = g.sum(dim=0)\n","\n","            with torch.no_grad():\n","                for name, p in params.items():\n","                    grad_sum = grad_sums[name]\n","                    if dp_enabled:\n","                        noise_sum = _dp_gaussian_noise_like(\n","                            p, sigma * float(max_grad_norm), privacy_generator, rng_mode\n","                        )\n","                        grad_sum = grad_sum + noise_sum\n","                    # Correct DP-SGD normalization: divide noisy clipped SUM by\n","                    # expected lot size q*n, not the data-dependent realized |B|.\n","                    grad_estimate = grad_sum / expected_batch_size\n","                    p.add_(grad_estimate, alpha=-float(lr))\n","\n","    achieved_epsilon = float(plan[\"achieved_epsilon\"])\n","    return clone_state_dict(model), sigma, achieved_epsilon, rng_mode\n"]},{"cell_type":"code","execution_count":25,"id":"5f6f8f85","metadata":{"execution":{"iopub.execute_input":"2026-10-11T12:13:36.347454Z","iopub.status.busy":"2026-10-11T12:13:36.347176Z","iopub.status.idle":"2026-10-11T12:13:36.358791Z","shell.execute_reply":"2026-10-11T12:13:36.357972Z"},"papermill":{"duration":0.053917,"end_time":"2026-10-11T12:13:36.360674","exception":false,"start_time":"2026-10-11T12:13:36.306757","status":"completed"},"tags":[]},"outputs":[],"source":["# 14C. Federated DP runner + matched non-private reference runner (v2)\n","DP_METHODS = [\"FedAvg\", \"Median\", \"TrimmedMean\"]\n","DP_PROTOCOL_VERSION = \"v2_poisson_expected_batch_sum_noise_matched_control\"\n","\n","\n","def _dp_lr_for(target_epsilon):\n","    if target_epsilon is None or not np.isfinite(float(target_epsilon)):\n","        return LR\n","    return DP_LR_BY_EPS[float(target_epsilon)]\n","\n","\n","def run_federated_dp(X, y, X_eval, y_eval, parts, method, seed, rounds,\n","                     local_epochs, batch_size, target_epsilon):\n","    \"\"\"target_epsilon=None means matched Poisson-sampled non-private control.\"\"\"\n","    if method not in DP_METHODS:\n","        raise ValueError(f\"Unsupported DP comparison method: {method}\")\n","    seed_everything(seed)\n","    initial_model = MLP(X.shape[1]).to(DEVICE)\n","    global_state = clone_state_dict(initial_model)\n","\n","    # Plan calibration once per client, reused over all rounds and all methods via cache.\n","    client_plans = [\n","        get_dp_client_plan(\n","            len(idx), batch_size, rounds, local_epochs, target_epsilon,\n","            DP_DELTA, DP_MAX_GRAD_NORM\n","        )\n","        for idx in parts\n","    ]\n","    client_eps = [p[\"achieved_epsilon\"] for p in client_plans if np.isfinite(p[\"achieved_epsilon\"])]\n","    client_sigmas = [p[\"sigma\"] for p in client_plans]\n","    rng_modes = set()\n","\n","    for rnd in range(int(rounds)):\n","        local_states, ns = [], []\n","        for k, idx in enumerate(parts):\n","            st, sigma, eps, rng_mode = dp_local_train(\n","                global_state, X, y, idx, seed + 1000 * rnd + k,\n","                total_rounds=rounds, local_epochs=local_epochs,\n","                batch_size=batch_size, target_epsilon=target_epsilon,\n","                delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM, lr=_dp_lr_for(target_epsilon),\n","                dp_plan=client_plans[k],\n","            )\n","            local_states.append(st)\n","            ns.append(len(idx))\n","            if target_epsilon is not None and np.isfinite(float(target_epsilon)):\n","                rng_modes.add(rng_mode)\n","\n","        if method == \"FedAvg\":\n","            global_state = aggregate_fedavg(local_states, ns)\n","        elif method == \"Median\":\n","            global_state = aggregate_median(local_states)\n","        elif method == \"TrimmedMean\":\n","            global_state = aggregate_trimmed_mean(local_states, TRIM_FRACTION)\n","\n","    result = evaluate_state(global_state, X_eval, y_eval)\n","    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n","    result.update({\n","        \"method\": method,\n","        \"seed\": int(seed),\n","        \"target_epsilon\": float(target_epsilon) if private else np.inf,\n","        \"max_client_achieved_epsilon\": float(max(client_eps)) if client_eps else np.nan,\n","        \"mean_client_sigma\": float(np.mean(client_sigmas)) if private else 0.0,\n","        \"min_client_sample_rate\": float(min(p[\"q\"] for p in client_plans)),\n","        \"max_client_sample_rate\": float(max(p[\"q\"] for p in client_plans)),\n","        \"min_client_steps_full_run\": int(min(p[\"total_steps\"] for p in client_plans)),\n","        \"max_client_steps_full_run\": int(max(p[\"total_steps\"] for p in client_plans)),\n","        \"dp_enabled\": bool(private),\n","        \"dp_protocol_version\": DP_PROTOCOL_VERSION,\n","        \"dp_rng_mode\": \"; \".join(sorted(rng_modes)) if private else \"not_applicable_matched_nonprivate_control\",\n","        \"nonprivate_control_protocol\": (\n","            \"not_applicable_private_run\" if private else\n","            \"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\"\n","        ),\n","    })\n","    return result\n"]},{"cell_type":"code","execution_count":26,"id":"bc28f6dd","metadata":{"execution":{"iopub.execute_input":"2026-10-11T12:13:36.44414Z","iopub.status.busy":"2026-10-11T12:13:36.443797Z","iopub.status.idle":"2026-10-11T12:23:03.304757Z","shell.execute_reply":"2026-10-11T12:23:03.30382Z"},"papermill":{"duration":566.942152,"end_time":"2026-10-11T12:23:03.344712","exception":false,"start_time":"2026-10-11T12:13:36.40256","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["eps 0.5 lr 0.05 done\n","eps 0.5 lr 0.1 done\n","eps 0.5 lr 0.2 done\n","eps 0.5 lr 0.5 done\n","eps 1.0 lr 0.05 done\n","eps 1.0 lr 0.1 done\n","eps 1.0 lr 0.2 done\n","eps 1.0 lr 0.5 done\n","eps 2.0 lr 0.05 done\n","eps 2.0 lr 0.1 done\n","eps 2.0 lr 0.2 done\n","eps 2.0 lr 0.5 done\n","eps 5.0 lr 0.05 done\n","eps 5.0 lr 0.1 done\n","eps 5.0 lr 0.2 done\n","eps 5.0 lr 0.5 done\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-