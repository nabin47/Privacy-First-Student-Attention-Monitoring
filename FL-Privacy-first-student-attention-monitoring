LIENT_COUNT_SENSITIVITY_METHODS = [\"FedAvg\", \"CAFAD\"]\nCLIENT_COUNT_SENSITIVITY_CONDITIONS = [(\"IID\", None), (\"Dirichlet\", 0.5)]\n\nCLIENT_SENS_PROGRESS = RESULTS_DIR / \"client_count_sensitivity_K5_K20_valid_v2_progress.csv\"\nCLIENT_SENS_NEW_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K20_valid_v2.csv\"\nCLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_valid_v2.csv\"\n\nif RUN_CLIENT_COUNT_SENSITIVITY:\n    progress = load_checkpoint(CLIENT_SENS_PROGRESS)\n    if not progress.empty:\n        progress[\"seed\"] = pd.to_numeric(progress[\"seed\"], errors=\"raise\").astype(int)\n        progress[\"n_clients\"] = pd.to_numeric(progress[\"n_clients\"], errors=\"raise\").astype(int)\n\n    for n_clients in CLIENT_COUNT_SENSITIVITY_COUNTS:\n        for seed in CLIENT_COUNT_SENSITIVITY_SEEDS:\n            for condition, alpha in CLIENT_COUNT_SENSITIVITY_CONDITIONS:\n                if condition == \"IID\":\n                    parts = balanced_iid_partition(y_train, n_clients, seed)\n                else:\n                    _capture = io.StringIO()\n                    with contextlib.redirect_stdout(_capture):\n                        parts = dirichlet_label_partition(\n                            y_train, n_clients, float(alpha), seed,\n                            min_size=PARTITION_MIN_SIZE, max_tries=PARTITION_MAX_TRIES\n                        )\n                    if \"repaired best draw\" in _capture.getvalue().lower():\n                        raise RuntimeError(\n                            f\"Partition repair occurred for K={n_clients}, alpha={alpha}, seed={seed}. \"\n                            \"Do not report this as an ordinary Dirichlet partition.\"\n                        )\n                for method in CLIENT_COUNT_SENSITIVITY_METHODS:\n                    if not progress.empty:\n                        done = (\n                            (progress[\"n_clients\"].astype(int) == n_clients)\n                            & (progress[\"seed\"].astype(int) == seed)\n                            & (progress[\"condition\"] == condition)\n                            & (progress[\"method\"] == method)\n                            & (progress[\"alpha\"].isna() if alpha is None else\n                               np.isclose(pd.to_numeric(progress[\"alpha\"], errors=\"coerce\"), float(alpha), equal_nan=False))\n                        ).any()\n                    else:\n                        done = False\n                    if done:\n                        continue\n                    result, _, _ = run_federated(\n                        X_train, y_train, X_test, y_test, parts, method, seed,\n                        CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"]\n                    )\n                    result.update({\n                        \"n_clients\": int(n_clients), \"seed\": int(seed),\n                        \"condition\": condition, \"alpha\": np.nan if alpha is None else float(alpha),\n                        \"method\": method,\n                        \"partition_protocol\": \"balanced_iid\" if alpha is None else \"dirichlet_label_skew_no_repair\",\n                    })\n                    progress = upsert_checkpoint(\n                        CLIENT_SENS_PROGRESS, [result],\n                        [\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"]\n                    )\n\n    expected_new = len(CLIENT_COUNT_SENSITIVITY_COUNTS) * len(CLIENT_COUNT_SENSITIVITY_SEEDS) * len(CLIENT_COUNT_SENSITIVITY_CONDITIONS) * len(CLIENT_COUNT_SENSITIVITY_METHODS)\n    progress = load_checkpoint(CLIENT_SENS_PROGRESS)\n    if len(progress) != expected_new:\n        raise RuntimeError(f\"Expected {expected_new} new K=5/20 sensitivity rows, found {len(progress)}\")\n\n    # Reuse K=10 from the primary clean sweep, with the same seeds and methods.\n    primary = pd.read_csv(RESULTS_DIR / \"clean_fl_sweep_v3.csv\")\n    primary = primary[(primary[\"n_clients\"].astype(int) == 10)\n                      & (primary[\"seed\"].astype(int).isin(CLIENT_COUNT_SENSITIVITY_SEEDS))\n                      & (primary[\"method\"].isin(CLIENT_COUNT_SENSITIVITY_METHODS))\n                      & (((primary[\"condition\"] == \"IID\") & primary[\"alpha\"].isna())\n                         | ((primary[\"condition\"] == \"Dirichlet\") & np.isclose(primary[\"alpha\"], 0.5)))]\n    primary = primary.copy()\n    primary[\"partition_protocol\"] = np.where(primary[\"condition\"].eq(\"IID\"), \"balanced_iid\", \"primary_dirichlet_alpha_0.5\")\n    combined = pd.concat([progress, primary], ignore_index=True, sort=False)\n    combined = combined.drop_duplicates([\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"], keep=\"last\")\n    expected_total = 3 * len(CLIENT_COUNT_SENSITIVITY_SEEDS) * len(CLIENT_COUNT_SENSITIVITY_CONDITIONS) * len(CLIENT_COUNT_SENSITIVITY_METHODS)\n    if len(combined) != expected_total:\n        raise RuntimeError(f\"Expected {expected_total} valid combined sensitivity rows, found {len(combined)}\")\n    atomic_to_csv(progress, CLIENT_SENS_NEW_FINAL)\n    atomic_to_csv(combined.sort_values([\"n_clients\", \"condition\", \"alpha\", \"method\", \"seed\"]), CLIENT_SENS_FINAL)\n    print(\"Valid client-count sensitivity exported:\", len(combined), \"rows.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T11:16:21.163478Z","iopub.execute_input":"2026-10-10T11:16:21.163826Z","iopub.status.idle":"2026-10-10T11:27:14.344249Z","shell.execute_reply.started":"2026-10-10T11:16:21.163796Z","shell.execute_reply":"2026-10-10T11:27:14.343122Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Valid client-count sensitivity exported: 120 rows.\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# 19C. Blocked centralized sensitivity — checkpointed, no FL retraining\nBLOCKS = 5\nBLOCKED_PROGRESS = RESULTS_DIR / \"blocked_centralized_sensitivity_progress_v3.csv\"\nBLOCKED_FINAL = RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\"\n\nRUN_BLOCKED_CENTRAL = True\n\nif RUN_BLOCKED_CENTRAL:\n    blocked_progress = load_checkpoint(BLOCKED_PROGRESS)\n    block_id = np.minimum(np.arange(len(df)) * BLOCKS // len(df), BLOCKS - 1)\n    for b in range(BLOCKS):\n        if not blocked_progress.empty and (blocked_progress[\"block\"].astype(int) == b).any():\n            print(\"SKIP blocked block\", b)\n            continue\n        train_mask = block_id != b; test_mask = block_id == b\n        tr = df.loc[train_mask].copy(); te = df.loc[test_mask].copy()\n        fold_pre = build_fold_preprocessor(tr)\n\n        tree_pipe = Pipeline([\n            (\"pre\", build_fold_preprocessor(tr)),\n            (\"clf\", DecisionTreeClassifier(max_depth=3, random_state=SEED)),\n        ])\n        tree_pipe.fit(tr[EXPECTED_FEATURES], tr[TARGET])\n        tree_pred = tree_pipe.predict(te[EXPECTED_FEATURES])\n\n        et_pipe = Pipeline([\n            (\"pre\", build_fold_preprocessor(tr)),\n            (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1)),\n        ])\n        et_pipe.fit(tr[EXPECTED_FEATURES], tr[TARGET])\n        et_pred = et_pipe.predict(te[EXPECTED_FEATURES])\n\n        rows=[\n            {\"block\":b,\"model\":\"DecisionTree_depth3\",\"n_train\":len(tr),\"n_test\":len(te),\n             \"test_label1_rate\":float(te[TARGET].mean()),\"accuracy\":accuracy_score(te[TARGET],tree_pred),\n             \"balanced_accuracy\":balanced_accuracy_score(te[TARGET],tree_pred),\"f1\":f1_score(te[TARGET],tree_pred,zero_division=0),\"mcc\":matthews_corrcoef(te[TARGET],tree_pred)},\n            {\"block\":b,\"model\":\"ExtraTrees\",\"n_train\":len(tr),\"n_test\":len(te),\n             \"test_label1_rate\":float(te[TARGET].mean()),\"accuracy\":accuracy_score(te[TARGET],et_pred),\n             \"balanced_accuracy\":balanced_accuracy_score(te[TARGET],et_pred),\"f1\":f1_score(te[TARGET],et_pred,zero_division=0),\"mcc\":matthews_corrcoef(te[TARGET],et_pred)},\n        ]\n        blocked_progress = upsert_checkpoint(BLOCKED_PROGRESS, rows, [\"block\", \"model\"])\n        print(f\"Blocked checkpoint: block {b}, {len(blocked_progress)} rows\")\n    atomic_to_csv(blocked_progress, BLOCKED_FINAL)\n    blocked_central = blocked_progress.copy()\n    display(blocked_central)\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T08:08:26.641814Z","iopub.status.busy":"2026-10-06T08:08:26.641295Z","iopub.status.idle":"2026-10-06T08:08:32.739132Z","shell.execute_reply":"2026-10-06T08:08:32.738524Z","shell.execute_reply.started":"2026-10-06T08:08:26.641785Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 20. Differential privacy\n\nThe DP mechanism is record/row-level DP-SGD with cumulative RDP accounting. The finite-ε runs are the expensive DP component and are independently checkpointed after every seed × ε × method run. The ε=∞ rows are newly trained matched non-private controls using the same Poisson sampling and expected-batch normalization as the private runs, with clipping and noise disabled.","metadata":{}},{"cell_type":"code","source":"# 20A. Corrected DP smoke tests — private mechanism + matched non-private control\nRUN_DP_SMOKE = True\nif RUN_DP_SMOKE:\n    smoke_parts = balanced_iid_partition(y_train, N_CLIENTS, seed=0)\n    smoke_private = run_federated_dp(\n        X_train, y_train, X_test, y_test, smoke_parts, \"FedAvg\", 0,\n        rounds=2, local_epochs=1, batch_size=32, target_epsilon=5.0\n    )\n    assert smoke_private[\"dp_enabled\"] is True\n    assert np.isfinite(smoke_private[\"max_client_achieved_epsilon\"])\n    assert smoke_private[\"max_client_achieved_epsilon\"] <= 5.0 + 1e-3, (\n        \"Smoke-test accountant exceeded its target epsilon.\"\n    )\n    print(\"PRIVATE DP SMOKE TEST PASSED:\", smoke_private)\n\n    smoke_control = run_federated_dp(\n        X_train, y_train, X_test, y_test, smoke_parts, \"FedAvg\", 0,\n        rounds=2, local_epochs=1, batch_size=32, target_epsilon=None\n    )\n    assert smoke_control[\"dp_enabled\"] is False\n    assert np.isinf(smoke_control[\"target_epsilon\"])\n    assert smoke_control[\"mean_client_sigma\"] == 0.0\n    print(\"MATCHED NON-PRIVATE CONTROL SMOKE TEST PASSED:\", smoke_control)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:40:19.25582Z","iopub.execute_input":"2026-10-10T08:40:19.256356Z","iopub.status.idle":"2026-10-10T08:40:20.91242Z","shell.execute_reply.started":"2026-10-10T08:40:19.256332Z","shell.execute_reply":"2026-10-10T08:40:20.911301Z"},"trusted":true},"outputs":[{"name":"stdout","text":"PRIVATE DP SMOKE TEST PASSED: {'accuracy': 0.5340272217774219, 'balanced_accuracy': np.float64(0.5153145865434001), 'f1': 0.0732484076433121, 'precision': 0.8214285714285714, 'recall': 0.03833333333333333, 'mcc': np.float64(0.10337044789050098), 'auroc': np.float64(0.6897971237801745), 'method': 'FedAvg', 'seed': 0, 'target_epsilon': 5.0, 'max_client_achieved_epsilon': 5.0, 'mean_client_sigma': 0.9043349715367499, 'min_client_sample_rate': 0.064, 'max_client_sample_rate': 0.06412825651302605, 'min_client_steps_full_run': 32, 'max_client_steps_full_run': 32, 'dp_enabled': True, 'dp_protocol_version': 'v2_poisson_expected_batch_sum_noise_matched_control', 'dp_rng_mode': 'os.urandom + Box-Muller (OS-CSPRNG-backed)', 'nonprivate_control_protocol': 'not_applicable_private_run'}\nMATCHED NON-PRIVATE CONTROL SMOKE TEST PASSED: {'accuracy': 0.7389911929543634, 'balanced_accuracy': np.float64(0.7305983564458141), 'f1': 0.6553911205073996, 'precision': 0.8959537572254336, 'recall': 0.5166666666666667, 'mcc': np.float64(0.5148755303427366), 'auroc': np.float64(0.7748574730354392), 'method': 'FedAvg', 'seed': 0, 'target_epsilon': inf, 'max_client_achieved_epsilon': nan, 'mean_client_sigma': 0.0, 'min_client_sample_rate': 0.064, 'max_client_sample_rate': 0.06412825651302605, 'min_client_steps_full_run': 32, 'max_client_steps_full_run': 32, 'dp_enabled'