        x_adv = (xt.detach() + float(eps) * grad_sign).detach()\n        with torch.no_grad():\n            adv_pred = model(x_adv).argmax(1).cpu().numpy()\n        adv_acc = accuracy_score(y, adv_pred)\n        rows.append({\n            \"attack_epsilon\": float(eps),\n            \"clean_accuracy\": float(clean_acc),\n            \"clean_f1\": float(clean_f1),\n            \"adv_accuracy\": float(adv_acc),\n            \"adv_balanced_accuracy\": float(balanced_accuracy_score(y, adv_pred)),\n            \"adv_f1\": float(f1_score(y, adv_pred, zero_division=0)),\n            \"adv_precision\": float(precision_score(y, adv_pred, zero_division=0)),\n            \"adv_recall\": float(recall_score(y, adv_pred, zero_division=0)),\n            \"adv_mcc\": float(matthews_corrcoef(y, adv_pred)),\n            \"adv_pred_class1_rate\": float(np.mean(adv_pred == 1)),\n            \"accuracy_drop\": float(clean_acc - adv_acc),\n        })\n    return rows\n\nif RUN_FULL_FGSM:\n    fgsm_progress = load_checkpoint(FGSM_PROGRESS_PATH)\n    expected_fgsm = len(FGSM_SEEDS) * len(FGSM_METHODS) * len(FGSM_EPSILONS)\n\n    if not CLEAN_FINAL_PATH.exists():\n        raise FileNotFoundError(f\"Clean FL final results are required before FGSM: {CLEAN_FINAL_PATH}\")\n\n    for seed in FGSM_SEEDS:\n        for method in FGSM_METHODS:\n            state_path = clean_iid_state_path(seed, method)\n            if not state_path.exists():\n                raise FileNotFoundError(\n                    f\"Missing cached clean IID model for seed={seed}, method={method}: {state_path}. \"\n                    \"Complete the clean FL sweep first.\"\n                )\n\n            done = False\n            if not fgsm_progress.empty:\n                done = (\n                    (fgsm_progress[\"seed\"].astype(int) == seed)\n                    & (fgsm_progress[\"method\"] == method)\n                    & fgsm_progress[\"attack_epsilon\"].isin(FGSM_EPSILONS)\n                ).sum() == len(FGSM_EPSILONS)\n            if done:\n                print(f\"SKIP FGSM seed={seed} method={method}\")\n                continue\n\n            payload = torch.load(state_path, map_location=\"cpu\")\n            state = payload[\"state\"] if isinstance(payload, dict) and \"state\" in payload else payload\n            rows = evaluate_cached_fgsm(state, X_test, y_test, FGSM_EPSILONS)\n            for row in rows:\n                row.update({\"seed\": int(seed), \"method\": method})\n\n            fgsm_progress = upsert_checkpoint(\n                FGSM_PROGRESS_PATH, rows, [\"seed\", \"method\", \"attack_epsilon\"]\n            )\n            print(f\"FGSM CHECKPOINT: {len(fgsm_progress)}/{expected_fgsm} rows\")\n\n    if len(fgsm_progress) == expected_fgsm:\n        atomic_to_csv(\n            fgsm_progress.sort_values([\"method\", \"attack_epsilon\", \"seed\"]),\n            FGSM_FINAL_PATH\n        )\n        print(\"FGSM COMPLETE:\", len(fgsm_progress), \"rows ->\", FGSM_FINAL_PATH)\n        display(\n            fgsm_progress.groupby([\"method\", \"attack_epsilon\"]).agg(\n                clean_accuracy_mean=(\"clean_accuracy\", \"mean\"),\n                adv_accuracy_mean=(\"adv_accuracy\", \"mean\"),\n                adv_accuracy_std=(\"adv_accuracy\", \"std\"),\n                accuracy_drop_mean=(\"accuracy_drop\", \"mean\"),\n                accuracy_drop_std=(\"accuracy_drop\", \"std\"),\n                n=(\"seed\", \"count\")\n            ).reset_index()\n        )\n    else:\n        print(\"FGSM INCOMPLETE; progress retained at:\", FGSM_PROGRESS_PATH)\n","metadata":{"trusted":true,"execution":{"execution_failed":"2026-10-06T11:23:44.503Z"}},"outputs":[],"execution_count":null},{"id":"4b9b7525","cell_type":"markdown","source":"## 22. Final statistical analyses and publication exports\n\nThese cells perform analysis only. They do not retrain any models.","metadata":{}},{"id":"2017105d","cell_type":"code","source":"# 22A. Recompute clean statistics from the saved final file\nclean_results = pd.read_csv(CLEAN_FINAL_PATH)\nexpected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\nassert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n\nMETRICS = [\"accuracy\",\"balanced_accuracy\",\"f1\",\"precision\",\"recall\",\"mcc\",\"auroc\"]\nfrom scipy.stats import t, wilcoxon\n\ndef summarize_metric(data, group_cols, metric):\n    rows=[]\n    for keys,g in data.groupby(group_cols, dropna=False):\n        vals=g[metric].dropna().to_numpy(); n=len(vals)\n        if n<2: continue\n        mean=float(vals.mean()); std=float(vals.std(ddof=1)); sem=std/np.sqrt(n)\n        margin=float(t.ppf(0.975,n-1)*sem)\n        if not isinstance(keys,tuple): keys=(keys,)\n        row=dict(zip(group_cols,keys)); row.update({\"metric\":metric,\"n\":n,\"mean\":mean,\"std\":std,\"ci95_low\":mean-margin,\"ci95_high\":mean+margin,\"ci95_half_width\":margin}); rows.append(row)\n    return pd.DataFrame(rows)\n\nmetric_summary=pd.concat([summarize_metric(clean_results,[\"condition\",\"alpha\",\"method\"],m) for m in METRICS],ignore_index=True)\naccuracy_summary=metric_summary[metric_summary[\"metric\"]==\"accuracy\"].copy()\nfor c in [\"mean\",\"std\",\"ci95_low\",\"ci95_high\"]:\n    accuracy_summary[c+\"_percent\"]=accuracy_summary[c]*100\n\n# Paired Wilcoxon tests vs FedAvg within every fixed condition.\ncomparison_rows=[]\nfor (condition,alpha),g in clean_results.groupby([\"condition\",\"alpha\"],dropna=False):\n    base=g[g[\"method\"]==\"FedAvg\"].set_index(\"seed\")\n    for method in [m for m in METHODS if m!=\"FedAvg\"]:\n        cur=g[g[\"method\"]==method].set_index(\"seed\")\n        common=sorted(set(base.index)&set(cur.index))\n        for metric in [\"accuracy\",\"f1\"]:\n            a=base.loc[common,metric].to_numpy(); b=cur.loc[common,metric].to_numpy()\n            stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n            comparison_rows.append({\"condition\":condition,\"alpha\":alpha,\"method_a\":\"FedAvg\",\"method_b\":method,\"metric\":metric,\"n\":len(common),\"mean_diff_b_minus_a\":float(np.mean(b-a)),\"median_diff_b_minus_a\":float(np.median(b-a)),\"wilcoxon_p\":float(p)})\naccuracy_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"accuracy\"])\nf1_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"f1\"])\nall_tests=pd.concat([accuracy_tests,f1_tests],ignore_index=True)\nall_tests[\"bh_q\"] = bh_adjust(all_tests[\"wilcoxon_p\"].to_numpy())\n\nmetric_summary.to_csv(RESULTS_DIR/\"clean_metric_summary_v3.csv\",index=False)\naccuracy_summary.to_csv(RESULTS_DIR/\"clean_accuracy_summary_v3.csv\",index=False)\naccuracy_tests.to_csv(RESULTS_DIR/\"clean_paired_accuracy_tests_v3.csv\",index=False)\nf1_tests.to_csv(RESULTS_DIR/\"clean_paired_f1_tests_v3.csv\",index=False)\nprint(\"Clean analysis exported.\")\n","metadata":{"trusted":true,"execution":{"execution_failed":"2026-10-06T11:23:44.503Z"}},"outputs":[],"execution_count":null},{"id":"99a65e36","cell_type":"code","source":"# 22B. Figures — clean heterogeneity, robustness, privacy–utility, FGSM, blocked sensitivity\n\n# Clean accuracy vs alpha\nfig,ax=plt.subplots(figsize=(8,5))\nfor method in METHODS:\n    s=accuracy_summary[(accuracy_summary[\"method\"]==method)&(accuracy_summary[\"condition\"]==\"Dirichlet\")].sort_values(\"alpha\")\n    ax.errorbar(s[\"alpha\"],s[\"mean_percent\"],yerr=[s[\"mean_percent\"]-s[\"ci95_low_percent\"],s[\"ci95_high_percent\"]-s[\"mean_percent\"]],marker=\"o\",capsize=4,label=method)\nax.set_xscale(\"log\"); ax.invert_xaxis(); ax.set_xlabel(\"Dirichlet concentration α\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Federated accuracy under increasing label heterogeneity\"); ax.grid(True,alpha=.25); ax.legend(fontsize=8); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_clean_accuracy_vs_alpha.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# Robustness figure\nrob 