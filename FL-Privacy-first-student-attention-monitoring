NAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_v3.csv\"\n\nROBUST_METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nROBUST_SEEDS = list(range(20))\nROBUST_SCENARIOS = [\n    (\"full_label_flip_20pct_clients\", [0, 1], 1.0, []),\n    (\"full_label_flip_40pct_clients\", [0, 1, 2, 3], 1.0, []),\n    (\"one_straggler_10pct_clients\", [], 0.0, [0]),\n]\n\nclean_results = pd.read_csv(CLEAN_FINAL_PATH)\nrob = pd.read_csv(ROBUST_FINAL_PATH)\nblk = pd.read_csv(BLOCKED_FINAL)\ndp = pd.read_csv(DP_FINAL_PATH)\nfg = pd.read_csv(FGSM_FINAL_PATH)\nclient_sens = pd.read_csv(CLIENT_SENS_FINAL) if CLIENT_SENS_FINAL.exists() else None\n\nexpected_clean = len(CFG[\"seeds\"]) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\nexpected_robust = len(ROBUST_SEEDS) * len(ROBUST_SCENARIOS) * len(ROBUST_METHODS)\nassert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\nassert len(rob) == expected_robust, f\"Expected {expected_robust} corrected robustness rows, found {len(rob)}\"\nassert len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 240\nassert len(dp[~np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))]) == 60\nassert len(fg) == 180\nassert len(blk) == 10\nassert client_sens is not None, f\"Run Cell 19B first; missing {CLIENT_SENS_FINAL}\"\nassert len(client_sens) == 180, f\"Expected 180 K=5/10/20 sensitivity rows, found {len(client_sens)}\"\nassert set(pd.to_numeric(client_sens[\"n_clients\"], errors=\"raise\").astype(int).unique()) == {5, 10, 20}\n\n# Save core raw data products.\nmetric_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_clean_benchmark_table.csv\", index=False)\naccuracy_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_accuracy_tests.csv\", index=False)\nf1_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_paired_f1_tests.csv\", index=False)\nrob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_results_corrected.csv\", index=False)\nblk.to_csv(RESULTS_DIR / \"MANUSCRIPT_blocked_sensitivity.csv\", index=False)\ndp.to_csv(RESULTS_DIR / \"MANUSCRIPT_DP_results.csv\", index=False)\nfg.to_csv(RESULTS_DIR / \"MANUSCRIPT_FGSM_results.csv\", index=False)\nclient_sens.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_raw.csv\", index=False)\n\n# Robustness summary table: mean/SD and 95% CI for accuracy, F1, MCC by scenario and method.\nrobust_summary = pd.concat([\n    summarize_metric(rob, [\"scenario\", \"method\"], metric)\n    for metric in [\"accuracy\", \"f1\", \"mcc\"]\n], ignore_index=True)\nrobust_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_corrected.csv\", index=False)\n\n# Client-count summary table: mean/SD/95% CI for accuracy, F1 and balanced accuracy.\nclient_sens_summary = pd.concat([\n    summarize_metric(client_sens, [\"n_clients\", \"condition\", \"alpha\", \"method\"], metric)\n    for metric in [\"accuracy\", \"f1\", \"balanced_accuracy\"]\n], ignore_index=True)\nclient_sens_summary.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_sensitivity_summary.csv\", index=False)\n\n# Paired Wilcoxon tests; BH correction is applied over all tests within each family.\ndef _bh_qvalues(p_values):\n    p = np.asarray(p_values, dtype=float)\n    q = np.full(p.shape, np.nan, dtype=float)\n    finite = np.isfinite(p)\n    pv = p[finite]\n    if pv.size == 0:\n        return q\n    order = np.argsort(pv)\n    ranked = pv[order]\n    adjusted = ranked * len(ranked) / np.arange(1, len(ranked) + 1)\n    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1]\n    unorder = np.empty_like(adjusted)\n    unorder[order] = np.clip(adjusted, 0, 1)\n    q[finite] = unorder\n    return q\n\ndef _paired_method_tests(frame, group_cols, methods_to_compare, metrics, method_col=\"method\"):\n    rows = []\n    for group_key, group in frame.groupby(group_cols, dropna=False):\n        if not isinstance(group_key, tuple):\n            group_key = (group_key,)\n        group_values = dict(zip(group_cols, group_key))\n        base = group[group[method_col].eq(\"FedAvg\")].set_index(\"seed\")\n        for method in methods_to_compare:\n            current = group[group[method_col].eq(method)].set_index(\"seed\")\n            common = sorted(set(base.index).intersection(current.index))\n            for metric in metrics:\n                if len(common) < 2:\n                    continue\n                a = base.loc[common, metric].astype(float).to_numpy()\n                b = current.loc[common, metric].astype(float).to_numpy()\n                diff = b - a\n                p = 1.0 if np.allclose(diff, 0) else float(wilcoxon(a, b, zero_method=\"wilcox\").pvalue)\n                rows.append({\n                    **group_values, \"method_a\": \"FedAvg\", \"method_b\": method,\n                    \"metric\": metric, \"n_pairs\": len(common),\n                    \"mean_diff_method_b_minus_fedavg\": float(np.mean(diff)),\n                    \"median_diff_method_b_minus_fedavg\": float(np.median(diff)),\n                    \"wilcoxon_p\": p,\n                })\n    out = pd.DataFrame(rows)\n    if not out.empty:\n        out[\"bh_q\"] = _bh_qvalues(out[\"wilcoxon_p\"].to_numpy())\n        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n    return out\n\nrobustness_tests = _paired_method_tests(\n    rob, [\"scenario\"], [m for m in ROBUST_METHODS if m != \"FedAvg\"], [\"accuracy\", \"f1\"]\n)\nrobustness_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_paired_tests_BH.csv\", index=False)\n\nclient_sensitivity_tests = _paired_method_tests(\n    client_sens, [\"n_clients\", \"condition\", \"alpha\"], [\"CAFAD\"], [\"accuracy\", \"f1\"]\n)\nclient_sensitivity_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_paired_tests_BH.csv\", index=False)\n\ncompact_rob = rob.groupby([\"scenario\", \"method\"])[[\"accuracy\", \"f1\", \"mcc\"]].agg([\"mean\", \"std\"]).reset_index()\ncompact_rob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_compact_corrected.csv\", index=False)\n\n# Final completeness manifest. Resolve device from the active runtime instead of a stale None value.\nactive_device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nfinal_manifest = {\n    \"clean_rows\": int(len(clean_results)),\n    \"robustness_rows_corrected\": int(len(rob)),\n    \"robustness_protocol\": \"20% and 40% of clients with fully flipped local training labels; one straggler\",\n    \"blocked_rows\": int(len(blk)),\n    \"dp_private_rows\": int(len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))])),\n    \"dp_nonprivate_rows\": int(len(dp[~np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))])),\n    \"fgsm_rows\": int(len(fg)),\n    \"n_clients_primary\": 10,\n    \"client_count_sensitivity_rows\": int(len(client_sens)),\n    \"client_count_values\": sorted(pd.to_numeric(client_sens[\"n_clients\"], errors=\"raise\").astype(int).unique().tolist()),\n    \"device_available_at_finalization\": str(active_device),\n    \"results_dir\": str(RESULTS_DIR),\n}\natomic_to_csv(pd.DataFrame([final_manifest]), RESULTS_DIR / \"FINAL_COMPLETENESS_CHECK.csv\")\nwith open(RESULTS_DIR / \"FINAL_COMPLETENESS_CHECK.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(final_manifest, f, indent=2)\nprint(json.dumps(final_manifest, indent=2))\nprint(\"\\nCORRECTED ROBUSTNESS, CLIENT-COUNT SENSITIVITY, FIGURES, AND TABLES EXPORTED.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T08:48:23.143104Z","iopub.execute_input":"2026-10-09T08:48:23.143519Z","iopub.status.idle":"2026-10-09T08:48:26.820845Z","shell.execute_reply.started":"2026-10-09T08:48:23.143481Z","shell.execute_reply":"2026-10-09T08:48:26.819957Z"}},"outputs":[{"name":"stdout","text":"{\n  \"clean_rows\": 600,\n  \"robustness_rows_corrected\": 300,\n  \"robustness_protocol\": \"20% and 40% of clients with fully flipped local training labels; one straggler\",\n  \"blocked_rows\": 10,\n  \"dp_private_rows\": 240,\n  \"dp_non