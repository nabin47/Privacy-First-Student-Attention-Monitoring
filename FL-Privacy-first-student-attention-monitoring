"TRIM_FRACTION = 0.20\n","KRUM_F = 3\n","\n","LR_TOLERANCE = 0.003\n","DP_LR_TOLERANCE = 0.003\n","\n","DP_DELTA = 1e-5\n","DP_MAX_GRAD_NORM = 1.0\n","DP_TARGET_EPS = [0.5, 1.0, 2.0, 5.0]\n","\n","PARTITION_MIN_SIZE = 10\n","PARTITION_MAX_TRIES = 5000\n","\n","EXPERIMENT_TAG = \"revision\"\n","RESULTS_DIR = Path(f\"/kaggle/working/attention_fl_v3_{EXPERIMENT_TAG}_results\")\n","RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","DEVICE = None\n","\n","np.random.seed(SEED)\n","random.seed(SEED)\n","\n","print(\"RUN_MODE:\", RUN_MODE)\n","print(\"CFG:\", CFG)\n","print(\"RESULTS_DIR:\", RESULTS_DIR)"]},{"cell_type":"code","execution_count":2,"id":"013fcb60","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:19.671986Z","iopub.status.busy":"2026-11-18T20:05:19.671558Z","iopub.status.idle":"2026-11-18T20:05:26.204469Z","shell.execute_reply":"2026-11-18T20:05:26.203291Z"},"papermill":{"duration":6.541845,"end_time":"2026-11-18T20:05:26.206363","exception":false,"start_time":"2026-11-18T20:05:19.664518","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["sklearn: 1.6.1\n","torch: 2.9.0+cpu\n","scipy: 1.16.3\n","DEVICE: cpu\n"]}],"source":["# 2. Imports\n","import sklearn\n","from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score\n","from sklearn.compose import ColumnTransformer\n","from sklearn.pipeline import Pipeline\n","from sklearn.preprocessing import OneHotEncoder, StandardScaler\n","from sklearn.impute import SimpleImputer\n","from sklearn.metrics import (\n","    accuracy_score, balanced_accuracy_score, f1_score,\n","    precision_score, recall_score, matthews_corrcoef,\n","    roc_auc_score\n",")\n","from sklearn.tree import DecisionTreeClassifier\n","from sklearn.ensemble import ExtraTreesClassifier\n","from sklearn.cluster import MiniBatchKMeans\n","\n","import scipy\n","from scipy.special import gammaln, logsumexp\n","from scipy.stats import wilcoxon\n","\n","import torch\n","from torch import nn\n","from torch.utils.data import TensorDataset, DataLoader\n","from torch.func import functional_call, grad, vmap\n","\n","import matplotlib.pyplot as plt\n","\n","print(\"sklearn:\", sklearn.__version__)\n","print(\"torch:\", torch.__version__)\n","print(\"scipy:\", scipy.__version__)\n","\n","\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","if DEVICE.type == \"cuda\":\n","    torch.backends.cudnn.benchmark = True\n","print(\"DEVICE:\", DEVICE)"]},{"cell_type":"code","execution_count":3,"id":"f95beede","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:26.219962Z","iopub.status.busy":"2026-11-18T20:05:26.219328Z","iopub.status.idle":"2026-11-18T20:05:26.57225Z","shell.execute_reply":"2026-11-18T20:05:26.571207Z"},"papermill":{"duration":0.361904,"end_time":"2026-11-18T20:05:26.574082","exception":false,"start_time":"2026-11-18T20:05:26.212178","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["xgboost: 3.1.3\n"]}],"source":["# 2B. Extra imports for the revision\n","from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier, HistGradientBoostingClassifier\n","from sklearn.neighbors import KNeighborsClassifier\n","try:\n","    from xgboost import XGBClassifier\n","    import xgboost\n","    XGB_AVAILABLE = True\n","    print(\"xgboost:\", xgboost.__version__)\n","except Exception as e:\n","    XGB_AVAILABLE = False\n","    print(\"xgboost not available:\", e)\n","try:\n","    from IPython.display import display\n","except Exception:\n","    display = print"]},{"cell_type":"code","execution_count":4,"id":"2677cfb2","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:26.587782Z","iopub.status.busy":"2026-11-18T20:05:26.587285Z","iopub.status.idle":"2026-11-18T20:05:28.246495Z","shell.execute_reply":"2026-11-18T20:05:28.244658Z"},"papermill":{"duration":1.670115,"end_time":"2026-11-18T20:05:28.250034","exception":false,"start_time":"2026-11-18T20:05:26.579919","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Loaded: /kaggle/input/datasets/ahmednabin47/attention-detection-dataset-v3/attention_detection_dataset_v3.csv\n","Shape: (6244, 38)\n"]}],"source":["# 3. Exact V3 schema + dataset loader\n","V3_FEATURE_GROUPS = {\n","    \"face\": [\"face_present\",\"no_of_face\",\"face_x\",\"face_y\",\"face_w\",\"face_h\",\"face_conf\"],\n","    \"facial_landmarks\": [\"left_eye_x\",\"left_eye_y\",\"right_eye_x\",\"right_eye_y\",\n","                         \"nose_tip_x\",\"nose_tip_y\",\"mouth_x\",\"mouth_y\"],\n","    \"hands\": [\"hand_count\",\"left_hand_x\",\"left_hand_y\",\"right_hand_x\",\"right_hand_y\",\n","              \"hand_obj_interaction\"],\n","    \"head_pose\": [\"head_pose\",\"head_pitch\",\"head_yaw\",\"head_roll\"],\n","    \"phone\": [\"phone_present\",\"phone_loc_x\",\"phone_loc_y\",\"phone_conf\"],\n","    \"gaze\": [\"gaze_on_screen\",\"gaze_direction\",\"gazePoint_x\",\"gazePoint_y\"],\n","    \"pupils\": [\"pupil_left_x\",\"pupil_left_y\",\"pupil_right_x\",\"pupil_right_y\"],\n","}\n","TARGET = \"label\"\n","EXPECTED_FEATURES = [c for group in V3_FEATURE_GROUPS.values() for c in group]\n","\n","def find_v3_csv():\n","    manual = os.environ.get(\"V3_DATA_PATH\", \"\").strip()\n","    candidates = [Path(manual)] if manual else []\n","    candidates += [Path(\"/kaggle/input\") / p for p in glob.glob(\"/kaggle/input/**/*.csv\", recursive=True)]\n","    candidates += [Path(\"/mnt/data/attention_detection_dataset_v3.csv\")]\n","    for p in candidates:\n","        if p.exists():\n","            try:\n","                cols = pd.read_csv(p, nrows=5).columns.tolist()\n","                if TARGET in cols and all(c in cols for c in EXPECTED_FEATURES):\n","                    return p\n","            except Exception:\n","                pass\n","    raise FileNotFoundError(\"V3 CSV not found. Set V3_DATA_PATH to your Kaggle CSV path.\")\n","\n","DATA_PATH = find_v3_csv()\n","df = pd.read_csv(DATA_PATH)\n","\n","missing_schema = [c for c in EXPECTED_FEATURES + [TARGET] if c not in df.columns]\n","if missing_schema:\n","    raise ValueError(f\"Missing V3 columns: {missing_schema}\")\n","\n","df = df[EXPECTED_FEATURES + [TARGET]].copy()\n","df[TARGET] = df[TARGET].astype(int)\n","\n","print(\"Loaded:\", DATA_PATH)\n","print(\"Shape:\", df.shape)"]},{"cell_type":"code","execution_count":5,"id":"10f72f3b","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.267347Z","iopub.status.busy":"2026-11-18T20:05:28.266992Z","iopub.status.idle":"2026-11-18T20:05:28.364957Z","shell.execute_reply":"2026-11-18T20:05:28.363997Z"},"papermill":{"duration":0.109168,"end_time":"2026-11-18T20:05:28.367136","exception":false,"start_time":"2026-11-18T20:05:28.257968","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train: (4995, 46) Test: (1249, 46)\n","Encoded features: 46\n"]}],"source":["# 5. Leakage-safe train/test preprocessing\n","train_df, test_df = train_test_split(\n","    df, test_size=0.20, stratify=df[TARGET], random_state=SEED\n",")\n","\n","numeric_cols = [c for c in EXPECTED_FEATURES if pd.api.types.is_numeric_dtype(df[c])]\n","categorical_cols = [c for c in EXPECTED_FEATURES if not pd.api.types.is_numeric_dtype(df[c])]\n","\n","try:\n","    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","except TypeError:\n","    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","\n","preprocessor = ColumnTransformer([\n","    (\"num\", Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"scaler\", StandardScaler()),\n","    ]), numeric_cols),\n","    (\"cat\", Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","        (\"onehot\", onehot),\n","    ]), categorical_cols),\n","])\n","\n","X_train = preprocessor.fit_transform(train_df[EXPECTED_FEATURES]).astype(np.float32)\n","X_test = preprocessor.transform(test_df[EXPECTED_FEATURES]).astype(np.float32)\n","y_train = train_df[TARGET].to_numpy(np.int64)\n","y_test = test_df[TARGET].to_numpy(np.int64)\n","FEATURE_NAMES_ENCODED = list(preprocessor.get_feature_names_out())\n","\n","print(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\n","print(\"Encoded features:\", len(FEATURE_NAMES_ENCODED))\n","\n","\n","# Fold-safe preprocessing helper used by blocked sensitivity and any fold-wise audit.\n","# IMPORTANT: the preprocessor is fit only on the supplied training frame, preventing\n","# information from the blocked test fold from entering imputation/scaling/encoding.\n","def build_fold_preprocessor(frame, cols=None):\n","    cols = list(EXPECTED_FEATURES if cols is None else cols)\n","    num_cols = [c for c in cols if pd.api.types.is_numeric_dtype(frame[c])]\n","    cat_cols = [c for c in cols if not pd.api.types.is_numeric_dtype(frame[c])]\n","\n","    try:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","    except TypeError:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","\n","    transformers = []\n","    if num_cols:\n","        transformers.append((\n","            \"num\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"median\")),\n","                (\"scaler\", StandardScaler()),\n","            ]),\n","            num_cols,\n","        ))\n","    if cat_cols:\n","        transformers.append((\n","            \"cat\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","                (\"onehot\", oh),\n","            ]),\n","            cat_cols,\n","        ))\n","\n","    if not transformers:\n","        raise ValueError(\"No usable numeric or categorical columns were supplied.\")\n","\n","    return ColumnTransformer(transformers, remainder=\"drop\")"]},{"cell_type":"code","execution_count":6,"id":"24394cb5","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.382804Z","iopub.status.busy":"2026-11-18T20:05:28.382005Z","iopub.status.idle":"2026-11-18T20:05:28.405398Z","shell.execute_reply":"2026-11-18T20:05:28.404312Z"},"papermill":{"duration":0.033597,"end_time":"2026-11-18T20:05:28.407312","exception":false,"start_time":"2026-11-18T20:05:28.373715","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Partition helpers ready for 10 simulated clients.\n"]}],"source":["# 7A. Partition helpers\n","def balanced_iid_partition(y, n_clients, seed):\n","    rng = np.random.default_rng(seed)\n","    parts = [[] for _ in range(n_clients)]\n","    for cls in np.unique(y):\n","        idx = rng.permutation(np.where(y == cls)[0])\n","        for k, s in enumerate(np.array_split(idx, n_clients)):\n","            parts[k].extend(s.tolist())\n","    return [np.array(sorted(z), dtype=int) for z in parts]\n","\n","\n","def dirichlet_label_partition(\n","    y,\n","    n_clients,\n","    alpha,\n","    seed,\n","    min_size=PARTITION_MIN_SIZE,\n","    max_tries=PARTITION_MAX_TRIES,\n","):\n","    rng = np.random.default_rng(seed)\n","    classes = np.unique(y)\n","    best_parts = None\n","    best_min = -1\n","\n","    for _ in range(max_tries):\n","        parts = [[] for _ in range(n_clients)]\n","\n","        for cls in classes:\n","            idx = rng.permutation(np.where(y == cls)[0])\n","            props = rng.dirichlet(np.ones(n_clients) * alpha)\n","            cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n","            splits = np.split(idx, cuts)\n","            for k, s in enumerate(splits):\n","                parts[k].extend(s.tolist())\n","\n","        sizes = [len(z) for z in parts]\n","        current_min = min(sizes)\n","        if current_min > best_min:\n","            best_min = current_min\n","            best_parts = [list(z) for z in parts]\n","\n","        if current_min >= min_size:\n","            return [np.array(sorted(z), dtype=int) for z in parts]\n","\n","    # Last-resort repair for pathological Dirichlet draws. This only activates\n","    # when the sampled partition cannot satisfy the requested floor after\n","    # max_tries; samples are transferred from the largest client(s) so that\n","    # local training never receives an unusably tiny client.\n","    repaired = [list(z) for z in best_parts]\n","    while min(len(z) for z in repaired) < min_size:\n","        small = int(np.argmin([len(z) for z in repaired]))\n","        donors = np.argsort([len(z) for z in repaired])[::-1]\n","        donor = next(int(d) for d in donors if d != small and len(repaired[d]) > min_size)\n","        need = min_size - len(repaired[small])\n","        take = min(need, len(repaired[donor]) - min_size)\n","        if take <= 0:\n","            raise RuntimeError(\n","                f\"Could not repair Dirichlet partition to min_size={min_size}; \"\n","                f\"client sizes={[len(z) for z in repaired]}\"\n","            )\n","        moved = repaired[donor][-take:]\n","        del repaired[donor][-take:]\n","        repaired[small].extend(moved)\n","\n","    print(\n","        f\"WARNING: alpha={alpha} seed={seed} did not meet min_size={min_size} \"\n","        f\"within {max_tries} draws; repaired best draw to min_client_size={min_size}.\"\n","    )\n","    return [np.array(sorted(z), dtype=int) for z in repaired]\n","\n","\n","def feature_cluster_partition(X, y, n_clients, n_clusters, seed):\n","    km = MiniBatchKMeans(\n","        n_clusters=n_clusters,\n","        random_state=seed,\n","        batch_size=256,\n","        n_init=10,\n","    )\n","    cluster_id = km.fit_predict(X)\n","    rng = np.random.default_rng(seed)\n","    parts = [[] for _ in range(n_clients)]\n","\n","    for c in range(n_clusters):\n","        idx = rng.permutation(np.where(cluster_id == c)[0])\n","        if len(idx) == 0:\n","            continue\n","        props = rng.dirichlet(np.ones(n_clients) * 0.35)\n","        cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n","        for k, s in enumerate(np.split(idx, cuts)):\n","            parts[k].extend(s.tolist())\n","\n","    for k in range(n_clients):\n","        if len(parts[k]) == 0:\n","            donor = int(np.argmax([len(z) for z in parts]))\n","            parts[k].append(parts[donor].pop())\n","\n","    return [np.array(sorted(z), dtype=int) for z in parts], cluster_id\n","\n","\n","def client_summary(parts, y, cluster_id=None):\n","    rows = []\n","    global_rate = float(np.mean(y))\n","\n","    for k, idx in enumerate(parts):\n","        row = {\n","            \"client\": k,\n","            \"n\": len(idx),\n","            \"label1_rate\": float(np.mean(y[idx])),\n","            \"abs_label_shift\": abs(float(np.mean(y[idx])) - global_rate),\n","        }\n","        if cluster_id is not None:\n","            vals, counts = np.unique(cluster_id[idx], return_counts=True)\n","            row[\"n_feature_clusters\"] = len(vals)\n","            row[\"dominant_cluster_share\"] = float(counts.max() / counts.sum())\n","        rows.append(row)\n","\n","    return pd.DataFrame(rows)\n","\n","\n","print(f\"Partition helpers ready for {N_CLIENTS} simulated clients.\")"]},{"cell_type":"code","execution_count":7,"id":"8b5778b3","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.423221Z","iopub.status.busy":"2026-11-18T20:05:28.422293Z","iopub.status.idle":"2026-11-18T20:05:28.436235Z","shell.execute_reply":"2026-11-18T20:05:28.43486Z"},"papermill":{"duration":0.024689,"end_time":"2026-11-18T20:05:28.438543","exception":false,"start_time":"2026-11-18T20:05:28.413854","status":"completed"},"tags":[]},"outputs":[],"source":["# 8. PyTorch model + utilities\n","\n","def seed_everything(seed):\n","    random.seed(seed)\n","    np.random.seed(seed)\n","    torch.manual_seed(seed)\n","    if torch.cuda.is_available():\n","        torch.cuda.manual_seed_all(seed)\n","\n","class MLP(nn.Module):\n","    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, hidden1), nn.ReLU(),\n","            nn.Linear(hidden1, hidden2), nn.ReLU(),\n","            nn.Linear(hidden2, 2)\n","        )\n","    def forward(self, x):\n","        return self.net(x)\n","\n","def clone_state_dict(model):\n","    # Always checkpoint on CPU so files remain portable across Kaggle sessions.\n","    return {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n","\n","def load_state_dict_device(model, state):\n","    model.load_state_dict({k: v.to(DEVICE) for k, v in state.items()})\n","\n","def load_state_dict_cpu(model, state):\n","    # Backward-compatible alias used by the existing analysis code.\n","    load_state_dict_device(model, state)\n","\n","def evaluate_state(state, X, y):\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, state)\n","    model.eval()\n","    with torch.no_grad():\n","        xt = torch.from_numpy(np.asarray(X, dtype=np.float32)).to(DEVICE)\n","        logits = model(xt)\n","        prob = torch.softmax(logits, dim=1)[:, 1].detach().cpu().numpy()\n","        pred = logits.argmax(1).detach().cpu().numpy()\n","    return {\n","        \"accuracy\": accuracy_score(y, pred),\n","        \"balanced_accuracy\": balanced_accuracy_score(y, pred),\n","        \"f1\": f1_score(y, pred, zero_division=0),\n","        \"precision\": precision_score(y, pred, zero_division=0),\n","        \"recall\": recall_score(y, pred, zero_division=0),\n","        \"mcc\": matthews_corrcoef(y, pred),\n","        \"auroc\": roc_auc_score(y, prob) if len(np.unique(y)) == 2 and np.isfinite(prob).all() else np.nan,\n","        \"nonfinite_output\": bool(not np.isfinite(prob).all()),\n","    }"]},{"cell_type":"code","execution_count":8,"id":"7ad28b6e","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.454908Z","iopub.status.busy":"2026-11-18T20:05:28.453773Z","iopub.status.idle":"2026-11-18T20:05:28.477397Z","shell.execute_reply":"2026-11-18T20:05:28.476216Z"},"papermill":{"duration":0.034689,"end_time":"2026-11-18T20:05:28.480074","exception":false,"start_time":"2026-11-18T20:05:28.445385","status":"completed"},"tags":[]},"outputs":[],"source":["# 9. Local training (non-DP)\n","def local_train(\n","    global_state,\n","    X,\n","    y,\n","    client_idx,\n","    seed,\n","    epochs=2,\n","    batch_size=64,\n","    lr=LR,\n","    prox_mu=0.0,\n","    corrupt_rate=0.0,\n","    straggler=False\n","):\n","    seed_everything(seed)\n","\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, global_state)\n","    model.train()\n","\n","    idx = np.asarray(client_idx, dtype=int).copy()\n","    if len(idx) < 2:\n","        raise ValueError(f\"Client has only {len(idx)} samples; too small for local training.\")\n","\n","    rng = np.random.default_rng(seed)\n","    rng.shuffle(idx)\n","\n","    client_y = y[idx]\n","    classes, counts = np.unique(client_y, return_counts=True)\n","    n_classes = len(classes)\n","    val_n = max(1, int(round(0.20 * len(idx))))\n","\n","    can_stratify = (\n","        n_classes == 2\n","        and int(counts.min()) >= 2\n","        and val_n >= 2\n","        and (len(idx) - val_n) >= 2\n","    )\n","\n","    if can_stratify:\n","        tr_idx, va_idx = train_test_split(\n","            idx, test_size=0.20, stratify=client_y, random_state=seed\n","        )\n","    elif n_classes == 2 and int(counts.min()) == 1:\n","        rare_class = classes[np.argmin(counts)]\n","        rare_idx = idx[client_y == rare_class]\n","        common_idx = idx[client_y != rare_class]\n","        rng.shuffle(common_idx)\n","        val_n = min(max(1, int(round(0.20 * len(idx)))), max(1, len(common_idx) - 1))\n","        va_idx = common_idx[:val_n]\n","        tr_idx = np.concatenate([rare_idx, common_idx[val_n:]])\n","        rng.shuffle(tr_idx)\n","    else:\n","        cut = max(1, min(len(idx) - 1, int(round(0.80 * len(idx)))))\n","        tr_idx, va_idx = idx[:cut], idx[cut:]\n","\n","    y_local = y[tr_idx].copy()\n","    if corrupt_rate > 0:\n","        corrupt_mask = rng.random(len(y_local)) < corrupt_rate\n","        y_local[corrupt_mask] = 1 - y_local[corrupt_mask]\n","\n","    x_tensor = torch.from_numpy(np.asarray(X[tr_idx], dtype=np.float32))\n","    y_tensor = torch.from_numpy(np.asarray(y_local, dtype=np.int64))\n","    ds = TensorDataset(x_tensor, y_tensor)\n","    loader = DataLoader(\n","        ds, batch_size=min(batch_size, len(ds)), shuffle=True,\n","        drop_last=False, pin_memory=(DEVICE.type == \"cuda\")\n","    )\n","\n","    optimizer = torch.optim.SGD(model.parameters(), lr=lr)\n","    criterion = nn.CrossEntropyLoss()\n","    n_epochs = 1 if straggler else epochs\n","\n","    global_tensors = {\n","        name: p.detach().clone()\n","        for name, p in model.named_parameters()\n","        if p.requires_grad\n","    }\n","\n","    for _ in range(n_epochs):\n","        for xb, yb in loader:\n","            xb = xb.to(DEVICE, non_blocking=True)\n","            yb = yb.to(DEVICE, non_blocking=True)\n","            optimizer.zero_grad(set_to_none=True)\n","            loss = criterion(model(xb), yb)\n","            if prox_mu > 0:\n","                prox = 0.0\n","                for name, p in model.named_parameters():\n","                    if p.requires_grad:\n","                        prox = prox + torch.sum((p - global_tensors[name]) ** 2)\n","                loss = loss + 0.5 * prox_mu * prox\n","            loss.backward()\n","            optimizer.step()\n","\n","    model.eval()\n","    with torch.no_grad():\n","        xv = torch.from_numpy(np.asarray(X[va_idx], dtype=np.float32)).to(DEVICE)\n","        pred = model(xv).argmax(dim=1).detach().cpu().numpy()\n","    y_val = y[va_idx].copy()\n","    if CONSISTENT_VAL_LABELS and corrupt_rate > 0:\n","        val_mask = rng.random(len(y_val)) < corrupt_rate\n","        y_val[val_mask] = 1 - y_val[val_mask]\n","    val_acc = accuracy_score(y_val, pred)\n","\n","    return clone_state_dict(model), float(val_acc), len(tr_idx)\n","\n","def train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n","                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n","    corrupt_clients = set(corrupt_clients or [])\n","    straggler_clients = set(straggler_clients or [])\n","    states, val_accs, ns = [], [], []\n","    for k, idx in enumerate(parts):\n","        prox = PROX_MU if method == \"FedProx\" else 0.0\n","        st, acc, n = local_train(\n","            global_state, X, y, idx, seed + k, epochs=epochs, batch_size=batch_size,\n","            lr=LR, prox_mu=prox,\n","            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n","            straggler=(k in straggler_clients)\n","        )\n","        if k in corrupt_clients and POISONED_REPORTED_ACC is not None:\n","            acc = float(POISONED_REPORTED_ACC)\n","        states.append(st); val_accs.append(acc); ns.append(n)\n","    return states, val_accs, ns"]},{"cell_type":"code","execution_count":9,"id":"386f725a","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.495879Z","iopub.status.busy":"2026-11-18T20:05:28.49538Z","iopub.status.idle":"2026-11-18T20:05:28.514818Z","shell.execute_reply":"2026-11-18T20:05:28.513602Z"},"papermill":{"duration":0.030468,"end_time":"2026-11-18T20:05:28.517212","exception":false,"start_time":"2026-11-18T20:05:28.486744","status":"completed"},"tags":[]},"outputs":[],"source":["# 10. Aggregators\n","def aggregate_fedavg(states, ns):\n","    total=float(sum(ns))\n","    return {k:sum(states[i][k]*(ns[i]/total) for i in range(len(states))) for k in states[0]}\n","\n","def aggregate_median(states):\n","    return {k:torch.median(torch.stack([s[k] for s in states]),dim=0).values for k in states[0]}\n","\n","def aggregate_trimmed_mean(states, trim_fraction=0.2):\n","    n=len(states); trim=int(math.floor(n*trim_fraction))\n","    if 2*trim>=n: return aggregate_median(states)\n","    out={}\n","    for k in states[0]:\n","        t=torch.stack([s[k] for s in states])\n","        t,_=torch.sort(t,dim=0)\n","        out[k]=t[trim:n-trim].mean(dim=0)\n","    return out\n","\n","def aggregate_cafad(states, ns, val_accs, beta=CAFAD_BETA, z=CAFAD_Z):\n","    c=np.asarray(val_accs,float); mu=float(c.mean()); sd=float(c.std())\n","    mask=np.ones(len(c),dtype=bool) if sd<1e-12 else (c >= mu-z*sd)\n","    if not mask.any(): mask[:]=True\n","    logits=beta*(c-c.max())\n","    raw=np.asarray(ns,float)*np.exp(logits)*mask.astype(float)\n","    if raw.sum()<=0: raw=np.asarray(ns,float)\n","    w=raw/raw.sum()\n","    return ({k:sum(states[i][k]*float(w[i]) for i in range(len(states))) for k in states[0]}, w, mask)\n","\n","def aggregate_multikrum(states, f=1):\n","    n=len(states)\n","    if n<=2*f+2: return aggregate_fedavg(states,[1]*n)\n","    V=torch.stack([torch.cat([s[k].reshape(-1).float() for k in s]) for s in states])\n","    d=torch.cdist(V,V,p=2)**2\n","    scores=[]\n","    for i in range(n):\n","        others=torch.cat([d[i,:i],d[i,i+1:]])\n","        scores.append(torch.topk(others,k=n-f-2,largest=False).values.sum().item())\n","    chosen=np.argsort(scores)[:n-f]\n","    chosen_states=[states[int(i)] for i in chosen]\n","    return aggregate_fedavg(chosen_states,[1]*len(chosen_states))\n","\n","def aggregate_median_true(states):\n","    out={}\n","    for k in states[0]:\n","        t,_=torch.sort(torch.stack([s[k] for s in states]),dim=0)\n","        n=t.shape[0]\n","        out[k]=t[n//2] if n%2 else 0.5*(t[n//2-1]+t[n//2])\n","    return out\n","\n","def aggregate(method, states, ns, val_accs):\n","    if method in (\"FedAvg\",\"FedProx\"): return aggregate_fedavg(states,ns),None,None\n","    if method==\"Median\": return aggregate_median(states),None,None\n","    if method==\"MedianTrue\": return aggregate_median_true(states),None,None\n","    if method==\"MeanUnweighted\": return aggregate_fedavg(states,[1]*len(states)),None,None\n","    if method==\"TrimmedMean\": return aggregate_trimmed_mean(states,TRIM_FRACTION),None,None\n","    if method==\"Krum\": return aggregate_multikrum(states,KRUM_F),None,None\n","    if method==\"CAFAD\":\n","        st,w,mask=aggregate_cafad(states,ns,val_accs); return st,w,mask\n","    raise ValueError(method)"]},{"cell_type":"code","execution_count":10,"id":"123f02a7","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.532987Z","iopub.status.busy":"2026-11-18T20:05:28.532389Z","iopub.status.idle":"2026-11-18T20:05:28.542767Z","shell.execute_reply":"2026-11-18T20:05:28.541698Z"},"papermill":{"duration":0.020359,"end_time":"2026-11-18T20:05:28.544824","exception":false,"start_time":"2026-11-18T20:05:28.524465","status":"completed"},"tags":[]},"outputs":[],"source":["# 11. Federated driver\n","METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","\n","\n","def run_federated(X, y, X_eval, y_eval, parts, method, seed, rounds, local_epochs,\n","                  batch_size, corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n","    seed_everything(seed)\n","    global_state = clone_state_dict(MLP(X.shape[1]).to(DEVICE))\n","    final_weights = None\n","    final_mask = None\n","    history = []\n","\n","    for rnd in range(rounds):\n","        states, val_accs, ns = train_clients_once(\n","            global_state, parts, X, y, seed + rnd * 1000, method,\n","            local_epochs, batch_size,\n","            corrupt_clients=corrupt_clients, corrupt_rate=corrupt_rate,\n","            straggler_clients=straggler_clients\n","        )\n","        global_state, weights, mask = aggregate(method, states, ns, val_accs)\n","        final_weights, final_mask = weights, mask\n","        history.append({\n","            \"round\": rnd + 1,\n","            \"method\": method,\n","            \"seed\": seed,\n","            **evaluate_state(global_state, X_eval, y_eval),\n","            \"mean_client_val_acc\": float(np.mean(val_accs)),\n","            \"std_client_val_acc\": float(np.std(val_accs)),\n","        })\n","\n","    result = evaluate_state(global_state, X_eval, y_eval)\n","    result.update({\n","        \"method\": method,\n","        \"seed\": seed,\n","        \"final_cafad_weight_min\": float(np.min(final_weights)) if final_weights is not None else np.nan,\n","        \"final_cafad_weight_max\": float(np.max(final_weights)) if final_weights is not None else np.nan,\n","        \"final_cafad_masked_clients\": int((~final_mask).sum()) if final_mask is not None else np.nan\n","    })\n","    return result, pd.DataFrame(history), global_state"]},{"cell_type":"code","execution_count":11,"id":"17e1fc60","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.560858Z","iopub.status.busy":"2026-11-18T20:05:28.56026Z","iopub.status.idle":"2026-11-18T20:05:28.581055Z","shell.execute_reply":"2026-11-18T20:05:28.580032Z"},"papermill":{"duration":0.031507,"end_time":"2026-11-18T20:05:28.583127","exception":false,"start_time":"2026-11-18T20:05:28.55162","status":"completed"},"tags":[]},"outputs":[],"source":["# 11B. Checkpoint and test helpers\n","def atomic_to_csv(frame, path):\n","    path = Path(path)\n","    path.parent.mkdir(parents=True, exist_ok=True)\n","    tmp = path.with_suffix(path.suffix + \".tmp\")\n","    frame.to_csv(tmp, index=False)\n","    os.replace(tmp, path)\n","\n","\n","def upsert_checkpoint(path, new_rows, key_cols):\n","    path = Path(path)\n","    current = pd.read_csv(path) if path.exists() else pd.DataFrame()\n","    incoming = pd.DataFrame(new_rows)\n","    merged = pd.concat([current, incoming], ignore_index=True, sort=False)\n","    if key_cols:\n","        merged = merged.drop_duplicates(subset=key_cols, keep=\"last\")\n","    merged = merged.reset_index(drop=True)\n","    atomic_to_csv(merged, path)\n","    return merged\n","\n","\n","def load_checkpoint(path):\n","    path = Path(path)\n","    return pd.read_csv(path) if path.exists() else pd.DataFrame()\n","\n","\n","def done_keys(frame):\n","    return set(frame[\"run_key\"].astype(str)) if \"run_key\" in frame.columns else set()\n","\n","\n","def record(path, row):\n","    return upsert_checkpoint(path, [row], [\"run_key\"])\n","\n","\n","@contextlib.contextmanager\n","def use_settings(lr=None, consistent_val=False, reported_acc=None, dp_lr_by_eps=None):\n","    global LR, CONSISTENT_VAL_LABELS, POISONED_REPORTED_ACC, DP_LR_BY_EPS\n","    old = (LR, CONSISTENT_VAL_LABELS, POISONED_REPORTED_ACC, DP_LR_BY_EPS)\n","    if lr is not None:\n","        LR = float(lr)\n","    CONSISTENT_VAL_LABELS = bool(consistent_val)\n","    POISONED_REPORTED_ACC = reported_acc\n","    if dp_lr_by_eps is not None:\n","        DP_LR_BY_EPS = dict(dp_lr_by_eps)\n","    try:\n","        yield\n","    finally:\n","        LR, CONSISTENT_VAL_LABELS, POISONED_REPORTED_ACC, DP_LR_BY_EPS = old\n","\n","\n","def bh_adjust(pvals):\n","    pvals=np.asarray(pvals,float); n=len(pvals)\n","    if n == 0:\n","        return pvals\n","    order=np.argsort(pvals); ranked=pvals[order]\n","    q=ranked*n/np.arange(1,n+1)\n","    q=np.minimum.accumulate(q[::-1])[::-1]\n","    out=np.empty_like(q); out[order]=q\n","    return np.minimum(out,1.0)\n","\n","\n","def select_lr(frame, group_col, tol):\n","    chosen = {}\n","    for key, g in frame.groupby(group_col):\n","        if \"diverged\" in g.columns:\n","            bad = g.groupby(\"lr\")[\"diverged\"].apply(lambda v: v.fillna(False).astype(bool).any())\n","            g = g[~g[\"lr\"].map(bad)]\n","        m = g.groupby(\"lr\")[\"val_accuracy\"].mean()\n","        chosen[key] = float(min(l for l, v in m.items() if v >= m.max() - tol))\n","    return chosen\n","\n","\n","def mean_sd(frame, by):\n","    g = frame.groupby(by, dropna=False)[\"accuracy\"]\n","    return pd.DataFrame({\"mean\": g.mean() * 100, \"sd\": g.std(ddof=1) * 100,\n","                         \"median\": g.median() * 100, \"n\": g.size()}).round(2).reset_index()\n","\n","\n","def paired_vs(frame, group_cols, arm_col, ref=\"FedAvg\"):\n","    rows = []\n","    for key, g in frame.groupby(group_cols, dropna=False):\n","        key = key if isinstance(key, tuple) else (key,)\n","        a = g[g[arm_col] == ref].set_index(\"seed\")[\"accuracy\"]\n","        for arm in sorted(set(g[arm_col]) - {ref}):\n","            b = g[g[arm_col] == arm].set_index(\"seed\")[\"accuracy\"]\n","            common = sorted(set(a.index) & set(b.index))\n","            if len(common) < 2:\n","                continue\n","            x = a.loc[common].to_numpy(float); z = b.loc[common].to_numpy(float)\n","            p = 1.0 if np.allclose(x, z) else float(wilcoxon(z, x, zero_method=\"wilcox\").pvalue)\n","            rows.append({**dict(zip(group_cols, key)), \"arm\": arm, \"reference\": ref, \"n_pairs\": len(common),\n","                         \"mean_diff_points\": float(np.mean(z - x) * 100), \"wilcoxon_p\": p})\n","    out = pd.DataFrame(rows)\n","    if not out.empty:\n","        out[\"bh_q\"] = bh_adjust(out[\"wilcoxon_p\"].to_numpy())\n","        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n","    return out\n","\n","\n","def single_class(frame):\n","    return int(np.isclose(frame[\"balanced_accuracy\"].astype(float), 0.5).sum())"]},{"cell_type":"code","execution_count":12,"id":"bef38cb4","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.599395Z","iopub.status.busy":"2026-11-18T20:05:28.599003Z","iopub.status.idle":"2026-11-18T20:05:28.850344Z","shell.execute_reply":"2026-11-18T20:05:28.849139Z"},"papermill":{"duration":0.262477,"end_time":"2026-11-18T20:05:28.852587","exception":false,"start_time":"2026-11-18T20:05:28.59011","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Files copied from an earlier run: 0\n"]}],"source":["# 11C. Resume from an earlier version of this notebook (optional)\n","copied = 0\n","for folder in glob.glob(f\"/kaggle/input/**/{RESULTS_DIR.name}\", recursive=True):\n","    for f in glob.glob(os.path.join(folder, \"*\")):\n","        target = RESULTS_DIR / os.path.basename(f)\n","        if os.path.isfile(f) and not target.exists():\n","            shutil.copy2(f, target)\n","            copied += 1\n","print(\"Files copied from an earlier run:\", copied)"]},{"cell_type":"code","execution_count":13,"id":"30780b6f","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.868455Z","iopub.status.busy":"2026-11-18T20:05:28.867931Z","iopub.status.idle":"2026-11-18T20:05:28.898058Z","shell.execute_reply":"2026-11-18T20:05:28.896939Z"},"papermill":{"duration":0.040779,"end_time":"2026-11-18T20:05:28.900097","exception":false,"start_time":"2026-11-18T20:05:28.859318","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torchcsprng is unavailable; using an OS-CSPRNG-backed implementation based on os.urandom for Poisson sampling and Gaussian noise.\n"]}],"source":["# 14A. Integer-order RDP accountant + cached calibration and DP RNG helpers (v2)\n","import secrets\n","import os\n","\n","DP_RDP_ORDERS = list(range(2, 65))\n","DP_CALIBRATION_CACHE = {}\n","DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM = True  # Formal DP runs fail closed unless torchcsprng is available.\n","\n","try:\n","    import torchcsprng as _torchcsprng\n","    DP_TORCHCSPRNG_AVAILABLE = True\n","except Exception:\n","    _torchcsprng = None\n","    DP_TORCHCSPRNG_AVAILABLE = False\n","\n","# os.urandom is backed by the operating system CSPRNG. If torchcsprng is not\n","# installed, use OS-CSPRNG bytes directly for Poisson masks and Gaussian noise.\n","# This avoids silently falling back to a conventional seeded PyTorch PRNG.\n","DP_CSPRNG_AVAILABLE = DP_TORCHCSPRNG_AVAILABLE or hasattr(os, \"urandom\")\n","if not DP_TORCHCSPRNG_AVAILABLE:\n","    print(\n","        \"torchcsprng is unavailable; using an OS-CSPRNG-backed implementation \"\n","        \"based on os.urandom for Poisson sampling and Gaussian noise.\"\n","    )\n","\n","def _os_csprng_uniform(shape):\n","    \"\"\"Generate float64 U(0,1) values from OS-CSPRNG bytes (never NumPy RNG).\"\"\"\n","    count = int(np.prod(shape, dtype=np.int64))\n","    if count == 0:\n","        return np.empty(shape, dtype=np.float64)\n","    raw = os.urandom(count * 8)\n","    vals = np.frombuffer(raw, dtype=np.uint64).copy() >> np.uint64(11)  # 53 random bits\n","    out = (vals.astype(np.float64) + 0.5) / float(2**53)\n","    return out.reshape(shape)\n","\n","def _os_csprng_normal(shape):\n","    \"\"\"Box-Muller standard normals from OS-CSPRNG uniforms.\"\"\"\n","    count = int(np.prod(shape, dtype=np.int64))\n","    if count == 0:\n","        return np.empty(shape, dtype=np.float64)\n","    pairs = (count + 1) // 2\n","    u = _os_csprng_uniform((pairs, 2))\n","    radius = np.sqrt(-2.0 * np.log(u[:, 0]))\n","    angle = 2.0 * np.pi * u[:, 1]\n","    z = np.empty(pairs * 2, dtype=np.float64)\n","    z[0::2] = radius * np.cos(angle)\n","    z[1::2] = radius * np.sin(angle)\n","    return z[:count].reshape(shape)\n","\n","def subsampled_gaussian_rdp(q, sigma, order):\n","    \"\"\"Exact integer-order RDP of the Poisson-subsampled Gaussian mechanism.\"\"\"\n","    a = int(order)\n","    if a < 2:\n","        raise ValueError(\"Integer RDP order must be >= 2.\")\n","    if sigma <= 0:\n","        raise ValueError(\"sigma must be positive for a private mechanism.\")\n","    if q <= 0:\n","        return 0.0\n","    if q >= 1:\n","        return float(a / (2.0 * sigma**2))\n","    i = np.arange(a + 1, dtype=np.float64)\n","    log_comb = gammaln(a + 1) - gammaln(i + 1) - gammaln(a - i + 1)\n","    log_q = i * math.log(q)\n","    log_1q = (a - i) * math.log1p(-q)\n","    exponent = (i * i - i) / (2.0 * sigma**2)\n","    log_a = logsumexp(log_comb + log_q + log_1q + exponent)\n","    return float(log_a / (a - 1))\n","\n","\n","def rdp_epsilon(q, sigma, steps, delta=DP_DELTA, orders=None):\n","    \"\"\"Convert composed RDP to an (epsilon, delta) upper bound.\"\"\"\n","    if not (0.0 < delta < 1.0):\n","        raise ValueError(\"delta must be in (0, 1).\")\n","    if steps <= 0:\n","        raise ValueError(\"steps must be positive.\")\n","    orders = DP_RDP_ORDERS if orders is None else list(orders)\n","    epsilons = [\n","        steps * subsampled_gaussian_rdp(q, sigma, a)\n","        + math.log(1.0 / delta) / (a - 1)\n","        for a in orders\n","    ]\n","    return float(np.min(epsilons))\n","\n","\n","def calibrate_sigma(target_epsilon, q, steps, delta=DP_DELTA):\n","    \"\"\"Find a conservative noise multiplier for the specified full-run budget.\"\"\"\n","    if not np.isfinite(target_epsilon) or target_epsilon <= 0:\n","        raise ValueError(\"target_epsilon must be finite and positive.\")\n","    if not (0.0 < q <= 1.0):\n","        raise ValueError(\"Poisson sample rate q must be in (0, 1].\")\n","\n","    lo, hi = 1e-3, 1.0\n","    while rdp_epsilon(q, hi, steps, delta) > target_epsilon:\n","        hi *= 2.0\n","        if hi > 1e6:\n","            raise RuntimeError(\"Could not bracket a noise multiplier for this budget.\")\n","    # If even the smallest searched multiplier already satisfies the target, keep a valid bracket.\n","    while rdp_epsilon(q, lo, steps, delta) <= target_epsilon and lo > 1e-12:\n","        lo *= 0.5\n","    for _ in range(64):\n","        mid = (lo + hi) / 2.0\n","        if rdp_epsilon(q, mid, steps, delta) > target_epsilon:\n","            lo = mid\n","        else:\n","            hi = mid\n","    return float(hi)\n","\n","\n","def get_dp_client_plan(n, batch_size, total_rounds, local_epochs, target_epsilon,\n","                       delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM):\n","    \"\"\"Plan/cached accounting once for a client-size and protocol combination.\"\"\"\n","    n = int(n)\n","    if n <= 0:\n","        raise ValueError(\"DP client must contain at least one record.\")\n","    q = min(1.0, float(batch_size) / n)\n","    expected_batch_size = q * n  # fixed expected Poisson lot size, never realized lot size\n","    steps_per_epoch = max(1, int(math.ceil(1.0 / q)))\n","    total_steps = int(total_rounds) * int(local_epochs) * steps_per_epoch\n","    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n","    eps_key = None if not private else round(float(target_epsilon), 12)\n","    key = (n, int(batch_size), int(total_rounds), int(local_epochs), eps_key,\n","           float(delta), float(max_grad_norm), tuple(DP_RDP_ORDERS))\n","    if key not in DP_CALIBRATION_CACHE:\n","        if private:\n","            sigma = calibrate_sigma(float(target_epsilon), q, total_steps, delta)\n","            achieved = rdp_epsilon(q, sigma, total_steps, delta)\n","        else:\n","            sigma = 0.0\n","            achieved = np.nan\n","        DP_CALIBRATION_CACHE[key] = {\n","            \"n\": n,\n","            \"q\": float(q),\n","            \"expected_batch_size\": float(expected_batch_size),\n","            \"steps_per_epoch\": steps_per_epoch,\n","            \"total_steps\": total_steps,\n","            \"sigma\": float(sigma),\n","            \"achieved_epsilon\": float(achieved) if np.isfinite(achieved) else np.nan,\n","            \"dp_enabled\": bool(private),\n","            \"target_epsilon\": float(target_epsilon) if private else np.inf,\n","            \"delta\": float(delta),\n","            \"max_grad_norm\": float(max_grad_norm),\n","        }\n","    return dict(DP_CALIBRATION_CACHE[key])\n","\n","\n","def make_dp_random_generator():\n","    \"\"\"Return a cryptographic RNG mode; never silently use a seeded PRNG for DP.\"\"\"\n","    if DP_TORCHCSPRNG_AVAILABLE:\n","        gen = _torchcsprng.create_random_device_generator(\"/dev/urandom\")\n","        return gen, \"torchcsprng:/dev/urandom (CSPRNG)\"\n","    if hasattr(os, \"urandom\"):\n","        return None, \"os.urandom + Box-Muller (OS-CSPRNG-backed)\"\n","    if DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM:\n","        raise RuntimeError(\n","            \"No cryptographically secure random source is available. \"\n","            \"Use a runtime with os.urandom or install a compatible torchcsprng build.\"\n","        )\n","    gen = torch.Generator(device=DEVICE)\n","    gen.manual_seed(secrets.randbits(63))\n","    return gen, \"OS-entropy-seeded PyTorch PRNG (NOT cryptographically secure)\"\n","\n","\n","def _dp_poisson_mask(n, q, generator, rng_mode):\n","    if \"torchcsprng\" in rng_mode:\n","        return (torch.rand(int(n), device=\"cpu\", generator=generator) < q).to(DEVICE)\n","    if \"os.urandom\" in rng_mode:\n","        u = _os_csprng_uniform((int(n),))\n","        return torch.from_numpy(u < float(q)).to(DEVICE)\n","    return torch.rand(int(n), device=DEVICE, generator=generator) < q\n","\n","def _dp_gaussian_noise_like(reference, std, generator, rng_mode):\n","    if \"torchcsprng\" in rng_mode:\n","        noise = torch.empty(tuple(reference.shape), dtype=reference.dtype, device=\"cpu\")\n","        noise.normal_(mean=0.0, std=float(std), generator=generator)\n","        return noise.to(reference.device)\n","    if \"os.urandom\" in rng_mode:\n","        arr = _os_csprng_normal(tuple(reference.shape)) * float(std)\n","        return torch.as_tensor(arr, dtype=reference.dtype, device=reference.device)\n","    noise = torch.empty_like(reference)\n","    noise.normal_(mean=0.0, std=float(std), generator=generator)\n","    return noise"]},{"cell_type":"code","execution_count":14,"id":"eda13b93","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.917035Z","iopub.status.busy":"2026-11-18T20:05:28.916555Z","iopub.status.idle":"2026-11-18T20:05:28.935053Z","shell.execute_reply":"2026-11-18T20:05:28.933931Z"},"papermill":{"duration":0.029557,"end_time":"2026-11-18T20:05:28.937284","exception":false,"start_time":"2026-11-18T20:05:28.907727","status":"completed"},"tags":[]},"outputs":[],"source":["# 14B. Corrected Poisson-sampled DP-SGD: expected-batch denominator + empty-lot noise\n","\n","def dp_local_train(global_state, X, y, client_idx, seed, total_rounds, local_epochs,\n","                   batch_size, target_epsilon, delta=DP_DELTA,\n","                   max_grad_norm=DP_MAX_GRAD_NORM, lr=LR, dp_plan=None):\n","    \"\"\"Train one client's local model. target_epsilon=None disables clipping/noise for a matched control.\"\"\"\n","    seed_everything(seed)  # deterministic model initialization; private RNG is created independently below\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, global_state)\n","    model.train()\n","\n","    idx = np.asarray(client_idx, dtype=int)\n","    if len(idx) == 0:\n","        raise ValueError(\"DP client partition cannot be empty.\")\n","    x_local = torch.from_numpy(np.asarray(X[idx], dtype=np.float32)).to(DEVICE)\n","    y_local = torch.from_numpy(np.asarray(y[idx], dtype=np.int64)).to(DEVICE)\n","    n = len(idx)\n","\n","    plan = dp_plan or get_dp_client_plan(\n","        n, batch_size, total_rounds, local_epochs, target_epsilon, delta, max_grad_norm\n","    )\n","    q = float(plan[\"q\"])\n","    expected_batch_size = float(plan[\"expected_batch_size\"])\n","    steps_per_epoch = int(plan[\"steps_per_epoch\"])\n","    sigma = float(plan[\"sigma\"])\n","    dp_enabled = bool(plan[\"dp_enabled\"])\n","\n","    if dp_enabled:\n","        privacy_generator, rng_mode = make_dp_random_generator()\n","    else:\n","        privacy_generator, rng_mode = None, \"not_applicable_matched_nonprivate_control\"\n","\n","    params = {k: v for k, v in model.named_parameters()}\n","    buffers = {k: v for k, v in model.named_buffers()}\n","\n","    def loss_one(params, buffers, x_one, y_one):\n","        logits = functional_call(model, (params, buffers), (x_one.unsqueeze(0),))\n","        return nn.functional.cross_entropy(logits, y_one.unsqueeze(0))\n","\n","    grad_one = grad(loss_one)\n","\n","    for _ in range(int(local_epochs)):\n","        for _ in range(steps_per_epoch):\n","            if dp_enabled:\n","                mask = _dp_poisson_mask(n, q, privacy_generator, rng_mode)\n","            else:\n","                # The non-private reference uses the same Poisson sampling protocol,\n","                # but its randomness is reproducibly seeded and no privacy claim is made.\n","                mask = (torch.rand(n, device=DEVICE) < q)\n","            ids = torch.where(mask)[0]\n","\n","            # A Poisson-sampled lot may be empty. The private mechanism must still\n","            # release a Gaussian-perturbed sum for that step; do not skip the update.\n","            grad_sums = {name: torch.zeros_like(p) for name, p in params.items()}\n","            if ids.numel() > 0:\n","                xb, yb = x_local[ids], y_local[ids]\n","                per_sample = vmap(grad_one, in_dims=(None, None, 0, 0))(\n","                    params, buffers, xb, yb\n","                )\n","\n","                if dp_enabled:\n","                    norm_sq = None\n","                    for g in per_sample.values():\n","                        flat = g.reshape(g.shape[0], -1)\n","                        term = (flat * flat).sum(dim=1)\n","                        norm_sq = term if norm_sq is None else norm_sq + term\n","                    norms = torch.sqrt(norm_sq + 1e-12)\n","                    coeff = torch.clamp(float(max_grad_norm) / norms, max=1.0)\n","                    for name, g in per_sample.items():\n","                        view = coeff.view(-1, *([1] * (g.ndim - 1)))\n","                        grad_sums[name] = (g * view).sum(dim=0)\n","                else:\n","                    # Matched non-private control: same sampling/update schedule,\n","                    # with clipping and noise disabled.\n","                    for name, g in per_sample.items():\n","                        grad_sums[name] = g.sum(dim=0)\n","\n","            with torch.no_grad():\n","                for name, p in params.items():\n","                    grad_sum = grad_sums[name]\n","                    if dp_enabled:\n","                        noise_sum = _dp_gaussian_noise_like(\n","                            p, sigma * float(max_grad_norm), privacy_generator, rng_mode\n","                        )\n","                        grad_sum = grad_sum + noise_sum\n","                    # Correct DP-SGD normalization: divide noisy clipped SUM by\n","                    # expected lot size q*n, not the data-dependent realized |B|.\n","                    grad_estimate = grad_sum / expected_batch_size\n","                    p.add_(grad_estimate, alpha=-float(lr))\n","\n","    achieved_epsilon = float(plan[\"achieved_epsilon\"])\n","    return clone_state_dict(model), sigma, achieved_epsilon, rng_mode"]},{"cell_type":"code","execution_count":15,"id":"d56a3502","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.954048Z","iopub.status.busy":"2026-11-18T20:05:28.953044Z","iopub.status.idle":"2026-11-18T20:05:28.968682Z","shell.execute_reply":"2026-11-18T20:05:28.96754Z"},"papermill":{"duration":0.027006,"end_time":"2026-11-18T20:05:28.971144","exception":false,"start_time":"2026-11-18T20:05:28.944138","status":"completed"},"tags":[]},"outputs":[],"source":["# 14C. Federated DP runner + matched non-private reference runner (v2)\n","DP_METHODS = [\"FedAvg\", \"Median\", \"TrimmedMean\", \"MedianTrue\"]\n","DP_PROTOCOL_VERSION = \"v2_poisson_expected_batch_sum_noise_matched_control\"\n","\n","\n","def _dp_lr_for(target_epsilon):\n","    if target_epsilon is None or not np.isfinite(float(target_epsilon)):\n","        return LR\n","    return DP_LR_BY_EPS[float(target_epsilon)]\n","\n","\n","def run_federated_dp(X, y, X_eval, y_eval, parts, method, seed, rounds,\n","                     local_epochs, batch_size, target_epsilon):\n","    \"\"\"target_epsilon=None means matched Poisson-sampled non-private control.\"\"\"\n","    if method not in DP_METHODS:\n","        raise ValueError(f\"Unsupported DP comparison method: {method}\")\n","    seed_everything(seed)\n","    initial_model = MLP(X.shape[1]).to(DEVICE)\n","    global_state = clone_state_dict(initial_model)\n","\n","    # Plan calibration once per client, reused over all rounds and all methods via cache.\n","    client_plans = [\n","        get_dp_client_plan(\n","            len(idx), batch_size, rounds, local_epochs, target_epsilon,\n","            DP_DELTA, DP_MAX_GRAD_NORM\n","        )\n","        for idx in parts\n","    ]\n","    client_eps = [p[\"achieved_epsilon\"] for p in client_plans if np.isfinite(p[\"achieved_epsilon\"])]\n","    client_sigmas = [p[\"sigma\"] for p in client_plans]\n","    rng_modes = set()\n","\n","    for rnd in range(int(rounds)):\n","        local_states, ns = [], []\n","        for k, idx in enumerate(parts):\n","            st, sigma, eps, rng_mode = dp_local_train(\n","                global_state, X, y, idx, seed + 1000 * rnd + k,\n","                total_rounds=rounds, local_epochs=local_epochs,\n","                batch_size=batch_size, target_epsilon=target_epsilon,\n","                delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM, lr=_dp_lr_for(target_epsilon),\n","                dp_plan=client_plans[k],\n","            )\n","            local_states.append(st)\n","            ns.append(len(idx))\n","            if target_epsilon is not None and np.isfinite(float(target_epsilon)):\n","                rng_modes.add(rng_mode)\n","\n","        if method == \"FedAvg\":\n","            global_state = aggregate_fedavg(local_states, ns)\n","        elif method == \"Median\":\n","            global_state = aggregate_median(local_states)\n","        elif method == \"TrimmedMean\":\n","            global_state = aggregate_trimmed_mean(local_states, TRIM_FRACTION)\n","        elif method == \"MedianTrue\":\n","            global_state = aggregate_median_true(local_states)\n","\n","    result = evaluate_state(global_state, X_eval, y_eval)\n","    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n","    result.update({\n","        \"method\": method,\n","        \"seed\": int(seed),\n","        \"target_epsilon\": float(target_epsilon) if private else np.inf,\n","        \"max_client_achieved_epsilon\": float(max(client_eps)) if client_eps else np.nan,\n","        \"mean_client_sigma\": float(np.mean(client_sigmas)) if private else 0.0,\n","        \"min_client_sample_rate\": float(min(p[\"q\"] for p in client_plans)),\n","        \"max_client_sample_rate\": float(max(p[\"q\"] for p in client_plans)),\n","        \"min_client_steps_full_run\": int(min(p[\"total_steps\"] for p in client_plans)),\n","        \"max_client_steps_full_run\": int(max(p[\"total_steps\"] for p in client_plans)),\n","        \"dp_enabled\": bool(private),\n","        \"dp_protocol_version\": DP_PROTOCOL_VERSION,\n","        \"dp_rng_mode\": \"; \".join(sorted(rng_modes)) if private else \"not_applicable_matched_nonprivate_control\",\n","        \"nonprivate_control_protocol\": (\n","            \"not_applicable_private_run\" if private else\n","            \"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\"\n","        ),\n","    })\n","    return result"]},{"cell_type":"code","execution_count":16,"id":"975fe607","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:05:28.987555Z","iopub.status.busy":"2026-11-18T20:05:28.987072Z","iopub.status.idle":"2026-11-18T20:05:29.127368Z","shell.execute_reply":"2026-11-18T20:05:29.125741Z"},"papermill":{"duration":0.151332,"end_time":"2026-11-18T20:05:29.129583","exception":false,"start_time":"2026-11-18T20:05:28.978251","status":"completed"},"tags