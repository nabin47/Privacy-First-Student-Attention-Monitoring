rest_500\": lambda: RandomForestClassifier(n_estimators=500, random_state=SEED, n_jobs=-1),\n","        \"GradientBoosting_default\": lambda: GradientBoostingClassifier(random_state=SEED),\n","        \"GradientBoosting_500_d5\": lambda: GradientBoostingClassifier(\n","            n_estimators=500, max_depth=5, learning_rate=0.05, random_state=SEED),\n","        \"HistGradientBoosting_500\": lambda: HistGradientBoostingClassifier(\n","            max_iter=500, learning_rate=0.05, random_state=SEED),\n","        \"kNN_1\": lambda: KNeighborsClassifier(n_neighbors=1),\n","        \"kNN_5\": lambda: KNeighborsClassifier(n_neighbors=5),\n","    }\n","    if XGB_AVAILABLE:\n","        for n_est in [300, 1000]:\n","            for depth in [3, 6, 10]:\n","                models[f\"XGBoost_{n_est}_d{depth}\"] = (lambda n_est=n_est, depth=depth: XGBClassifier(\n","                    n_estimators=n_est, max_depth=depth, learning_rate=0.05, subsample=0.8,\n","                    colsample_bytree=0.8, eval_metric=\"logloss\", random_state=SEED, n_jobs=-1))\n","    return models\n","\n","\n","def audit_fit_eval(make_model, tr, te):\n","    pipe = Pipeline([(\"pre\", build_fold_preprocessor(tr)), (\"clf\", make_model())])\n","    pipe.fit(tr[EXPECTED_FEATURES], tr[TARGET].astype(int))\n","    pred = pipe.predict(te[EXPECTED_FEATURES])\n","    yt = te[TARGET].astype(int).to_numpy()\n","    return {\"accuracy\": accuracy_score(yt, pred), \"balanced_accuracy\": balanced_accuracy_score(yt, pred),\n","            \"f1\": f1_score(yt, pred, zero_division=0), \"mcc\": matthews_corrcoef(yt, pred),\n","            \"n_train\": len(tr), \"n_test\": len(te)}\n","\n","\n","skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n","cv_folds = list(skf.split(df[EXPECTED_FEATURES], df[TARGET]))\n","block_id = np.minimum(np.arange(len(df)) * 5 // len(df), 4)\n","splits = [(f\"cv5_fold{i}\", df.iloc[tr], df.iloc[te]) for i, (tr, te) in enumerate(cv_folds)]\n","splits += [(\"test_split\", train_df, test_df)]\n","splits += [(f\"block{b}\", df.loc[block_id != b], df.loc[block_id == b]) for b in range(5)]\n","\n","audit = load_checkpoint(AUDIT_PATH); done = done_keys(audit)\n","for name, make_model in audit_models().items():\n","    for split_name, tr, te in splits:\n","        key = f\"{name}|{split_name}\"\n","        if key in done:\n","            continue\n","        row = audit_fit_eval(make_model, tr, te)\n","        row.update({\"model\": name, \"split\": split_name, \"run_key\": key})\n","        audit = record(AUDIT_PATH, row); done.add(key)\n","    print(\"audit done:\", name)\n","\n","audit = load_checkpoint(AUDIT_PATH)\n","audit[\"protocol\"] = audit[\"split\"].str.replace(r\"\\d+$\", \"\", regex=True).str.replace(\"_fold\", \"\", regex=False)\n","audit_summary = (audit.groupby([\"model\", \"protocol\"])[\"accuracy\"].agg([\"mean\", \"std\", \"min\", \"max\", \"count\"])\n","                 .mul([100, 100, 100, 100, 1]).round(2).unstack(\"protocol\"))\n","display(audit_summary)\n","\n","_key = lambda d: d[EXPECTED_FEATURES].astype(object).fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\n","dup_info = {\n","    \"test_rows_with_identical_train_feature_vector\": int(_key(test_df).isin(set(_key(train_df))).sum()),\n","    \"test_rows\": int(len(test_df)),\n","}\n","(RESULTS_DIR / \"rev_audit_duplicates.json\").write_text(json.dumps(dup_info, indent=2))\n","print(dup_info)"]},{"cell_type":"markdown","id":"ae83e09c","metadata":{"papermill":{"duration":0.007513,"end_time":"2026-11-18T20:18:38.294179","exception":false,"start_time":"2026-11-18T20:18:38.286666","status":"completed"},"tags":[]},"source":["## R2. Median convention, and an equal-weight mean at alpha=0.1"]},{"cell_type":"code","execution_count":18,"id":"579b3466","metadata":{"execution":{"iopub.execute_input":"2026-11-18T20:18:38.311008Z","iopub.status.busy":"2026-11-18T20:18:38.310657Z","iopub.status.idle":"2026-11-18T21:11:53.319563Z","shell.execute_reply":"2026-11-18T21: