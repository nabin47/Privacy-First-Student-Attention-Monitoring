\"]\n","R3_LR_GRID = [0.01, 0.03, 0.1, 0.3, 0.5, 1.0, 2.0, 3.0]\n","R3_ALPHA = 0.1\n","\n","fit_idx, val_idx = train_test_split(\n","    np.arange(len(X_train)), test_size=0.20, stratify=y_train, random_state=123\n",")\n","X_fit, y_fit = X_train[fit_idx], y_train[fit_idx]\n","X_val, y_val = X_train[val_idx], y_train[val_idx]\n","\n","r3t = load_checkpoint(R3_TUNE_PATH); done = done_keys(r3t)\n","for s in CFG[\"tune_seeds\"]:\n","    parts = partition_for(\"Dirichlet\", R3_ALPHA, s, y=y_fit)\n","    for method in R3_RULES:\n","        for lr_candidate in R3_LR_GRID:\n","            key = f\"{method}|{lr_candidate}|{s}\"\n","            if key in done:\n","                continue\n","            with use_settings(lr=lr_candidate):\n","                r, _, _ = run_federated(X_fit, y_fit, X_val, y_val, parts, method, s,\n","                                        CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"])\n","            r3t = record(R3_TUNE_PATH, {\"method\": method, \"lr\": lr_candidate, \"seed\": s,\n","                                        \"val_accuracy\": r[\"accuracy\"], \"diverged\": r[\"nonfinite_output\"],\n","                                        \"run_key\": key})\n","            done.add(key)\n","        print(\"R3A done:\", method, \"seed\", s)\n","\n","r3t = load_checkpoint(R3_TUNE_PATH)\n","RULE_LR_A01 = select_lr(r3t, \"method\", LR_TOLERANCE)\n","display((r3t.groupby([\"method\", \"lr\"])[\"val_accuracy\"].mean().unstack(\"lr\") * 100).round(2))\n","print(\"Selected learning rates at alpha=0.1:\", RULE_LR_A01)\n","edge = {m: v for m, v in RULE_LR_A01.items() if v in (min(R3_LR_GRID), max(R3_LR_GRID))}\n","print(\"Selected at the edge of the grid:\", edge)\n","print(\"Tuning runs whose model diverged (non-finite output):\", int(r3t.get(\"diverged\", pd.Series(dtype=bool)).fillna(False).astype(bool).sum()))"]},{"cell_type":"code","execution_count":21,"id":"3271e8fc","metadata":{"execution":{"iopub.execute_input":"2026-11-18T22: