========\n\nplot_data = accuracy_summary.copy()\n\n# ------------------------------------------------------------\n# IID gets a synthetic x-position of 20 for visualization.\n# We do NOT interpret this as an actual Dirichlet alpha.\n# ------------------------------------------------------------\n\nplot_data[\"alpha_plot\"] = plot_data[\"alpha\"]\n\niid_rows = (\n    plot_data[\n        plot_data[\"condition\"] == \"IID\"\n    ]\n    .copy()\n)\n\niid_rows[\"alpha_plot\"] = 20.0\niid_rows[\"alpha_label\"] = \"IID\"\n\ndir_rows = (\n    plot_data[\n        plot_data[\"condition\"] == \"Dirichlet\"\n    ]\n    .copy()\n)\n\ndir_rows[\"alpha_label\"] = (\n    \"α=\"\n    +\n    dir_rows[\"alpha\"].map(\n        lambda x: f\"{x:g}\"\n    )\n)\n\nplot_data = pd.concat(\n    [iid_rows, dir_rows],\n    ignore_index=True\n)\n\n\nfor method in METHODS:\n\n    subset = plot_data[\n        plot_data[\"method\"] == method\n    ].sort_values(\n        \"alpha_plot\",\n        ascending=False\n    )\n\n    plt.figure(\n        figsize=(8, 5)\n    )\n\n    plt.errorbar(\n        subset[\"alpha_plot\"],\n        subset[\"mean_percent\"],\n        yerr=[\n            subset[\"mean_percent\"]\n            - subset[\"ci95_low_percent\"],\n\n            subset[\"ci95_high_percent\"]\n            - subset[\"mean_percent\"]\n        ],\n        marker=\"o\",\n        capsize=4\n    )\n\n    plt.xscale(\"log\")\n\n    plt.xlabel(\n        \"Dirichlet concentration α \"\n        \"(IID shown separately at the right)\"\n    )\n\n    plt.ylabel(\n        \"Test Accuracy (%)\"\n    )\n\n    plt.title(\n        f\"{method}: Accuracy vs. Client Label Heterogeneity\"\n    )\n\n    plt.grid(\n        True,\n        alpha=0.25\n    )\n\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:00:02.738365Z","iopub.execute_input":"2026-10-05T17:00:02.738721Z","iopub.status.idle":"2026-10-05T17:00:04.123767Z","shell.execute_reply.started":"2026-10-05T17:00:02.738683Z","shell.execute_reply":"2026-10-05T17:00:04.123066Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":20},{"id":"c31c221d-3a9b-4bd2-b1e6-03be0c8f8275","cell_type":"code","source":"# ============================================================\n# 13D. CONVERGENCE ANALYSIS\n# ============================================================\n\n# ------------------------------------------------------------\n# Select 3 FedAvg seeds closest to the median FedAvg accuracy\n# for each condition.\n# ------------------------------------------------------------\n\nCONVERGENCE_CONDITIONS = [\n    (\"IID\", None),\n    (\"Dirichlet\", 1.0),\n    (\"Dirichlet\", 0.1)\n]\n\nCONVERGENCE_METHODS = [\n    \"FedAvg\",\n    \"CAFAD\",\n    \"Median\"\n]\n\nN_CONVERGENCE_SEEDS = 3\n\n\ndef select_representative_seeds(\n    condition,\n    alpha,\n    n=3\n):\n\n    if condition == \"IID\":\n\n        subset = clean_results[\n            clean_results[\"condition\"] == \"IID\"\n        ]\n\n    else:\n\n        subset = clean_results[\n            (clean_results[\"condition\"] == condition)\n            &\n            (clean_results[\"alpha\"] == alpha)\n        ]\n\n    subset = subset[\n        subset[\"method\"] == \"FedAvg\"\n    ].copy()\n\n    median_accuracy = (\n        subset[\"accuracy\"].median()\n    )\n\n    subset[\"distance\"] = (\n        subset[\"accuracy\"]\n        -\n        median_accuracy\n    ).abs()\n\n    return (\n        subset\n        .nsmallest(\n            n,\n            \"distance\"\n        )[\"seed\"]\n        .astype(int)\n        .tolist()\n    )\n\n\nconvergence_histories = []\n\n\nfor condition, alpha in CONVERGENCE_CONDITIONS:\n\n    seeds = select_representative_seeds(\n        condition,\n        alpha,\n        N_CONVERGENCE_SEEDS\n    )\n\n    print(\n        f\"\\n{condition}, alpha={alpha}\"\n    )\n\n    print(\n        \"Representative seeds:\",\n        seeds\n    )\n\n    parts_by_seed = {}\n\n    for seed in seeds:\n\n        parts_by_seed[seed] = get_partition(\n            condition,\n            alpha,\n            seed\n        )\n\n    for method in CONVERGENCE_METHODS:\n\n        for seed in seeds:\n\n            print(\n                f\"Running {condition}, \"\n                f\"alpha={alpha}, \"\n                f\"{method}, \"\n                f\"seed={seed}\"\n            )\n\n            _, history, _ = run_federated(\n                X_train,\n                y_train,\n                X_test,\n                y_test,\n                parts_by_seed[seed],\n                method,\n                seed,\n                CFG[\"fl_rounds\"],\n                CFG[\"local_epochs\"],\n                CFG[\"batch_size\"]\n            )\n\n            history[\"condition\"] = condition\n            history[\"alpha\"] = alpha\n            history[\"method\"] = method\n            history[\"seed\"] = seed\n\n            convergence_histories.append(\n                history\n            )\n\n\nconvergence_df = pd.concat(\n    convergence_histories,\n    ignore_index=True\n)\n\n\n# ------------------------------------------------------------\n# Plot one figure per condition\n# ------------------------------------------------------------\n\nfor condition, alpha in CONVERGENCE_CONDITIONS:\n\n    subset = convergence_df[\n        (convergence_df[\"condition\"] == condition)\n        &\n        (\n            (\n                convergence_df[\"alpha\"].isna()\n                &\n                pd.isna(alpha)\n            )\n            |\n            (\n                convergence_df[\"alpha\"] == alpha\n            )\n        )\n    ]\n\n    plt.figure(\n        figsize=(8, 5)\n    )\n\n    for method in CONVERGENCE_METHODS:\n\n        method_data = subset[\n            subset[\"method\"] == method\n        ]\n\n        grouped = (\n            method_data\n            .groupby(\"round\")[\"accuracy\"]\n            .agg(\n                mean=\"mean\",\n                std=\"std\"\n            )\n            .reset_index()\n        )\n\n        plt.plot(\n            grouped[\"round\"],\n            grouped[\"mean\"],\n            marker=\"o\",\n            markersize=3,\n            label=method\n        )\n\n        # Only shade if multiple seeds exist\n        if len(\n            method_data[\"seed\"].unique()\n        ) > 1:\n\n            lower = (\n                grouped[\"mean\"]\n                - grouped[\"std\"].fillna(0)\n            )\n\n            upper = (\n                grouped[\"mean\"]\n                + grouped[\"std\"].fillna(0)\n            )\n\n            plt.fill_between(\n                grouped[\"round\"],\n                lower,\n                upper,\n                alpha=0.15\n            )\n\n    if condition == \"IID\":\n\n        title = \"Convergence — IID\"\n\n    else:\n\n        title = (\n            f\"Convergence — Dirichlet α={alpha}\"\n        )\n\n    plt.title(title)\n\n    plt.xlabel(\n        \"Communication Round\"\n    )\n\n    plt.ylabel(\n        \"Test Accuracy\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True,\n        alpha=0.25\n    )\n\n    plt.show()\n\n\nconvergence_df.to_csv(\n    RESULTS_DIR / \"convergence_analysis_v3.csv\",\n    index=False\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:00:04.124662Z","iopub.execute_input":"2026-10-05T17:00:04.124938Z","iopub.status.idle":"2026-10-0