e tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>client</th>\n      <th>n</th>\n      <th>label1_rate</th>\n      <th>abs_label_shift</th>\n      <th>n_feature_clusters</th>\n      <th>dominant_cluster_share</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0</td>\n      <td>210</td>\n      <td>0.314286</td>\n      <td>0.166195</td>\n      <td>6</td>\n      <td>0.471429</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>1</td>\n      <td>766</td>\n      <td>0.458225</td>\n      <td>0.022256</td>\n      <td>8</td>\n      <td>0.390339</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>2</td>\n      <td>2243</td>\n      <td>0.367811</td>\n      <td>0.112670</td>\n      <td>7</td>\n      <td>0.626839</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>3</td>\n      <td>951</td>\n      <td>0.467928</td>\n      <td>0.012552</td>\n      <td>8</td>\n      <td>0.390116</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>4</td>\n      <td>825</td>\n      <td>0.864242</td>\n      <td>0.383762</td>\n      <td>8</td>\n      <td>0.635152</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":16},{"id":"4ad8744c","cell_type":"code","source":"\n# 8. PyTorch model + utilities\ndef seed_everything(seed):\n    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)\n\nclass MLP(nn.Module):\n    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden1), nn.ReLU(),\n            nn.Linear(hidden1, hidden2), nn.ReLU(),\n            nn.Linear(hidden2, 2)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef clone_state_dict(model):\n    return {k: v.detach().cpu().clone() for k,v in model.state_dict().items()}\n\ndef load_state_dict_cpu(model, state):\n    model.load_state_dict({k:v.clone() for k,v in state.items()})\n\ndef evaluate_state(state, X, y):\n    model=MLP(X.shape[1]); load_state_dict_cpu(model, state); model.eval()\n    with torch.no_grad():\n        xt=torch.tensor(X, dtype=torch.float32)\n        logits=model(xt)\n        prob=torch.softmax(logits, dim=1)[:,1].numpy()\n        pred=logits.argmax(1).numpy()\n    return {\n        \"accuracy\":accuracy_score(y,pred),\n        \"balanced_accuracy\":balanced_accuracy_score(y,pred),\n        \"f1\":f1_score(y,pred),\n        \"precision\":precision_score(y,pred,zero_division=0),\n        \"recall\":recall_score(y,pred,zero_division=0),\n        \"mcc\":matthews_corrcoef(y,pred),\n        \"auroc\":roc_auc_score(y,prob) if len(np.unique(y))==2 else np.nan\n    }\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:08.051437Z","iopub.execute_input":"2026-10-04T10:11:08.051807Z","iopub.status.idle":"2026-10-04T10:11:08.060568Z","shell.execute_reply.started":"2026-10-04T10:11:08.051781Z","shell.execute_reply":"2026-10-04T10:11:08.059699Z"},"trusted":true},"outputs":[],"execution_count":17},{"id":"b0535d7a","cell_type":"code","source":"\n# 9. Local training (non-DP)\ndef local_train(global_state, X, y, client_idx, seed, epochs=2, batch_size=64,\n                lr=LR, prox_mu=0.0, corrupt_rate=0.0, straggler=False):\n    seed_everything(seed)\n    model=MLP(X.shape[1]); load_state_dict_cpu(model, global_state); model.train()\n\n    idx=np.array(client_idx, dtype=int)\n    rng=np.random.default_rng(seed+991*(int(idx[0]) if len(idx) else 0)); rng.shuffle(idx)\n\n    if len(idx)>=20 and len(np.unique(y[idx]))==2:\n        tr_idx, va_idx=train_test_split(idx, test_size=0.20, stratify=y[idx], random_state=seed)\n    else:\n        cut=max(1,int(len(idx)*0.8)); tr_idx, va_idx=idx[:cut],idx[cut:]\n\n    y_local=y[tr_idx].copy()\n    if corrupt_rate>0:\n        m=rng.random(len(y_local))<corrupt_rate\n        y_local[m]=1-y_local[m]\n\n    ds=TensorDataset(torch.tensor(X[tr_idx],dtype=torch.float32),\n                     torch.tensor(y_local,dtype=torch.long))\n    loader=DataLoader(ds,batch_size=batch_size,shuffle=True,drop_last=False)\n    optimizer=torch.optim.SGD(model.parameters(),lr=lr)\n    criterion=nn.CrossEntropyLoss()\n    n_epochs=1 if straggler else epochs\n\n    global_tensors={n:p.detach().clone() for n,p in model.named_parameters() if p.requires_grad}\n    for _ in range(n_epochs):\n        for xb,yb in loader:\n            optimizer.zero_grad()\n            loss=criterion(model(xb),yb)\n            if prox_mu>0:\n                prox=0.0\n                for n,p in model.named_parameters():\n                    if p.requires_grad: prox += torch.sum((p-global_tensors[n])**2)\n                loss=loss+0.5*prox_mu*prox\n            loss.backward(); optimizer.step()\n\n    val_metrics=evaluate_state(clone_state_dict(model),X[va_idx],y[va_idx])\n    return clone_state_dict(model), val_metrics[\"accuracy\"], len(tr_idx)\n\ndef train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n    corrupt_clients=set(corrupt_clients or [])\n    straggler_clients=set(straggler_clients or [])\n    states=[]; val_accs=[]; ns=[]\n    for k,idx in enumerate(parts):\n        prox=PROX_MU if method==\"FedProx\" else 0.0\n        st,acc,n=local_train(\n            global_state,X,y,idx,seed+k,epochs=epochs,batch_size=batch_size,\n            lr=LR,prox_mu=prox,\n            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n            straggler=(k in straggler_clients)\n        )\n        states.append(st); val_accs.append(acc); ns.append(n)\n    return states,val_accs,ns\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:08.061527Z","iopub.execute_input":"2026-10-04T10:11:08.061906Z","iopub.status.idle":"2026-10-04T10:11:08.081425Z","shell.execute_reply.started":"2026-10-04T10:11:08.061874Z","shell.execute_reply":"2026-10-04T10:11:08.080659Z"},"trusted":true},"outputs":[],"execution_count":18},{"id":"6a6f3b57","cell_type":"code","source":"\n# 10. Aggregators\ndef aggregate_fedavg(states, ns):\n    total=float(sum(ns))\n    return {k:sum(states[i][k]*(ns[i]/total) for i in range(len(states))) for k in states[0]}\n\ndef aggregate_median(states):\n    return {k:torch.median(torch.stack([s[k] for s in states]),dim=0).values for k in states[0]}\n\ndef aggregate_trimmed_mean(states, trim_fraction=0.2):\n    n=len(states); trim=int(math.floor(n*trim_fraction))\n    if 2*trim>=n: return aggregate_median(states)\n    out={}\n    for k in states[0]:\n        t=torch.stack([s[k] for s in states])\n        t,_=torch.sort(t,dim=0)\n        out[k]=t[trim:n-trim].mean(dim=0)\n    return out\n\ndef aggregate_cafad(states, ns, val_accs, beta=CAFAD_BETA, z=CAFAD_Z):\n    c=np.asarray(val_accs,float); mu=float(c.mean()); sd=float(c.std())\n    mask=np.ones(len(c),dtype=bool) if sd<1e-12 else (c >= mu-z*sd)\n    if not mask.any(): mask[:]=True\n    logits=beta*(c-c.max())\n    raw=np.asarray(ns,float)*np.exp(logits)*mask.astype(float)\n    if raw.sum()<=0: raw=np.asarray(ns,float)\n    w=raw/raw.sum()\n    return ({k:sum(states[i][k]*float(w[i]) for i in range(len(states))) for k in states[0]}, w, mask)\n\ndef aggregate_multikrum(states, f=1):\n    n=len(states)\n    if n<=2*f+2: return aggregate_fedavg(states,[1]*n)\n    V=torch.stack([torch.cat([s[k].reshape(-1).float() for k in s]) for s in states])\n    d=torch.cdist(V,V,p=2)**2\n    scores=[]\n    for i in range(n):\n        others=torch.cat([d[i,:i],d[i,i+1:]])\n        scores.append(torch.topk(others,k=n-f-2,largest=False).values.sum().item())\n    chosen=np.argsort(scores)[:n-f-2]\n    chosen_states=[states[int(i)] for i in chosen]\n    return aggregate_fedavg(chosen_states,[1]*len(chosen_states))\n\ndef aggregate(method, states, ns, val_accs):\n    if method in (\"FedAvg\",\"FedProx\"): return aggregate_fedavg(states,ns),None,None\n    if method==\"Median\": return aggregate_median(states),None,None\n    if method==\"TrimmedMean\": return aggregate_trimmed_mean(states,TRIM_FRACTION),None,None\n    if method==\"Krum\": return aggregate_multikrum(states,KRUM_F),None,None\n    if method==\"CAFAD\":\n        st,w,mask=aggregate_cafad(states,ns,val_accs); return st,w,mask\n    raise ValueError(method)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:08.082515Z","iopub.execute_input":"2026-10-04T10:11:08.082809Z","iopub.status.idle":"2026-10-04T10:11:08.099741Z","shell.execute_reply.started":"2026-10-04T10:11:08.082777Z","shell.execute_reply":"2026-10-04T10:11:08.098969Z"},"trusted":true},"outputs":[],"execution_count":19},{"id":"f7cfcf6b","cell_type":"code","source":"\n# 11. Federated driver + pilot sanity check\nMETHODS=[\"FedAvg\",\"FedProx\",\"Median\",\"TrimmedMean\",\"CAFAD\"]\n\ndef run_federated(X,y,X_eval,y_eval,parts,method,seed,rounds,local_epochs,batch_size,\n                  corrupt_clients=None,corrupt_rate=0.0,straggler_clients=None):\n    seed_everything(seed)\n    global_state=clone_state_dict(MLP(X.shape[1]))\n    final_weights=None; final_mask=None; history=[]\n\n    for rnd in range(rounds):\n        states,val_accs,ns=train_clients_once(\n            global_state,parts,X,y,seed+rnd*1000,method,local_epochs,batch_size,\n            corrupt_clients=corrupt_clients,corrupt_rate=corrupt_rate,\n            straggler_clients=straggler_clients\n        )\n        global_state,weights,mask=aggregate(method,states,ns,val_accs)\n        final_weights,final_mask=weights,mask\n        history.append({\"round\":rnd+1,**evaluate_state(global_state,X_eval,y_eval),\n                        \"mean_client_val_acc\":float(np.mean(val_accs))})\n\n    result=evaluate_state(global_state,X_eval,y_eval)\n    result.update({\n        \"method\":method,\"seed\":seed,\n        \"final_cafad_weight_min\":float(np.min(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_weight_max\":float(np.max(final_weights)) if final_weights is not None else np.nan,\n        \"final_cafad_masked_clients\":int((~final_mask).sum()) if final_mask is not None else np.nan\n    })\n    return result,pd.DataFrame(history),global_state\n\npilot_parts=balanced_iid_partition(y_train,N_CLIENTS,0)\npilot=[]\nfor method in METHODS:\n    r,_,st=run_federated(X_train,y_train,X_test,y_test,pilot_parts,method,0,2,1,64)\n    pilot.append(r)\ndisplay(pd.DataFrame(pilot))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:08.100707Z","iopub.execute_input":"2026-10-04T10:11:08.101056Z","iopub.status.idle":"2026-10-04T10:11:13.249444Z","shell.execute_reply.started":"2026-10-04T10:11:08.101027Z","shell.execute_reply":"2026-10-04T10:11:13.248741Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"   accuracy  balanced_accuracy        f1  precision    recall       mcc  \\\n0  0.698159           0.687343  0.567164   0.911439  0.411667  0.454163   \n1  0.697358           0.686510  0.565517   0.911111  0.410000  0.452748   \n2  0.700560           0.689843  0.572082   0.912409  0.416667  0.458401   \n3  0.699760           0.689010  0.570447   0.912088  0.415000  0.456990   \n4  0.698159           0.687343  0.567164   0.911439  0.411667  0.454163   \n\n      auroc       method  seed  final_cafad_weight_min  \\\n0  0.735257       FedAvg     0                     NaN   \n1  0.734091      FedProx     0                     NaN   \n2  0.734301       Median     0                     NaN   \n3  0.734253  TrimmedMean     0                     NaN   \n4  0.735362        CAFAD     0                0.196399   \n\n   final_cafad_weight_max  final_cafad_masked_clients  \n0                     NaN                         NaN  \n1                     NaN        