"metadata":{}}],"execution_count":29},{"id":"43297e51-15a3-4732-b269-2230d091c47a","cell_type":"code","source":"\n# ============================================================\n# 19B. Failure-mode plots\n# ============================================================\n\n# 1) Final prediction collapse\nfor alpha in [0.5, 0.1]:\n    subset = diagnostic_final[\n        diagnostic_final[\"alpha\"] == alpha\n    ].copy()\n\n    plt.figure(figsize=(8, 5))\n\n    for method in [\"FedAvg\", \"Median\", \"TrimmedMean\", \"CAFAD\"]:\n        m = subset[subset[\"method\"] == method]\n        if len(m) == 0:\n            continue\n        plt.scatter(\n            m[\"pred_class1_rate\"] * 100,\n            m[\"accuracy\"] * 100,\n            label=method\n        )\n\n    plt.xlabel(\"Predicted class-1 rate (%)\")\n    plt.ylabel(\"Test accuracy (%)\")\n    plt.title(f\"Prediction collapse diagnostic — α={alpha}\")\n    plt.legend()\n    plt.grid(True, alpha=0.25)\n    plt.tight_layout()\n    plt.savefig(\n        RESULTS_DIR / f\"fig_failure_collapse_alpha_{str(alpha).replace('.', '_')}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n    plt.show()\n\n# 2) Local update norms for the worst cases\nplot_hist = diagnostic_history.copy()\n\nfor alpha in [0.5, 0.1]:\n    subset = plot_hist[\n        plot_hist[\"alpha\"] == alpha\n    ]\n\n    plt.figure(figsize=(8, 5))\n\n    for method in [\"FedAvg\", \"Median\", \"CAFAD\"]:\n        m = (\n            subset[subset[\"method\"] == method]\n            .groupby(\"round\")[\"mean_client_update_norm\"]\n            .mean()\n        )\n        if len(m):\n            plt.plot(\n                m.index,\n                m.values,\n                marker=\"o\",\n                markersize=3,\n                label=method\n            )\n\n    plt.xlabel(\"Communication round\")\n    plt.ylabel(\"Mean client update norm\")\n    plt.title(f\"Update dynamics in worst runs — α={alpha}\")\n    plt.legend()\n    plt.grid(True, alpha=0.25)\n    plt.tight_layout()\n    plt.savefig(\n        RESULTS_DIR / f\"fig_update_norm_alpha_{str(alpha).replace('.', '_')}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n    plt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:35:54.761865Z","iopub.execute_input":"2026-10-05T17:35:54.762224Z","iopub.status.idle":"2026-10-05T17:35:57.032503Z","shell.execute_reply.started":"2026-10-05T17:35:54.762159Z","shell.execute_reply":"2026-10-05T17:35:57.031634Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":30},{"id":"5bb0fd3d-8152-4044-a749-519994869de5","cell_type":"markdown","source":"\n## 19C. Blocked train/test sensitivity\n\nThe V3 audit showed a consecutive same-label rate of about 0.761 versus about 0.501 under an IID label-order expectation. This does not prove temporal identity, but it justifies a sensitivity analysis that prevents adjacent row blocks from being split across train and test.\n\nThe first pass below evaluates the **centralized benchmark** across five contiguous blocks. This is deliberately cheaper than a full FL blocked-split grid.\n\nIf the centralized result remains stable, the next cell can optionally run a smaller blocked FL sensitivity experiment.\n","metadata":{}},{"id":"1fc17f1e-bd23-4068-9a6a-947fc32cb198","cell_type":"code","source":"\n# ============================================================\n# 19C-1. Five-block centralized sensitivity\n# ============================================================\n\ndef build_fold_preprocessor(train_part):\n    num_cols = [\n        c for c in EXPECTED_FEATURES\n        if train_part[c].dtype != \"object\"\n    ]\n    cat_cols = [\n        c for c in EXPECTED_FEATURES\n        if train_part[c].dtype == \"object\"\n    ]\n\n    try:\n        oh = OneHotEncoder(\n            handle_unknown=\"ignore\",\n            sparse_output=False\n        )\n    except TypeError:\n        oh = OneHotEncoder(\n            handle_unknown=\"ignore\",\n            sparse=False\n        )\n\n    return ColumnTransformer([\n        (\n            \"num\",\n            Pipeline([\n                (\"imputer\", SimpleImputer(strategy=\"median\")),\n                (\"scaler\", StandardScaler()),\n            ]),\n            num_cols,\n        ),\n        (\n            \"cat\",\n            Pipeline([\n                (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n                (\"onehot\", oh),\n            ]),\n            cat_cols,\n        ),\n    ])\n\nBLOCKS = 5\nblock_id = np.minimum(\n    np.arange(len(df)) * BLOCKS // len(df),\n    BLOCKS - 1\n)\n\nblocked_rows = []\n\nfor b in range(BLOCKS):\n\n    train_mask = block_id != b\n    test_mask = block_id == b\n\n    tr = df.loc[train_mask].copy()\n    te = df.loc[test_mask].copy()\n\n    fold_pre = build_fold_preprocessor(tr)\n\n    X_tr = fold_pre.fit_transform(\n        tr[EXPECTED_FEATURES]\n    ).astype(np.float32)\n\n    X_te = fold_pre.transform(\n        te[EXPECTED_FEATURES]\n    ).astype(np.float32)\n\n    y_tr = tr[TARGET].to_numpy(np.int64)\n    y_te = te[TARGET].to_numpy(np.int64)\n\n    # Shallow tree\n    tree = DecisionTreeClassifier(\n        max_depth=3,\n        random_state=SEED\n    )\n\n    tree_pipe = Pipeline([\n        (\"pre\", build_fold_preprocessor(tr)),\n        (\"clf\", tree)\n    ])\n\n    tree_pipe.fit(\n        tr[EXPECTED_FEATURES],\n        y_tr\n    )\n\n    tree_pred = tree_pipe.predict(\n        te[EXPECTED_FEATURES]\n    )\n\n    # ExtraTrees\n    et = ExtraTreesClassifier(\n        n_estimators=300,\n        random_state=SEED,\n        n_jobs=-1\n    )\n\n    et_pipe = Pipeline([\n        (\"pre\", build_fold_preprocessor(tr)),\n        (\"clf\", et)\n    ])\n\n    et_pipe.fit(\n        tr[EXPECTED_FEATURES],\n        y_tr\n    )\n\n    et_pred = et_pipe.predict(\n        te[EXPECTED_FEATURES]\n    )\n\n    blocked_rows.extend([\n        {\n            \"block\": b,\n            \"model\": \"DecisionTree_depth3\",\n            \"n_train\": len(tr),\n            \"n_test\": len(te),\n            \"test_label1_rate\": float(np.mean(y_te)),\n            \"accuracy\": accuracy_score(y_te, tree_pred),\n            \"balanced_accuracy\": balanced_accuracy_score(y_te, tree_pred),\n            \"f1\": f1_score(y_te, tree_pred, zero_division=0),\n            \"mcc\": matthews_corrcoef(y_te, tree_pred),\n        },\n        {\n            \"block\": b,\n            \"model\": \"ExtraTrees\",\n            \"n_train\": len(tr),\n            \"n_test\": len(te),\n            \"test_label1_rate\": float(np.mean(y_te)),\n            \"accuracy\": accuracy_score(y_te, et_pred),\n            \"balanced_accuracy\": balanced_accuracy_score(y_te, et_pred),\n            \"f1\": f1_score(y_te, et_pred, zero_division=0),\n            \"mcc\": matthews_corrcoef(y_te, et_pred),\n        }\n    ])\n\nblocked_central = pd.DataFrame(blocked_rows)\n\ndisplay(blocked_central)\n\nblocked_central.to_csv(\n    RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\",\n    index=False\n)\n\nprint(\n    \"\\nBlocked means:\"\n)\n\ndisplay(\n    blocked_central.groupby(\"model\")[\n        [\"accuracy\", \"balanced_accuracy\", \"f1\", \"mcc\"]\n    ].mean()\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:40:45.464779Z","iopub.execute_input":"2026-10-05T17:40:45.465403Z","iopub.status.idle":"2026-10-05T17:40:51.465108Z","shell.execute_reply.started":"2026-10-05T17:40:45.465364Z","shell.execute_reply":"2026-10-05T17:40:5