97fe-6cf571296547","cell_type":"code","source":"# ============================================================\n# 13B-2. RE-RUN WORST CASES AND INSPECT PREDICTIONS\n# ============================================================\n\ndef get_partition(\n    condition,\n    alpha,\n    seed\n):\n\n    if condition == \"IID\":\n\n        return balanced_iid_partition(\n            y_train,\n            N_CLIENTS,\n            seed\n        )\n\n    return dirichlet_label_partition(\n        y_train,\n        N_CLIENTS,\n        alpha=alpha,\n        seed=seed,\n        min_size=100\n    )\n\n\ndef predictions_from_state(\n    state,\n    X,\n    y\n):\n\n    model = MLP(\n        X.shape[1]\n    )\n\n    load_state_dict_cpu(\n        model,\n        state\n    )\n\n    model.eval()\n\n    with torch.no_grad():\n\n        logits = model(\n            torch.tensor(\n                X,\n                dtype=torch.float32\n            )\n        )\n\n        predictions = (\n            logits\n            .argmax(\n                dim=1\n            )\n            .cpu()\n            .numpy()\n        )\n\n    cm = confusion_matrix(\n        y,\n        predictions,\n        labels=[0, 1]\n    )\n\n    return {\n        \"accuracy\":\n            accuracy_score(y, predictions),\n\n        \"balanced_accuracy\":\n            balanced_accuracy_score(\n                y,\n                predictions\n            ),\n\n        \"f1\":\n            f1_score(\n                y,\n                predictions,\n                zero_division=0\n            ),\n\n        \"precision\":\n            precision_score(\n                y,\n                predictions,\n                zero_division=0\n            ),\n\n        \"recall\":\n            recall_score(\n                y,\n                predictions,\n                zero_division=0\n            ),\n\n        \"mcc\":\n            matthews_corrcoef(\n                y,\n                predictions\n            ),\n\n        \"predicted_class0_rate\":\n            np.mean(predictions == 0),\n\n        \"predicted_class1_rate\":\n            np.mean(predictions == 1),\n\n        \"confusion_matrix\":\n            cm\n    }\n\n\n# ------------------------------------------------------------\n# Pick the 3 worst seeds for each method/alpha.\n#\n# Start with 3 to keep this diagnostic reasonable.\n# Change to 5 after the first run if needed.\n# ------------------------------------------------------------\n\nN_WORST = 3\n\ndiagnostic_rows = []\n\nfor alpha in WORST_ALPHAS:\n\n    for method in WORST_METHODS:\n\n        candidates = (\n            clean_results[\n                (clean_results[\"condition\"] == \"Dirichlet\")\n                &\n                (clean_results[\"alpha\"] == alpha)\n                &\n                (clean_results[\"method\"] == method)\n            ]\n            .nsmallest(\n                N_WORST,\n                \"accuracy\"\n            )\n        )\n\n        for _, row in candidates.iterrows():\n\n            seed = int(row[\"seed\"])\n\n            parts = get_partition(\n                \"Dirichlet\",\n                alpha,\n                seed\n            )\n\n            # ------------------------------------------------\n            # IMPORTANT:\n            # Compare the unstable method against FedAvg\n            # on exactly the same partition and seed.\n            # ------------------------------------------------\n\n            for compare_method in [\n                \"FedAvg\",\n                method,\n                \"CAFAD\"\n            ]:\n\n                result, history, state = run_federated(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    compare_method,\n                    seed,\n                    CFG[\"fl_rounds\"],\n                    CFG[\"local_epochs\"],\n                    CFG[\"batch_size\"]\n                )\n\n                pred_metrics = predictions_from_state(\n                    state,\n                    X_test,\n                    y_test\n                )\n\n                diagnostic_rows.append({\n\n                    \"alpha\": alpha,\n                    \"original_method\":\n                        method,\n                    \"seed\": seed,\n                    \"method\":\n                        compare_method,\n\n                    \"accuracy\":\n                        pred_metrics[\"accuracy\"],\n\n                    \"f1\":\n                        pred_metrics[\"f1\"],\n\n                    \"precision\":\n                        pred_metrics[\"precision\"],\n\n                    \"recall\":\n                        pred_metrics[\"recall\"],\n\n                    \"pred_class0_rate\":\n                        pred_metrics[\n                            \"predicted_class0_rate\"\n                        ],\n\n                    \"pred_class1_rate\":\n                        pred_metrics[\n                            \"predicted_class1_rate\"\n                        ],\n\n                    \"confusion_matrix\":\n                        pred_metrics[\n                            \"confusion_matrix\"\n                        ]\n\n                })\n\n\ndiagnostic_results = pd.DataFrame(\n    diagnostic_rows\n)\n\ndisplay(\n    diagnostic_results[\n        [\n            \"alpha\",\n            \"original_method\",\n            \"seed\",\n            \"method\",\n            \"accuracy\",\n            \"f1\",\n            \"precision\",\n            \"recall\",\n            \"pred_class0_rate\",\n            \"pred_class1_rate\"\n        ]\n    ]\n    .sort_values(\n        [\"alpha\", \"original_method\", \"seed\", \"method\"]\n    )\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T16:55:49.68549Z","iopub.execute_input":"2026-10-05T16:55:49.685834Z","iopub.status.idle":"2026-10-05T17:00:02.73717Z