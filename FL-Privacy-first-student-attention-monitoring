"phone_present\",\"phone_loc_x\",\"phone_loc_y\",\"phone_conf\"],\n","    \"gaze\": [\"gaze_on_screen\",\"gaze_direction\",\"gazePoint_x\",\"gazePoint_y\"],\n","    \"pupils\": [\"pupil_left_x\",\"pupil_left_y\",\"pupil_right_x\",\"pupil_right_y\"],\n","}\n","TARGET = \"label\"\n","EXPECTED_FEATURES = [c for group in V3_FEATURE_GROUPS.values() for c in group]\n","\n","def find_v3_csv():\n","    manual = os.environ.get(\"V3_DATA_PATH\", \"\").strip()\n","    candidates = [Path(manual)] if manual else []\n","    candidates += [Path(\"/kaggle/input\") / p for p in glob.glob(\"/kaggle/input/**/*.csv\", recursive=True)]\n","    candidates += [Path(\"/mnt/data/attention_detection_dataset_v3.csv\")]\n","    for p in candidates:\n","        if p.exists():\n","            try:\n","                cols = pd.read_csv(p, nrows=5).columns.tolist()\n","                if TARGET in cols and all(c in cols for c in EXPECTED_FEATURES):\n","                    return p\n","            except Exception:\n","                pass\n","    raise FileNotFoundError(\"V3 CSV not found. Set V3_DATA_PATH to your Kaggle CSV path.\")\n","\n","DATA_PATH = find_v3_csv()\n","df = pd.read_csv(DATA_PATH)\n","\n","missing_schema = [c for c in EXPECTED_FEATURES + [TARGET] if c not in df.columns]\n","if missing_schema:\n","    raise ValueError(f\"Missing V3 columns: {missing_schema}\")\n","\n","df = df[EXPECTED_FEATURES + [TARGET]].copy()\n","df[TARGET] = df[TARGET].astype(int)\n","\n","print(\"Loaded:\", DATA_PATH)\n","print(\"Shape:\", df.shape)\n"]},{"cell_type":"code","execution_count":4,"id":"fb646f8d","metadata":{"execution":{"iopub.execute_input":"2026-10-11T10:38:24.379168Z","iopub.status.busy":"2026-10-11T10:38:24.378857Z","iopub.status.idle":"2026-10-11T10:38:24.463521Z","shell.execute_reply":"2026-10-11T10:38:24.462353Z"},"papermill":{"duration":0.093588,"end_time":"2026-10-11T10:38:24.465263","exception":false,"start_time":"2026-10-11T10:38:24.371675","status":"completed"},"tags":[]},"outputs