                print(f\"SKIP  {condition} alpha={alpha} {method} seed={seed}\")\n                    continue\n\n                print(f\"RUN   {condition} alpha={alpha} {method} seed={seed}\")\n\n                result, history, state = run_federated(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    method,\n                    seed,\n                    CFG[\"fl_rounds\"],\n                    CFG[\"local_epochs\"],\n                    CFG[\"batch_size\"],\n                )\n\n                result.update({\n                    \"condition\": condition,\n                    \"alpha\": np.nan if alpha is None else float(alpha),\n                    \"partition_seed\": int(seed),\n                    \"n_clients\": int(N_CLIENTS),\n                })\n\n                # Save the model state and its complete round history atomically.\n                atomic_torch_save(\n                    {\n                        \"state\": state,\n                        \"seed\": int(seed),\n                        \"condition\": condition,\n                        \"alpha\": None if alpha is None else float(alpha),\n                        \"method\": method,\n                        \"n_clients\": int(N_CLIENTS),\n                    },\n                    state_path,\n                )\n\n                hist = history.copy()\n                hist[\"condition\"] = condition\n                hist[\"alpha\"] = np.nan if alpha is None else float(alpha)\n                hist[\"n_clients\"] = int(N_CLIENTS)\n                atomic_to_csv(hist, history_path)\n\n                # Only mark the run complete after BOTH state and history exist.\n                clean_progress = upsert_checkpoint(\n                    CLEAN_PROGRESS_PATH,\n                    [result],\n                    [\"seed\", \"condition\", \"alpha\", \"method\"],\n                )\n\n    