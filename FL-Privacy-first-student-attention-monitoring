ect\"]\ncategorical_cols = [c for c in EXPECTED_FEATURES if df[c].dtype == \"object\"]\n\ntry:\n    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\nexcept TypeError:\n    onehot = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n\npreprocessor = ColumnTransformer([\n    (\"num\", Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"median\")),\n        (\"scaler\", StandardScaler()),\n    ]), numeric_cols),\n    (\"cat\", Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n        (\"onehot\", onehot),\n    ]), categorical_cols),\n])\n\nX_train = preprocessor.fit_transform(train_df[EXPECTED_FEATURES]).astype(np.float32)\nX_test = preprocessor.transform(test_df[EXPECTED_FEATURES]).astype(np.float32)\ny_train = train_df[TARGET].to_numpy(np.int64)\ny_test = test_df[TARGET].to_numpy(np.int64)\nFEATURE_NAMES_ENCODED = list(preprocessor.get_feature_names_out())\n\nprint(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\nprint(\"Encoded features:\", len(FEATURE_NAMES_ENCODED))\n\n\n# Fold-safe preprocessing helper used by blocked sensitivity and any fold-wise audit.\n# IMPORTANT: the preprocessor is fit only on the supplied training frame, preventing\n# information from the blocked test fold from entering imputation/scaling/encoding.\ndef build_fold_preprocessor(frame, cols=None):\n    cols = list(EXPECTED_FEATURES if cols is None else cols)\n    num_cols = [c for c in cols if frame[c].dtype != \"object\"]\n    cat_cols = [c for c in cols if frame[c].dtype == \"object\"]\n\n    try:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n    except TypeError:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n\n    transformers = []\n    if num_cols:\n        transformers.append((\n            \"num\",\n            Pipeline([\n                (\"imputer\", SimpleImputer(strategy=\"median\")),\n                (\"scaler\", StandardScaler()),\n            ]),\n          