ype(str).agg(\"|\".join, axis=1)\n\nmajority_map = cue_train.assign(_key=train_keys).groupby(\"_key\")[TARGET].agg([\"mean\",\"size\"])\nglobal_majority = int(train_df[TARGET].mean() >= 0.5)\n\npred = []\nfor key in test_keys:\n    if key in majority_map.index:\n        pred.append(int(majority_map.loc[key, \"mean\"] >= 0.5))\n    else:\n        pred.append(global_majority)\n\nprint(\"Direct-cue lookup accuracy:\", round(accuracy_score(y_test, pred), 4))\nprint(\"Direct-cue lookup F1:\", round(f1_score(y_test, pred), 4))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:06.480679Z","iopub.execute_input":"2026-10-04T10:11:06.480991Z","iopub.status.idle":"2026-10-04T10:11:06.545753Z","shell.execute_reply.started":"2026-10-04T10:11:06.480961Z","shell.execute_reply":"2026-10-04T10:11:06.545217Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Direct-cue lookup accuracy: 0.9223\nDirect-cue lookup F1: 0.9199\n","output_type":"stream"}],"execution_count":14},{"id":"e87666e2","cell_type":"code","source":"\n# 6C. Centralized baselines\ncentral_results = []\n\ndt_pipe = make_tree_pipeline(EXPECTED_FEATURES, max_depth=3)\ndt_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\ndt_pred = dt_pipe.predict(test_df[EXPECTED_FEATURES])\ncentral_results.append({\n    \"model\": \"DecisionTree_depth3\",\n    \"accuracy\": accuracy_score(y_test, dt_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, dt_pred),\n    \"f1\": f1_score(y_test, dt_pred),\n    \"mcc\": matthews_corrcoef(y_test, dt_pred),\n})\n\net_pipe = Pipeline([\n    (\"pre\", preprocessor),\n    (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1))\n])\net_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\net_pred = et_pipe.predict(test_df[EXPECTED_FEATURES])\net_prob = et_pipe.predict_proba(test_df[EXPECTED_FEATURES])[:,1]\ncentral_results.append({\n    \"model\": \"ExtraTrees\",\n    \"accuracy\": accuracy_score(y_test, et_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, et_pred),\n    \"f1\": f1_score(y_test, et_pred),\n    \"mcc\": matthews_corrcoef(y_test, et_pred),\n    \"auroc\": roc_auc_score(y_test, et_prob),\n})\n\ncentral_table = pd.DataFrame(central_results)\ndisplay(central_table)\ncentral_table.to_csv(RESULTS_DIR / \"centralized_baselines_v3.csv\", index=False)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:06.546515Z","iopub.execute_input":"2026-10-04T10:11:06.546815Z","iopub.status.idle":"2026-10-04T10:11:07.917869Z","shell.execute_reply.started":"2026-10-04T10:11:06.546794Z","shell.execute_reply":"2026-10-04T10:11:07.917299Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"                 model  accuracy  balanced_accuracy        f1       mcc  \\\n0  DecisionTree_depth3  0.923139           0.923335  0.920661  0.846246   \n1           ExtraTrees  0.916733           0.916668  0.913478  0.833235   \n\n      auroc  \n0       NaN  \n1  0.917354  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>model</th>\n      <th>accuracy</th>\n      <th>balanced_accuracy</th>\n      <th>f1</th>\n      <th>mcc</th>\n      <th>auroc</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>DecisionTree_depth3</td>\n      <td>0.923139</td>\n      <td>0.923335</td>\n      <td>0.920661</td>\n      <td>0.846246</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>ExtraTrees</td>\n      <td>0.916733</td>\n      <td>0.916668</td>\n      <td>0.913478</td>\n      <td>0.833235</td>\n      <td>0.917354</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":15},{"id":"ed26d3d8","cell_type":"markdown","source":"\n## 7. Federated simulation\n\nThe FL clients are **controlled partitions of the training records**. In the manuscript, call them **simulated clients / decentralized data partitions**, not identified classrooms or students.\n\nPartition modes:\n\n- **IID:** approximately balanced label composition.\n- **Dirichlet label skew:** controlled changes in `P(y | client)`.\n- **Feature-cluster skew:** controlled differences in feature composition; explicitly described as a simulation, not a reproduction of real device populations.\n","metadata":{}},{"id":"1ab4370b","cell_type":"code","source":"\n# 7A. Partition helpers\ndef balanced_iid_partition(y, n_clients, seed):\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n    for cls in np.unique(y):\n        idx = rng.permutation(np.where(y == cls)[0])\n        for k, s in enumerate(np.array_split(idx, n_clients)):\n            parts[k].extend(s.tolist())\n    return [np.array(sorted(z), dtype=int) for z in parts]\n\ndef dirichlet_label_partition(y, n_clients, alpha, seed, min_size=100, max_tries=200):\n    rng = np.random.default_rng(seed)\n    classes = np.unique(y)\n    for _ in range(max_tries):\n        parts = [[] for _ in range(n_clients)]\n        for cls in classes:\n            idx = rng.permutation(np.where(y == cls)[0])\n            props = rng.dirichlet(np.ones(n_clients) * alpha)\n            cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n            splits = np.split(idx, cuts)\n            for k, s in enumerate(splits):\n                parts[k].extend(s.tolist())\n        if min(len(z) for z in parts) >= min_size:\n            return [np.array(sorted(z), dtype=int) for z in parts]\n    raise RuntimeError(\"Failed to build a valid Dirichlet partition.\")\n\ndef feature_cluster_partition(X, y, n_clients, n_clusters, seed):\n    km = MiniBatchKMeans(n_clusters=n_clusters, random_state=seed, batch_size=256, n_init=10)\n    cluster_id = km.fit_predict(X)\n    rng = np.random.default_rng(seed)\n    parts = [[] for _ in range(n_clients)]\n    for c in range(n_clusters):\n        idx = rng.permutation(np.where(cluster_id == c)[0])\n        if len(idx) == 0:\n            continue\n        props = rng.dirichlet(np.ones(n_clients) * 0.35)\n        cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n        for k, s in enumerate(np.split(idx, cuts)):\n            parts[k].extend(s.tolist())\n    for k in range(n_clients):\n        if len(parts[k]) == 0:\n            donor = int(np.argmax([len(z) for z in parts]))\n            parts[k].append(parts[donor].pop())\n    return [np.array(sorted(z), dtype=int) for z in parts], cluster_id\n\ndef client_summary(parts, y, cluster_id=None):\n    rows=[]\n    global_rate=float(np.mean(y))\n    for k, idx in enumerate(parts):\n        row={\"client\":k, \"n\":len(idx),\n             \"label1_rate\":float(np.mean(y[idx])),\n             \"abs_label_shift\":abs(float(np.mean(y[idx]))-global_rate)}\n        if cluster_id is not None:\n            vals, counts=np.unique(cluster_id[idx], return_counts=True)\n            row[\"n_feature_clusters\"]=len(vals)\n            row[\"dominant_cluster_share\"]=float(counts.max()/counts.sum())\n        rows.append(row)\n    return pd.DataFrame(rows)\n\niid_parts = balanced_iid_partition(y_train, N_CLIENTS, SEED)\ndir_parts = dirichlet_label_partition(y_train, N_CLIENTS, 0.5, SEED)\ncluster_parts, cluster_ids = feature_cluster_partition(\n    X_train, y_train, N_CLIENTS, N_FEATURE_CLUSTERS, SEED\n)\n\nprint(\"IID\"); display(client_summary(iid_parts, y_train))\nprint(\"Dirichlet alpha=0.5\"); display(client_summary(dir_parts, y_train))\nprint(\"Cluster-skew\"); display(client_summary(cluster_parts, y_train, cluster_ids))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:07.918668Z","iopub.execute_input":"2026-10-04T10:11:07.919026Z","iopub.status.idle":"2026-10-04T10:11:08.049464Z","shell.execute_reply.started":"2026-10-