al training labels are flipped\n# - two clients: 40% of each selected client's local training labels are flipped\n# - one straggler: one client trains for only 1 local epoch\nROBUST_SCENARIOS = [\n    (\"one_poison_20pct\", [0], 0.20, []),\n    (\"two_poison_40pct\", [0, 1], 0.40, []),\n    (\"one_straggler\", [], 0.0, [0]),\n]\n\nRUN_ROBUSTNESS_SWEEP = True\n\nif RUN_ROBUSTNESS_SWEEP:\n    robustness_progress = load_checkpoint(ROBUST_PROGRESS_PATH)\n    expected_robust = (\n        len(ROBUST_SEEDS)\n        * len(ROBUST_SCENARIOS)\n        * len(ROBUST_METHODS)\n    )\n\n    for seed in ROBUST_SEEDS:\n        parts = balanced_iid_partition(y_train, N_CLIENTS, seed)\n\n        for scenario, poisoned, rate, stragglers in ROBUST_SCENARIOS:\n            for method in ROBUST_METHODS:\n                done = False\n\n                if not robustness_progress.empty:\n                    done = (\n                        (robustness_progress[\"seed\"].astype(int) == seed)\n                        & (robustness_progress[\"scenario\"] == scenario)\n                        & (robustness_progress[\"method\"] == method)\n                    ).any()\n\n                if done:\n                    print(f\"SKIP  {scenario} {method} seed={seed}\")\n                    continue\n\n                print(f\"RUN   {scenario} {method} seed={seed}\")\n\n                result, _, _ = run_federated(\n                    X_train,\n                    y_train,\n                    X_test,\n                    y_test,\n                    parts,\n                    method,\n                    seed,\n                    CFG[\"fl_rounds\"],\n                    CFG[\"local_epochs\"],\n                    CFG[\"batch_size\"],\n                    corrupt_clients=poisoned,\n                    corrupt_rate=rate,\n                    straggler_clients=stragglers,\n                )\n\n                result.update({\n                    \"scenario\": scenario,\n                    \"partition\": \"IID\",\n                    \"n_clients\": int(N_CLIENTS),\n                    \"poisoned_client_count\": len(poisoned),\n                    \"poisoned_client_fraction\": len(poisoned) / N_CLIENTS,\n                    \"local_label_flip_rate\": float(rate),\n                })\n\n                robustness_progress = upsert_checkpoint(\n                    ROBUST_PROGRESS_PATH,\n                    [result],\n                    [\"seed\", \"scenario\", \"method\"],\n                )\n\n                print(\n                    f\"CHECKPOINT: {len(robustness_progress)}/{expected_robust} \"\n                    \"robustness runs\"\n                )\n\n    if len(robustness_progress) == expected_robust:\n        atomic_to_csv(\n            robustness_progress.sort_values(\n                [\"scenario\", \"method\", \"seed\"]\n            ),\n            ROBUST_FINAL_PATH,\n        )\n        print(\"ROBUSTNESS SWEEP COMPLETE:\", len(robustness_progress), \"rows\")\n    else:\n        print(\n            \"ROBUSTNESS SWEEP INCOMPLETE; progress retained at:\",\n            ROBUST_PROGRESS_PATH,\n        )\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T06:31:25.206253Z","iopub.execute_input":"2026-10-06T06:31:25.206636Z","iopub.status.idle":"2026-10-06T07:26:32.389843Z","shell.execute_reply.started":"2026-10-06T06:31:25.206611Z","shell.execute_reply":"2026-10-06T07:26:32.389192Z"},"trusted":true},"outputs":[{"name":"stdout","text":"RUN   one_poison_20pct FedAvg seed=0\nCHECKPOINT: 1/300 robustness runs\nRUN   one_poison_20pct FedProx seed=0\nCHECKPOINT: 2/300 robustness runs\nRUN   one_poison_20pct Median seed=0\nCHECKPOINT: 3/300 robustness runs\nRUN   one_poison_20pct TrimmedMean seed=0\nCHECKPOINT: 4/300 robustness runs\nRUN   one_poison_20pct CAFAD seed=0\nCHECKPOINT: 5/300 robustness runs\nRUN   two_poison_40pct FedAvg seed=0\nCHECKPOINT: 6/300 robustness runs\nRUN   two_poison_40pct FedProx seed=0\nCHECKPOINT: 7/300 robustness runs\nRUN 