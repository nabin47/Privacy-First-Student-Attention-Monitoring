at\n    )\n\n    n = len(p_values)\n\n    order = np.argsort(\n        p_values\n    )\n\n    ranked = p_values[order]\n\n    adjusted = (\n        ranked * n /\n        np.arange(1, n + 1)\n    )\n\n    adjusted = np.minimum.accumulate(\n        adjusted[::-1]\n    )[::-1]\n\n    output = np.empty_like(\n        adjusted\n    )\n\n    output[order] = np.minimum(\n        adjusted,\n        1.0\n    )\n\n    return output\n\n\n# ------------------------------------------------------------\n# Paired method comparison\n# ------------------------------------------------------------\n\nBASELINE = \"FedAvg\"\n\nCOMPARE_METHODS = [\n    \"FedProx\",\n    \"Median\",\n    \"TrimmedMean\",\n    \"CAFAD\"\n]\n\n\ndef paired_comparison(\n    data,\n    metric\n):\n\n    rows = []\n\n    conditions = (\n        data[\n            [\"condition\", \"alpha\"]\n        ]\n        .drop_duplicates()\n        .to_dict(\"records\")\n    )\n\n    for c in conditions:\n\n        condition = c[\"condition\"]\n        alpha = c[\"alpha\"]\n\n        subset = data[\n            (data[\"condition\"] == condition)\n            &\n            (\n                (\n                    data[\"alpha\"].isna()\n                    &\n                    pd.isna(alpha)\n                )\n                |\n                (\n                    data[\"alpha\"] == alpha\n                )\n            )\n        ].copy()\n\n        pivot = subset.pivot(\n            index=\"seed\",\n            columns=\"method\",\n            values=metric\n        )\n\n        for method in COMPARE_METHODS:\n\n            if (\n                BASELINE not in pivot.columns\n                or method not in pivot.columns\n            ):\n                continue\n\n            pair = pivot[\n                [BASELINE, method]\n            ].dropna()\n\n            if len(pair) < 5:\n                continue\n\n            diff = (\n                pair[method]\n                -\n                pair[BASELINE]\n            ).to_numpy()\n\n            # Wilcoxon signed-rank\n            stat, p = wilcoxon(\n                diff,\n                zero_method=\"wilcox\",\n                alternative=\"two-sided\"\n            )\n\n            diff_std = np.std(\n                diff,\n                ddof=1\n            )\n\n            paired_d = (\n                np.mean(diff) /\n                diff_std\n                if diff_std > 0\n                else np.nan\n            )\n\n            rows.append({\n\n                \"condition\": condition,\n                \"alpha\": alpha,\n                \"metric\": metric,\n\n                \"baseline\": BASELINE,\n                \"method\": method,\n\n                \"n_pairs\": len(pair),\n\n                \"mean_difference\": np.mean(diff),\n                \"median_difference\": np.median(diff),\n\n                # percentage-point difference\n                \"mean_difference_pp\":\n                    100 * np.mean(diff),\n\n                \"median_difference_pp\":\n                    100 * np.median(diff),\n\n                \"paired_effect_d\":\n                    paired_d,\n\n                \"wilcoxon_statistic\":\n                    stat,\n\n                \"p_value\":\n                    p\n\n            })\n\n    result = pd.DataFrame(rows)\n\n    if len(result):\n\n        result[\"p_bh\"] = bh_adjust(\n            result[\"p_value\"]\n        )\n\n    return result\n\n\n# ------------------------------------------------------------\n# Accuracy tests\n# ------------------------------------------------------------\n\naccuracy_tests = paired_comparison(\n    clean_results,\n    \"accuracy\"\n)\n\nprint(\n    \"\\n================ ACCURACY PAIRED TESTS ================\\n\"\n)\n\ndisplay(\n    accuracy_tests[\n        [\n            \"condition\",\n            \"alpha\",\n            \"method\",\n            \"n_pairs\",\n            \"mean_difference_pp\",\n            \"median_difference_pp\",\n            \"paired_effect_d\",\n            \"p_value\",\n            \"p_bh\"\n        ]\n    ]\n    .sort_values(\n        [\"condition\", \"alpha\", \"method\"],\n        na_position=\"first\"\n    )\n)\n\n\n# ------------------------------------------------------------\n# F1 tests\n# ------------------------------------------------------------\n\nf1_tests = paired_comparison(\n    clean_results,\n    \"f1\"\n)\n\nprint(\n    \"\\n================ F1 PAIRED TESTS ================\\n\"\n)\n\ndisplay(\n    f1_tests[\n        [\n            \"condition\",\n            \"alpha\",\n            \"method\",\n            \"mean_difference_pp\",\n            \"median_difference_pp\",\n            \"paired_effect_d\",\n            \"p_value\",\n            \"p_bh\"\n        ]\n    ]\n    .sort_values(\n        [\"condition\", \"alpha\", \"method\"],\n        na_position=\"first\"\n    )\n)\n\n\naccuracy_tests.to_csv(\n    RESULTS_DIR / \"paired_accuracy_tests_v3.csv\",\n    index=False\n)\n\nf1_tests.to_csv(\n    RESULTS_DIR / \"paired_f1_tests_v3.csv\",\n    index=False\n)\n\n\n# ============================================================\n# WORST RUNS\n# ============================================================\n\nprint(\n    \"\\n================ WORST RUNS ================\\n\"\n)\n\nWORST_ALPHAS = [\n    0.5,\n    0.1\n]\n\nWORST_METHODS = [\n    \"Median\",\n    \"TrimmedMean\"\n]\n\nworst_rows = []\n\nfor alpha in WORST_ALPHAS:\n\n    subset = clean_results[\n        (clean_results[\"condition\"] == \"Dirichlet\")\n        &\n        (clean_results[\"alpha\"] == alpha)\n        &\n        (clean_results[\"method\"].isin(WORST_METHODS))\n    ].copy()\n\n    for method in WORST_METHODS:\n\n        temp = subset[\n            subset[\"method\"] == method\n        ].nsmallest(\n            5,\n            \"accuracy\"\n        )\n\n        for _, row in temp.iterrows():\n\n            worst_rows.append({\n                \"alpha\": alpha,\n                \"method\": 