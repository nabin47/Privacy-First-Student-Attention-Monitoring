ndex=False)\n\n# Paired Wilcoxon tests; BH correction is applied over all tests within each family.\ndef _bh_qvalues(p_values):\n    p = np.asarray(p_values, dtype=float)\n    q = np.full(p.shape, np.nan, dtype=float)\n    finite = np.isfinite(p)\n    pv = p[finite]\n    if pv.size == 0:\n        return q\n    order = np.argsort(pv)\n    ranked = pv[order]\n    adjusted = ranked * len(ranked) / np.arange(1, len(ranked) + 1)\n    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1]\n    unorder = np.empty_like(adjusted)\n    unorder[order] = np.clip(adjusted, 0, 1)\n    q[finite] = unorder\n    return q\n\ndef _paired_method_tests(frame, group_cols, methods_to_compare, metrics, method_col=\"method\"):\n    rows = []\n    for group_key, group in frame.groupby(group_cols, dropna=False):\n        if not isinstance(group_key, tuple):\n            group_key = (group_key,)\n        group_values = dict(zip(group_cols, group_key))\n        base = group[group[method_col].eq(\"FedAvg\")].set_index(\"seed\")\n        for method in methods_to_compare:\n            current = group[group[method_col].eq(method)].set_index(\"seed\")\n            common = sorted(set(base.index).intersection(current.index))\n            for metric in metrics:\n                if len(common) < 2:\n                    continue\n                a = base.loc[common, metric].astype(float).to_numpy()\n                b = current.loc[common, metric].astype(float).to_numpy()\n                diff = b - a\n                p = 1.0 if np.allclose(diff, 0) else float(wilcoxon(a, b, zero_method=\"wilcox\").pvalue)\n                rows.append({\n                    **group_values, \"method_a\": \"FedAvg\", \"method_b\": method,\n                    \"metric\": metric, \"n_pairs\": len(common),\n                    \"mean_diff_method_b_minus_fedavg\": float(np.mean(diff)),\n                    \"median_diff_method_b_minus_fedavg\": float(np.median(diff)),\n                    \"wilcoxon_p\": p,\n                })\n    out = pd.DataFrame(rows)\n    if not out.empty:\n        out[\"bh_q\"] = _bh_qvalues(out[\"wilcoxon_p\"].to_numpy())\n        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n    return out\n\nrobustness_tests = _paired_method_tests(\n    rob, [\"scenario\"], [m for m in ROBUST_METHODS if m != \"FedAvg\"], [\"accuracy\", \"f1\"]\n)\nrobustness_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_paired_tests_BH.csv\", index=False)\n\nclient_sensitivity_tests = _paired_method_tests(\n    client_sens, [\"n_clients\", \"condition\", \"alpha\"], [\"CAFAD\"], [\"accuracy\", \"f1\"]\n)\nclient_sensitivity_tests.to_csv(RESULTS_DIR / \"MANUSCRIPT_client_count_paired_tests_BH.csv\", index=False)\n\ncompact_rob = rob.groupby([\"scenario\", \"method\"])[[\"accuracy\", \"f1\", \"mcc\"]].agg([\"mean\", \"std\"]).reset_index()\ncompact_rob.to_csv(RESULTS_DIR / \"MANUSCRIPT_robustness_summary_compact_corrected.csv\", index=False)\n\n# Final completeness manifest. Resolve device from the active runtime instead of a stale None value.\nactive_device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\ndp_rng_is_csprng = dp.loc[\n    np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\")), \"dp_rng_mode\"\n].astype(str).str.contains(\"CSPRNG\").all()\nif not dp_rng_is_csprng:\n    print(\n        \"DP METHODOLOGY WARNING: at least one private run used a non-cryptographic \"\n        \"PyTorch PRNG fallback. Do not present this as a strict practical DP certificate; \"\n        \"rerun the corrected DP grid with a supported CSPRNG before making a formal privacy claim.\"\n    )\nfinal_manifest = {\n    \"clean_rows\": int(len(clean_results)),\n    \"robustness_rows_corrected\": int(len(rob)),\n    \"robustness_protocol\": \"20% and 40% of clients with fully flipped local training labels; one straggler\",\n    \"blocked_rows\": int(len(blk)),\n    \"dp_private_rows\": int(len(dp[np.isfinite(pd.to_numeric(dp[\"target_epsilon\"], errors=\"coerce\"))])),