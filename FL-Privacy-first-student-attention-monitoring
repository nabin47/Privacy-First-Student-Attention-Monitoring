cpu()\n                    .numpy()\n                )\n\n\n            clean_accuracy = accuracy_score(\n                y_test,\n                clean_pred\n            )\n\n            clean_f1 = f1_score(\n                y_test,\n                clean_pred,\n                zero_division=0\n            )\n\n\n            # ------------------------------------------------\n            # Generate all attack strengths\n            # ------------------------------------------------\n\n            for eps in FGSM_EPSILONS:\n\n                model = MLP(\n                    X_test.shape[1]\n                )\n\n                load_state_dict_cpu(\n                    model,\n                    state\n                )\n\n                model.eval()\n\n\n                xt = torch.tensor(\n                    X_test,\n                    dtype=torch.float32,\n                    requires_grad=True\n                )\n\n                yt = torch.tensor(\n                    y_test,\n                    dtype=torch.long\n                )\n\n\n                logits = model(\n                    xt\n                )\n\n                loss = nn.functional.cross_entropy(\n                    logits,\n                    yt\n                )\n\n\n                model.zero_grad(\n                    set_to_none=True\n                )\n\n                loss.backward()\n\n\n                x_adv = (\n                    xt\n                    + eps * xt.grad.sign()\n                ).detach()\n\n\n                with torch.no_grad():\n\n                    adv_pred = (\n                        model(x_adv)\n                        .argmax(1)\n                        .cpu()\n                        .numpy()\n                    )\n\n\n                adv_accuracy = accuracy_score(\n                    y_test,\n                    adv_pred\n                )\n\n\n                row = {\n\n                    \"seed\": seed,\n\n                    \"method\": method,\n\n                    \"attack_epsilon\": eps,\n\n                    \"clean_accuracy\":\n                        clean_accuracy,\n\n                    \"clean_f1\":\n                        clean_f1,\n\n                    \"adv_accuracy\":\n                        adv_accuracy,\n\n                    \"adv_balanced_accuracy\":\n                        balanced_accuracy_score(\n                            y_test,\n                            adv_pred\n                        ),\n\n                    \"adv_f1\":\n                        f1_score(\n                            y_test,\n                            adv_pred,\n                            zero_division=0\n                        ),\n\n                    \"adv_precision\":\n                        precision_score(\n                            y_test,\n                            adv_pred,\n                            zero_division=0\n                        ),\n\n                    \"adv_recall\":\n                        recall_score(\n                            y_test,\n                            adv_pred,\n                            zero_division=0\n                        ),\n\n                    \"adv_mcc\":\n                        matthews_corrcoef(\n                            y_test,\n                            adv_pred\n                        ),\n\n                    \"adv_pred_class1_rate\":\n                        float(\n                            np.mean(\n                                adv_pred == 1\n                            )\n                        ),\n\n                    \"accuracy_drop\":\n                        clean_accuracy\n                        - adv_accuracy\n                }\n\n\n                fgsm_progress = pd.concat(\n                    [\n                        fgsm_progress,\n                        pd.DataFrame([row])\n                    ],\n                    ignore_index=True\n                )\n\n\n            # ------------------------------------------------\n            # CHECKPOINT AFTER ENTIRE SEED × METHOD\n            # ------------------------------------------------\n\n            fgsm_progress = (\n                fgsm_progress\n                .drop_duplicates(\n                    subset=[\n                        \"seed\",\n                        \"method\",\n                        \"attack_epsilon\"\n                    ],\n                    keep=\"last\"\n                )\n                .sort_values(\n                    [\n                        \"seed\",\n                        \"method\",\n                        \"attack_epsilon\"\n                    ]\n                )\n                .reset_index(drop=True)\n            )\n\n\n            fgsm_progress.to_csv(\n                FGSM_PROGRESS_PATH,\n                index=False\n            )\n\n\n            print(\n                \"CHECKPOINT SAVED:\",\n                len(fgsm_progress),\n                \"rows\"\n            )\n\n\n    # --------------------------------------------------------\n    # Final FGSM file\n    # --------------------------------------------------------\n\n    fgsm_results = (\n        fgsm_progress\n        .drop_duplicates(\n            subset=[\n                \"seed\",\n                \"method\",\n                \"attack_epsilon\"\n            ],\n            keep=\"last\"\n        )\n        .sort_values(\n            [\n                \"seed\",\n                \"method\",\n                \"attack_epsilon\"\n            ]\n        )\n        .reset_index(drop=True)\n    )\n\n\n    fgsm_results.to_csv(\n        FGSM_FINAL_PATH,\n        index=False\n    )\n\n\n    print(\n        \"\\nFGSM COMPLETE:\",\n        len(fgsm_results),\n        \"rows\"\n    )\n\n\n    display(\n        fgsm_results.groupby(\n            [\n                \"method\",\n                \"attack_epsilon\"\n            ]\n        )\n        .agg(\n            clean_accuracy_mean=(\n                \"clean_accuracy\",\n                \"mean\"\n            ),\n            adv_accuracy_mean=(\n                \"adv_accuracy\",\n                \"mean\"\n            ),\n            adv_accuracy_std=(\n                \"adv_accuracy\",\n                \"std\"\n            ),\n            adv_f1_mean=(\n                \"adv_f1\",\n                \"mean\"\n            ),\n            accuracy_drop_mean=(\n                \"accuracy_drop\",\n                \"mean\"\n            ),\n            accuracy_drop_std=(\n                \"accuracy_drop\",\n                \"std\"\n            ),\n            pred_class1_rate_mean=(\n                \"adv_pred_class1_rate\",\n                \"mean\"\n            ),\n            n=(\n                \"seed\",\n                \"count\"\n            )\n        )\n        .reset_index()\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T19:20:45.730428Z","iopub.status.idle":"2026-10-05T19:20:45.730674Z","shell.execute_reply.started":"2026-10-05T19:20:45.730562Z","shell.execute_reply":"2026-10-05T19:20:45.730575Z"}},"outputs":[],"execution_count":null},{"id":"09d93c2b-76a6-44a3-9f3a-90e40801612d","cell_type":"markdown","source":"\n## 19F. Publication-ready figures and exports\n\nThis section does not retrain models. It reads the saved clean/DP/FGSM results and creates PNG figures suitable for the manuscript.\n\nThe earlier notebook plotted figures inline, but did not save publication files. This section explicitly saves them at 300 dpi.\n","metadata":{}},{"id":"4c9df418-5ce4-4e53-acdc-2509126c727f","cell_type":"code","source":"\n# ============================================================\n# 19F. Publication figures\n# ============================================================\n\n# ---------- Figure 1: clean accuracy vs alpha ----------\n\nfig, ax = plt.subplots(figsize=(8, 5))\n\nfor method in METHODS:\n\n    s = accuracy_summary[\n        accuracy_summary[\"method\"] == method\n    ].copy()\n\