t)\n\n        corrected = corrected.drop_duplicates(\n            subset=[\"seed\", \"scenario\", \"method\"],\n            keep=\"last\",\n        )\n\n    def atomic_save(df, path):\n        path.parent.mkdir(parents=True, exist_ok=True)\n        temp = path.with_suffix(path.suffix + \".tmp\")\n        df.to_csv(temp, index=False)\n        temp.replace(path)\n\n    atomic_save(corrected, NEW_PROGRESS)\n\n    expected = 20 * 3 * 5\n\n    print(\"Corrected checkpoint saved:\", NEW_PROGRESS)\n    print(\"Completed corrected runs:\", len(corrected))\n    print(\"Expected corrected runs:\", expected)\n\n    if not corrected.empty:\n        print(\"\\nRuns by scenario:\")\n        print(corrected.groupby(\"scenario\").size())\n\n    if len(corrected) == expected:\n        atomic_save(\n            corrected.sort_values([\"scenario\", \"method\", \"seed\"]),\n            NEW_FINAL,\n        )\n        print(\"\\nCorrected robustness sweep is complete:\", NEW_FINAL)\n    else:\n        print(\n            \"\\nCorrected robustness sweep is incomplete. \"\n            \"Resume missing runs using the corrected checkpoint.\"\n        )","metadata":{"execution":{"iopub.execute_input":"2026-10-09T07:46:04.921137Z","iopub.status.busy":"2026-10-09T07:46:04.920757Z","iopub.status.idle":"2026-10-09T07:46:04.964664Z","shell.execute_reply":"2026-10-09T07:46:04.96376Z","shell.execute_reply.started":"2026-10-09T07:46:04.921108Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Corrected checkpoint saved: /kaggle/working/attention_fl_v3_q1_10client_results/robustness_sweep_corrected_progress_v3.csv\n","Completed corrected runs: 300\n","Expected corrected runs: 300\n","\n","Runs by scenario:\n","scenario\n","full_label_flip_20pct_clients    100\n","full_label_flip_40pct_clients    100\n","one_straggler_10pct_clients      100\n","dtype: int64\n","\n","Corrected robustness sweep is complete: /kaggle/working/attention_fl_v3_q1_10client_results/robustness_sweep_corrected_v3.csv\n"]}],"execution_count":9},{"cell_type":"markdown","source":"## 14. Record-level DP-SGD — corrected protocol v2 (use only v2 outputs)\n\nThe DP mechanism below uses Poisson sampling, per-record gradient clipping, Gaussian noise added to the clipped **gradient sum**, and division by the fixed expected batch size `q*n`. Empty sampled lots still execute a noisy update. The integer-order RDP accountant calibrates the noise multiplier for the complete local training schedule. Since clients hold disjoint row partitions, report the maximum client-level epsilon (record/row-level privacy; not student-level privacy).\n\n**Important:** the DP CSVs in the previously archived results ZIP were generated by the old realized-lot-normalization implementation. They are historical outputs and must not be used as the paper's formal DP results. Run Cells 14A–14C and the corrected DP sweep (Cell 20B) to create the v2 results.\n\nFor a formal privacy claim, set `DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM=True` and use a compatible `torchcsprng` installation. If the CSPRNG is unavailable, the code labels its fallback as non-cryptographic and must not be described as a cryptographically secure implementation.","metadata":{}},{"cell_type":"code","source":"# 14A. Integer-order RDP accountant + cached calibration and DP RNG helpers (v2)\nimport secrets\nimport os\n\nDP_RDP_ORDERS = list(range(2, 65))\nDP_CALIBRATION_CACHE = {}\nDP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM = True  # Formal DP runs fail closed unless torchcsprng is available.\n\ntry:\n    import torchcsprng as _torchcsprng\n    DP_TORCHCSPRNG_AVAILABLE = True\nexcept Exception:\n    _torchcsprng = None\n    DP_TORCHCSPRNG_AVAILABLE = False\n\n# os.urandom is backed by the operating system CSPRNG. If torchcsprng is not\n# installed, use OS-CSPRNG bytes directly for Poisson masks and Gaussian noise.\n# This avoids silently falling back to a conventional seeded PyTorch PRNG.\nDP_CSPRNG_AVAILABLE = DP_TORCHCSPRNG_AVAILABLE or hasattr(os, \"urandom\")\nif not DP_TORCHCSPRNG_AVAILABLE:\n    print(\n        \"torchcsprng is unavailable; using an OS-CSPRNG-backed implementation \"\n        \"based on os.urandom for Poisson sampling and Gaussian noise.\"\n    )\n\ndef _os_csprng_uniform(shape):\n    \"\"\"Generate float64 U(0,1) values from OS-CSPRNG bytes (never NumPy RNG).\"\"\"\n    count = int(np.prod(shape, dtype=np.int64))\n    if count == 0:\n        return np.empty(shape, dtype=np.float64)\n    raw = os.urandom(count * 8)\n    vals = np.frombuffer(raw, dtype=np.uint64).copy() >> np.uint64(11)  # 53 random bits\n    out = (vals.astype(np.float64) + 0.5) / float(2**53)\n    return out.reshape(shape)\n\ndef _os_csprng_normal(shape):\n    \"\"\"Box-Muller standard normals from OS-CSPRNG uniforms.\"\"\"\n    count = int(np.prod(shape, dtype=np.int64))\n    if count == 0:\n        return np.empty(shape, dtype=np.float64)\n    pairs = (count + 1) // 2\n    u = _os_csprng_uniform((pairs, 2))\n    radius = np.sqrt(-2.0 * np.log(u[:, 0]))\n    angle = 2.0 * np.pi * u[:, 1]\n    z = np.empty(pairs * 2, dtype=np.float64)\n    z[0::2] = radius * np.cos(angle)\n    z[1::2] = radius * np.sin(angle)\n    return z[:count].reshape(shape)\n\ndef subsampled_gaussian_rdp(q, sigma, order):\n    \"\"\"Exact integer-order RDP of the Poisson-subsampled Gaussian mechanism.\"\"\"\n    a = int(order)\n    if a < 2:\n        raise ValueError(\"Integer RDP order must be >= 2.\")\n    if sigma <= 0:\n        raise ValueError(\"sigma must be positive for a private mechanism.\")\n    if q <= 0:\n        return 0.0\n    if q >= 1:\n        return float(a / (2.0 * sigma**2))\n    i = np.arange(a + 1, dtype=np.float64)\n    log_comb = gammaln(a + 1) - gammaln(i + 1) - gammaln(a - i + 1)\n    log_q = i * math.log(q)\n    log_1q = (a - i) * math.log1p(-q)\n    exponent = (i * i - i) / (2.0 * sigma**2)\n    log_a = logsumexp(log_comb + log_q + log_1q + exponent)\n    return float(log_a / (a - 1))\n\n\ndef rdp_epsilon(q, sigma, steps, delta=DP_DELTA, orders=None):\n    \"\"\"Convert composed RDP to an (epsilon, delta) upper bound.\"\"\"\n    if not (0.0 < delta < 1.0):\n        raise ValueError(\"delta must be in (0, 1).\")\n    if steps <= 0:\n        raise ValueError(\"steps must be positive.\")\n    orders = DP_RDP_ORDERS if orders is None else list(orders)\n    epsilons = [\n        steps * subsampled_gaussian_rdp(q, sigma, a)\n        + math.log(1.0 / delta) / (a - 1)\n        for a in orders\n    ]\n    return float(np.min(epsilons))\n\n\ndef calibrate_sigma(target_epsilon, q, steps, delta=DP_DELTA):\n    \"\"\"Find a conservative noise multiplier for the specified full-run budget.\"\"\"\n    if not np.isfinite(target_epsilon) or target_epsilon <= 0:\n        raise ValueError(\"target_epsilon must be finite and positive.\")\n    if not (0.0 < q <= 1.0):\n        raise ValueError(\"Poisson sample rate q must be in (0, 1].\")\n\n    lo, hi = 1e-3, 1.0\n    while rdp_epsilon(q, hi, steps, delta) > target_epsilon:\n        hi *= 2.0\n        if hi > 1e6:\n            raise RuntimeError(\"Could not bracket a noise multiplier for this budget.\")\n    # If even the smallest searched multiplier already satisfies the target, keep a valid bracket.\n    while rdp_epsilon(q, lo, steps, delta) <= target_epsilon and lo > 1e-12:\n        lo *= 0.5\n    for _ in range(64):\n        mid = (lo + hi) / 2.0\n        if rdp_epsilon(q, mid, steps, delta) > target_epsilon:\n            lo = mid\n        else:\n            hi = mid\n    return float(hi)\n\n\ndef get_dp_client_plan(n, batch_size, total_rounds, local_epochs, target_epsilon,\n                       delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM):\n    \"\"\"Plan/cached accounting once for a client-size and protocol combination.\"\"\"\n    n = int(n)\n    if n <= 0:\n        raise ValueError(\"DP client must contain at least one record.\")\n    q = min(1.0, float(batch_size) / n)\n    expected_batch_size = q * n  # fixed expected Poisson lot size, never realized lot size\n    steps_per_epoch = max(1, int(math.ceil(1.0 / q)))\n    total_steps = int(total_rounds) * int(local_epochs) * steps_per_epoch\n    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n    eps_key = None if not private else round(float(target_epsilon), 12)\n    key = (n, int(batch_size), int(total_rounds), int(local_epochs), eps_key,\n           float(delta), float(max_grad_norm), tuple(DP_RDP_ORDERS))\n    if key not in DP_CALIBRATION_CACHE:\n        if private:\n            sigma = calibrate_sigma(float(target_epsilon), q, total_steps, delta)\n            achieved = rdp_epsilon(q, sigma, total_steps, delta)\n        else:\n            sigma = 0.0\n            achieved = np.nan\n        DP_CALIBRATION_CACHE[key] = {\n            \"n\": n,\n            \"q\": float(q),\n            \"expected_batch_size\": float(expected_batch_size),\n            \"steps_per_epoch\": steps_per_epoch,\n            \"total_steps\": total_steps,\n            \"sigma\": float(sigma),\n            \"achieved_epsilon\": float(achieved) if np.isfinite(achieved) else np.nan,\n            \"dp_enabled\": bool(private),\n            \"target_epsilon\": float(target_epsilon) if private else np.inf,\n            \"delta\": float(delta),\n            \"max_grad_norm\": float(max_grad_norm),\n        }\n    return dict(DP_CALIBRATION_CACHE[key])\n\n\ndef make_dp_random_generator():\n    \"\"\"Return a cryptographic RNG mode; never silently use a seeded PRNG for DP.\"\"\"\n    if DP_TORCHCSPRNG_AVAILABLE:\n        gen = _torchcsprng.create_random_device_generator(\"/dev/urandom\")\n        return gen, \"torchcsprng:/dev/urandom (CSPRNG)\"\n    if hasattr(os, \"urandom\"):\n        return None, \"os.urandom + Box-Muller (OS-CSPRNG-backed)\"\n    if DP_REQUIRE_CSPRNG_FOR_FORMAL_CLAIM:\n        raise RuntimeError(\n            \"No cryptographically secure random source is available. \"\n            \"Use a runtime with os.urandom or install a compatible torchcsprng build.\"\n        )\n    gen = torch.Generator(device=DEVICE)\n    gen.manual_seed(secrets.randbits(63))\n    return gen, \"OS-entropy-seeded PyTorch PRNG (NOT cryptographically secure)\"\n\n\ndef _dp_poisson_mask(n, q, generator, rng_mode):\n    if \"torchcsprng\" in rng_mode:\n        return (torch.rand(int(n), device=\"cpu\", generator=generator) < q).to(DEVICE)\n    if \"os.urandom\" in rng_mode:\n        u = _os_csprng_uniform((int(n),))\n        return torch.from_numpy(u < float(q)).to(DEVICE)\n    return torch.rand(int(n), device=DEVICE, generator=generator) < q\n\ndef _dp_gaussian_noise_like(reference, std, generator, rng_mode):\n    if \"torchcsprng\" in rng_mode:\n        noise = torch.empty(tuple(reference.shape), dtype=reference.dtype, device=\"cpu\")\n        noise.normal_(mean=0.0, std=float(std), generator=generator)\n        return noise.to(reference.device)\n    if \"os.urandom\" in rng_mode:\n        arr = _os_csprng_normal(tuple(reference.shape)) * float(std)\n        return torch.as_tensor(arr, dtype=reference.dtype, device=reference.device)\n    noise = torch.empty_like(reference)\n    noise.normal_(mean=0.0, std=float(std), generator=generator)\n    return noise\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:36:56.135958Z","iopub.execute_input":"2026-10-10T08:36:56.136774Z","iopub.status.idle":"2026-10-10T08:36:56.159257Z","shell.execute_reply.started":"2026-10-10T08:36:56.136731Z","shell.execute_reply":"2026-10-10T08:36:56.158676Z"},"trusted":true},"outputs":[{"name":"stdout","text":"torchcsprng is unavailable; using an OS-CSPRNG-backed implementation based on os.urandom for Poisson sampling and Gaussian noise.\n","output_type":"stream"}],"execution_count":20},{"cell_type":"code","source":"# 14B. Corrected Poisson-sampled DP-SGD: expected-batch denominator + empty-lot noise\n\ndef dp_local_train(global_state, X, y, client_idx, seed, total_rounds, local_epochs,\n                   batch_size, target_epsilon, delta=DP_DELTA,\n                   max_grad_norm=DP_MAX_GRAD_NORM, lr=LR, dp_plan=None):\n    \"\"\"Train one client's local model. target_epsilon=None disables clipping/noise for a matched control.\"\"\"\n    seed_everything(seed)  # deterministic model initialization; private RNG is created independently below\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, global_state)\n    model.train()\n\n    idx = np.asarray(client_idx, dtype=int)\n    if len(idx) == 0:\n        raise ValueError(\"DP client partition cannot be empty.\")\n    x_local = torch.from_numpy(np.asarray(X[idx], dtype=np.float32)).to(DEVICE)\n    y_local = torch.from_numpy(np.asarray(y[idx], dtype=np.int64)).to(DEVICE)\n    n = len(idx)\n\n    plan = dp_plan or get_dp_client_plan(\n        n, batch_size, total_rounds, local_epochs, target_epsilon, delta, max_grad_norm\n    )\n    q = float(plan[\"q\"])\n    expected_batch_size = float(plan[\"expected_batch_size\"])\n    steps_per_epoch = int(plan[\"steps_per_epoch\"])\n    sigma = float(plan[\"sigma\"])\n    dp_enabled = bool(plan[\"dp_enabled\"])\n\n    if dp_enabled:\n        privacy_generator, rng_mode = make_dp_random_generator()\n    else:\n        privacy_generator, rng_mode = None, \"not_applicable_matched_nonprivate_control\"\n\n    params = {k: v for k, v in model.named_parameters()}\n    buffers = {k: v for k, v in model.named_buffers()}\n\n    def loss_one(params, buffers, x_one, y_one):\n        logits = functional_call(model, (params, buffers), (x_one.unsqueeze(0),))\n        return nn.functional.cross_entropy(logits, y_one.unsqueeze(0))\n\n    grad_one = grad(loss_one)\n\n    for _ in range(int(local_epochs)):\n        for _ in range(steps_per_epoch):\n            if dp_enabled:\n                mask = _dp_poisson_mask(n, q, privacy_generator, rng_mode)\n            else:\n                # The non-private reference uses the same Poisson sampling protocol,\n                # but its randomness is reproducibly seeded and no privacy claim is made.\n                mask = (torch.rand(n, device=DEVICE) < q)\n            ids = torch.where(mask)[0]\n\n            # A Poisson-sampled lot may be empty. The private mechanism must still\n            # release a Gaussian-perturbed sum for that step; do not skip the update.\n            grad_sums = {name: torch.zeros_like(p) for name, p in params.items()}\n            if ids.numel() > 0:\n                xb, yb = x_local[ids], y_local[ids]\n                per_sample = vmap(grad_one, in_dims=(None, None, 0, 0))(\n                    params, buffers, xb, yb\n                )\n\n                if dp_enabled:\n                    norm_sq = None\n                    for g in per_sample.values():\n                        flat = g.reshape(g.shape[0], -1)\n                        term = (flat * flat).sum(dim=1)\n                        norm_sq = term if norm_sq is None else norm_sq + term\n                    norms = torch.sqrt(norm_sq + 1e-12)\n                    coeff = torch.clamp(float(max_grad_norm) / norms, max=1.0)\n                    for name, g in per_sample.items():\n                        view = coeff.view(-1, *([1] * (g.ndim - 1)))\n                        grad_sums[name] = (g * view).sum(dim=0)\n                else:\n                    # Matched non-private control: same sampling/update schedule,\n                    # with clipping and noise disabled.\n                    for name, g in per_sample.items():\n                        grad_sums[name] = g.sum(dim=0)\n\n            with torch.no_grad():\n                for name, p in params.items():\n                    grad_sum = grad_sums[name]\n                    if dp_enabled:\n                        noise_sum = _dp_gaussian_noise_like(\n                            p, sigma * float(max_grad_norm), privacy_generator, rng_mode\n                        )\n                        grad_sum = grad_sum + noise_sum\n                    # Correct DP-SGD normalization: divide noisy clipped SUM by\n                    # expected lot size q*n, not the data-dependent realized |B|.\n                    grad_estimate = grad_sum / expected_batch_size\n                    p.add_(grad_estimate, alpha=-float(lr))\n\n    achieved_epsilon = float(plan[\"achieved_epsilon\"])\n    return clone_state_dict(model), sigma, achieved_epsilon, rng_mode\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:39:24.741145Z","iopub.execute_input":"2026-10-10T08:39:24.741436Z","iopub.status.idle":"2026-10-10T08:39:24.754267Z","shell.execute_reply.started":"2026-10-10T08:39:24.741413Z","shell.execute_reply":"2026-10-10T08:39:24.753443Z"},"trusted":true},"outputs":[],"execution_count":22},{"cell_type":"code","source":"# 14C. Federated DP runner + matched non-private reference runner (v2)\nDP_METHODS = [\"FedAvg\", \"Median\", \"TrimmedMean\"]\nDP_PROTOCOL_VERSION = \"v2_poisson_expected_batch_sum_noise_matched_control\"\n\n\ndef run_federated_dp(X, y, X_eval, y_eval, parts, method, seed, rounds,\n                     local_epochs, batch_size, target_epsilon):\n    \"\"\"target_epsilon=None means matched Poisson-sampled non-private control.\"\"\"\n    if method not in DP_METHODS:\n        raise ValueError(f\"Unsupported DP comparison method: {method}\")\n    seed_everything(seed)\n    initial_model = MLP(X.shape[1]).to(DEVICE)\n    global_state = clone_state_dict(initial_model)\n\n    # Plan calibration once per client, reused over all rounds and all methods via cache.\n    client_plans = [\n        get_dp_client_plan(\n            len(idx), batch_size, rounds, local_epochs, target_epsilon,\n            DP_DELTA, DP_MAX_GRAD_NORM\n        )\n        for idx in parts\n    ]\n    client_eps = [p[\"achieved_epsilon\"] for p in client_plans if np.isfinite(p[\"achieved_epsilon\"])]\n    client_sigmas = [p[\"sigma\"] for p in client_plans]\n    rng_modes = set()\n\n    for rnd in range(int(rounds)):\n        local_states, ns = [], []\n        for k, idx in enumerate(parts):\n            st, sigma, eps, rng_mode = dp_local_train(\n                global_state, X, y, idx, seed + 1000 * rnd + k,\n                total_rounds=rounds, local_epochs=local_epochs,\n                batch_size=batch_size, target_epsilon=target_epsilon,\n                delta=DP_DELTA, max_grad_norm=DP_MAX_GRAD_NORM, lr=LR,\n                dp_plan=client_plans[k],\n            )\n            local_states.append(st)\n            ns.append(len(idx))\n            if target_epsilon is not None and np.isfinite(float(target_epsilon)):\n                rng_modes.add(rng_mode)\n\n        if method == \"FedAvg\":\n            global_state = aggregate_fedavg(local_states, ns)\n        elif method == \"Median\":\n            global_state = aggregate_median(local_states)\n        elif method == \"TrimmedMean\":\n            global_state = aggregate_trimmed_mean(local_states, TRIM_FRACTION)\n\n    result = evaluate_state(global_state, X_eval, y_eval)\n    private = target_epsilon is not None and np.isfinite(float(target_epsilon))\n    result.update({\n        \"method\": method,\n        \"seed\": int(seed),\n        \"target_epsilon\": float(target_epsilon) if private else np.inf,\n        \"max_client_achieved_epsilon\": float(max(client_eps)) if client_eps else np.nan,\n        \"mean_client_sigma\": float(np.mean(client_sigmas)) if private else 0.0,\n        \"min_client_sample_rate\": float(min(p[\"q\"] for p in client_plans)),\n        \"max_client_sample_rate\": float(max(p[\"q\"] for p in client_plans)),\n        \"min_client_steps_full_run\": int(min(p[\"total_steps\"] for p in client_plans)),\n        \"max_client_steps_full_run\": int(max(p[\"total_steps\"] for p in client_plans)),\n        \"dp_enabled\": bool(private),\n        \"dp_protocol_version\": DP_PROTOCOL_VERSION,\n        \"dp_rng_mode\": \"; \".join(sorted(rng_modes)) if private else \"not_applicable_matched_nonprivate_control\",\n        \"nonprivate_control_protocol\": (\n            \"not_applicable_private_run\" if private else\n            \"matched_poisson_sampling_expected_batch_denominator_clipping_off_noise_off\"\n        ),\n    })\n    return result\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:39:46.209006Z","iopub.execute_input":"2026-10-10T08:39:46.209276Z","iopub.status.idle":"2026-10-10T08:39:46.219428Z","shell.execute_reply.started":"2026-10-10T08:39:46.209254Z","shell.execute_reply":"2026-10-10T08:39:46.218414Z"},"trusted":true},"outputs":[],"execution_count":23},{"cell_type":"code","source":"# ===== LR TUNING (validation only; test set untouched) =====\nimport time\nfrom sklearn.model_selection import train_test_split\n\nfit_idx, val_idx = train_test_split(np.arange(len(X_train)), test_size=0.2,\n                                    stratify=y_train, random_state=123)\nX_fit, y_fit = X_train[fit_idx], y_train[fit_idx]\nX_val, y_val = X_train[val_idx], y_train[val_idx]\n\nLR_GRID, K_GRID, TUNE_SEEDS = [0.01, 0.03, 0.05, 0.1, 0.2, 0.3], [5, 10, 20], [0, 1, 2]\n_LR_BACKUP = LR\nrows = []\nfor lr in LR_GRID:\n    LR = lr                                   # train_clients_once reads this global at call time\n    for K in K_GRID:\n        for s in TUNE_SEEDS:\n            parts = balanced_iid_partition(y_fit, K, s)\n            r, _, _ = run_federated(X_fit, y_fit, X_val, y_val, parts, \"FedAvg\", s,\n                                    CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"])\n            rows.append({\"lr\": lr, \"K\": K, \"seed\": s, \"val_acc\": r[\"accuracy\"]})\n    print(\"done lr\", lr, time.strftime(\"%H:%M:%S\"))\nLR = _LR_BACKUP\ntune = pd.DataFrame(rows)\nprint(tune.groupby([\"lr\", \"K\"]).val_acc.mean().unstack(\"K\").round(4))\n\n# Matched centralized MLP (same architecture/optimizer, 75 epochs = 25 rounds x 3 epochs)\ndef centralized_mlp_matched(lr, epochs, Xtr, ytr, Xev, yev, seed=0, bs=64):\n    seed_everything(seed)\n    model = MLP(Xtr.shape[1]).to(DEVICE); opt = torch.optim.SGD(model.parameters(), lr=lr)\n    Xt = torch.from_numpy(np.asarray(Xtr, dtype=np.float32)).to(DEVICE)\n    yt = torch.from_numpy(np.asarray(ytr, dtype=np.int64)).to(DEVICE)\n    for _ in range(epochs):\n        perm = torch.randperm(len(Xt), device=DEVICE)\n        for i in range(0, len(Xt), bs):\n            b = perm[i:i+bs]; opt.zero_grad()\n            nn.functional.cross_entropy(model(Xt[b]), yt[b]).backward(); opt.step()\n    return evaluate_state(clone_state_dict(model), Xev, yev)\n\nfor lr in LR_GRID:\n    print(\"centralized lr\", lr,\n          round(centralized_mlp_matched(lr, 75, X_fit, y_fit, X_val, y_val)[\"accuracy\"], 4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-10T14:58:10.986564Z","iopub.execute_input":"2026-10-10T14:58:10.986952Z","iopub.status.idle":"2026-10-10T15:05:09.760301Z","shell.execute_reply.started":"2026-10-10T14:58:10.986918Z","shell.execute_reply":"2026-10-10T15:05:09.759148Z"}},"outputs":[{"name":"stdout","text":"done lr 0.01 14:59:20\ndone lr 0.03 15:00:25\ndone lr 0.05 15:01:32\ndone lr 0.1 15:02:38\ndone lr 0.2 15:03:44\ndone lr 0.3 15:04:50\nK         5       10      20\nlr                          \n0.01  0.8836  0.8442  0.8071\n0.03  0.9179  0.8906  0.8822\n0.05  0.9209  0.9146  0.8902\n0.10  0.9216  0.9209  0.9189\n0.20  0.9213  0.9213  0.9213\n0.30  0.9209  0.9213  0.9213\ncentralized lr 0.01 0.9229\ncentralized lr 0.03 0.9229\ncentralized lr 0.05 0.9229\ncentralized lr 0.1 0.9189\ncentralized lr 0.2 0.9189\ncentralized lr 0.3 0.9219\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"\n## 15. FGSM evaluation\n\nFGSM is applied to the encoded tabular feature vector at evaluation time.\n\nThis is an **input-space robustness experiment**, not a claim that a real webcam attacker can perturb these detector features in exactly this way.\n\nReport clean accuracy/F1, attacked accuracy/F1, absolute degradation, and paired seed-level degradation.\n","metadata":{}},{"cell_type":"code","source":"# 15A. True-gradient FGSM helper — definition only; no training pilot\ndef fgsm_metrics(state, X, y, epsilon):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n\n    xt = torch.tensor(X, dtype=torch.float32, device=DEVICE, requires_grad=True)\n    yt = torch.tensor(y, dtype=torch.long, device=DEVICE)\n\n    logits = model(xt)\n    loss = nn.functional.cross_entropy(logits, yt)\n\n    model.zero_grad(set_to_none=True)\n    loss.backward()\n\n    x_adv = (xt + epsilon * xt.grad.sign()).detach()\n\n    with torch.no_grad():\n        clean_pred = logits.argmax(1).cpu().numpy()\n        adv_pred = model(x_adv).argmax(1).cpu().numpy()\n\n    clean_acc = accuracy_score(y, clean_pred)\n    adv_acc = accuracy_score(y, adv_pred)\n\n    return {\n        \"clean_accuracy\": clean_acc,\n        \"adv_accuracy\": adv_acc,\n        \"accuracy_drop\": clean_acc - adv_acc,\n        \"epsilon\": epsilon,\n    }\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T07:26:32.440052Z","iopub.status.busy":"2026-10-06T07:26:32.439689Z","iopub.status.idle":"2026-10-06T07:26:32.457498Z","shell.execute_reply":"2026-10-06T07:26:32.456878Z","shell.execute_reply.started":"2026-10-06T07:26:32.440024Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 16. Statistics and manuscript outputs\n\nUse matched seed-level comparisons, with Wilcoxon paired tests and Benjamini–Hochberg FDR correction. All final tables/figures are generated from saved result files; no training is repeated during reporting.","metadata":{}},{"cell_type":"code","source":"\n# 16A. BH correction + paired test helper\ndef bh_adjust(pvals):\n    pvals=np.asarray(pvals,float); n=len(pvals)\n    order=np.argsort(pvals); ranked=pvals[order]\n    q=ranked*n/np.arange(1,n+1)\n    q=np.minimum.accumulate(q[::-1])[::-1]\n    out=np.empty_like(q); out[order]=q\n    return np.minimum(out,1.0)\n\ndef paired_method_test(results,method_a,method_b,metric=\"accuracy\"):\n    a=results[results[\"method\"]==method_a].sort_values(\"seed\")[metric].to_numpy()\n    b=results[results[\"method\"]==method_b].sort_values(\"seed\")[metric].to_numpy()\n    if len(a)!=len(b) or len(a)<5: raise ValueError(\"Need at least 5 matched seeds.\")\n    stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n    return {\"method_a\":method_a,\"method_b\":method_b,\"metric\":metric,\n            \"mean_diff\":float(np.mean(a-b)),\"median_diff\":float(np.median(a-b)),\n            \"wilcoxon_p\":float(p)}\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T07:26:32.458614Z","iopub.status.busy":"2026-10-06T07:26:32.458281Z","iopub.status.idle":"2026-10-06T07:26:32.480617Z","shell.execute_reply":"2026-10-06T07:26:32.480052Z","shell.execute_reply.started":"2026-10-06T07:26:32.458584Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 17. Recommended paper figures/tables\n\n**Figure 1 — V3 benchmark audit:** label distribution, missingness, duplicate/conflicting-label count, shallow-tree reconstruction by feature group.\n\n**Figure 2 — Client heterogeneity:** IID vs Dirichlet α and feature-cluster skew.\n\n**Figure 3 — FL clean performance:** method × heterogeneity, mean ± confidence interval.\n\n**Figure 4 — Client unreliability:** poisoning and straggler effects relative to FedAvg.\n\n**Figure 5 — Privacy–utility:** achieved record-level ε vs accuracy/F1 for FedAvg, Median, TrimmedMean.\n\n**Figure 6 — FGSM:** clean-to-attacked degradation.\n\n**Tables:** full metrics, feature dependence, statistical tests, and privacy-accounting details.\n","metadata":{}},{"cell_type":"code","source":"# 18. Machine-readable run manifest\nmanifest = {\n    \"dataset\": \"Students Attention Detection Dataset V3\",\n    \"data_path\": str(DATA_PATH),\n    \"n_rows\": int(len(df)),\n    \"n_features\": int(len(EXPECTED_FEATURES)),\n    \"n_clients_primary\": N_CLIENTS,\n    \"run_mode\": RUN_MODE,\n    \"config\": CFG,\n    \"fl_methods\": METHODS,\n    \"dp_methods\": [\"FedAvg\", \"Median\", \"TrimmedMean\"],\n    \"dp_delta\": DP_DELTA,\n    \"dp_max_grad_norm\": DP_MAX_GRAD_NORM,\n    \"privacy_unit\": \"record/row-level\",\n    \"subject_ids_available\": False,\n    \"partition_min_size\": PARTITION_MIN_SIZE,\n    \"notes\": [\n        \"Clients are simulated partitions, not identified real students.\",\n        \"Primary benchmark uses 10 simulated clients; this is an algorithmic stress-test, not a claim of 10 real classrooms/devices.\",\n        \"Extreme alpha=0.1 is treated as a stress condition; very small clients are allowed and handled explicitly.\",\n        \"FGSM reuses cached clean IID model states; it does not retrain those models.\",\n        \"Corrected DP v2 trains 60 matched non-private controls with the same Poisson sampling/update schedule; these controls are not copied from the older clean FL sweep.\",\n    ]\n}\nwith open(RESULTS_DIR / \"run_manifest_v3.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(manifest, f, indent=2)\nprint(json.dumps(manifest, indent=2))\n","metadata":{"execution":{"iopub.execute_input":"2026-10-06T07:26:32.481685Z","iopub.status.busy":"2026-10-06T07:26:32.481463Z","iopub.status.idle":"2026-10-06T07:26:32.494707Z","shell.execute_reply":"2026-10-06T07:26:32.494062Z","shell.execute_reply.started":"2026-10-06T07:26:32.481665Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Final research protocol\n\n**Primary federation size:** 10 simulated clients. There is no universal client-count threshold for a Q1-quality FL study; what matters is a justified, controlled client population and sensitivity to client-count assumptions. The primary benchmark therefore uses 10 clients, while an optional targeted 5-vs-10 sensitivity analysis is provided. Recent FL studies explicitly vary client counts because client count can affect accuracy, data fragmentation, and system cost. citeturn796241search0turn796241search2\n\nThe ten clients are simulated partitions of the single public training set, not identified students/classes/devices. Results therefore describe algorithmic behavior under controlled partitions rather than subject-disjoint generalization or real deployment prevalence.\n\nExecution order:\n1. Dataset audit, benchmark-validity audit, and centralized baselines.\n2. Run the pre-flight validation cell.\n3. Clean FL sweep — 20 seeds × (IID + five Dirichlet α values) × five aggregation methods = 600 runs. Every run checkpoints its result, final state, and round history.\n4. Client unreliability sweep — 20 seeds × three original scenarios × five methods = 300 runs. Every run checkpoints its result.\n5. Optional 5-vs-10 client sensitivity — targeted 120-run grid, OFF by default.\n6. Blocked centralized sensitivity — five held-out blocks, checkpointed after each block.\n7. Corrected DP privacy–utility sweep — 20 seeds × four finite ε × three aggregation methods = 240 private runs, plus 60 newly trained matched non-private controls. The controls use the same Poisson sampling/update schedule, with clipping and noise disabled; they are not copied from the older clean sweep.\n8. FGSM — no retraining: reuse cached clean IID states for FedAvg/FedProx/CAFAD and evaluate ε_attack ∈ {0.05, 0.10, 0.15}. The attack gradient is computed once per model and reused across the three attack strengths.\n9. Final statistics, figures, and manuscript tables — generated only from saved result files.\n\nEvery long-running section writes atomic checkpoints to `/kaggle/working/attention_fl_v3_q1_10client_results/`. If a Kaggle session ends, rerun only the interrupted section; completed keys are skipped and no completed run is intentionally retrained.\n\nThe code does not claim that ten simulated clients are equivalent to ten real classrooms or devices. Any final manuscript statement about scalability should be framed as controlled client-count sensitivity rather than deployment-scale validation.\n","metadata":{}},{"cell_type":"markdown","source":"## 19. Full Q1 benchmark execution and finalization\n\nThe following cells replace the previous ad-hoc resumable cells. Checkpointing is built directly into each expensive experiment, so there is no separate bootstrap/resume section and no duplicate training for FGSM or convergence analysis.","metadata":{}},{"cell_type":"code","source":"# 19A. Fast smoke test (small, non-paper run)\n# Run this once after restarting a Kaggle kernel. It does not create manuscript results.\nRUN_SMOKE_TEST = True\nif RUN_SMOKE_TEST:\n    smoke_parts = balanced_iid_partition(y_train, N_CLIENTS, seed=0)\n    smoke_result, _, _ = run_federated(\n        X_train, y_train, X_test, y_test, smoke_parts,\n        method=\"FedAvg\", seed=0, rounds=2, local_epochs=1, batch_size=64\n    )\n    print(\"SMOKE TEST PASSED:\", smoke_result)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-10T08:22:17.727191Z","iopub.execute_input":"2026-10-10T08:22:17.727476Z","iopub.status.idle":"2026-10-10T08:22:20.570387Z","shell.execute_reply.started":"2026-10-10T08:22:17.727452Z","shell.execute_reply":"2026-10-10T08:22:20.569568Z"},"trusted":true},"outputs":[{"name":"stdout","text":"SMOKE TEST PASSED: {'accuracy': 0.6156925540432346, 'balanced_accuracy': np.float64(0.6016987673343606), 'f1': 0.3798449612403101, 'precision': 0.8448275862068966, 'recall': 0.245, 'mcc': np.float64(0.29347073649727856), 'auroc': np.float64(0.6292475603492553), 'method': 'FedAvg', 'seed': 0, 'final_cafad_weight_min': nan, 'final_cafad_weight_max': nan, 'final_cafad_masked_clients': nan}\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"import warnings, json, contextlib, io\n\n# 19B-preflight. Client-partition diagnostics for the client-count sensitivity study.\n# Run before Cell 19B. The primary sensitivity study uses IID and alpha=0.5 only;\n# alpha=0.1 is excluded because the previous K=20 run required post-hoc partition repair.\nPARTITION_DIAGNOSTIC_SEEDS = list(range(10))\nPARTITION_DIAGNOSTIC_COUNTS = [5, 10, 20]\nPARTITION_DIAGNOSTIC_ALPHAS = [0.5]\npartition_diagnostic_rows = []\nfor _k in PARTITION_DIAGNOSTIC_COUNTS:\n    for _alpha in PARTITION_DIAGNOSTIC_ALPHAS:\n        for _seed in PARTITION_DIAGNOSTIC_SEEDS:\n            # Use the same partitioner, but capture whether a minimum-size repair is triggered.\n            # The function's warning output is informative; this diagnostic records actual sizes.\n            _capture = io.StringIO()\n            with contextlib.redirect_stdout(_capture):\n                _parts = dirichlet_label_partition(\n                    y_train, _k, float(_alpha), _seed,\n                    min_size=PARTITION_MIN_SIZE, max_tries=PARTITION_MAX_TRIES\n                )\n            _sizes = [len(x) for x in _parts]\n            _repair_text = _capture.getvalue()\n            partition_diagnostic_rows.append({\n                \"n_clients\": _k, \"alpha\": float(_alpha), \"seed\": _seed,\n                \"min_client_size\": int(min(_sizes)), \"max_client_size\": int(max(_sizes)),\n                \"client_sizes\": json.dumps(_sizes),\n                \"repair_warning\": \"repaired best draw\" in _repair_text.lower(),\n            })\npartition_diagnostic = pd.DataFrame(partition_diagnostic_rows)\npartition_diagnostic.to_csv(RESULTS_DIR / \"client_partition_diagnostic_v2.csv\", index=False)\ndisplay(partition_diagnostic.groupby([\"n_clients\", \"alpha\"]).agg(\n    seeds=(\"seed\", \"count\"), min_observed_client_size=(\"min_client_size\", \"min\"),\n    repair_seed_count=(\"repair_warning\", \"sum\")\n).reset_index())\nprint(\"Sensitivity design excludes alpha=0.1 until partitions can be generated without repair.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-10T11:14:38.08467Z","iopub.execute_input":"2026-10-10T11:14:38.085029Z","iopub.status.idle":"2026-10-10T11:14:38.183757Z","shell.execute_reply.started":"2026-10-10T11:14:38.084