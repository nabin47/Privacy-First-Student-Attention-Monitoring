, cat),\n    ])\n    return Pipeline([(\"pre\", pre),\n                     (\"clf\", DecisionTreeClassifier(max_depth=max_depth, random_state=SEED))])\n\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\naudit_rows = []\n\nfor gname, cols in V3_FEATURE_GROUPS.items():\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": gname, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\nkey_cues = [\"gaze_on_screen\", \"head_pose\", \"hand_obj_interaction\", \"phone_present\"]\nfor name, cols in [(\"key_direct_cues\", key_cues), (\"all_features\", EXPECTED_FEATURES)]:\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": name, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\naudit_table = pd.DataFrame(audit_rows).sort_values(\"mean_accuracy\", ascending=False)\ndisplay(audit_table)\naudit_table.to_csv(RESULTS_DIR / \"v3_feature_group_audit.csv\", index=False)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:05.559806Z","iopub.execute_input":"2026-10-04T10:11:05.560162Z","iopub.status.idle":"2026-10-04T10:11:06.479711Z","shell.execute_reply.started":"2026-10-04T10:11:05.560139Z","shell.execute_reply":"2026-10-04T10:11:06.478903Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"        feature_set  mean_accuracy  std_accuracy\n7   key_direct_cues       0.923607      0.005778\n8      all_features       0.923127      0.006396\n5              gaze       0.823510      0.007770\n6            pupils       0.763452      0.009426\n3         head_pose       0.689783      0.007790\n1  facial_landmarks       0.662553      0.013518\n0              face       0.654866      0.012402\n2             hands       0.605543