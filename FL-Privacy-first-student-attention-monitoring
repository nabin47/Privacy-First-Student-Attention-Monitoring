for(condition, alpha, seed)\n","        alpha_key = -1.0 if alpha is None else float(alpha)\n","        methods = R2_METHODS + ([\"MeanUnweighted\"] if alpha_key == 0.1 else [])\n","        for method in methods:\n","            key = f\"{condition}|{alpha_key}|{method}|{seed}\"\n","            if key in done:\n","                continue\n","            with use_settings(lr=LR):\n","                res, _, _ = run_federated(X_train, y_train, X_test, y_test, parts, method, seed,\n","                                          CFG[\"fl_rounds\"], CFG[\"local_epochs\"], CFG[\"batch_size\"])\n","            res.update({\"condition\": condition, \"alpha\": np.nan if alpha is None else alpha,\n","                        \"alpha_key\": alpha_key, \"n_clients\": N_CLIENTS, \"lr\": LR, \"run_key\": key})\n","            r2 = record(R2_CLEAN_PATH, res); done.add(key)\n","    print(\"R2A seed done:\", seed)\n","\n","r2 = load_checkpoint(R2_CLEAN_PATH)\n","display(mean_sd(r2, [\"alpha_key\", \"method\"]).pivot(index=\"method\", columns=\"alpha_key\", values=\"mean\"))"]},{"cell_type":"code","execution_count":19,"id":"55eb76c9","metadata":{"execution":{"iopub.execute_input":"2026-11-18T21:11:53.349231Z","iopub.status.busy":"2026-11-18T21:11:53.348851Z","iopub.status.idle":"2026-11-18T21:36:18.499764Z","shell.execute_reply":"2026-11-18T21:36:18.498925Z"},"papermill":{"duration":1465.173487,"end_time":"2026-11-18T21:36:18.512055","exception":false,"start_time":"2026-11-18T21:11:53.338568","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["R2B seed done: 0\n","R2B seed done: 1\n","R2B seed done: 2\n","R2B seed done: 3\n","R2B seed done: 4\n","R2B seed done: 5\n","R2B seed done: 6\n","R2B seed done: 7\n","R2B seed done: 8\n","R2B seed done: 9\n","R2B seed done: 10\n","R2B seed done: 11\n","R2B seed done: 12\n","R2B seed done: 13\n","R2B seed done: 14\n","R2B seed done: 15\n","R2B seed done: 16\n","R2B seed done: 17\n","R2B seed done: 18\n","R