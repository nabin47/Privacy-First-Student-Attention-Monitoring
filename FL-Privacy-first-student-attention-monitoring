dian</td>\n      <td>0</td>\n      <td>5.0</td>\n      <td>5.0</td>\n      <td>0.787286</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>0.53803</td>\n      <td>0.519293</td>\n      <td>0.079745</td>\n      <td>0.925926</td>\n      <td>0.041667</td>\n      <td>0.132556</td>\n      <td>0.818721</td>\n      <td>TrimmedMean</td>\n      <td>0</td>\n      <td>5.0</td>\n      <td>5.0</td>\n      <td>0.787286</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":24},{"id":"93d591e0","cell_type":"markdown","source":"\n## 15. FGSM evaluation\n\nFGSM is applied to the encoded tabular feature vector at evaluation time.\n\nThis is an **input-space robustness experiment**, not a claim that a real webcam attacker can perturb these detector features in exactly this way.\n\nReport clean accuracy/F1, attacked accuracy/F1, absolute degradation, and paired seed-level degradation.\n","metadata":{}},{"id":"694d7613","cell_type":"code","source":"\n# 15A. True-gradient FGSM\ndef fgsm_metrics(state,X,y,epsilon):\n    model=MLP(X.shape[1]); load_state_dict_cpu(model,state); model.eval()\n    xt=torch.tensor(X,dtype=torch.float32,requires_grad=True)\n    yt=torch.tensor(y,dtype=torch.long)\n    logits=model(xt)\n    loss=nn.functional.cross_entropy(logits,yt)\n    model.zero_grad(set_to_none=True); loss.backward()\n    x_adv=(xt+epsilon*xt.grad.sign()).detach()\n    with torch.no_grad():\n        clean_pred=logits.argmax(1).numpy()\n        adv_pred=model(x_adv).argmax(1).numpy()\n    clean_acc=accuracy_score(y,clean_pred); adv_acc=accuracy_score(y,adv_pred)\n    return {\"clean_accuracy\":clean_acc,\"adv_accuracy\":adv_acc,\n            \"accuracy_drop\":clean_acc-adv_acc,\"epsilon\":epsilon}\n\niid_parts=balanced_iid_partition(y_train,N_CLIENTS,0)\n_,_,pilot_state=run_federated(\n    X_train,y_train,X_test,y_test,iid_parts,\"FedAvg\",0,2,1,64\n)\ndisplay(pd.DataFrame([fgsm_metrics(pilot_state,X_test,y_test,0.01)]))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:03:34.292677Z","iopub.execute_input":"2026-10-05T17:03:34.293016Z","iopub.status.idle":"2026-10-05T17:03:34.548328Z","shell.execute_reply.started":"2026-10-05T17:03:34.292975Z","shell.execute_reply":"2026-10-05T17:03:34.547459Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"   clean_accuracy  adv_accuracy  accuracy_drop  epsilon\n0         0.70056      0.658127       0.042434     0.01","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>clean_accuracy</th>\n      <th>adv_accuracy</th>\n      <th>accuracy_drop</th>\n      <th>epsilon</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0.70056</td>\n      <td>0.658127</td>\n      <td>0.042434</td>\n      <td>0.01</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":25},{"id":"62702687","cell_type":"markdown","source":"\n## 16. Statistics and manuscript outputs\n\nUse matched seed-level comparisons.\n\nRecommended reporting:\n\n- mean/median paired difference,\n- confidence interval,\n- Wilcoxon signed-rank test,\n- Benjamini–Hochberg correction,\n- effect size,\n- not p-values alone.\n","metadata":{}},{"id":"68fa11a4","cell_type":"code","source":"\n# 16A. BH correction + paired test helper\ndef bh_adjust(pvals):\n    pvals=np.asarray(pvals,float); n=len(pvals)\n    order=np.argsort(pvals); ranked=pvals[order]\n    q=ranked*n/np.arange(1,n+1)\n    q=np.minimum.accumulate(q[::-1])[::-1]\n    out=np.empty_like(q); out[order]=q\n    return np.minimum(out,1.0)\n\ndef paired_method_test(results,method_a,method_b,metric=\"accuracy\"):\n    a=results[results[\"method\"]==method_a].sort_values(\"seed\")[metric].to_numpy()\n    b=results[results[\"method\"]==method_b].sort_values(\"seed\")[metric].to_numpy()\n    if len(a)!=len(b) or len(a)<5: raise ValueError(\"Need at least 5 matched seeds.\")\n    stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n    return {\"method_a\":method_a,\"method_b\":method_b,\"metric\":metric,\n            \"mean_diff\":float(np.mean(a-b)),\"median_diff\":float(np.median(a-b)),\n            \"wilcoxon_p\":float(p)}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T17:03:34.549485Z","iopub.execute_input":"2026-10-05T17:03:34.549815Z","iopub.status.idle":"2026-10-05T17:03:34.556348Z","shell.execute_reply.started":"2026-10-05T17:03:34.54979Z","shell.execute_reply":"2026-10-05T17:03:34.555543Z"}},"outputs":[],"execution_count":26},{"id":"c07518fc","cell_type":"markdown","source":"\n## 17. Recommended paper figures/tables\n\n**Figure 1 — V3 benchmark audit:** label distribution, missingness, duplicate/conflicting-label count, shallow-tree reconstruction by feature group.\n\n**Figure 2 — Client heterogeneity:** IID vs Dirichlet α and feature-cluster skew.\n\n**Figure 3 — FL clean performance:** method × heterogeneity, mean ± confidence interval.\n\n**Figure 4 — Client unreliability:** poisoning and straggler effects relative to FedAvg.\n\n**Figure 5 — Privacy–utility:** achieved record-level ε vs accuracy/F1 for FedAvg, Median, TrimmedMean.\n\n**Figure 6 — FGSM:** clean-to-attacked degradation.\n\n**Tables:** full metrics, feature dependence, statistical tests, and privacy-accounting details.\n","metadata":{}},{"id":"3b8cc861","cell_type":"code","source":"\n# 18. Machine-readable run manifest\nmanifest={\n    \"dataset\":\"Students Attention Detection Dataset V3\",\n    \"data_path\":str(DATA_PATH),\n    \"n_rows\":int(len(df)),\n    \"n_features\":int(len(EXPECTED_FEATURES)),\n    \"n_clients\":N_CLIENTS,\n    \"run_mode\":RUN_MODE,\n    \"config\":CFG,\n    \"fl_methods\":METHODS,\n    