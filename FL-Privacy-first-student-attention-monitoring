2)\n    log_a=logsumexp(log_comb+log_q+log_1q+exponent)\n    return float(log_a/(a-1))\n\ndef rdp_epsilon(q,sigma,steps,delta=DP_DELTA,orders=None):\n    orders=orders or list(range(2,65))\n    eps=[steps*subsampled_gaussian_rdp(q,sigma,a)+math.log(1.0/delta)/(a-1) for a in orders]\n    return float(np.min(eps))\n\ndef calibrate_sigma(target_epsilon,q,steps,delta=DP_DELTA):\n    lo,hi=0.01,100.0\n    while rdp_epsilon(q,hi,steps,delta)>target_epsilon:\n        hi*=2.0\n        if hi>1e6: raise RuntimeError(\"Could not bracket sigma.\")\n    for _ in range(70):\n        mid=(lo+hi)/2\n        if rdp_epsilon(q,mid,steps,delta)>target_epsilon: lo=mid\n        else: hi=mid\n    return hi\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.390865Z","iopub.execute_input":"2026-10-06T07:26:32.39116Z","iopub.status.idle":"2026-10-06T07:26:32.39817Z","shell.execute_reply.started":"2026-10-06T07:26:32.391139Z","shell.execute_reply":"2026-10-06T07:26:32.3976Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 14B. Auditable DP-SGD with torch.func\ndef dp_local_train(global_state,X,y,client_idx,seed,total_rounds,local_epochs,batch_size,\n                   target_epsilon,delta=DP_DELTA,max_grad_norm=DP_MAX_GRAD_NORM,lr=LR):\n    seed_everything(seed)\n    model=MLP(X.shape[1]).to(DEVICE); load_state_dict_device(model,global_state); model.train()\n    idx=np.array(client_idx,dtype=int)\n    x_local=torch.from_numpy(np.asarray(X[idx],dtype=np.float32)).to(DEVICE)\n    y_local=torch.from_numpy(np.asarray(y[idx],dtype=np.int64)).to(DEVICE)\n    n=len(idx)\n    q=min(1.0,batch_size/n)\n    steps_per_epoch=max(1,math.ceil(1.0/q))\n    total_steps=total_rounds*local_epochs*steps_per_epoch\n    sigma=calibrate_sigma(target_epsilon,q,total_steps,delta)\n\n    params={k:v for k,v in model.named_parameters()}\n    buffers={k:v for k,v in model.named_buffers()}\n\n    def loss_one(params,buffers,x_one,y_one):\n        logits=functional_call(model,(params,buffers),(x_one.unsqueeze(0),))\n        return nn.functional.cross_entropy(logits,y_one.unsqueeze(0))\n    grad_one=grad(loss_one)\n\n    for _ in range(local_epochs):\n        for _ in range(steps_per_epoch):\n            mask=(torch.rand(n, device=DEVICE) < q)\n            ids=torch.where(mask)[0]\n            if len(ids)==0: continue\n            xb,yb=x_local[ids],y_local[ids]\n\n            per_sample=vmap(grad_one,in_dims=(None,None,0,0))(params,buffers,xb,yb)\n            norm_sq=None\n            for g in per_sample.values():\n                z=g.reshape(g.shape[0],-1)\n                term=(z*z).sum(dim=1)\n                norm_sq=term if norm_sq is None else norm_sq+term\n            norms=torch.sqrt(norm_sq+1e-12)\n            coeff=torch.clamp(max_grad_norm/norms,max=1.0)\n\n            with torch.no_grad():\n                for name,p in params.items():\n                    g=per_sample[name]\n                    view=coeff.view(-1,*([1]*(g.ndim-1)))\n                    clipped=g*view\n                    mean_grad=clipped.mean(dim=0)\n                    noise=torch.randn_like(mean_grad)*(sigma*max_grad_norm/len(ids))\n                    p.data-=lr*(mean_grad+noise)\n\n    return clone_state_dict(model),sigma,rdp_epsilon(q,sigma,total_steps,delta)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.399094Z","iopub.execute_input":"2026-10-06T07:26:32.399442Z","iopub.status.idle":"2026-10-06T07:26:32.423274Z","shell.execute_reply.started":"2026-10-06T07:26:32.39942Z","shell.execute_reply":"2026-10-06T07:26:32.422671Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 14C. DP federated runner\nDP_METHODS=[\"FedAvg\",\"Median\",\"TrimmedMean\"]\n\ndef run_federated_dp(X,y,X_eval,y_eval,parts,method,seed,rounds,local_epochs,batch_size,target_epsilon):\n    seed_everything(seed)\n    global_state=clone_state_dict(MLP(X.shape[1]))\n    client_eps=[]; client_sigmas=[]\n\n    for rnd in range(rounds):\n        local_states=[]; ns=[]\n        for k,idx in enumerate(parts):\n            st,sigma,eps=dp_local_train(\n                global_state,X,y,idx,seed+1000*rnd+k,\n                total_rounds=rounds,local_epochs=local_epochs,batch_size=batch_size,\n                target_epsilon=target_epsilon\n            )\n            local_states.append(st); ns.append(len(idx))\n            if rnd==0:\n                client_eps.append(eps); client_sigmas.append(sigma)\n\n        if method==\"FedAvg\": global_state=aggregate_fedavg(local_states,ns)\n        elif method==\"Median\": global_state=aggregate_median(local_states)\n        elif method==\"TrimmedMean\": global_state=aggregate_trimmed_mean(local_states,TRIM_FRACTION)\n        else: raise ValueError(method)\n\n    result=evaluate_state(global_state,X_eval,y_eval)\n    result.update({\n        \"method\":method,\"seed\":seed,\"target_epsilon\":target_epsilon,\n        \"max_client_achieved_epsilon\":max(client_eps),\n        \"mean_client_sigma\":float(np.mean(client_sigmas))\n    })\n    return result\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.424077Z","iopub.execute_input":"2026-10-06T07:26:32.424361Z","iopub.status.idle":"2026-10-06T07:26:32.438618Z","shell.execute_reply.started":"2026-10-06T07:26:32.424331Z","shell.execute_reply":"2026-10-06T07:26:32.438102Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 15. FGSM evaluation\n\nFGSM is applied to the encoded tabular feature vector at evaluation time.\n\nThis is an **input-space robustness experiment**, not a claim that a real webcam attacker can perturb these detector features in exactly this way.\n\nReport clean accuracy/F1, attacked accuracy/F1, absolute degradation, and paired seed-level degradation.\n","metadata":{}},{"cell_type":"code","source":"# 15A. True-gradient FGSM helper — definition only; no training pilot\ndef fgsm_metrics(state, X, y, epsilon):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n\n    xt = torch.tensor(X, dtype=torch.float32, device=DEVICE, requires_grad=True)\n    yt = torch.tensor(y, dtype=torch.long, device=DEVICE)\n\n    logits = model(xt)\n    loss = nn.functional.cross_entropy(logits, yt)\n\n    model.zero_grad(set_to_none=True)\n    loss.backward()\n\n    x_adv = (xt + epsilon * xt.grad.sign()).detach()\n\n    with torch.no_grad():\n        clean_pred = logits.argmax(1).cpu().numpy()\n        adv_pred = model(x_adv).argmax(1).cpu().numpy()\n\n    clean_acc = accuracy_score(y, clean_pred)\n    adv_acc = accuracy_score(y, adv_pred)\n\n    return {\n        \"clean_accuracy\": clean_acc,\n        \"adv_accuracy\": adv_acc,\n        \"accuracy_drop\": clean_acc - adv_acc,\n        \"epsilon\": epsilon,\n    }\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.439689Z","iopub.execute_input":"2026-10-06T07:26:32.440052Z","iopub.status.idle":"2026-10-06T07:26:32.457498Z","shell.execute_reply.started":"2026-10-06T07:26:32.440024Z","shell.execute_reply":"2026-10-06T07:26:32.456878Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 16. Statistics and manuscript outputs\n\nUse matched seed-level comparisons, with Wilcoxon paired tests and Benjamini–Hochberg FDR correction. All final tables/figures are generated from saved result files; no training is repeated during reporting.","metadata":{}},{"cell_type":"code","source":"\n# 16A. BH correction + paired test helper\ndef bh_adjust(pvals):\n    pvals=np.asarray(pvals,float); n=len(pvals)\n    order=np.argsort(pvals); ranked=pvals[order]\n    q=ranked*n/np.arange(1,n+1)\n    q=np.minimum.accumulate(q[::-1])[::-1]\n    out=np.empty_like(q); out[order]=q\n    return np.minimum(out,1.0)\n\ndef paired_method_test(results,method_a,method_b,metric=\"accuracy\"):\n    a=results[results[\"method\"]==method_a].sort_values(\"seed\")[metric].to_numpy()\n    b=results[results[\"method\"]==method_b].sort_values(\"seed\")[metric].to_numpy()\n    if len(a)!=len(b) or len(a)<5: raise ValueError(\"Need at least 5 matched seeds.\")\n    stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n    return {\"method_a\":method_a,\"method_b\":method_b,\"metric\":metric,\n            \"mean_diff\":float(np.mean(a-b)),\"median_diff\":float(np.median(a-b)),\n            \"wilcoxon_p\":float(p)}\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.458281Z","iopub.execute_input":"2026-10-06T07:26:32.458614Z","iopub.status.idle":"2026-10-06T07:26:32.480617Z","shell.execute_reply.started":"2026-10-06T07:26:32.458584Z","shell.execute_reply":"2026-10-06T07:26:32.480052Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 17. Recommended paper figures/tables\n\n**Figure 1 — V3 benchmark audit:** label distribution, missingness, duplicate/conflicting-label count, shallow-tree reconstruction by feature group.\n\n**Figure 2 — Client heterogeneity:** IID vs Dirichlet α and feature-cluster skew.\n\n**Figure 3 — FL clean performance:** method × heterogeneity, mean ± confidence interval.\n\n**Figure 4 — Client unreliability:** poisoning and straggler effects relative to FedAvg.\n\n**Figure 5 — Privacy–utility:** achieved record-level ε vs accuracy/F1 for FedAvg, Median, TrimmedMean.\n\n**Figure 6 — FGSM:** clean-to-attacked degradation.\n\n**Tables:** full metrics, feature dependence, statistical tests, and privacy-accounting details.\n","metadata":{}},{"cell_type":"code","source":"# 18. Machine-readable run manifest\nmanifest = {\n    \"dataset\": \"Students Attention Detection Dataset V3\",\n    \"data_path\": str(DATA_PATH),\n    \"n_rows\": int(len(df)),\n    \"n_features\": int(len(EXPECTED_FEATURES)),\n    \"n_clients_primary\": N_CLIENTS,\n    \"run_mode\": RUN_MODE,\n    \"config\": CFG,\n    \"fl_methods\": METHODS,\n    \"dp_methods\": [\"FedAvg\", \"Median\", \"TrimmedMean\"],\n    \"dp_delta\": DP_DELTA,\n    \"dp_max_grad_norm\": DP_MAX_GRAD_NORM,\n    \"privacy_unit\": \"record/row-level\",\n    \"subject_ids_available\": False,\n    \"partition_min_size\": PARTITION_MIN_SIZE,\n    \"notes\": [\n        \"Clients are simulated partitions, not identified real students.\",\n        \"Primary benchmark uses 10 simulated clients; this is an algorithmic stress-test, not a claim of 10 real classrooms/devices.\",\n        \"Extreme alpha=0.1 is treated as a stress condition; very small clients are allowed and handled explicitly.\",\n        \"FGSM reuses cached clean IID model states; it does not retrain those models.\",\n        \"Non-private DP references reuse the IID clean FL results; they are not retrained in the DP section.\",\n    ]\n}\nwith open(RESULTS_DIR / \"run_manifest_v3.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(manifest, f, indent=2)\nprint(json.dumps(manifest, indent=2))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T07:26:32.481463Z","iopub.execute_input":"2026-10-06T07:26:32.481685Z","iopub.status.idle":"2026-10-06T07:26:32.494707Z","shell.execute_reply.started":"2026-10-06T07:26:32.481665Z","shell.execute_reply":"2026-10-06T07:26:32.494062Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Final research protocol\n\n**Primary federation size:** 10 simulated clients. There is no universal client-count threshold for a Q1-quality FL study; what matters is a justified, controlled client population and sensitivity to client-count assumptions. The primary benchmark therefore uses 10 clients, while an optional targeted 5-vs-10 sensitivity analysis is provided. Recent FL studies explicitly vary client counts because client count can affect accuracy, data fragmentation, and system cost. citeturn796241search0turn796241search2\n\nThe ten clients are simulated partitions of the single public training set, not identified students/classes/devices. Results therefore describe algorithmic behavior under controlled partitions rather than subject-disjoint generalization or real deployment prevalence.\n\nExecution order:\n1. Dataset audit, benchmark-validity audit, and centralized baselines.\n2. Run the pre-flight validation cell.\n3. Clean FL sweep — 20 seeds × (IID + five Dirichlet α values) × five aggregation methods = 600 runs. Every run checkpoints its result, final state, and round history.\n4. Client unreliability sweep — 20 seeds × three original scenarios × five methods = 300 runs. Every run checkpoints its result.\n5. Optional 5-vs-10 client sensitivity — targeted 120-run grid, OFF by default.\n6. Blocked centralized sensitivity — five held-out blocks, checkpointed after each block.\n7. DP privacy–utility sweep — 20 seeds × four finite ε × three aggregation methods = 240 private runs. Non-private IID references are taken directly from the completed clean sweep, so they are never retrained.\n8. FGSM — no retraining: reuse cached clean IID states for FedAvg/FedProx/CAFAD and evaluate ε_attack ∈ {0.05, 0.10, 0.15}. The attack gradient is computed once per model and reused across the three attack strengths.\n9. Final statistics, figures, and manuscript tables — generated only from saved result files.\n\nEvery long-running section writes atomic checkpoints to `/kaggle/working/attention_fl_v3_q1_10client_results/`. If a Kaggle session ends, rerun only the interrupted section; completed keys are skipped and no completed run is intentionally retrained.\n\nThe code does not claim that ten simulated clients are equivalent to ten real classrooms or devices. Any final manuscript statement about scalability should be framed as controlled client-count sensitivity rather than deployment-scale validation.\n","metadata":{}},{"cell_type":"markdown","source":"## 19. Full Q1 benchmark execution and finalization\n\nThe following cells replace the previous ad-hoc resumable cells. Checkpointing is built directly into each expensive experiment, so there is no separate bootstrap/resume section and no duplicate training for FGSM or convergence analysis.","metadata":{}},{"cell_type":"code","source":"# 19A. Fast smoke test (small, non-paper run)\n# Run this once after restarting a Kaggle kernel. It does not create manuscript results.\nRUN_SMOKE_TEST = True\nif RUN_SMOKE_TEST:\n    smoke_parts = balanced_iid_partition(y_train, N_CLIENTS, seed=0)\n    smoke_result, _, _ = run_federated(\n        X_train, y_train, X_test, y_test, smoke_parts,\n        method=\"FedAvg\", seed=0, rounds=2, local_epochs=1, batch_size=64\n    )\n    print(\"SMOKE TEST PASSED:\", smoke_result)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T07:26:32.495565Z","iopub.execute_input":"2026-10-06T07:26:32.495821Z","iopub.status.idle":"2026-10-06T07:26:32.841571Z","shell.execute_reply.started":"2026-10-06T07:26:32.495801Z","shell.execute_reply":"2026-10-06T07:26:32.840819Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 19B. Client-count sensitivity: train K=5 and K=20; reuse K=10 main-benchmark results\nRUN_CLIENT_COUNT_SENSITIVITY = True\nCLIENT_COUNT_SENSITIVITY_COUNTS = [5, 20]\nCLIENT_COUNT_SENSITIVITY_SEEDS = list(range(10))\n\nCLIENT_COUNT_SENSITIVITY_METHODS = [\n    \"FedAvg\", \"CAFAD\"\n]\n\nCLIENT_COUNT_SENSITIVITY_CONDITIONS = [\n    (\"IID\", None),\n    (\"Dirichlet\", 0.5),\n    (\"Dirichlet\", 0.1),\n]\n# Fresh names keep the interrupted K={5,10} attempt and all old outputs intact.\nCLIENT_SENS_LEGACY_PROGRESS = RESULTS_DIR / \"client_count_sensitivity_progress_v3.csv\"\nCLIENT_SENS_PROGRESS = RESULTS_DIR / \"client_count_sensitivity_K5_K20_progress_v3.csv\"\nCLIENT_SENS_NEW_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K20_v3.csv\"\nCLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_v3.csv\"\n\nif RUN_CLIENT_COUNT_SENSITIVITY:\n    progress = load_checkpoint(CLIENT_SENS_PROGRESS)\n\n    for n_clients in CLIENT_COUNT_SENSITIVITY_COUNTS:\n        for seed in CLIENT_COUNT_SENSITIVITY_SEEDS:\n            for condition, alpha in CLIENT_COUNT_SENSITIVITY_CONDITIONS:\n                if condition == \"IID\":\n                    parts = balanced_iid_partition(y_train, n_clients, seed)\n                else:\n                    parts = dirichlet_label_partition(\n                        y_train,\n                        n_clients,\n                        float(alpha),\n                        seed,\n                        min_size=PARTITION_MIN_SIZE,\n                        max_tries=PARTITION_MAX_TRIES,\n                    )\n\n                for method in CLIENT_COUNT_SENSITIVITY_METHODS:\n                    if progress.empty:\n                        done = False\n                    else:\n                        done = (\n                            (progress[\"n_clients\"].astype(int) == n_clients)\n                            & (progress[\"seed\"].astype(int) == seed)\n                            & (progress[\"condition\"] == condition)\n                            & (progress[\"method\"] == method)\n                            & (\n                                (progress[\"alpha\"].isna() & (alpha is None))\n                                | progress[\"alpha\"].fillna(-999).eq(\n                                    float(alpha) if alpha is not None else -999\n                                )\n                            )\n                        ).any()\n\n                    if done:\n                        continue\n\n                    result, _, _ = run_federated(\n                        X_train,\n                        y_train,\n                        X_test,\n                        y_test,\n                        parts,\n                        method,\n                        seed,\n                        CFG[\"fl_rounds\"],\n                        CFG[\"local_epochs\"],\n                        CFG[\"batch_size\"],\n                    )\n                    result.update({\n                        \"n_clients\": int(n_clients),\n                        \"seed\": int(seed),\n                        \"condition\": condition,\n                        \"alpha\": np.nan if alpha is None else float(alpha),\n                        \"method\": method,\n                    })\n                    progress = upsert_checkpoint(\n                        CLIENT_SENS_PROGRESS,\n                        [result],\n                        [\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"],\n                    )\n\n    expected = (\n        len(CLIENT_COUNT_SENSITIVITY_COUNTS)\n        * len(CLIENT_COUNT_SENSITIVITY_SEEDS)\n        * len(CLIENT_COUNT_SENSITIVITY_CONDITIONS)\n        * len(CLIENT_COUNT_SENSITIVITY_METHODS)\n    )\n    if len(progress) == expected:\n        atomic_to_csv(progress, CLIENT_SENS_FINAL)\n        print(\"Client-count sensitivity complete:\", len(progress), \"rows\")\n    else:\n        print(\"Client-count sensitivity incomplete:\", len(progress), \"/\", expected)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T07:53:15.272765Z","iopub.execute_input":"2026-10-09T07:53:15.273216Z","iopub.status.idle":"2026-10-09T08:12:49.145063Z","shell.execute_reply.started":"2026-10-09T07:53:15.273185Z","shell.execute_reply":"2026-10-09T08:12:49.143935Z"}},"outputs":[{"name":"stdout","text":"WARNING: alpha=0.1 seed=0 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=1 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=2 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=3 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=4 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=5 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=6 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=7 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=8 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nWARNING: alpha=0.1 seed=9 did not meet min_size=10 within 5000 draws; repaired best draw to min_client_size=10.\nClient-count sensitivity complete: 120 rows\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"# 19C. Blocked centralized sensitivity — checkpointed, no FL retraining\nBLOCKS = 5\nBLOCKED_PROGRESS = RESULTS_DIR / \"blocked_centralized_sensitivity_progress_v3.csv\"\nBLOCKED_FINAL = RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\"\n\nRUN_BLOCKED_CENTRAL = True\n\nif RUN_BLOCKED_CENTRAL:\n    blocked_progress = load_checkpoint(BLOCKED_PROGRESS)\n    block_id = np.minimum(np.arange(len(df)) * BLOCKS // len(df), BLOCKS - 1)\n    for b in range(BLOCKS):\n        if not blocked_progress.empty and (blocked_progress[\"block\"].astype(int) == b).any():\n            print(\"SKIP blocked block\", b)\n            continue\n        train_mask = block_id != b; test_mask = block_id == b\n        tr = df.loc[train_mask].copy(); te = df.loc[test_mask].copy()\n        fold_pre = build_fold_preprocessor(tr)\n\n        tree_pipe = Pipeline([\n            (\"pre\", build_fold_preprocessor(tr)),\n            (\"clf\", DecisionTreeClassifier(max_depth=3, random_state=SEED)),\n        ])\n        tree_pipe.fit(tr[EXPECTED_FEATURES], tr[TARGET])\n        tree_pred = tree_pipe.predict(te[EXPECTED_FEATURES])\n\n        et_pipe = Pipeline([\n            (\"pre\", build_fold_preprocessor(tr)),\n            (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1)),\n        ])\n        et_pipe.fit(tr[EXPECTED_FEATURES], tr[TARGET])\n        et_pred = et_pipe.predict(te[EXPECTED_FEATURES])\n\n        rows=[\n            {\"block\":b,\"model\":\"DecisionTree_depth3\",\"n_train\":len(tr),\"n_test\":len(te),\n             \"test_label1_rate\":float(te[TARGET].mean()),\"accuracy\":accuracy_score(te[TARGET],tree_pred),\n             \"balanced_accuracy\":balanced_accuracy_score(te[TARGET],tree_pred),\"f1\":f1_score(te[TARGET],tree_pred,zero_division=0),\"mcc\":matthews_corrcoef(te[TARGET],tree_pred)},\n            {\"block\":b,\"model\":\"ExtraTrees\",\"n_train\":len(tr),\"n_test\":len(te),\n             \"test_label1_rate\":float(te[TARGET].mean()),\"accuracy\":accuracy_score(te[TARGET],et_pred),\n             \"balanced_accuracy\":balanced_accuracy_score(te[TARGET],et_pred),\"f1\":f1_score(te[TARGET],et_pred,zero_division=0),\"mcc\":matthews_corrcoef(te[TARGET],et_pred)},\n        ]\n        blocked_progress = upsert_checkpoint(BLOCKED_PROGRESS, rows, [\"block\", \"model\"])\n        print(f\"Blocked checkpoint: block {b}, {len(blocked_progress)} rows\")\n    atomic_to_csv(blocked_progress, BLOCKED_FINAL)\n    blocked_central = blocked_progress.copy()\n    display(blocked_central)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T08:08:26.641295Z","iopub.execute_input":"2026-10-06T08:08:26.641814Z","iopub.status.idle":"2026-10-06T08:08:32.739132Z","shell.execute_reply.started":"2026-10-06T08:08:26.641785Z","shell.execute_reply":"2026-10-06T08:08:32.738524Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 20. Differential privacy\n\nThe DP mechanism is record/row-level DP-SGD with cumulative RDP accounting. The finite-ε runs are the expensive DP component and are independently checkpointed after every seed × ε × method run. The clean IID sweep supplies the ε=∞ reference, so those models are not trained a second time.","metadata":{}},{"cell_type":"code","source":"# 20A. DP smoke test — one tiny run only\nRUN_DP_SMOKE = True\nif RUN_DP_SMOKE:\n    parts = balanced_iid_partition(y_train, N_CLIENTS, seed=0)\n    smoke = run_federated_dp(\n        X_train, y_train, X_test, y_test, parts, \"FedAvg\", 0,\n        rounds=2, local_epochs=1, batch_size=32, target_epsilon=5.0\n    )\n    print(\"DP smoke test PASSED:\", smoke)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T08:08:39.52914Z","iopub.execute_input":"2026-10-06T08:08:39.529566Z","iopub.status.idle":"2026-10-06T08:09:00.407628Z","shell.execute_reply.started":"2026-10-06T08:08:39.529539Z","shell.execute_reply":"2026-10-06T08:09:00.406585Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 20B. Full DP privacy–utility sweep — checkpointed, no redundant non-private retraining\n# Persistent-path bootstrap: safe to run after a kernel restart; does not retrain or delete anything.\n_RESULTS_ROOT = Path(\"/kaggle/working/attention_fl_v3_q1_10client_results\")\nRESULTS_DIR = _RESULTS_ROOT\nRESULTS_DIR.mkdir(parents=True, exist_ok=True)\nDP_PROGRESS_PATH = RESULTS_DIR / \"dp_privacy_utility_progress_v3.csv\"\nDP_FINAL_PATH = RESULTS_DIR / \"dp_privacy_utility_v3.csv\"\nCLEAN_FINAL_PATH = globals().get(\"CLEAN_FINAL_PATH\", RESULTS_DIR / \"clean_fl_sweep_v3.csv\")\n\n# Persistent-path bootstrap: safe to run after a kernel restart; does not retrain or delete anything.\n_RESULTS_ROOT = Path(\"/kaggle/working/attention_fl_v3_q1_10client_results\")\nRESULTS_DIR = _RESULTS_ROOT\nRESULTS_DIR.mkdir(parents=True, exist_ok=True)\nDP_PROGRESS_PATH = RESULTS_DIR / \"dp_privacy_utility_progress_v3.csv\"\nDP_FINAL_PATH = RESULTS_DIR / \"dp_privacy_utility_v3.csv\"\nCLEAN_FINAL_PATH = globals().get(\"CLEAN_FINAL_PATH\", RESULTS_DIR / \"clean_fl_sweep_v3.csv\")\n\nDP_SEEDS = list(CFG[\"seeds\"])\nDP_EPSILONS = list(DP_TARGET_EPS)\nDP_METHODS = [\"FedAvg\", \"Median\", \"TrimmedMean\"]\nRUN_FULL_DP = True\n\nif RUN_FULL_DP:\n    dp_progress = load_checkpoint(DP_PROGRESS_PATH)\n    if not dp_progress.empty:\n        dp_progress[\"seed\"] = dp_progress[\"seed\"].astype(int)\n        dp_progress[\"target_epsilon\"] = pd.to_numeric(dp_progress[\"target_epsilon\"], errors=\"coerce\")\n\n    expected_private = len(DP_SEEDS) * len(DP_EPSILONS) * len(DP_METHODS)\n\n    if not CLEAN_FINAL_PATH.exists():\n        raise FileNotFoundError(\n            f\"Clean FL final results are required before DP: {CLEAN_FINAL_PATH}\"\n        )\n\n    for seed in DP_SEEDS:\n        parts = balanced_iid_partition(y_train, N_CLIENTS, seed)\n        for eps in DP_EPSILONS:\n            for method in DP_METHODS:\n                done = False\n                if not dp_progress.empty:\n                    done = (\n                        (dp_progress[\"seed\"] == int(seed))\n                        & np.isclose(dp_progress[\"target_epsilon\"].astype(float), float(eps))\n                        & (dp_progress[\"method\"] == method)\n                    ).any()\n                if done:\n                    print(f\"SKIP DP  seed={seed} eps={eps} method={method}\")\n                    continue\n\n                print(f\"RUN  DP  seed={seed} eps={eps} method={method}\")\n                result = run_federated_dp(\n                    X_train, y_train, X_test, y_test, parts, method, seed,\n                    rounds=CFG[\"fl_rounds\"], local_epochs=CFG[\"local_epochs\"],\n                    batch_size=CFG[\"batch_size\"], target_epsilon=float(eps)\n                )\n                result.update({\n                    \"partition\": \"IID\",\n                    \"n_clients\": int(N_CLIENTS),\n                    \"privacy_unit\": \"record/row-level\",\n                    \"delta\": float(DP_DELTA),\n                })\n                dp_progress = upsert_checkpoint(\n                    DP_PROGRESS_PATH, [result],\n                    [\"seed\", \"target_epsilon\", \"method\"]\n                )\n                print(f\"DP CHECKPOINT: {len(dp_progress)}/{expected_private} private runs\")\n\n    if len(dp_progress) == expected_private:\n        clean_iid = pd.read_csv(CLEAN_FINAL_PATH)\n        nonprivate = clean_iid[\n            (clean_iid[\"condition\"] == \"IID\")\n            & (clean_iid[\"method\"].isin(DP_METHODS))\n        ].copy()\n        assert len(nonprivate) == len(DP_SEEDS) * len(DP_METHODS), (\n            f\"Expected {len(DP_SEEDS) * len(DP_METHODS)} non-private clean references; \"\n            f\"found {len(nonprivate)}\"\n        )\n        nonprivate[\"target_epsilon\"] = np.inf\n        nonprivate[\"max_client_achieved_epsilon\"] = np.nan\n        nonprivate[\"mean_client_sigma\"] = np.nan\n        nonprivate[\"privacy_unit\"] = \"record/row-level\"\n        nonprivate[\"delta\"] = float(DP_DELTA)\n        nonprivate[\"partition\"] = \"IID\"\n        nonprivate[\"n_clients\"] = int(N_CLIENTS)\n\n        private = dp_progress.copy()\n        dp_all = pd.concat([private, nonprivate], ignore_index=True, sort=False)\n        dp_all = dp_all.drop_duplicates(\n            subset=[\"seed\", \"target_epsilon\", \"method\"], keep=\"last\"\n        ).sort_values([\"target_epsilon\", \"method\", \"seed\"], na_position=\"last\")\n        atomic_to_csv(dp_all, DP_FINAL_PATH)\n        print(\"DP SWEEP COMPLETE:\", len(dp_all), \"rows ->\", DP_FINAL_PATH)\n        display(\n            dp_all.groupby([\"target_epsilon\", \"method\"], dropna=False).agg(\n                accuracy_mean=(\"accuracy\", \"mean\"),\n                accuracy_std=(\"accuracy\", \"std\"),\n                f1_mean=(\"f1\", \"mean\"),\n                f1_std=(\"f1\", \"std\"),\n                balanced_accuracy_mean=(\"balanced_accuracy\", \"mean\"),\n                auroc_mean=(\"auroc\", \"mean\"),\n                achieved_epsilon=(\"max_client_achieved_epsilon\", \"mean\"),\n                n=(\"accuracy\", \"count\")\n            ).reset_index()\n        )\n    else:\n        print(\"DP SWEEP INCOMPLETE; progress retained at:\", DP_PROGRESS_PATH)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T05:18:26.712439Z","iopub.execute_input":"2026-10-07T05:18:26.712778Z","iopub.status.idle":"2026-10-07T09:53:19.207392Z","shell.execute_reply.started":"2026-10-07T05:18:26.712739Z","shell.execute_reply":"2026-10-07T09:53:19.206308Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 21. FGSM evaluation\n\nFGSM deliberately reuses the already-trained clean IID global models saved during the clean sweep. This removes the earlier redundant 60-model retraining step.","metadata":{}},{"cell_type":"code","source":"from pathlib import Path\n\nRESULTS_DIR = Path(\"/kaggle/working/attention_fl_v3_q1_10client_results\")\nRESULTS_DIR.mkdir(parents=True, exist_ok=True)\n\nMODEL_CACHE_DIR = RESULTS_DIR / \"model_cache\"\nMODEL_CACHE_DIR.mkdir(parents=True, exist_ok=True)\n\nCLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nFGSM_PROGRESS_PATH = RESULTS_DIR / \"fgsm_full_progress_v3.csv\"\nFGSM_FINAL_PATH = RESULTS_DIR / \"fgsm_full_v3.csv\"\n\nprint(\"FGSM paths initialized\")\nprint(\"FGSM_PROGRESS_PATH:\", FGSM_PROGRESS_PATH)\nprint(\"FGSM_FINAL_PATH:\", FGSM_FINAL_PATH)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T10:33:27.233544Z","iopub.execute_input":"2026-10-07T10:33:27.234721Z","iopub.status.idle":"2026-10-07T10:33:27.241555Z","shell.execute_reply.started":"2026-10-07T10:33:27.234657Z","shell.execute_reply":"2026-10-07T10:33:27.240663Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 21A. Full FGSM evaluation — reuse cached clean IID models; no FL retraining\nFGSM_SEEDS = list(CFG[\"seeds\"])\nFGSM_METHODS = [\"FedAvg\", \"FedProx\", \"CAFAD\"]\nFGSM_EPSILONS = [0.05, 0.10, 0.15]\nRUN_FULL_FGSM = True\n\ndef clean_iid_state_path(seed, method):\n    return MODEL_CACHE_DIR / f\"clean_seed{seed:02d}_iid_alphaiid_{method}.pt\"\n\ndef evaluate_cached_fgsm(state, X, y, epsilons):\n    model = MLP(X.shape[1]).to(DEVICE)\n    load_state_dict_device(model, state)\n    model.eval()\n    xt = torch.tensor(X, dtype=torch.float32, device=DEVICE, requires_grad=True)\n    yt = torch.tensor(y, dtype=torch.long, device=DEVICE)\n\n    logits = model(xt)\n    loss = nn.functional.cross_entropy(logits, yt)\n    model.zero_grad(set_to_none=True)\n    loss.backward()\n    grad_sign = xt.grad.detach().sign()\n\n    with torch.no_grad():\n        clean_pred = logits.argmax(1).detach().cpu().numpy()\n    clean_acc = accuracy_score(y, clean_pred)\n    clean_f1 = f1_score(y, clean_pred, zero_division=0)\n\n    rows = []\n    for eps in epsilons:\n        x_adv = (xt.detach() + float(eps) * grad_sign).detach()\n        with torch.no_grad():\n            adv_pred = model(x_adv).argmax(1).cpu().numpy()\n        adv_acc = accuracy_score(y, adv_pred)\n        rows.append({\n            \"attack_epsilon\": float(eps),\n            \"clean_accuracy\": float(clean_acc),\n            \"clean_f1\": float(clean_f1),\n            \"adv_accuracy\": float(adv_acc),\n            \"adv_balanced_accuracy\": float(balanced_accuracy_score(y, adv_pred)),\n            \"adv_f1\": float(f1_score(y, adv_pred, zero_division=0)),\n            \"adv_precision\": float(precision_score(y, adv_pred, zero_division=0)),\n            \"adv_recall\": float(recall_score(y, adv_pred, zero_division=0)),\n            \"adv_mcc\": float(matthews_corrcoef(y, adv_pred)),\n            \"adv_pred_class1_rate\": float(np.mean(adv_pred == 1)),\n            \"accuracy_drop\": float(clean_acc - adv_acc),\n        })\n    return rows\n\nif RUN_FULL_FGSM:\n    fgsm_progress = load_checkpoint(FGSM_PROGRESS_PATH)\n    expected_fgsm = len(FGSM_SEEDS) * len(FGSM_METHODS) * len(FGSM_EPSILONS)\n\n    if not CLEAN_FINAL_PATH.exists():\n        raise FileNotFoundError(f\"Clean FL final results are required before FGSM: {CLEAN_FINAL_PATH}\")\n\n    for seed in FGSM_SEEDS:\n        for method in FGSM_METHODS:\n            state_path = clean_iid_state_path(seed, method)\n            if not state_path.exists():\n                raise FileNotFoundError(\n                    f\"Missing cached clean IID model for seed={seed}, method={method}: {state_path}. \"\n                    \"Complete the clean FL sweep first.\"\n                )\n\n            done = False\n            if not fgsm_progress.empty:\n                done = (\n                    (fgsm_progress[\"seed\"].astype(int) == seed)\n                    & (fgsm_progress[\"method\"] == method)\n                    & fgsm_progress[\"attack_epsilon\"].isin(FGSM_EPSILONS)\n                ).sum() == len(FGSM_EPSILONS)\n            if done:\n                print(f\"SKIP FGSM seed={seed} method={method}\")\n                continue\n\n            payload = torch.load(state_path, map_location=\"cpu\")\n            state = payload[\"state\"] if isinstance(payload, dict) and \"state\" in payload else payload\n            rows = evaluate_cached_fgsm(state, X_test, y_test, FGSM_EPSILONS)\n            for row in rows:\n                row.update({\"seed\": int(seed), \"method\": method})\n\n            fgsm_progress = upsert_checkpoint(\n                FGSM_PROGRESS_PATH, rows, [\"seed\", \"method\", \"attack_epsilon\"]\n            )\n            print(f\"FGSM CHECKPOINT: {len(fgsm_progress)}/{expected_fgsm} rows\")\n\n    if len(fgsm_progress) == expected_fgsm:\n        atomic_to_csv(\n            fgsm_progress.sort_values([\"method\", \"attack_epsilon\", \"seed\"]),\n            FGSM_FINAL_PATH\n        )\n        print(\"FGSM COMPLETE:\", len(fgsm_progress), \"rows ->\", FGSM_FINAL_PATH)\n        display(\n            fgsm_progress.groupby([\"method\", \"attack_epsilon\"]).agg(\n                clean_accuracy_mean=(\"clean_accuracy\", \"mean\"),\n                adv_accuracy_mean=(\"adv_accuracy\", \"mean\"),\n                adv_accuracy_std=(\"adv_accuracy\", \"std\"),\n                accuracy_drop_mean=(\"accuracy_drop\", \"mean\"),\n                accuracy_drop_std=(\"accuracy_drop\", \"std\"),\n                n=(\"seed\", \"count\")\n            ).reset_index()\n        )\n    else:\n        print(\"FGSM INCOMPLETE; progress retained at:\", FGSM_PROGRESS_PATH)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T10:33:32.029414Z","iopub.execute_input":"2026-10-07T10:33:32.029765Z","iopub.status.idle":"2026-10-07T10:33:34.818877Z","shell.execute_reply.started":"2026-10-07T10:33:32.029734Z","shell.execute_reply":"2026-10-07T10:33:34.818007Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 22. Final statistical analyses and publication exports\n\nThese cells perform analysis only. They do not retrain any models.","metadata":{}},{"cell_type":"code","source":"# 22A. Recompute clean statistics from the saved final file (no clean-model retraining)\nRESULTS_DIR = Path(\"/kaggle/working/attention_fl_v3_q1_10client_results\")\nCLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nCLEAN_SEEDS = list(CFG[\"seeds\"])\nMETHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nif not CLEAN_FINAL_PATH.exists():\n    raise FileNotFoundError(f\"Completed clean FL result file is required: {CLEAN_FINAL_PATH}\")\nclean_results = pd.read_csv(CLEAN_FINAL_PATH)\nexpected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\nassert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n\nMETRICS = [\"accuracy\",\"balanced_accuracy\",\"f1\",\"precision\",\"recall\",\"mcc\",\"auroc\"]\nfrom scipy.stats import t, wilcoxon\nif \"bh_adjust\" not in globals():\n    def bh_adjust(pvals):\n        pvals = np.asarray(pvals, dtype=float)\n        n = len(pvals)\n        order = np.argsort(pvals)\n        ranked = pvals[order]\n        q = ranked * n / np.arange(1, n + 1)\n        q = np.minimum.accumulate(q[::-1])[::-1]\n        out = np.empty_like(q)\n        out[order] = q\n        return np.minimum(out, 1.0)\n\ndef summarize_metric(data, group_cols, metric):\n    rows=[]\n    for keys,g in data.groupby(group_cols, dropna=False):\n        vals=g[metric].dropna().to_numpy(); n=len(vals)\n        if n<2: continue\n        mean=float(vals.mean()); std=float(vals.std(ddof=1)); sem=std/np.sqrt(n)\n        margin=float(t.ppf(0.975,n-1)*sem)\n        if not isinstance(keys,tuple): keys=(keys,)\n        row=dict(zip(group_cols,keys)); row.update({\"metric\":metric,\"n\":n,\"mean\":mean,\"std\":std,\"ci95_low\":mean-margin,\"ci95_high\":mean+margin,\"ci95_half_width\":margin}); rows.append(row)\n    return pd.DataFrame(rows)\n\nmetric_summary=pd.concat([summarize_metric(clean_results,[\"condition\",\"alpha\",\"method\"],m) for m in METRICS],ignore_index=True)\naccuracy_summary=metric_summary[metric_summary[\"metric\"]==\"accuracy\"].copy()\nfor c in [\"mean\",\"std\",\"ci95_low\",\"ci95_high\"]:\n    accuracy_summary[c+\"_percent\"]=accuracy_summary[c]*100\n\n# Paired Wilcoxon tests vs FedAvg within every fixed condition.\ncomparison_rows=[]\nfor (condition,alpha),g in clean_results.groupby([\"condition\",\"alpha\"],dropna=False):\n    base=g[g[\"method\"]==\"FedAvg\"].set_index(\"seed\")\n    for method in [m for m in METHODS if m!=\"FedAvg\"]:\n        cur=g[g[\"method\"]==method].set_index(\"seed\")\n        common=sorted(set(base.index)&set(cur.index))\n        for metric in [\"accuracy\",\"f1\"]:\n            a=base.loc[common,metric].to_numpy(); b=cur.loc[common,metric].to_numpy()\n            stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n            comparison_rows.append({\"condition\":condition,\"alpha\":alpha,\"method_a\":\"FedAvg\",\"method_b\":method,\"metric\":metric,\"n\":len(common),\"mean_diff_b_minus_a\":float(np.mean(b-a)),\"median_diff_b_minus_a\":float(np.median(b-a)),\"wilcoxon_p\":float(p)})\naccuracy_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"accuracy\"])\nf1_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"f1\"])\nall_tests=pd.concat([accuracy_tests,f1_tests],ignore_index=True)\nall_tests[\"bh_q\"] = bh_adjust(all_tests[\"wilcoxon_p\"].to_numpy())\n\nmetric_summary.to_csv(RESULTS_DIR/\"clean_metric_summary_v3.csv\",index=False)\naccuracy_summary.to_csv(RESULTS_DIR/\"clean_accuracy_summary_v3.csv\",index=False)\naccuracy_tests.to_csv(RESULTS_DIR/\"clean_paired_accuracy_tests_v3.csv\",index=False)\nf1_tests.to_csv(RESULTS_DIR/\"clean_paired_f1_tests_v3.csv\",index=False)\nprint(\"Clean analysis exported.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T08:12:49.146671Z","iopub.execute_input":"2026-10-09T08:12:49.147035Z","iopub.status.idle":"2026-10-09T08:12:49.447468Z","shell.execute_reply.started":"2026-10-09T08:12:49.147002Z","shell.execute_reply":"2026-10-09T08:12:49.446559Z"}},"outputs":[{"name":"stdout","text":"Clean analysis exported.\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nRESULTS_DIR = Path(\n    \"/kaggle/working/attention_fl_v3_q1_10client_results\"\n)\n\nCLEAN_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\nK5_K20_PATH = RESULTS_DIR / \"client_count_sensitivity_K5_K20_v3.csv\"\nK5_K20_PROGRESS = RESULTS_DIR / \"client_count_sensitivity_K5_K20_progress_v3.csv\"\nFINAL_PATH = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_v3.csv\"\n\n# 1. Confirm that the main clean benchmark is available.\nif not CLEAN_PATH.exists():\n    raise FileNotFoundError(f\"Clean benchmark not found: {CLEAN_PATH}\")\n\n# 2. Load the new K=5/K=20 runs.\n# Prefer the completed result file, then the progress checkpoint.\nif K5_K20_PATH.exists():\n    new = pd.read_csv(K5_K20_PATH)\n    source = K5_K20_PATH\nelif FINAL_PATH.exists():\n    new = pd.read_csv(FINAL_PATH)\n    source = FINAL_PATH\nelif K5_K20_PROGRESS.exists():\n    new = pd.read_csv(K5_K20_PROGRESS)\n    source = K5_K20_PROGRESS\nelse:\n    raise FileNotFoundError(\n        \"No K=5/K=20 sensitivity results found. \"\n        \"Check the sensitivity checkpoint files.\"\n    )\n\nrequired = {\n    \"n_clients\", \"seed\", \"condition\",\n    \"alpha\", \"method\", \"accuracy\", \"f1\"\n}\nmissing = required - set(new.columns)\n\nif missing:\n    raise ValueError(f\"Missing columns in {source}: {missing}\")\n\nnew[\"n_clients\"] = pd.to_numeric(\n    new[\"n_clients\"], errors=\"raise\"\n).astype(int)\nnew[\"seed\"] = pd.to_numeric(\n    new[\"seed\"], errors=\"raise\"\n).astype(int)\nnew[\"alpha\"] = pd.to_numeric(\n    new[\"alpha\"], errors=\"coerce\"\n)\n\n# Keep only the new client-count settings.\nnew = new[new[\"n_clients\"].isin([5, 20])].copy()\n\nkey = [\"n_clients\", \"seed\", \"condition\", \"alpha\", \"method\"]\n\nnew = new.drop_duplicates(subset=key, keep=\"last\")\n\ncounts = new.groupby(\"n_clients\").size().to_dict()\nprint(\"K=5/K=20 source:\", source)\nprint(\"New-run counts:\", counts)\n\nif len(new) != 120 or counts != {5: 60, 20: 60}:\n    raise ValueError(\n        f\"Expected 60 rows each for K=5 and K=20; got {counts}. \"\n        \"Do not finalize yet; check or resume Cell 19B.\"\n    )\n\n# 3. Reuse K=10 rows from the completed clean benchmark.\nclean = pd.read_csv(CLEAN_PATH)\nclean[\"seed\"] = pd.to_numeric(\n    clean[\"seed\"], errors=\"raise\"\n).astype(int)\nclean[\"alpha\"] = pd.to_numeric(\n    clean[\"alpha\"], errors=\"coerce\"\n)\n\nmask = (\n    clean[\"seed\"].isin(range(10))\n    & clean[\"method\"].isin([\"FedAvg\", \"CAFAD\"])\n    & (\n        (clean[\"condition\"].eq(\"IID\") & clean[\"alpha\"].isna())\n        | (\n            clean[\"condition\"].eq(\"Dirichlet\")\n            & clean[\"alpha\"].isin([0.5, 0.1])\n        )\n    )\n)\n\nk10 = clean.loc[mask].copy()\nk10[\"n_clients\"] = 10\nk10[\"client_count_sensitivity_source\"] = (\n    \"reused_main_K10_clean_benchmark\"\n)\n\nk10 = k10.drop_duplicates(subset=key, keep=\"last\")\n\nif len(k10) != 60:\n    raise ValueError(\n        f\"Expected 60 reusable K=10 rows, found {len(k10)}. \"\n        \"Check the clean benchmark's condition and alpha columns.\"\n    )\n\n# 4. Combine all three client counts.\ncombined = pd.concat([new, k10], ignore_index=True, sort=False)\ncombined = combined.drop_duplicates(\n    subset=key, keep=\"last\"\n)\n\nif len(combined) != 180:\n    raise ValueError(\n        f\"Expected 180 combined rows, got {len(combined)}.\"\n    )\n\nif set(combined[\"n_clients\"].unique()) != {5, 10, 20}:\n    raise ValueError(\"Expected client counts K={5, 10, 20}.\")\n\n# 5. Write atomically so an interrupted write cannot leave a partial CSV.\ntmp = FINAL_PATH.with_suffix(\".csv.tmp\")\ncombined.to_csv(tmp, index=False)\ntmp.replace(FINAL_PATH)\n\nprint(\"\\nClient-count file repaired successfully.\")\nprint(\"Saved:\", FINAL_PATH)\nprint(\"\\nRows per client count:\")\nprint(combined.groupby(\"n_clients\").size())\nprint(\"\\nTotal rows:\", len(combined))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T08:47:56.908664Z","iopub.execute_input":"2026-10-09T08:47:56.909443Z","iopub.status.idle":"2026-10-09T08:47:56.958418Z","shell.execute_reply.started":"2026-10-09T08:47:56.9094Z","shell.execute_reply":"2026-10-09T08:47:56.957446Z"}},"outputs":[{"name":"stdout","text":"K=5/K=20 source: /kaggle/working/attention_fl_v3_q1_10client_results/client_count_sensitivity_K5_K10_K20_v3.csv\nNew-run counts: {5: 60, 20: 60}\n\nClient-count file repaired successfully.\nSaved: /kaggle/working/attention_fl_v3_q1_10client_results/client_count_sensitivity_K5_K10_K20_v3.csv\n\nRows per client count:\nn_clients\n5     60\n10    60\n20    60\ndtype: int64\n\nTotal rows: 180\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"# 22B. Figures — clean heterogeneity, corrected robustness, privacy–utility, FGSM, blocked and client-count sensitivity\n# Explicit output paths avoid accidentally plotting the earlier milder robustness sweep.\nROBUST_FINAL_PATH = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\nDP_FINAL_PATH = RESULTS_DIR / \"dp_privacy_utility_v3.csv\"\nFGSM_FINAL_PATH = RESULTS_DIR / \"fgsm_full_v3.csv\"\nBLOCKED_FINAL = RESULTS_DIR / \"blocked_centralized_sensitivity_v3.csv\"\nCLIENT_SENS_FINAL = RESULTS_DIR / \"client_count_sensitivity_K5_K10_K20_v3.csv\"\nMETHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\nROBUST_METHODS = list(METHODS)\nDP_METHODS = [\"FedAvg\", \"Median\", \"TrimmedMean\"]\nFGSM_METHODS = [\"FedAvg\", \"FedProx\", \"CAFAD\"]\n\n# Clean accuracy vs alpha\nfig,ax=plt.subplots(figsize=(8,5))\nfor method in METHODS:\n    s=accuracy_summary[(accuracy_summary[\"method\"]==method)&(accuracy_summary[\"condition\"]==\"Dirichlet\")].sort_values(\"alpha\")\n    ax.errorbar(s[\"alpha\"],s[\"mean_percent\"],yerr=[s[\"mean_percent\"]-s[\"ci95_low_percent\"],s[\"ci95_high_percent\"]-s[\"mean_percent\"]],marker=\"o\",capsize=4,label=method)\nax.set_xscale(\"log\"); ax.invert_xaxis(); ax.set_xlabel(\"Dirichlet concentration α\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Federated accuracy under increasing label heterogeneity\"); ax.grid(True,alpha=.25); ax.legend(fontsize=8); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_clean_accuracy_vs_alpha.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# Corrected client-unreliability figure\nrob = pd.read_csv(ROBUST_FINAL_PATH)\nfig,ax=plt.subplots(figsize=(10,5))\norder=rob.groupby(\"scenario\")[\"accuracy\"].mean().sort_values(ascending=False).index.tolist()\nfor method in ROBUST_METHODS:\n    g=rob[rob[\"method\"]==method].groupby(\"scenario\")[\"accuracy\"].agg([\"mean\",\"std\"]).reindex(order)\n    ax.errorbar(np.arange(len(order)),g[\"mean\"]*100,yerr=g[\"std\"]*100,marker=\"o\",capsize=4,label=method)\nax.set_xticks(np.arange(len(order))); ax.set_xticklabels(order,rotation=20,ha=\"right\"); ax.set_ylabel(\"Accuracy (%)\"); ax.set_title(\"Corrected client unreliability: full label-flip poisoning and straggler\"); ax.grid(True,alpha=.25); ax.legend(fontsize=8); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_client_robustness_corrected.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# Blocked sensitivity\nblk=pd.read_csv(BLOCKED_FINAL)\nfig,ax=plt.subplots(figsize=(8,5))\nfor model_name in blk[\"model\"].unique():\n    s=blk[blk[\"model\"]==model_name].sort_values(\"block\")\n    ax.plot(s[\"block\"],s[\"accuracy\"]*100,marker=\"o\",label=model_name)\nax.set_xlabel(\"Contiguous held-out block\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Blocked-split sensitivity\"); ax.grid(True,alpha=.25); ax.legend(); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_blocked_split_sensitivity.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# DP privacy-utility\nDP_ALL=pd.read_csv(DP_FINAL_PATH)\nfig,ax=plt.subplots(figsize=(8,5))\nfor method in DP_METHODS:\n    g=DP_ALL[DP_ALL[\"method\"]==method].groupby(\"target_epsilon\")[\"accuracy\"].agg([\"mean\",\"std\"]).reset_index().sort_values(\"target_epsilon\")\n    finite=g[np.isfinite(g[\"target_epsilon\"])]; inf=g[~np.isfinite(g[\"target_epsilon\"])]\n    if not finite.empty: ax.errorbar(finite[\"target_epsilon\"],finite[\"mean\"]*100,yerr=finite[\"std\"]*100,marker=\"o\",capsize=4,label=method)\n    if not inf.empty: ax.axhline(inf[\"mean\"].iloc[0]*100,linestyle=\"--\",label=f\"{method} non-private\")\nax.set_xscale(\"log\"); ax.invert_xaxis(); ax.set_xlabel(\"Record-level ε (target budget)\"); ax.set_ylabel(\"Test accuracy (%)\"); ax.set_title(\"Privacy–utility trade-off\"); ax.grid(True,alpha=.25); ax.legend(fontsize=7); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_privacy_utility.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# FGSM degradation\nfg=pd.read_csv(FGSM_FINAL_PATH)\nfig,ax=plt.subplots(figsize=(8,5))\nfor method in FGSM_METHODS:\n    g=fg[fg[\"method\"]==method].groupby(\"attack_epsilon\")[\"accuracy_drop\"].agg([\"mean\",\"std\"]).reset_index()\n    ax.errorbar(g[\"attack_epsilon\"],g[\"mean\"]*100,yerr=g[\"std\"]*100,marker=\"o\",capsize=4,label=method)\nax.set_xlabel(\"FGSM ε in encoded feature space\"); ax.set_ylabel(\"Accuracy drop (percentage points)\"); ax.set_title(\"Evaluation-time adversarial degradation\"); ax.grid(True,alpha=.25); ax.legend(); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_FGSM_degradation.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n\n# Client-count sensitivity (K=10 points are reused from the main clean sweep; K=5/20 are newly trained).\nif CLIENT_SENS_FINAL.exists():\n    sens = pd.read_csv(CLIENT_SENS_FINAL)\n    from scipy.stats import t as student_t\n    fig, axes = plt.subplots(1, 3, figsize=(14, 4.5), sharey=True)\n    sens_conditions = [(\"IID\", None, \"IID\"), (\"Dirichlet\", 0.5, \"Dirichlet α=0.5\"), (\"Dirichlet\", 0.1, \"Dirichlet α=0.1\")]\n    for ax, (condition, alpha, title) in zip(axes, sens_conditions):\n        m = sens[\"condition\"].eq(condition)\n        if alpha is None:\n            m &= sens[\"alpha\"].isna()\n        else:\n            m &= np.isclose(pd.to_numeric(sens[\"alpha\"], errors=\"coerce\").fillna(-999), float(alpha))\n        subset = sens.loc[m]\n        for method in [\"FedAvg\", \"CAFAD\"]:\n            stats = subset[subset[\"method\"].eq(method)].groupby(\"n_clients\")[\"accuracy\"].agg([\"mean\", \"std\", \"count\"]).reset_index().sort_values(\"n_clients\")\n            if stats.empty:\n                continue\n            sem = stats[\"std\"] / np.sqrt(stats[\"count\"])\n            critical = [student_t.ppf(0.975, max(int(n)-1, 1)) for n in stats[\"count\"]]\n            ci = sem.to_numpy() * np.asarray(critical)\n            ax.errorbar(stats[\"n_clients\"], stats[\"mean\"]*100, yerr=ci*100, marker=\"o\", capsize=4, label=method)\n        ax.set_title(title); ax.set_xlabel(\"Number of simulated clients K\"); ax.set_xticks([5, 10, 20]); ax.grid(True, alpha=.25)\n    axes[0].set_ylabel(\"Test accuracy (%)\")\n    axes[-1].legend(fontsize=8)\n    fig.suptitle(\"Client-count sensitivity: mean accuracy with 