ation statistic is separately privatized.\n- The target is the released label (`0 = attentive`, `1 = inattentive`). The feature-dependence section tests how much of that label is reconstructable from the released behavioral signals.\n","metadata":{}},{"id":"ee3a9393","cell_type":"code","source":"\n# 1. Configuration\nimport os, glob, math, json, random, warnings, time\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nSEED = 42\nN_CLIENTS = 5\nRUN_MODE = \"PAPER\"  # change to \"PAPER\" after smoke tests\n\nCONFIGS = {\n    \"PILOT\": {\n        \"fl_rounds\": 8,\n        \"local_epochs\": 2,\n        \"batch_size\": 64,\n        \"seeds\": [0, 1, 2],\n        \"alphas\": [10.0, 0.5],\n        \"poison_rates\": [0.20, 0.40],\n    },\n    \"PAPER\": {\n        \"fl_rounds\": 25,\n        \"local_epochs\": 3,\n        \"batch_size\": 64,\n        \"seeds\": list(range(20)),\n        \"alphas\": [10.0, 2.0, 1.0, 0.5, 0.1],\n        \"poison_rates\": [0.20, 0.40],\n    },\n}\nCFG = CONFIGS[RUN_MODE]\n\nHIDDEN_1, HIDDEN_2 = 64, 32\nLR = 1e-2\nPROX_MU = 0.10\nCAFAD_BETA = 2.0\nCAFAD_Z = 2.0\nTRIM_FRACTION = 0.20\nKRUM_F = 1\n\nDP_DELTA = 1e-5\nDP_MAX_GRAD_NORM = 1.0\nDP_TARGET_EPS = [0.5, 1.0, 2.0, 5.0]\nN_FEATURE_CLUSTERS = 8\n\nRESULTS_DIR = Path(\"/kaggle/working/attention_fl_v3_results\")\nif not RESULTS_DIR.exists():\n    RESULTS_DIR = Path(\"/mnt/data/attention_fl_v3_results\")\nRESULTS_DIR.mkdir(parents=True, exist_ok=True)\n\nnp.random.seed(SEED)\nrandom.seed(SEED)\n\nprint(\"RUN_MODE:\", RUN_MODE)\nprint(\"CFG:\", CFG)\nprint(\"RESULTS_DIR:\", RESULTS_DIR)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-05T03:54:39.703864Z","iopub.execute_input":"2026-10-05T03:54:39.704272Z","iopub.status.idle":"2026-10-05T03:54:39.71482Z","shell.execute_reply.started":"2026-10-05T03:54:39.70424Z","shell.execute_reply":"2026-10-05T03:54:39.713626Z"},"trusted":true},"outputs":[{"name":"stdout","text":"RUN_MODE: PAPER\nCFG: {'fl_rounds': 25, 'local_epoch