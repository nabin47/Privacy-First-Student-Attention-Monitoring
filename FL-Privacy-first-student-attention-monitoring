 {10: 300}\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nOLD_PROGRESS = RESULTS_DIR / \"robustness_sweep_progress_v3.csv\"\n\nNEW_PROGRESS = (\n    RESULTS_DIR / \"robustness_sweep_corrected_progress_v3.csv\"\n)\nNEW_FINAL = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n\nNEW_SCENARIOS = [\n    \"full_label_flip_20pct_clients\",\n    \"full_label_flip_40pct_clients\",\n    \"one_straggler_10pct_clients\",\n]\n\nif not OLD_PROGRESS.exists():\n    print(\"No old robustness checkpoint found.\")\nelse:\n    old = pd.read_csv(OLD_PROGRESS)\n\n    corrected = old[\n        old[\"scenario\"].isin(NEW_SCENARIOS)\n    ].copy()\n\n    if not corrected.empty:\n        corrected[\"seed\"] = corrected[\"seed\"].astype(int)\n\n        corrected = corrected.drop_duplicates(\n            subset=[\"seed\", \"scenario\", \"method\"],\n            keep=\"last\",\n        )\n\n    def atomic_save(df, path):\n        path.parent.mkdir(parents=True, exist_ok=True)\n        temp = path.with_suffix(path.suffix + \".tmp\")\n        df.to_csv(temp, index=False)\n        temp.replace(path)\n\n    atomic_save(corrected, NEW_PROGRESS)\n\n    expected = 20 * 3 * 5\n\n    print(\"Corrected checkpoint saved:\", NEW_PROGRESS)\n    print(\"Completed corrected runs:\", len(corrected))\n    print(\"Expected corrected runs:\", expected)\n\n    if not corrected.empty:\n        print(\"\\nRuns by scenario:\")\n        print(corrected.groupby(\"scenario\").size())\n\n    if len(corrected) == expected:\n        atomic_save(\n            corrected.sort_values([\"scenario\", \"method\", \"seed\"]),\n            NEW_FINAL,\n        )\n        print(\"\\nCorrected robustness sweep is complete:\", NEW_FINAL)\n    else:\n        print(\n            \"\\nCorrected robustness sweep is incomplete. \"\n            \"Resume missing runs using the corrected checkpoint.\"\n        )","metadata":{"trusted":true,"execution":{"iopub.s