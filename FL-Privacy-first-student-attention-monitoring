n\")[\"accuracy_drop\"].agg([\"mean\",\"std\"]).reset_index()\n","    ax.errorbar(g[\"attack_epsilon\"],g[\"mean\"]*100,yerr=g[\"std\"]*100,marker=\"o\",capsize=4,label=method)\n","ax.set_xlabel(\"FGSM ε in encoded feature space\"); ax.set_ylabel(\"Accuracy drop (percentage points)\"); ax.set_title(\"Evaluation-time adversarial degradation\"); ax.grid(True,alpha=.25); ax.legend(); fig.tight_layout(); fig.savefig(RESULTS_DIR/\"Figure_FGSM_degradation.png\",dpi=300,bbox_inches=\"tight\"); plt.show()\n","\n","# Client-count sensitivity (K=10 points are reused from the main clean sweep; K=5/20 are newly trained).\n","if CLIENT_SENS_FINAL.exists():\n","    sens = pd.read_csv(CLIENT_SENS_FINAL)\n","    from scipy.stats import t as student_t\n","    fig, axes = plt.subplots(1, 3, figsize=(14, 4.5), sharey=True)\n","    sens_conditions = [(\"IID\", None, \"IID\"), (\"Dirichlet\", 0.5, \"Dirichlet α=0.5\"), (\"Dirichlet\", 0.1, \"Dirichlet α=0.1\")]\n","    for ax, (condition, alpha, title) in zip(axes, sens_conditions):\n","        m = sens[\"condition\"].eq(condition)\n","        if alpha is None:\n","            m &= sens[\"alpha\"].isna()\n","        else:\n","            m &= np.isclose(pd.to_numeric(sens[\"alpha\"], errors=\"coerce\").fillna(-999), float(alpha))\n","        subset = sens.loc[m]\n","        for method in [\"FedAvg\", \"CAFAD\"]:\n","            stats = subset[subset[\"method\"].eq(method)].groupby(\"n_clients\")[\"accuracy\"].agg([\"mean\", \"std\", \"count\"]).reset_index().sort_values(\"n_clients\")\n","            if stats.empty:\n","                continue\n","            sem = stats[\"std\"] / np.sqrt(stats[\"count\"])\n","            critical = [student_t.ppf(0.975, max(int(n)-1, 1)) for n in stats[\"count\"]]\n","            ci = sem.to_numpy() * np.asarray(critical)\n","            ax.errorbar(stats[\"n_clients\"], stats[\"mean\"]*100, yerr=ci*100, marker=\"o\", capsize=4, label=method)\n","        ax.set_title(title); ax.set_xlabel(\"Number of