line([\n                (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n                (\"onehot\", oh),\n            ]),\n            cat_cols,\n        ))\n\n    if not transformers:\n        raise ValueError(\"No usable numeric or categorical columns were supplied.\")\n\n    return ColumnTransformer(transformers, remainder=\"drop\")\n\n","metadata":{"execution":{"iopub.status.busy":"2026-10-09T06:46:22.333235Z","iopub.execute_input":"2026-10-09T06:46:22.33362Z","iopub.status.idle":"2026-10-09T06:46:22.42089Z","shell.execute_reply.started":"2026-10-09T06:46:22.333584Z","shell.execute_reply":"2026-10-09T06:46:22.419956Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Train: (4995, 44) Test: (1249, 44)\nEncoded features: 44\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"\n## 6. Benchmark-validity / feature-dependence audit\n\nThis section is deliberately separate from FL.\n\nA high-performing shallow model does **not** automatically mean train/test leakage. Instead, it shows that the released behavioral representation contains a strong, low-complexity mapping to the released operational label.\n\nWe therefore report:\n\n- shallow decision-tree reconstruction,\n- feature-group-only performance,\n- a direct-cue lookup,\n- and later, leave-one-group-out sensitivity.\n\nUse terms such as **feature–label construction dependence** or **benchmark-validity audit**, rather than calling this “leakage” unless a true split violation is demonstrated.\n","metadata":{}},{"cell_type":"code","source":"\n# 6A. Shallow-tree reconstruction\ndef make_tree_pipeline(cols, max_depth=3):\n    num = [c for c in cols if df[c].dtype != \"object\"]\n    cat = [c for c in cols if df[c].dtype == \"object\"]\n    try:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n    except TypeError:\n        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n    pre = ColumnTransformer([\n        (\"num\", SimpleImputer(strategy=\"median\"), num),\n        (\"cat\", Pipeline([\n            (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n            (\"onehot\", oh),\n        ]), cat),\n    ])\n    return Pipeline([(\"pre\", pre),\n                     (\"clf\", DecisionTreeClassifier(max_depth=max_depth, random_state=SEED))])\n\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\naudit_rows = []\n\nfor gname, cols in V3_FEATURE_GROUPS.items():\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": gname, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\nkey_cues = [\"gaze_on_screen\", \"head_pose\", \"hand_obj_interaction\", \"phone_present\"]\nfor name, cols in [(\"key_direct_cues\", key_cues), (\"all_features\", EXPECTED_FEATURES)]:\n    pipe = make_tree_pipeline(cols, max_depth=3)\n    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n    audit_rows.append({\"feature_set\": name, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n\naudit_table = pd.DataFrame(audit_rows).sort_values(\"mean_accuracy\", ascending=False)\ndisplay(audit_table)\naudit_table.to_csv(RESULTS_DIR / \"v3_feature_group_audit.csv\", index=False)\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T08:33:16.939026Z","iopub.execute_input":"2026-10-06T08:33:16.939477Z","iopub.status.idle":"2026-10-06T08:33:20.247103Z","shell.execute_reply.started":"2026-10-06T08:33:16.939448Z","shell.execute_reply":"2026-10-06T08:33:20.246416Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 6B. Direct-cue conditional lookup (fit on train only)\ncue_train = train_df[key_cues + [TARGET]].copy()\ncue_test = test_df[key_cues + [TARGET]].copy()\n\ntrain_keys = cue_train[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\ntest_keys = cue_test[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\n\nmajority_map = cue_train.assign(_key=train_keys).groupby(\"_key\")[TARGET].agg([\"mean\",\"size\"])\nglobal_majority = int(train_df[TARGET].mean() >= 0.5)\n\npred = []\nfor key in test_keys:\n    if key in majority_map.index:\n        pred.append(int(majority_map.loc[key, \"mean\"] >= 0.5))\n    else:\n        pred.append(global_majority)\n\nprint(\"Direct-cue lookup accuracy:\", round(accuracy_score(y_test, pred), 4))\nprint(\"Direct-cue lookup F1:\", round(f1_score(y_test, pred), 4))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-06T04:42:59.949669Z","iopub.execute_input":"2026-10-06T04:42:59.950712Z","iopub.status.idle":"2026-10-06T04:43:00.020882Z","shell.execute_reply.started":"2026-10-06T04:42:59.950675Z","shell.execute_reply":"2026-10-06T04:43:00.020264Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# 6C. Centralized baselines\ncentral_results = []\n\ndt_pipe = make_tree_pipeline(EXPECTED_FEATURES, max_depth=3)\ndt_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\ndt_pred = dt_pipe.predict(test_df[EXPECTED_FEATURES])\ncentral_results.append({\n    \"model\": \"DecisionTree_depth3\",\n    \"accuracy\": accuracy_score(y_test, dt_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, dt_pred),\n    \"f1\": f1_score(y_test, dt_pred),\n    \"mcc\": matthews_corrcoef(y_test, dt_pred),\n})\n\net_pipe = Pipeline([\n    (\"pre\", preprocessor),\n    (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1))\n])\net_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\net_pred = et_pipe.predict(test_df[EXPECTED_FEATURES])\net_prob = et_pipe.predict_proba(test_df[EXPECTED_FEATURES])[:,1]\ncentral_results.append({\n    \"model\": \"ExtraTrees\",\n    \"accuracy\": accuracy_score(y_test, et_pred),\n    \"balanced_accuracy\": balanced_accuracy_score(y_test, et_pred),\n    \"f1\": f1_score(y_test, et_pred),\n    \"mcc\": mat