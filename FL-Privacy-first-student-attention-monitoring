False\nif RUN_CLEAN_SWEEP:\n    clean_results=run_clean_sweep()\n    display(clean_results.groupby([\"condition\",\"method\"])[\"accuracy\"].agg([\"mean\",\"std\",\"count\"]))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:13.250346Z","iopub.execute_input":"2026-10-04T10:11:13.250775Z","iopub.status.idle":"2026-10-04T10:11:13.258372Z","shell.execute_reply.started":"2026-10-04T10:11:13.25075Z","shell.execute_reply":"2026-10-04T10:11:13.257193Z"},"trusted":true},"outputs":[],"execution_count":21},{"id":"81d95ee3","cell_type":"markdown","source":"\n## 13. Client unreliability\n\nUse three conditions:\n\n1. one client with 20% label corruption,\n2. two clients with severe corruption,\n3. one honest but undertrained straggler.\n\nAn optional model-replacement attack can be added later. The clean local validation split remains uncorrupted, so CAFAD's validation score measures how the poisoned/undertrained local model performs on clean held-out local data.\n","metadata":{}},{"id":"8e2405bf","cell_type":"code","source":"\n# 13A. Poisoning / straggler sweep\nROBUST_METHODS=[\"FedAvg\",\"FedProx\",\"Median\",\"TrimmedMean\",\"CAFAD\"]\n\ndef run_robustness_sweep():\n    rows=[]\n    seeds=list(range(max(10,len(CFG[\"seeds\"]))))\n    for seed in seeds:\n        parts=balanced_iid_partition(y_train,N_CLIENTS,seed)\n        scenarios=[\n            (\"one_poison_20pct\",[0],0.20,[]),\n            (\"two_poison_40pct\",[0,1],0.40,[]),\n            (\"one_straggler\",[],0.0,[0])\n        ]\n        for scenario,poisoned,rate,stragglers in scenarios:\n            for method in ROBUST_METHODS:\n                r,_,_=run_federated(\n                    X_train,y_train,X_test,y_test,parts,method,seed,\n                    CFG[\"fl_rounds\"],CFG[\"local_epochs\"],CFG[\"batch_size\"],\n                    corrupt_clients=poisoned,corrupt_rate=rate,straggler_clients=stragglers\n                )\n                r.update({\"scenario\":scenario,\"partition\":\"IID\"})\n                rows.append(r)\n                print(scenario,method,seed,round(r[\"accuracy\"],4))\n    out=pd.DataFrame(rows)\n    out.to_csv(RESULTS_DIR/\"robustness_sweep_v3.csv\",index=False)\n    return out\n\nRUN_ROBUSTNESS_SWEEP=False\nif RUN_ROBUSTNESS_SWEEP:\n    robustness_results=run_robustness_sweep()\n    display(robustness_results.groupby([\"scenario\",\"method\"])[\"accuracy\"].agg([\"mean\",\"std\",\"count\"]))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:13.259185Z","iopub.execute_input":"2026-10-04T10:11:13.259515Z","iopub.status.idle":"2026-10-04T10:11:13.286327Z","shell.execute_reply.started":"2026-10-04T10:11:13.259472Z","shell.execute_reply":"2026-10-04T10:11:13.285548Z"},"trusted":true},"outputs":[],"execution_count":22},{"id":"179b0f94","cell_type":"markdown","source":"\n## 14. Record-level DP-SGD\n\nThe earlier draft used a basic per-round ε shortcut. This notebook replaces that with cumulative RDP accounting.\n\nThe implementation uses:\n\n- per-record gradient clipping,\n- Gaussian noise,\n- Poisson/Bernoulli inclusion sampling,\n- cumulative integer-order RDP,\n- explicit δ,\n- record/row-level privacy scope.\n\n### Why CAFAD is excluded from the formal DP comparison\n\nCAFAD sends a validation accuracy derived from local data. That is an additional data-dependent communication channel. Unless that statistic is also privatized and its privacy loss is accounted for, an end-to-end DP claim would be incomplete.\n\nTherefore the formal DP comparison uses FedAvg, Median and TrimmedMean.\n","metadata":{}},{"id":"025ff1d1","cell_type":"code","source":"\n# 14A. Integer-order RDP accountant for Poisson-sampled Gaussian mechanism\ndef subsampled_gaussian_rdp(q,sigma,order):\n    a=int(order)\n    if q<=0: return 0.0\n    if q>=1: return a/(2.0*sigma**2)\n    i=np.arange(a+1)\n    log_comb=(gammaln(a+1)-gammaln(i+1)-gammaln(a-i+1))\n    log_q=i*math.log(q)\n    log_1q=(a-i)*math.log(1-q)\n    exponent=(i*i-i)/(2.0*sigma**2)\n    log_a=logsumexp(log_comb+log_q+log_1q+exponent)\n    return float(log_a/(a-1))\n\ndef rdp_epsilon(q,sigma,steps,delta=DP_DELTA,orders=None):\n    orders=orders or list(range(2,65))\n    eps=[steps*subsampled_gaussian_rdp(q,sigma,a)+math.log(1.0/delta)/(a-1) for a in orders]\n    return float(np.min(eps))\n\ndef calibrate_sigma(target_epsilon,q,steps,delta=DP_DELTA):\n    lo,hi=0.01,100.0\n    while rdp_epsilon(q,hi,steps,delta)>target_epsilon:\n        hi*=2.0\n        if hi>1e6: raise RuntimeError(\"Could not bracket sigma.\")\n    for _ in range(70):\n        mid=(lo+hi)/2\n        if rdp_epsilon(q,mid,steps,delta)>target_epsilon: lo=mid\n        else: hi=mid\n    return hi\n\nfor eps_target in [1.0,2.0,5.0]:\n    q=64/1000; steps=500\n    sigma=calibrate_sigma(eps_target,q,steps)\n    print(\"target\",eps_target,\"sigma\",round(sigma,4),\"achieved\",round(rdp_epsilon(q,sigma,steps),4))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:13.287141Z","iopub.execute_input":"2026-10-04T10:11:13.287319Z","iopub.status.idle":"2026-10-04T10:11:16.241797Z","shell.execute_reply.started":"2026-10-04T10:11:13.287301Z","shell.execute_reply":"2026-10-04T10:11:16.241237Z"},"trusted":true},"outputs":[{"name":"stdout","text":"target 1.0 sigma 7.1442 achieved 1.0\ntarget 2.0 sigma 3.7374 achieved 2.0\ntarget 5.0 sigma 1.7387 achieved 5.0\n","output_type":"stream"}],"execution_count":23},{"id":"93edd4fe","cell_type":"code","source":"\n# 14B. Auditable DP-SGD with torch.func\ndef dp_local_train(global_state,X,y,client_idx,seed,total_rounds,local_epochs,batch_size,\n                   target_epsilon,delta=DP_DELTA,max_grad_norm=DP_MAX_GRAD_NORM,lr=LR):\n    seed_everything(seed)\n    model=MLP(X.shape[1]); load_state_dict_cpu(model,global_state); model.train()\n    idx=np.array(client_idx,dtype=int)\n    x_local=torch.tensor(X[idx],dtype=torch.float32)\n    y_local=torch.tensor(y[idx],dtype=torch.long)\n    n=len(idx)\n    q=min(1.0,batch_size/n)\n    steps_per_epoch=max(1,math.ceil(1.0/q))\n    total_steps=total_rounds*local_epochs*steps_per_epoch\n    sigma=calibrate_sigma(target_epsilon,q,total_steps,delta)\n\n    params={k:v for k,v in model.named_parameters()}\n    buffers={k:v for k,v in model.named_buffers()}\n\n    def loss_one(params,buffers,x_one,y_one):\n        logits=functional_call(model,(params,buffers),(x_one.unsqueeze(0),))\n        return nn.functional.cross_entropy(logits,y_one.unsqueeze(0))\n    grad_one=grad(loss_one)\n\n    for _ in range(local_epochs):\n        for _ in range(steps_per_epoch):\n            mask=torch.rand(n)<q\n            ids=torch.where(mask)[0]\n            if len(ids)==0: continue\n            xb,yb=x_local[ids],y_local[ids]\n\n            per_sample=vmap(grad_one,in_dims=(None,None,0,0))(params,buffers,xb,yb)\n            norm_sq=None\n            for g in per_sample.values():\n                z=g.reshape(g.shape[0],-1)\n                term=(z*z).sum(dim=1)\n                norm_sq=term if norm_sq is None else norm_sq+term\n            norms=torch.sqrt(norm_sq+1e-12)\n            coeff=torch.clamp(max_grad_norm/norms,max=1.0)\n\n            with torch.no_grad():\n                for name,p in params.items():\n                    g=per_sample[name]\n                    view=coeff.view(-1,*([1]*(g.ndim-1)))\n                    clipped=g*view\n                    mean_grad=clipped.mean(dim=0)\n                    noise=torch.randn_like(mean_grad)*(sigma*max_grad_norm/len(ids))\n                    p.data-=lr*(mean_grad+noise)\n\n    return clone_state_dict(model),sigma,rdp_epsilon(q,sigma,total_steps,delta)\n\nparts=balanced_iid_partition(y_train,N_CLIENTS,0)\nbase_state=clone_state_dict(MLP(X_train.shape[1]))\ndp_state,sigma,eps=dp_local_train(\n    base_state,X_train,y_train,parts[0],seed=0,total_rounds=2,local_epochs=1,\n    batch_size=32,target_epsilon=5.0\n)\nprint(\"DP smoke test OK; sigma =\",round(sigma,4),\"achieved epsilon =\",round(eps,4))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:16.242783Z","iopub.execute_input":"2026-10-04T10:11:16.243226Z","iopub.status.idle":"2026-10-04T10:11:17.304509Z","shell.execute_reply.started":"2026-10-04T10:11:16.2432Z","shell.execute_reply":"2026-10-04T10:11:17.30372Z"},"trusted":true},"outputs":[{"name":"stdout","text":"DP smoke test OK; sigma = 0.7873 achieved epsilon = 5.0\n","output_type":"stream"}],"execution_count":24},{"id":"d666f6ec","cell_type":"code","source":"\n# 14C. DP federated runner\nDP_METHODS=[\"FedAvg\",\"Median\",\"TrimmedMean\"]\n\ndef run_federated_dp(X,y,X_eval,y_eval,parts,method,seed,rounds,local_epochs,batch_size,target_epsilon):\n    seed_everything(seed)\n    global_state=clone_state_dict(MLP(X.shape[1]))\n    client_eps=[]; client_sigmas=[]\n\n    for rnd in range(rounds):\n        local_states=[]; ns=[]\n        for k,idx in enumerate(parts):\n            st,sigma,eps=dp_local_train(\n                global_state,X,y,idx,seed+1000*rnd+k,\n                total_rounds=rounds,local_epochs=local_epochs,batch_size=batch_size,\n                target_epsilon=target_epsilon\n            )\n            local_states.append(st); ns.append(len(idx))\n            if rnd==0:\n                client_eps.append(eps); client_sigmas.append(sigma)\n\n        if method==\"FedAvg\": global_state=aggregate_fedavg(local_states,ns)\n        elif method==\"Median\": global_state=aggregate_median(local_states)\n        elif method==\"TrimmedMean\": global_state=aggregate_trimmed_mean(local_states,TRIM_FRACTION)\n        else: raise ValueError(method)\n\n    result=evaluate_state(global_state,X_eval,y_eval)\n    result.update({\n        \"method\":method,\"seed\":seed,\"target_epsilon\":target_epsilon,\n        \"max_client_achieved_epsilon\":max(client_eps),\n        \"mean_client_sigma\":float(np.mean(client_sigmas))\n    })\n    return result\n\ndp_smoke=[]\nfor method in DP_METHODS:\n    dp_smoke.append(run_federated_dp(\n        X_train,y_train,X_test,y_test,parts,method,0,2,1,32,5.0\n    ))\ndisplay(pd.DataFrame(dp_smoke))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-04T10:11:17.305562Z","iopub.execute_input":"2026-10-04T10:11:17.305963Z","iopub.status.idle":"2026-10-04T10:11:41.688523Z","shell.execute_reply.started":"2026-10-04T10:11:17.305939Z","shell.execute_reply":"2026-10-04T10:11:41.687906Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"   accuracy  balanced_accuracy        f1  precision    recall       mcc  \\\n0   0.53723           0.518522  0.079618   0.892857  0.041667  0.125020   \n1   0.53723           0.518459  0.076677   0.923077  0.040000  0.129193   \n2   0.53803           0.519293  0.079745   0.925926  0.041667  0.132556   \n\n      auroc       method  seed  target_epsilon  max_client_achieved_epsilon  \\\n0  0.818373       FedAvg     0             5.0                          5.0   \n1  0.818819       Median     0             5.0                          5.0   \n2  0.818721  TrimmedMean     0             5.0                          5.0   \n\n   mean_client_sigma  \n0           0.787286  \n1           0.787286  \n2           0.787286  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>accuracy</th>\n      <th>balanced_accuracy</th>\n      <th>f1</th>\n      <th>precision</th>\n      <th>recall</th>\n      <th>mcc</th>\n      <th>auroc</th>\n      <th>method</th>\n      <th>seed</th>\n      <th>target_epsilon</th>\n      <th>max_client_achieved_epsilon</th>\n      <th>mean_client_sigma</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0.53723</td>\n      <td>0.518522</td>\n      <td>0.079618</td>\n      <td>0.8928