iddle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Seed</th>\n      <th>Setting</th>\n      <th>Method</th>\n      <th>Epsilon</th>\n      <th>Accuracy</th>\n      <th>F1</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>42</td>\n      <td>IID</td>\n      <td>cafad</td>\n      <td>0.5</td>\n      <td>0.75250</td>\n      <td>0.584034</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>42</td>\n      <td>IID</td>\n      <td>cafad</td>\n      <td>1.0</td>\n      <td>0.75500</td>\n      <td>0.589958</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>42</td>\n      <td>IID</td>\n      <td>cafad</td>\n      <td>2.0</td>\n      <td>0.75500</td>\n      <td>0.589958</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>42</td>\n      <td>IID</td>\n      <td>cafad</td>\n      <td>5.0</td>\n      <td>0.75500</td>\n      <td>0.589958</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>42</td>\n      <td>IID</td>\n      <td>cafad</td>\n      <td>inf</td>\n      <td>0.96875</td>\n      <td>0.961715</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":22},{"cell_type":"markdown","source":"## 7. Statistical Significance Testing\n\nPaired (same-seed) t-test **and** Wilcoxon signed-rank test for CAFAD vs.\nFedAvg and FedProx vs. FedAvg, computed separately for each (Setting,\nEpsilon) combination. Report both -- the Wilcoxon test does not assume\nnormality across only 10 paired seeds, which the t-test does. Because this\nruns many (Setting x Epsilon) comparisons, treat individual p-values with a\nHolm-Bonferroni correction in the paper rather than reading each p < 0.05\nin isolation.","metadata":{}},{"cell_type":"code","source":"def paired_tests(df, method_a, method_b, setting, epsilon, metric=\"Accuracy\"):\n    a = df[(df.Method == method_a) & (df.Setting == setting) & (df.Epsilon == epsilon)].sort_values(\"Seed\")[metric].values\n    b = df[(df.Method == method_b) & (df.Setting == setting) & (df.Epsilon == epsilon)].sort_values(\"Seed\")[metric].values\n    if len(a) != len(b) or len(a) < 2:\n        return np.nan, np.nan, np.nan\n    t_stat, p_t = stats.ttest_rel(a, b)\n    try:\n        w_stat, p_w = stats.wilcoxon(a, b)\n    except ValueError:\n        p_w = np.nan  # identical distributions -> Wilcoxon undefined\n    return a.mean() - b.mean(), p_t, p_w\n\nsig_rows = []\nfor setting_name, _ in SETTINGS:\n    for eps in EPSILONS:\n        for challenger in [\"cafad\", \"fedprox\"]:\n            diff, p_t, p_w = paired_tests(results_df, challenger, \"fedavg\", setting_name, eps, metric=\"Accuracy\")\n            sig_rows.append([setting_name, eps, f\"{challenger} vs fedavg\", diff, p_t, p_w])\n\nsig_df = pd.DataFrame(sig_rows, columns=[\"Setting\", \"Epsilon\", \"Comparison\", \"MeanAccDiff\", \"p_ttest\", \"p_wilcoxon\"])\n# Holm-Bonferroni correction across all comparisons in this table\nfrom scipy.stats import false_discovery_control\nvalid = sig_df[\"p_ttest\"].notna()\nsig_df.loc[valid, \"p_ttest_holm\"] = stats.false_discovery_control(sig_df.loc[valid, \"p_ttest\"], method=\"bh\")\nsig_df[\"significant_0.05\"] = sig_df[\"p_ttest_holm\"] < 0.05\ndisplay(sig_df.round(4))\nsig_df.to_csv(\"significance_table.csv\", index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T17:20:36.226823Z","iopub.execute_input":"2026-09-07T17:20:36.227096Z","iopub.status.idle":"2026-09-07T17:20:39.092452Z","shell.execute_reply.started":"2026-09-07T17:20:36.227073Z","shell.execute_reply":"2026-09-07T17:20:39.091565Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"    Setting  Epsilon         Comparison  MeanAccDiff  p_ttest  p_wilcoxon  \\\n0       IID      0.5    cafad vs fedavg      -0.0038   0.0085      0.0078   \n1   