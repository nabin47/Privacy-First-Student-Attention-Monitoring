ario\": scenario,\n","                \"partition\": \"IID\",\n","                \"n_clients\": int(N_CLIENTS),\n","                \"poisoned_client_count\": len(poisoned),\n","                \"poisoned_client_fraction\": len(poisoned) / N_CLIENTS,\n","                \"local_label_flip_rate\": float(rate),\n","                \"client_val_labels\": \"flipped\",\n","            })\n","            consistent_progress = upsert_checkpoint(\n","                CONSISTENT_PROGRESS_PATH, [result], [\"seed\", \"scenario\", \"method\"]\n","            )\n","            print(f\"{scenario} seed={seed} accuracy={result['accuracy']:.4f}\")\n","finally:\n","    CONSISTENT_VAL_LABELS = False\n","\n","if len(consistent_progress) == expected_consistent:\n","    atomic_to_csv(consistent_progress.sort_values([\"scenario\", \"seed\"]), CONSISTENT_FINAL_PATH)\n","    print(\"CONSISTENT-LABEL SWEEP COMPLETE:\", len(consistent_progress), \"rows\")\n","else:\n","    print(\"CONSISTENT-LABEL SWEEP INCOMPLETE; progress retained at:\", CONSISTENT_PROGRESS_PATH)\n","\n","main_robust_path = RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\"\n","if CONSISTENT_FINAL_PATH.exists() and main_robust_path.exists():\n","    main_rob = pd.read_csv(main_robust_path)\n","    main_rob = main_rob[main_rob[\"scenario\"].isin([s[0] for s in CONSISTENT_SCENARIOS])]\n","    flipped = pd.read_csv(CONSISTENT_FINAL_PATH).assign(method=\"CAFAD_flipped_val\")\n","    combined = pd.concat([main_rob, flipped], ignore_index=True, sort=False)\n","    combined[\"accuracy_pct\"] = combined[\"accuracy\"] * 100\n","    consistent_summary = (\n","        combined.groupby([\"scenario\", \"method\"])[\"accuracy_pct\"]\n","        .agg([\"mean\", \"std\", \"count\"]).round(2).reset_index()\n","    )\n","    display(consistent_summary)\n","\n","    test_rows = []\n","    for scenario, g in combined.groupby(\"scenario\"):\n","        ref = g[g[\"method\"].eq(\"CAFAD_flipped_val\")].set_index(\"seed\")[\"accuracy\"]\n","        for other in [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]:\n","            cmp = g[g[\"method\"].eq(other)].set_index(\"seed\")[\"accuracy\"]\n","            common = sorted(set(ref.index) & set(cmp.index))\n","            a = cmp.loc[common].to_numpy(dtype=float)\n","            b = ref.loc[common].to_numpy(dtype=float)\n","            p = 1.0 if np.allclose(a, b) else float(wilcoxon(a, b).pvalue)\n","            test_rows.append({\n","                \"scenario\": scenario, \"method_a\": other, \"method_b\": \"CAFAD_flipped_val\",\n","                \"n_pairs\": len(common), \"mean_diff_b_minus_a\": float(np.mean(b - a)),\n","                \"wilcoxon_p\": p,\n","            })\n","    consistent_tests = pd.DataFrame(test_rows)\n","    pv = consistent_tests[\"wilcoxon_p\"].to_numpy()\n","    order = np.argsort(pv)\n","    adjusted = pv[order] * len(pv) / np.arange(1, len(pv) + 1)\n","    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1].clip(0, 1)\n","    consistent_tests[\"bh_q\"] = np.empty_like(adjusted)\n","    consistent_tests.loc[order, \"bh_q\"] = adjusted\n","    consistent_tests[\"significant_bh_0_05\"] = consistent_tests[\"bh_q\"] < 0.05\n","    display(consistent_tests)\n","\n","    atomic_to_csv(consistent_summary, RESULTS_DIR / \"MANUSCRIPT_robustness_consistent_val_summary.csv\")\n","    atomic_to_csv(consistent_tests, RESULTS_DIR / \"MANUSCRIPT_robustness_consistent_val_tests.csv\")\n"]},{"cell_type":"code","execution_count":21,"id":"28892414","metadata":{"execution":{"iopub.execute_input":"2026-10-11T12:13:35.873498Z","iopub.status.busy":"2026-10-11T12:13:35.873207Z","iopub.status.idle":"2026-10-11T12:13:35.895034Z","shell.execute_reply":"2026-10-11T12:13:35.894028Z"},"papermill":{"duration":0.062107,"end_time":"2026-10-11T12:13:35.896422","exception":false,"start_time":"2026-10-11T12:13:35.834315","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["RESULTS_DIR: /kaggle/workin