,\n","    (\"cat\", Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","        (\"onehot\", onehot),\n","    ]), categorical_cols),\n","])\n","\n","X_train = preprocessor.fit_transform(train_df[EXPECTED_FEATURES]).astype(np.float32)\n","X_test = preprocessor.transform(test_df[EXPECTED_FEATURES]).astype(np.float32)\n","y_train = train_df[TARGET].to_numpy(np.int64)\n","y_test = test_df[TARGET].to_numpy(np.int64)\n","FEATURE_NAMES_ENCODED = list(preprocessor.get_feature_names_out())\n","\n","print(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\n","print(\"Encoded features:\", len(FEATURE_NAMES_ENCODED))\n","\n","\n","# Fold-safe preprocessing helper used by blocked sensitivity and any fold-wise audit.\n","# IMPORTANT: the preprocessor is fit only on the supplied training frame, preventing\n","# information from the blocked test fold from entering imputation/scaling/encoding.\n","def build_fold_preprocessor(frame, cols=None):\n","    cols = list(EXPECTED_FEATURES if cols is None else cols)\n","    num_cols = [c for c in cols if frame[c].dtype != \"object\"]\n","    cat_cols = [c for c in cols if frame[c].dtype == \"object\"]\n","\n","    try:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","    except TypeError:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","\n","    transformers = []\n","    if num_cols:\n","        transformers.append((\n","            \"num\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"median\")),\n","                (\"scaler\", StandardScaler()),\n","            ]),\n","            num_cols,\n","        ))\n","    if cat_cols:\n","        transformers.append((\n","            \"cat\",\n","            Pipeline([\n","                (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","                (\"onehot\", oh),\n","            ]),\n","            cat_cols,\n","        ))\n","\n","    if not transformers:\n","        raise ValueError(\"No usable numeric or categorical columns were supplied.\")\n","\n","    return ColumnTransformer(transformers, remainder=\"drop\")\n","\n"]},{"cell_type":"markdown","id":"f1bb1c3e","metadata":{"papermill":{"duration":0.010722,"end_time":"2026-11-07T07:11:42.461495","exception":false,"start_time":"2026-11-07T07:11:42.450773","status":"completed"},"tags":[]},"source":["\n","## 6. Benchmark-validity / feature-dependence audit\n","\n","This section is deliberately separate from FL.\n","\n","A high-performing shallow model does **not** automatically mean train/test leakage. Instead, it shows that the released behavioral representation contains a strong, low-complexity mapping to the released operational label.\n","\n","We therefore report:\n","\n","- shallow decision-tree reconstruction,\n","- feature-group-only performance,\n","- a direct-cue lookup,\n","- and later, leave-one-group-out sensitivity.\n","\n","Use terms such as **feature–label construction dependence** or **benchmark-validity audit**, rather than calling this “leakage” unless a true split violation is demonstrated.\n"]},{"cell_type":"code","execution_count":6,"id":"71507636","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:42.485744Z","iopub.status.busy":"2026-11-07T07:11:42.484943Z","iopub.status.idle":"2026-11-07T07:11:46.343881Z","shell.execute_reply":"2026-11-07T07:11:46.342977Z"},"papermill":{"duration":3.873631,"end_time":"2026-11-07T07:11:46.346003","exception":false,"start_time":"2026-11-07T07:11:42.472372","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n"