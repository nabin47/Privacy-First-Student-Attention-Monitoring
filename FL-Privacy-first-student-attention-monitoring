ta":{},"output_type":"display_data"}],"source":["\n","# 6A. Shallow-tree reconstruction\n","def make_tree_pipeline(cols, max_depth=3):\n","    num = [c for c in cols if df[c].dtype != \"object\"]\n","    cat = [c for c in cols if df[c].dtype == \"object\"]\n","    try:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n","    except TypeError:\n","        oh = OneHotEncoder(handle_unknown=\"ignore\", sparse=False)\n","    pre = ColumnTransformer([\n","        (\"num\", SimpleImputer(strategy=\"median\"), num),\n","        (\"cat\", Pipeline([\n","            (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n","            (\"onehot\", oh),\n","        ]), cat),\n","    ])\n","    return Pipeline([(\"pre\", pre),\n","                     (\"clf\", DecisionTreeClassifier(max_depth=max_depth, random_state=SEED))])\n","\n","skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n","audit_rows = []\n","\n","for gname, cols in V3_FEATURE_GROUPS.items():\n","    pipe = make_tree_pipeline(cols, max_depth=3)\n","    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n","    audit_rows.append({\"feature_set\": gname, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n","\n","key_cues = [\"gaze_on_screen\", \"head_pose\", \"hand_obj_interaction\", \"phone_present\"]\n","for name, cols in [(\"key_direct_cues\", key_cues), (\"all_features\", EXPECTED_FEATURES)]:\n","    pipe = make_tree_pipeline(cols, max_depth=3)\n","    scores = cross_val_score(pipe, df[cols], df[TARGET], cv=skf, scoring=\"accuracy\", n_jobs=-1)\n","    audit_rows.append({\"feature_set\": name, \"mean_accuracy\": scores.mean(), \"std_accuracy\": scores.std()})\n","\n","audit_table = pd.DataFrame(audit_rows).sort_values(\"mean_accuracy\", ascending=False)\n","display(audit_table)\n","audit_table.to_csv(RESULTS_DIR / \"v3_feature_group_audit.csv\", index=False)\n"]},{"cell_type":"code","execution_count":7,"id":"f1a2cb34","metadata":{"execution":{"iopub.execute_input":"2026-10-11T10:38:27.038398Z","iopub.status.busy":"2026-10-11T10:38:27.038073Z","iopub.status.idle":"2026-10-11T10:38:27.092031Z","shell.execute_reply":"2026-10-11T10:38:27.091119Z"},"papermill":{"duration":0.06298,"end_time":"2026-10-11T10:38:27.0936","exception":false,"start_time":"2026-10-11T10:38:27.03062","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Direct-cue lookup accuracy: 0.9223\n","Direct-cue lookup F1: 0.9199\n"]}],"source":["\n","# 6B. Direct-cue conditional lookup (fit on train only)\n","cue_train = train_df[key_cues + [TARGET]].copy()\n","cue_test = test_df[key_cues + [TARGET]].copy()\n","\n","train_keys = cue_train[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\n","test_keys = cue_test[key_cues].fillna(\"<NA>\").astype(str).agg(\"|\".join, axis=1)\n","\n","majority_map = cue_train.assign(_key=train_keys).groupby(\"_key\")[TARGET].agg([\"mean\",\"size\"])\n","global_majority = int(train_df[TARGET].mean() >= 0.5)\n","\n","pred = []\n","for key in test_keys:\n","    if key in majority_map.index:\n","        pred.append(int(majority_map.loc[key, \"mean\"] >= 0.5))\n","    else:\n","        pred.append(global_majority)\n","\n","print(\"Direct-cue lookup accuracy:\", round(accuracy_score(y_test, pred), 4))\n","print(\"Direct-cue lookup F1:\", round(f1_score(y_test, pred), 4))\n"]},{"cell_type":"code","execution_count":8,"id":"a68df4ab","metadata":{"execution":{"iopub.execute_input":"2026-10-11T10:38:27.10819Z","iopub.status.busy":"2026-10-11T10:38:27.107915Z","iopub.status.idle":"2026-10-11T10:38:28.186897Z","shell.execute_reply":"2026-10-11T10:38:28.186232Z"},"papermill":{"duration":1.088252,"end_time":"2026-10-11T10:38:28.18864","exception":false,"start_time":"2026-10-11T10:38:27.100388","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th: