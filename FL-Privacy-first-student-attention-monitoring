=================\n# 13A. CLEAN FL STATISTICAL ANALYSIS\n# ============================================================\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.stats import t\n\n\n# ------------------------------------------------------------\n# Load results if they are not currently in memory\n# ------------------------------------------------------------\n\nif \"clean_results\" not in globals():\n\n    clean_results = pd.read_csv(\n        RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\n    )\n\nprint(\"Clean FL results shape:\", clean_results.shape)\n\n# Expected:\n# 20 seeds\n# × 6 conditions\n# × 5 methods\n# = 600 rows\n\n\n# ------------------------------------------------------------\n# Basic verification\n# ------------------------------------------------------------\n\nprint(\"\\nMethods:\")\nprint(clean_results[\"method\"].unique())\n\nprint(\"\\nConditions:\")\nprint(clean_results[[\"condition\", \"alpha\"]]\n      .drop_duplicates()\n      .sort_values([\"condition\", \"alpha\"], na_position=\"first\"))\n\n\n# ------------------------------------------------------------\n# Metrics we will analyze\n# ------------------------------------------------------------\n\nMETRICS = [\n    \"accuracy\",\n    \"balanced_accuracy\",\n    \"f1\",\n    \"precision\",\n    \"recall\",\n    \"mcc\",\n    \"auroc\"\n]\n\n\n# ------------------------------------------------------------\n# 95% confidence interval summary\n# ------------------------------------------------------------\n\ndef summarize_metric(\n    data,\n    group_cols,\n    metric\n):\n\n    rows = []\n\n    for keys, g in data.groupby(\n        group_cols,\n        dropna=False\n    ):\n\n        values = g[metric].dropna().to_numpy()\n\n        n = len(values)\n\n        if n < 2:\n            continue\n\n        mean = np.mean(values)\n        std = np.std(values, ddof=1)\n        sem = std / np.sqrt(n)\n\n        # 95% t confidence interval\n        tcrit = t.ppf(\n            0.975,\n            df=n - 1\n        )\n\n        margin = tcrit * sem\n\n        if not isinstance(keys, tuple):\n            keys = (keys,)\n\n        row = dict(\n            zip(group_cols, keys)\n        )\n\n        row.update({\n            \"metric\": metric,\n            \"n\": n,\n            \"mean\": mean,\n            \"std\": std,\n            \"ci95_low\": mean - margin,\n            \"ci95_high\": mean + margin,\n            \"ci95_half_width\": margin\n        })\n\n        rows.append(row)\n\n    return pd.DataFrame(rows)\n\n\nsummary_tables = []\n\nfor metric in METRICS:\n\n    tmp = summarize_metric(\n        clean_results,\n        [\"condition\", \"alpha\", \"method\"],\n        metric\n    )\n\n    summary_tables.append(tmp)\n\n\nmetric_summary = pd.concat(\n    summary_tables,\n    ignore_index=True\n)\n\n\n# ------------------------------------------------------------\n# Accuracy summary\n# ------------------------------------------------------------\n\naccuracy_summary = (\n    metric_summary[\n        metric_summary[\"metric\"] == \"accuracy\"\n    ]\n    .copy()\n)\n\naccuracy_summary[\"mean_percent\"] = (\n    accuracy_summary[\"mean\"] * 100\n)\n\naccuracy_summary[\"std_percent\"] = (\n    accuracy_summary[\"std\"] * 100\n)\n\naccuracy_summary[\"ci95_low_percent\"] = (\n    accuracy_summary[\"ci95_low\"] * 100\n)\n\naccuracy_summary[\"ci95_high_percent\"] = (\n    accuracy_summary[\"ci95_high\"] * 100\n)\n\n\nprint(\"\\n================ ACCURACY SUMMARY ================\\n\")\n\ndisplay(\n    accuracy_summary[\n        [\n            \"condition\",\n            \"alpha\",\n            \"method\",\n            \"n\",\n            \"mean_percent\",\n            \"std_percent\",\n            \"ci95_low_percent\",\n            \"ci95_high_percent\"\n        ]\n    ]\n    .sort_values(\n        [\"condition\", \"alpha\", \"method\"],\n        na_position=\"first\"\n    )\n)\n\n\n# ------------------------------------------------------------\n# Save summary\n# ------------------------------------------------------------\n\nmetric_summary.to_csv(\n    RESULTS_DIR / \"clean_fl_metric_summary_v3.csv\",\n    index=False\n)\n\naccuracy_summary.to_csv(\n    RESULTS_DIR / \"clean_fl_accuracy_summary_v3.csv\",\n    index=False\n)\n\n\n# ------------------------------------------------------------\n# Compact table: mean ± std\n# ------------------------------------------------------------\n\ncompact = accuracy_summary.copy()\n\ncompact[\"mean_pm_std\"] = (\n    compact[\"mean_percent\"].map(\n        lambda x: f\"{x:.2f}\"\n    )\n    + \" ± \"\n    + compact[\"std_percent\"].map(\n        lambda x: f\"{x:.2f}\"\n    )\n)\n\nprint(\"\\n================ MEAN ± STD ================\\n\")\n\ndisplay(\n    compact[\n        [\n            \"condition\",\n            \"alpha\",\n            \"method\",\n            \"mean_pm_std\"\n        ]\n    ]\n    .sort_values(\n        [\"condition\", \"alpha\", \"method\"],\n        na_position=\"first\"\n    )\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-05T16:55:49.308355Z","iopub.execute_input":"2026-10-05T16:55:49.308687Z","iopub.status.idle":"2026-10-05T16:55:49.45599Z","shell.execute_reply.started":"2026-10-05T16:55:49.308664Z","shell.execute_reply":"2026-10-05T16:55:49.45553Z"}},"outputs":[{"name":"stdout","text":"Clean FL results shape: (600, 15)\n\nMethods:\n['FedAvg' 'FedProx' 'Median' 'TrimmedMean' 'CAFAD']\n\nConditions:\n    condition  alpha\n25  Dirichlet    0.1\n20  Dirichlet    0.5\n15  Dirichlet    1.0\n10  Dirichlet    2.0\n5   Dirichlet   10.0\n0         IID    NaN\n\n================ ACCURACY SUMMARY ================\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"    condition  alpha       method   n  mean_percent  std_percent  \\\n0   Dirichlet    0.1        CAFAD  20     90.292234     0.929671   \n1   Dirichlet    0.1       FedAvg  20     90.292234     0.934738   \n2   Diric