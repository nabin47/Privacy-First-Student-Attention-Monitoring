rocessor),\n","    (\"clf\", ExtraTreesClassifier(n_estimators=300, random_state=SEED, n_jobs=-1))\n","])\n","et_pipe.fit(train_df[EXPECTED_FEATURES], y_train)\n","et_pred = et_pipe.predict(test_df[EXPECTED_FEATURES])\n","et_prob = et_pipe.predict_proba(test_df[EXPECTED_FEATURES])[:,1]\n","central_results.append({\n","    \"model\": \"ExtraTrees\",\n","    \"accuracy\": accuracy_score(y_test, et_pred),\n","    \"balanced_accuracy\": balanced_accuracy_score(y_test, et_pred),\n","    \"f1\": f1_score(y_test, et_pred),\n","    \"mcc\": matthews_corrcoef(y_test, et_pred),\n","    \"auroc\": roc_auc_score(y_test, et_prob),\n","})\n","\n","central_table = pd.DataFrame(central_results)\n","display(central_table)\n","central_table.to_csv(RESULTS_DIR / \"centralized_baselines_v3.csv\", index=False)\n"]},{"cell_type":"markdown","id":"33595739","metadata":{"papermill":{"duration":0.011356,"end_time":"2026-11-07T07:11:48.204621","exception":false,"start_time":"2026-11-07T07:11:48.193265","status":"completed"},"tags":[]},"source":["## 7. Federated simulation\n","\n","The FL clients are **controlled partitions of the training records**. In the manuscript, call them **simulated clients / decentralized data partitions**, not identified students. The primary benchmark uses 10 clients; the optional client-count sensitivity compares 5 vs 10 clients on a smaller matched grid."]},{"cell_type":"code","execution_count":9,"id":"1e04e2ed","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.23144Z","iopub.status.busy":"2026-11-07T07:11:48.231067Z","iopub.status.idle":"2026-11-07T07:11:48.25371Z","shell.execute_reply":"2026-11-07T07:11:48.252532Z"},"papermill":{"duration":0.039537,"end_time":"2026-11-07T07:11:48.255845","exception":false,"start_time":"2026-11-07T07:11:48.216308","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Partition helpers ready for 10 simulated clients.\n"]}],"source":["# 7A. Partition helpers\n","def balanced_iid_partition(y, n_clients, seed):\n","    rng = np.random.default_rng(seed)\n","    parts = [[] for _ in range(n_clients)]\n","    for cls in np.unique(y):\n","        idx = rng.permutation(np.where(y == cls)[0])\n","        for k, s in enumerate(np.array_split(idx, n_clients)):\n","            parts[k].extend(s.tolist())\n","    return [np.array(sorted(z), dtype=int) for z in parts]\n","\n","\n","def dirichlet_label_partition(\n","    y,\n","    n_clients,\n","    alpha,\n","    seed,\n","    min_size=PARTITION_MIN_SIZE,\n","    max_tries=PARTITION_MAX_TRIES,\n","):\n","    rng = np.random.default_rng(seed)\n","    classes = np.unique(y)\n","    best_parts = None\n","    best_min = -1\n","\n","    for _ in range(max_tries):\n","        parts = [[] for _ in range(n_clients)]\n","\n","        for cls in classes:\n","            idx = rng.permutation(np.where(y == cls)[0])\n","            props = rng.dirichlet(np.ones(n_clients) * alpha)\n","            cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n","            splits = np.split(idx, cuts)\n","            for k, s in enumerate(splits):\n","                parts[k].extend(s.tolist())\n","\n","        sizes = [len(z) for z in parts]\n","        current_min = min(sizes)\n","        if current_min > best_min:\n","            best_min = current_min\n","            best_parts = [list(z) for z in parts]\n","\n","        if current_min >= min_size:\n","            return [np.array(sorted(z), dtype=int) for z in parts]\n","\n","    # Last-resort repair for pathological Dirichlet draws. This only activates\n","    # when the sampled partition cannot satisfy the requested floor after\n","    # max_tries; samples are transferred from the largest client(s) so that\n","    # local training never receives an unusably tiny client.\n","    repaired = [list(z) for z in best_parts]\n","    while min(len(z) for z in repaired) < min_size:\n","        small = int(np.argmin([len(z) for z in repaired]))\n","        donors = np.argsort([len(z) for z in repaired])[::-1]\n","        donor = next(int(d) for d in donors if d != small and len(repaired[d]) > min_size)\n","        need = min_size - len(repaired[small])\n","        take = min(need, len(repaired[donor]) - min_size)\n","        if take <= 0:\n","            raise RuntimeError(\n","                f\"Could not repair Dirichlet partition to min_size={min_size}; \"\n","                f\"client sizes={[len(z) for z in repaired]}\"\n","            )\n","        moved = repaired[donor][-take:]\n","        del repaired[donor][-take:]\n","        repaired[small].extend(moved)\n","\n","    print(\n","        f\"WARNING: alpha={alpha} seed={seed} did not meet min_size={min_size} \"\n","        f\"within {max_tries} draws; repaired best draw to min_client_size={min_size}.\"\n","    )\n","    return [np.array(sorted(z), dtype=int) for z in repaired]\n","\n","\n","def feature_cluster_partition(X, y, n_clients, n_clusters, seed):\n","    km = MiniBatchKMeans(\n","        n_clusters=n_clusters,\n","        random_state=seed,\n","        batch_size=256,\n","        n_init=10,\n","    )\n","    cluster_id = km.fit_predict(X)\n","    rng = np.random.default_rng(seed)\n","    parts = [[] for _ in range(n_clients)]\n","\n","    for c in range(n_clusters):\n","        idx = rng.permutation(np.where(cluster_id == c)[0])\n","        if len(idx) == 0:\n","            continue\n","        props = rng.dirichlet(np.ones(n_clients) * 0.35)\n","        cuts = (np.cumsum(props) * len(idx)).astype(int)[:-1]\n","        for k, s in enumerate(np.split(idx, cuts)):\n","            parts[k].extend(s.tolist())\n","\n","    for k in range(n_clients):\n","        if len(parts[k]) == 0:\n","            donor = int(np.argmax([len(z) for z in parts]))\n","            parts[k].append(parts[donor].pop())\n","\n","    return [np.array(sorted(z), dtype=int) for z in parts], cluster_id\n","\n","\n","def client_summary(parts, y, cluster_id=None):\n","    rows = []\n","    global_rate = float(np.mean(y))\n","\n","    for k, idx in enumerate(parts):\n","        row = {\n","            \"client\": k,\n","            \"n\": len(idx),\n","            \"label1_rate\": float(np.mean(y[idx])),\n","            \"abs_label_shift\": abs(float(np.mean(y[idx])) - global_rate),\n","        }\n","        if cluster_id is not None:\n","            vals, counts = np.unique(cluster_id[idx], return_counts=True)\n","            row[\"n_feature_clusters\"] = len(vals)\n","            row[\"dominant_cluster_share\"] = float(counts.max() / counts.sum())\n","        rows.append(row)\n","\n","    return pd.DataFrame(rows)\n","\n","\n","print(f\"Partition helpers ready for {N_CLIENTS} simulated clients.\")\n"]},{"cell_type":"code","execution_count":10,"id":"5e132281","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.281273Z","iopub.status.busy":"2026-11-07T07:11:48.280879Z","iopub.status.idle":"2026-11-07T07:11:48.293399Z","shell.execute_reply":"2026-11-07T07:11:48.292499Z"},"papermill":{"duration":0.028129,"end_time":"2026-11-07T07:11:48.295482","exception":false,"start_time":"2026-11-07T07:11:48.267353","status":"completed"},"tags":[]},"outputs":[],"source":["# 8. PyTorch model + utilities\n","\n","def seed_everything(seed):\n","    random.seed(seed)\n","    np.random.seed(seed)\n","    torch.manual_seed(seed)\n","    if torch.cuda.is_available():\n","        torch.cuda.manual_seed_all(seed)\n","\n","class MLP(nn.Module):\n","    def __init__(self, input_dim, hidden1=HIDDEN_1, hidden2=HIDDEN_2):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, hidden1), nn.ReLU(),\n","            nn.Linear(hidden1, hidden2), nn.ReLU(),\n","            nn.Linear(hidden2, 2)\n","        )\n","    def forward(self, x):\n","        return self.net(x)\n","\n","def clone_state_dict(model):\n","    # Always checkpoint on CPU so files remain portable across Kaggle sessions.\n","    return {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n","\n","def load_state_dict_device(model, state):\n","    model.load_state_dict({k: v.to(DEVICE) for k, v in state.items()})\n","\n","def load_state_dict_cpu(model, state):\n","    # Backward-compatible alias used by the existing analysis code.\n","    load_state_dict_device(model, state)\n","\n","def evaluate_state(state, X, y):\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, state)\n","    model.eval()\n","    with torch.no_grad():\n","        xt = torch.from_numpy(np.asarray(X, dtype=np.float32)).to(DEVICE)\n","        logits = model(xt)\n","        prob = torch.softmax(logits, dim=1)[:, 1].detach().cpu().numpy()\n","        pred = logits.argmax(1).detach().cpu().numpy()\n","    return {\n","        \"accuracy\": accuracy_score(y, pred),\n","        \"balanced_accuracy\": balanced_accuracy_score(y, pred),\n","        \"f1\": f1_score(y, pred, zero_division=0),\n","        \"precision\": precision_score(y, pred, zero_division=0),\n","        \"recall\": recall_score(y, pred, zero_division=0),\n","        \"mcc\": matthews_corrcoef(y, pred),\n","        \"auroc\": roc_auc_score(y, prob) if len(np.unique(y)) == 2 else np.nan\n","    }\n"]},{"cell_type":"code","execution_count":11,"id":"c5b3fe47","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.32111Z","iopub.status.busy":"2026-11-07T07:11:48.320693Z","iopub.status.idle":"2026-11-07T07:11:48.342045Z","shell.execute_reply":"2026-11-07T07:11:48.341005Z"},"papermill":{"duration":0.036919,"end_time":"2026-11-07T07:11:48.344043","exception":false,"start_time":"2026-11-07T07:11:48.307124","status":"completed"},"tags":[]},"outputs":[],"source":["# 9. Local training (non-DP)\n","def local_train(\n","    global_state,\n","    X,\n","    y,\n","    client_idx,\n","    seed,\n","    epochs=2,\n","    batch_size=64,\n","    lr=LR,\n","    prox_mu=0.0,\n","    corrupt_rate=0.0,\n","    straggler=False\n","):\n","    seed_everything(seed)\n","\n","    model = MLP(X.shape[1]).to(DEVICE)\n","    load_state_dict_device(model, global_state)\n","    model.train()\n","\n","    idx = np.asarray(client_idx, dtype=int).copy()\n","    if len(idx) < 2:\n","        raise ValueError(f\"Client has only {len(idx)} samples; too small for local training.\")\n","\n","    rng = np.random.default_rng(seed)\n","    rng.shuffle(idx)\n","\n","    client_y = y[idx]\n","    classes, counts = np.unique(client_y, return_counts=True)\n","    n_classes = len(classes)\n","    val_n = max(1, int(round(0.20 * len(idx))))\n","\n","    can_stratify = (\n","        n_classes == 2\n","        and int(counts.min()) >= 2\n","        and val_n >= 2\n","        and (len(idx) - val_n) >= 2\n","    )\n","\n","    if can_stratify:\n","        tr_idx, va_idx = train_test_split(\n","            idx, test_size=0.20, stratify=client_y, random_state=seed\n","        )\n","    elif n_classes == 2 and int(counts.min()) == 1:\n","        rare_class = classes[np.argmin(counts)]\n","        rare_idx = idx[client_y == rare_class]\n","        common_idx = idx[client_y != rare_class]\n","        rng.shuffle(common_idx)\n","        val_n = min(max(1, int(round(0.20 * len(idx)))), max(1, len(common_idx) - 1))\n","        va_idx = common_idx[:val_n]\n","        tr_idx = np.concatenate([rare_idx, common_idx[val_n:]])\n","        rng.shuffle(tr_idx)\n","    else:\n","        cut = max(1, min(len(idx) - 1, int(round(0.80 * len(idx)))))\n","        tr_idx, va_idx = idx[:cut], idx[cut:]\n","\n","    y_local = y[tr_idx].copy()\n","    if corrupt_rate > 0:\n","        corrupt_mask = rng.random(len(y_local)) < corrupt_rate\n","        y_local[corrupt_mask] = 1 - y_local[corrupt_mask]\n","\n","    x_tensor = torch.from_numpy(np.asarray(X[tr_idx], dtype=np.float32))\n","    y_tensor = torch.from_numpy(np.asarray(y_local, dtype=np.int64))\n","    ds = TensorDataset(x_tensor, y_tensor)\n","    loader = DataLoader(\n","        ds, batch_size=min(batch_size, len(ds)), shuffle=True,\n","        drop_last=False, pin_memory=(DEVICE.type == \"cuda\")\n","    )\n","\n","    optimizer = torch.optim.SGD(model.parameters(), lr=lr)\n","    criterion = nn.CrossEntropyLoss()\n","    n_epochs = 1 if straggler else epochs\n","\n","    global_tensors = {\n","        name: p.detach().clone()\n","        for name, p in model.named_parameters()\n","        if p.requires_grad\n","    }\n","\n","    for _ in range(n_epochs):\n","        for xb, yb in loader:\n","            xb = xb.to(DEVICE, non_blocking=True)\n","            yb = yb.to(DEVICE, non_blocking=True)\n","            optimizer.zero_grad(set_to_none=True)\n","            loss = criterion(model(xb), yb)\n","            if prox_mu > 0:\n","                prox = 0.0\n","                for name, p in model.named_parameters():\n","                    if p.requires_grad:\n","                        prox = prox + torch.sum((p - global_tensors[name]) ** 2)\n","                loss = loss + 0.5 * prox_mu * prox\n","            loss.backward()\n","            optimizer.step()\n","\n","    model.eval()\n","    with torch.no_grad():\n","        xv = torch.from_numpy(np.asarray(X[va_idx], dtype=np.float32)).to(DEVICE)\n","        pred = model(xv).argmax(dim=1).detach().cpu().numpy()\n","    y_val = y[va_idx].copy()\n","    if CONSISTENT_VAL_LABELS and corrupt_rate > 0:\n","        val_mask = rng.random(len(y_val)) < corrupt_rate\n","        y_val[val_mask] = 1 - y_val[val_mask]\n","    val_acc = accuracy_score(y_val, pred)\n","\n","    return clone_state_dict(model), float(val_acc), len(tr_idx)\n","\n","def train_clients_once(global_state, parts, X, y, seed, method, epochs, batch_size,\n","                       corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n","    corrupt_clients = set(corrupt_clients or [])\n","    straggler_clients = set(straggler_clients or [])\n","    states, val_accs, ns = [], [], []\n","    for k, idx in enumerate(parts):\n","        prox = PROX_MU if method == \"FedProx\" else 0.0\n","        st, acc, n = local_train(\n","            global_state, X, y, idx, seed + k, epochs=epochs, batch_size=batch_size,\n","            lr=LR, prox_mu=prox,\n","            corrupt_rate=corrupt_rate if k in corrupt_clients else 0.0,\n","            straggler=(k in straggler_clients)\n","        )\n","        states.append(st); val_accs.append(acc); ns.append(n)\n","    return states, val_accs, ns\n"]},{"cell_type":"code","execution_count":12,"id":"213d0e65","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.369379Z","iopub.status.busy":"2026-11-07T07:11:48.368986Z","iopub.status.idle":"2026-11-07T07:11:48.386693Z","shell.execute_reply":"2026-11-07T07:11:48.385466Z"},"papermill":{"duration":0.033171,"end_time":"2026-11-07T07:11:48.388889","exception":false,"start_time":"2026-11-07T07:11:48.355718","status":"completed"},"tags":[]},"outputs":[],"source":["\n","# 10. Aggregators\n","def aggregate_fedavg(states, ns):\n","    total=float(sum(ns))\n","    return {k:sum(states[i][k]*(ns[i]/total) for i in range(len(states))) for k in states[0]}\n","\n","def aggregate_median(states):\n","    return {k:torch.median(torch.stack([s[k] for s in states]),dim=0).values for k in states[0]}\n","\n","def aggregate_trimmed_mean(states, trim_fraction=0.2):\n","    n=len(states); trim=int(math.floor(n*trim_fraction))\n","    if 2*trim>=n: return aggregate_median(states)\n","    out={}\n","    for k in states[0]:\n","        t=torch.stack([s[k] for s in states])\n","        t,_=torch.sort(t,dim=0)\n","        out[k]=t[trim:n-trim].mean(dim=0)\n","    return out\n","\n","def aggregate_cafad(states, ns, val_accs, beta=CAFAD_BETA, z=CAFAD_Z):\n","    c=np.asarray(val_accs,float); mu=float(c.mean()); sd=float(c.std())\n","    mask=np.ones(len(c),dtype=bool) if sd<1e-12 else (c >= mu-z*sd)\n","    if not mask.any(): mask[:]=True\n","    logits=beta*(c-c.max())\n","    raw=np.asarray(ns,float)*np.exp(logits)*mask.astype(float)\n","    if raw.sum()<=0: raw=np.asarray(ns,float)\n","    w=raw/raw.sum()\n","    return ({k:sum(states[i][k]*float(w[i]) for i in range(len(states))) for k in states[0]}, w, mask)\n","\n","def aggregate_multikrum(states, f=1):\n","    n=len(states)\n","    if n<=2*f+2: return aggregate_fedavg(states,[1]*n)\n","    V=torch.stack([torch.cat([s[k].reshape(-1).float() for k in s]) for s in states])\n","    d=torch.cdist(V,V,p=2)**2\n","    scores=[]\n","    for i in range(n):\n","        others=torch.cat([d[i,:i],d[i,i+1:]])\n","        scores.append(torch.topk(others,k=n-f-2,largest=False).values.sum().item())\n","    chosen=np.argsort(scores)[:n-f]\n","    chosen_states=[states[int(i)] for i in chosen]\n","    return aggregate_fedavg(chosen_states,[1]*len(chosen_states))\n","\n","def aggregate(method, states, ns, val_accs):\n","    if method in (\"FedAvg\",\"FedProx\"): return aggregate_fedavg(states,ns),None,None\n","    if method==\"Median\": return aggregate_median(states),None,None\n","    if method==\"TrimmedMean\": return aggregate_trimmed_mean(states,TRIM_FRACTION),None,None\n","    if method==\"Krum\": return aggregate_multikrum(states,KRUM_F),None,None\n","    if method==\"CAFAD\":\n","        st,w,mask=aggregate_cafad(states,ns,val_accs); return st,w,mask\n","    raise ValueError(method)\n"]},{"cell_type":"code","execution_count":13,"id":"8f338744","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.414229Z","iopub.status.busy":"2026-11-07T07:11:48.413863Z","iopub.status.idle":"2026-11-07T07:11:48.423713Z","shell.execute_reply":"2026-11-07T07:11:48.42269Z"},"papermill":{"duration":0.024984,"end_time":"2026-11-07T07:11:48.425622","exception":false,"start_time":"2026-11-07T07:11:48.400638","status":"completed"},"tags":[]},"outputs":[],"source":["# 11. Federated driver\n","METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","\n","\n","def run_federated(X, y, X_eval, y_eval, parts, method, seed, rounds, local_epochs,\n","                  batch_size, corrupt_clients=None, corrupt_rate=0.0, straggler_clients=None):\n","    seed_everything(seed)\n","    global_state = clone_state_dict(MLP(X.shape[1]).to(DEVICE))\n","    final_weights = None\n","    final_mask = None\n","    history = []\n","\n","    for rnd in range(rounds):\n","        states, val_accs, ns = train_clients_once(\n","            global_state, parts, X, y, seed + rnd * 1000, method,\n","            local_epochs, batch_size,\n","            corrupt_clients=corrupt_clients, corrupt_rate=corrupt_rate,\n","            straggler_clients=straggler_clients\n","        )\n","        global_state, weights, mask = aggregate(method, states, ns, val_accs)\n","        final_weights, final_mask = weights, mask\n","        history.append({\n","            \"round\": rnd + 1,\n","            \"method\": method,\n","            \"seed\": seed,\n","            **evaluate_state(global_state, X_eval, y_eval),\n","            \"mean_client_val_acc\": float(np.mean(val_accs)),\n","            \"std_client_val_acc\": float(np.std(val_accs)),\n","        })\n","\n","    result = evaluate_state(global_state, X_eval, y_eval)\n","    result.update({\n","        \"method\": method,\n","        \"seed\": seed,\n","        \"final_cafad_weight_min\": float(np.min(final_weights)) if final_weights is not None else np.nan,\n","        \"final_cafad_weight_max\": float(np.max(final_weights)) if final_weights is not None else np.nan,\n","        \"final_cafad_masked_clients\": int((~final_mask).sum()) if final_mask is not None else np.nan\n","    })\n","    return result, pd.DataFrame(history), global_state\n"]},{"cell_type":"markdown","id":"b552d10a","metadata":{"papermill":{"duration":0.011665,"end_time":"2026-11-07T07:11:48.448967","exception":false,"start_time":"2026-11-07T07:11:48.437302","status":"completed"},"tags":[]},"source":["## 12. Clean FL / heterogeneity sweep\n","\n","Primary paper grid: 20 seeds × 10 simulated clients × (IID + Dirichlet α∈{10,2,1,0.5,0.1}) × five aggregation methods = 600 federated runs. Every run writes a recoverable result row, round history, and final model-state cache."]},{"cell_type":"code","execution_count":14,"id":"d1904a65","metadata":{"execution":{"iopub.execute_input":"2026-11-07T07:11:48.474801Z","iopub.status.busy":"2026-11-07T07:11:48.474094Z","iopub.status.idle":"2026-11-07T07:11:48.485861Z","shell.execute_reply":"2026-11-07T07:11:48.484633Z"},"papermill":{"duration":0.027197,"end_time":"2026-11-07T07:11:48.487979","exception":false,"start_time":"2026-11-07T07:11:48.460782","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Results directory: /kaggle/working/attention_fl_v3_q1_10client_lrtuned_results\n","Checkpoint directory: /kaggle/working/attention_fl_v3_q1_10client_lrtuned_results/checkpoints\n","Model cache directory: /kaggle/working/attention_fl_v3_q1_10client_lrtuned_results/model_cache\n","Clean-history cache directory: /kaggle/working/attention_fl_v3_q1_10client_lrtuned_results/clean_history_cache\n"]}],"source":["# 11B. Checkpoint utilities\n","\n","def atomic_to_csv(frame, path):\n","    path = Path(path)\n","    path.parent.mkdir(parents=True, exist_ok=True)\n","    tmp = path.with_suffix(path.suffix + \".tmp\")\n","    frame.to_csv(tmp, index=False)\n","    os.replace(tmp, path)\n","\n","\n","def atomic_torch_save(obj, path):\n","    path = Path(path)\n","    path.parent.mkdir(parents=True, exist_ok=True)\n","    tmp = path.with_suffix(path.suffix + \".tmp\")\n","    torch.save(obj, tmp)\n","    os.replace(tmp, path)\n","\n","\n","def upsert_checkpoint(path, new_rows, key_cols):\n","    path = Path(path)\n","    current = pd.read_csv(path) if path.exists() else pd.DataFrame()\n","    incoming = pd.DataFrame(new_rows)\n","    merged = pd.concat([current, incoming], ignore_index=True, sort=False)\n","\n","    if key_cols:\n","        merged = merged.drop_duplicates(subset=key_cols, keep=\"last\")\n","\n","    merged = merged.re