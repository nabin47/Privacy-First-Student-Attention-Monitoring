                False  "]},"metadata":{},"output_type":"display_data"}],"source":["# 23F. Summary of section 23\n","def _mean_sd(frame, by):\n","    g = frame.groupby(by, dropna=False)[\"accuracy\"]\n","    return pd.DataFrame({\"mean\": g.mean() * 100, \"sd\": g.std(ddof=1) * 100, \"n\": g.size()}).round(2).reset_index()\n","\n","def _vs_fedavg(frame, group_cols, arm_col):\n","    rows = []\n","    for key, g in frame.groupby(group_cols, dropna=False):\n","        key = key if isinstance(key, tuple) else (key,)\n","        ref = g[g[arm_col] == \"FedAvg\"].set_index(\"seed\")[\"accuracy\"]\n","        for arm in sorted(set(g[arm_col]) - {\"FedAvg\"}):\n","            cur = g[g[arm_col] == arm].set_index(\"seed\")[\"accuracy\"]\n","            common = sorted(set(ref.index) & set(cur.index))\n","            if len(common) < 2:\n","                continue\n","            a = ref.loc[common].to_numpy(dtype=float)\n","            b = cur.loc[common].to_numpy(dtype=float)\n","            p = 1.0 if np.allclose(a, b) else float(wilcoxon(a, b).pvalue)\n","            rows.append({**dict(zip(group_cols, key)), \"arm\": arm, \"n_pairs\": len(common),\n","                         \"mean_diff_vs_fedavg\": float(np.mean(b - a)), \"wilcoxon_p\": p})\n","    out = pd.DataFrame(rows)\n","    if not out.empty:\n","        out[\"bh_q\"] = bh_adjust(out[\"wilcoxon_p\"].to_numpy())\n","        out[\"significant_bh_0_05\"] = out[\"bh_q\"] < 0.05\n","    return out\n","\n","def _save(frame, name):\n","    if frame is not None and not frame.empty:\n","        atomic_to_csv(frame, RESULTS_DIR / name)\n","        display(frame)\n","\n","print(\"Per-rule learning rates at alpha=0.1:\", RULE_LR)\n","print(\"Per-rule DP learning rates:\", DP_RULE_LR)\n","\n","if ALPHA01_FINAL.exists() and KRUM_FINAL.exists():\n","    clean_main = pd.read_csv(RESULTS_DIR / \"clean_fl_sweep_v3.csv\")\n","    clean_main = clean_main[np.isclose(pd.to_numeric(clean_main[\"alpha\"], errors=\"coerce\"), RULE_ALPHA)]\n","    krum_all = pd.read_csv(KRUM_FINAL)\n","    krum_a01 = krum_all[(krum_all[\"scenario\"] == \"clean\") & np.isclose(krum_all[\"alpha_key\"], RULE_ALPHA)]\n","    a01 = pd.concat([\n","        clean_main.assign(variant=\"shared_lr\"),\n","        krum_a01.assign(variant=\"shared_lr\"),\n","        pd.read_csv(ALPHA01_FINAL),\n","    ], ignore_index=True, sort=False)\n","    _save(_mean_sd(a01, [\"variant\", \"method\"]), \"MANUSCRIPT_extra_alpha0p1_summary.csv\")\n","    _save(_vs_fedavg(a01, [\"variant\"], \"method\"), \"MANUSCRIPT_extra_alpha0p1_tests.csv\")\n","\n","if KRUM_FINAL.exists():\n","    _save(_mean_sd(pd.read_csv(KRUM_FINAL), [\"scenario\", \"condition\", \"alpha_key\"]), \"MANUSCRIPT_extra_krum_summary.csv\")\n","    rob_main = pd.read_csv(RESULTS_DIR / \"robustness_sweep_corrected_v3.csv\")\n","    krum_rob = pd.read_csv(KRUM_FINAL)\n","    krum_rob = krum_rob[krum_rob[\"scenario\"] != \"clean\"]\n","    _save(_vs_fedavg(pd.concat([rob_main, krum_rob], ignore_index=True, sort=False), [\"scenario\"], \"method\"),\n","          \"MANUSCRIPT_extra_krum_robustness_tests.csv\")\n","\n","if SKEW_FLIP_FINAL.exists():\n","    sf = pd.read_csv(SKEW_FLIP_FINAL)\n","    _save(_mean_sd(sf, [\"scenario\", \"arm\"]), \"MANUSCRIPT_extra_label_flip_alpha0p1_summary.csv\")\n","    _save(_vs_fedavg(sf, [\"scenario\"], \"arm\"), \"MANUSCRIPT_extra_label_flip_alpha0p1_tests.csv\")\n","    display(sf.groupby(\"scenario\")[\"poisoned_record_share\"].describe().round(3))\n","\n","if DP_RULE_FINAL.exists():\n","    dpr = pd.read_csv(DP_RULE_FINAL)\n","    dp_ctrl = pd.read_csv(RESULTS_DIR / \"dp_privacy_utility_corrected_v2.csv\")\n","    dp_ctrl = dp_ctrl[np.isinf(dp_ctrl[\"target_epsilon\"].astype(float))]\n","    dp_all = pd.concat([dpr, dp_ctrl], ignore_index=True, sort=False)\n","    _save(_mean_sd(dp_all, [\"target_epsilon\", \"method\"]), \"MANUSCRIPT_extra_dp_rule_lr_summary.csv\")\n","    _save(_vs_fedavg(dpr, [\"target_epsilon\"], \"method\"), \"MANUSCRIPT_extra_dp_rule_lr_tests.csv\")\n"]},{"cell_type":"markdown","id":"8bef2ff0","metadata":{"papermill":{"duration":0.091845,"end_time":"2026-11-07T17:13:25.207494","exception":false,"start_time":"2026-11-07T17:13:25.115649","status":"completed"},"tags":[]},"source":["## 24. Final statistical analyses and publication exports\n","\n","These cells perform analysis only. They do not retrain any models."]},{"cell_type":"code","execution_count":44,"id":"9c233bb4","metadata":{"execution":{"iopub.execute_input":"2026-11-07T17:13:25.395154Z","iopub.status.busy":"2026-11-07T17:13:25.394363Z","iopub.status.idle":"2026-11-07T17:13:25.642818Z","shell.execute_reply":"2026-11-07T17:13:25.64172Z"},"papermill":{"duration":0.351616,"end_time":"2026-11-07T17:13:25.64483","exception":false,"start_time":"2026-11-07T17:13:25.293214","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Clean analysis exported.\n"]}],"source":["# 24A. Recompute clean statistics from the saved final file (no clean-model retraining)\n","CLEAN_FINAL_PATH = RESULTS_DIR / \"clean_fl_sweep_v3.csv\"\n","CLEAN_SEEDS = list(CFG[\"seeds\"])\n","METHODS = [\"FedAvg\", \"FedProx\", \"Median\", \"TrimmedMean\", \"CAFAD\"]\n","if not CLEAN_FINAL_PATH.exists():\n","    raise FileNotFoundError(f\"Completed clean FL result file is required: {CLEAN_FINAL_PATH}\")\n","clean_results = pd.read_csv(CLEAN_FINAL_PATH)\n","expected_clean = len(CLEAN_SEEDS) * (1 + len(CFG[\"alphas\"])) * len(METHODS)\n","assert len(clean_results) == expected_clean, f\"Expected {expected_clean} clean rows, found {len(clean_results)}\"\n","\n","METRICS = [\"accuracy\",\"balanced_accuracy\",\"f1\",\"precision\",\"recall\",\"mcc\",\"auroc\"]\n","from scipy.stats import t, wilcoxon\n","if \"bh_adjust\" not in globals():\n","    def bh_adjust(pvals):\n","        pvals = np.asarray(pvals, dtype=float)\n","        n = len(pvals)\n","        order = np.argsort(pvals)\n","        ranked = pvals[order]\n","        q = ranked * n / np.arange(1, n + 1)\n","        q = np.minimum.accumulate(q[::-1])[::-1]\n","        out = np.empty_like(q)\n","        out[order] = q\n","        return np.minimum(out, 1.0)\n","\n","def summarize_metric(data, group_cols, metric):\n","    rows=[]\n","    for keys,g in data.groupby(group_cols, dropna=False):\n","        vals=g[metric].dropna().to_numpy(); n=len(vals)\n","        if n<2: continue\n","        mean=float(vals.mean()); std=float(vals.std(ddof=1)); sem=std/np.sqrt(n)\n","        margin=float(t.ppf(0.975,n-1)*sem)\n","        if not isinstance(keys,tuple): keys=(keys,)\n","        row=dict(zip(group_cols,keys)); row.update({\"metric\":metric,\"n\":n,\"mean\":mean,\"std\":std,\"ci95_low\":mean-margin,\"ci95_high\":mean+margin,\"ci95_half_width\":margin}); rows.append(row)\n","    return pd.DataFrame(rows)\n","\n","metric_summary=pd.concat([summarize_metric(clean_results,[\"condition\",\"alpha\",\"method\"],m) for m in METRICS],ignore_index=True)\n","accuracy_summary=metric_summary[metric_summary[\"metric\"]==\"accuracy\"].copy()\n","for c in [\"mean\",\"std\",\"ci95_low\",\"ci95_high\"]:\n","    accuracy_summary[c+\"_percent\"]=accuracy_summary[c]*100\n","\n","# Paired Wilcoxon tests vs FedAvg within every fixed condition.\n","comparison_rows=[]\n","for (condition,alpha),g in clean_results.groupby([\"condition\",\"alpha\"],dropna=False):\n","    base=g[g[\"method\"]==\"FedAvg\"].set_index(\"seed\")\n","    for method in [m for m in METHODS if m!=\"FedAvg\"]:\n","        cur=g[g[\"method\"]==method].set_index(\"seed\")\n","        common=sorted(set(base.index)&set(cur.index))\n","        for metric in [\"accuracy\",\"f1\"]:\n","            a=base.loc[common,metric].to_numpy(); b=cur.loc[common,metric].to_numpy()\n","            stat,p=wilcoxon(a,b,zero_method=\"wilcox\",alternative=\"two-sided\")\n","            comparison_rows.append({\"condition\":condition,\"alpha\":alpha,\"method_a\":\"FedAvg\",\"method_b\":method,\"metric\":metric,\"n\":len(common),\"mean_diff_b_minus_a\":float(np.mean(b-a)),\"median_diff_b_minus_a\":float(np.median(b-a)),\"wilcoxon_p\":float(p)})\n","accuracy_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"accuracy\"])\n","f1_tests=pd.DataFrame([r for r in comparison_rows if r[\"metric\"]==\"f1\"])\n","all_tests=pd.concat([accuracy_tests,f1_tests],ignore_index=True)\n","all_tests[\"bh_q\"] = bh_adjust(all_tests[\"wilcoxon_p\"].to_numpy())\n","\n","metric_summary.to_csv(RESULTS_DIR/\"clean_metric_summary_v3.csv\",index=False)\n","accuracy_summary.to_csv(RESULTS_DIR/\"clean_accuracy_summary_v3.csv\",index=False)\n","accuracy_tests.to_csv(RESULTS_DIR/\"clean_paired_accuracy_tests_v3.csv\",index=False)\n","f1_tests.to_csv(RESULTS_DIR/\"clean_paired_f1_tests_v3.csv\",index=False)\n","print(\"Clean analysis exported.\")\n"]},{"cell_type":"code","execution_count":45,"id":"6094569c","metadata":{"execution":{"iopub.execute_input":"2026-11-07T17:13:25.81942Z","iopub.status.busy":"2026-11-07T17:13:25.81908Z","iopub.status.idle":"2026-11-07T17:13:30.491552Z","shell.execute_reply":"2026-11-07T17:13:30.4905Z"},"papermill":{"duration":4.761518,"end_time":"2026-11-07T17:13:30.493685","exception":false,"start_time":"2026-11-07T17:13:25.732167","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1000x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_16/2302519118.py:78: UserWarning: No